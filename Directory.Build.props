<Project>
  <!-- Shared by every project in the repo. -->
  <PropertyGroup>
    <Authors>falling_colud</Authors>
    <Company>falling_colud</Company>
    <Product>CloudLauncher</Product>
    <Copyright>Copyright (c) 2026 falling_colud</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Keep the file version free of the git commit hash. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Release builds: symbols inside the dll (so crash logs keep line numbers) with build-machine
       paths replaced, and no separate .pdb files next to the exe. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/src/</PathMap>
  </PropertyGroup>
</Project>
