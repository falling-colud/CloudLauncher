<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the Linux launcher's pages to PNG with Avalonia's headless platform: no window, no screen,
       on Windows or Linux. Run it against the showcase fake server (tools/linux-shots/shots.ps1). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClLinuxShots</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CloudLauncher.Linux\CloudLauncher.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.23" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.23" />
  </ItemGroup>

</Project>
