<Page x:Class="CloudLauncher.Views.PackBrowserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Pack browser"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="18,16,18,8">
            <TextBlock Style="{StaticResource H2}" Text="Download a pack"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Browse CurseForge, Modrinth, and CloudLauncher catalogs. Pick a source below."/>
        </StackPanel>

        <Border Grid.Row="1" Margin="18,0,18,12">
            <StackPanel>
                <!-- Right group, in the usual order: Filters, search box, Refresh. -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="FiltersButton" Style="{StaticResource ToolbarIconButton}"
                                Content="&#xE71C;" ToolTip="Filters" Click="OnFiltersClick"/>
                        <!-- Longer debounce than the 200ms default: every search here is a request to
                        CurseForge, Modrinth or the server. -->
                        <views:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0"
                                                DebounceMilliseconds="450"
                                                Placeholder="Search this source"
                                                SearchToolTip="Search the selected catalog for a modpack"/>
                        <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                                Content="&#xE72C;"
                                ToolTip="Re-run this search and re-check which packs you already have (F5)"
                                Click="OnRefresh"/>
                    </StackPanel>
                    <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="0" VerticalOffset="6">
                        <slate:SlateBorder Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" MinWidth="260">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Minecraft version"/>
                                <TextBox x:Name="FilterMcBox" Margin="0,4,0,10"
                                         ToolTip="e.g. 1.20.1 - leave empty for any"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Loader"/>
                                <ComboBox x:Name="FilterLoaderBox" Margin="0,4,0,10">
                                    <ComboBoxItem Content="(any)" IsSelected="True"/>
                                    <ComboBoxItem Content="fabric"/>
                                    <ComboBoxItem Content="forge"/>
                                    <ComboBoxItem Content="neoforge"/>
                                    <ComboBoxItem Content="quilt"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Apply" Style="{StaticResource AccentButton}"
                                            Click="OnApplyFilters" Padding="14,5"/>
                                </StackPanel>
                            </StackPanel>
                        </slate:SlateBorder>
                    </Popup>
                </Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,2">
                    <ItemsControl x:Name="SourceStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <slate:SlateBorder Padding="0" Margin="0,2,8,2" Cursor="{Binding CursorHint}"
                                        Background="{Binding Background}"
                                        BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                        CornerRadius="14"
                                        ToolTip="{Binding ToolTipText}"
                                        MouseLeftButtonUp="OnSourceChipClick"
                                        Visibility="{Binding ChipVisibility}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="11" Margin="12,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground}"
                                                   Visibility="{Binding IconVisibility}"/>
                                        <TextBlock Text="{Binding Label}" Margin="0,0,12,0"
                                                   Padding="0,5,0,5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground}"
                                                   FontWeight="{Binding FontWeight}"/>
                                    </StackPanel>
                                </slate:SlateBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="260"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <slate:SlateBorder Grid.Row="0" Margin="18,0,18,8"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ResultsList"
                             SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             anim:Animate.EntranceStagger="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnResultsScroll">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="Transparent"
                                        anim:Animate.HoverLift="True"
                                        ToolTip="{Binding RowToolTip}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.ActionLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="OnCtxPrimaryAction">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open instance" Click="OnCtxOpenInstance"
                                                      Visibility="{Binding PlacementTarget.DataContext.AddedMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open project page" Click="OnCtxOpenProjectPage"
                                                      Visibility="{Binding PlacementTarget.DataContext.ExternalMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE774;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Copy pack ID" Click="OnCtxCopyId"
                                                      Visibility="{Binding PlacementTarget.DataContext.InternalMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy project URL" Click="OnCtxCopyUrl"
                                                      Visibility="{Binding PlacementTarget.DataContext.ExternalMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Visibility="{Binding PlacementTarget.DataContext.AddedMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Remove from my list..." Click="OnCtxRemoveFromList"
                                                      Visibility="{Binding PlacementTarget.DataContext.AddedMenuVisibility, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <slate:SlateBorder Grid.Column="0" Width="42" Height="42"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Load through the icon cache: a raw URL on
                                                Image.Source downloads and decodes at full size on
                                                the UI thread, which makes fast scrolling stutter. -->
                                                <Image views:IconLoader.Url="{Binding IconUrl}"
                                                       views:IconLoader.DecodeWidth="42"
                                                       Stretch="Uniform"/>
                                                <!-- Locally cached artwork for a CloudLauncher pack you
                                                already have; hosted packs carry no icon URL of their
                                                own. -->
                                                <Image Source="{Binding IconImage}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </slate:SlateBorder>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Row actions live at the right edge, as on the Instances list. -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <!-- Marks your own pack (Public pins it to the top).
                                                Plain pill: the tag colours mean Public/Team/Shared
                                                elsewhere, and the accent ones blend into the
                                                CloudLauncher badge next to it. -->
                                                <slate:SlateBorder Style="{StaticResource Pill}" Margin="0,0,6,0"
                                                        Visibility="{Binding YoursVisibility}"
                                                        ToolTip="You own this pack">
                                                    <TextBlock Text="Yours" Style="{StaticResource PillText}"/>
                                                </slate:SlateBorder>
                                                <slate:SlateBorder Style="{StaticResource Pill}"
                                                        Background="{Binding SourceBadgeBackground}">
                                                    <TextBlock Text="{Binding SourceBadge}"
                                                               Style="{StaticResource PillText}"
                                                               Foreground="{Binding SourceBadgeForeground}"/>
                                                </slate:SlateBorder>
                                            </StackPanel>
                                            <TextBlock Text="Not hosted" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding NotHostedVisibility}"
                                                       ToolTip="{Binding NotHostedHint}"/>
                                            <Button Content="{Binding ActionLabel}"
                                                    Style="{StaticResource AccentButton}"
                                                    Click="OnDownloadRow" Tag="{Binding}"
                                                    Visibility="{Binding ActionVisibility}"
                                                    Padding="12,5" MinHeight="30" MinWidth="0"
                                                    HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Searching / no results / failed / offline, all from Views/PageState.cs. -->
                    <views:PageStateView x:Name="PageStateHost"/>
                </Grid>
            </slate:SlateBorder>

            <Grid Grid.Row="1" Margin="18,4,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="DetailHeader" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <slate:SlateBorder Grid.Column="0" Width="42" Height="42"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H3}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                        </Grid>
                    </slate:SlateBorder>
                    <StackPanel Grid.Column="1">
                        <!--  MaxHeight is two lines of H2; longer names are trimmed with an ellipsis.  -->
                        <TextBlock x:Name="PackNameLabel" Style="{StaticResource H2}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="54"/>
                        <TextBlock x:Name="PackMetaLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!--  Actions get their own row: next to the name they would take most of the
                    pane at the minimum window width. WrapPanel so they wrap instead of spilling
                    out of the card. The hint comes first so the buttons stay flush right, as on
                    the other browsers.  -->
                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
                               HorizontalAlignment="Right" Margin="0,10,0,0">
                        <TextBlock x:Name="AddedHint" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   TextWrapping="Wrap" MaxWidth="320"/>
                        <Button x:Name="OpenProjectButton" Content="Open page"
                                Click="OnOpenSelectedProject"
                                Padding="10,4" MinWidth="0" MinHeight="0"/>
                        <Button x:Name="DownloadSelectedButton" Content="Download"
                                Style="{StaticResource AccentButton}"
                                Click="OnDownloadSelectedPack"
                                Padding="10,4" MinWidth="0" MinHeight="0"/>
                    </WrapPanel>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="DetailPlaceholder"
                           Text="Select or double-click a modpack to see overview, screenshots, links, and downloadable versions."
                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" MaxWidth="520"/>

                <TabControl Grid.Row="1" x:Name="PackTabs" Visibility="Collapsed"
                            anim:Animate.TabTransition="True">
                    <TabItem Header="Overview">
                        <Border x:Name="OverviewHost"
                                ClipToBounds="True"
                                Background="{DynamicResource Surface0Brush}"
                                Margin="0,12,0,0"
                                MinHeight="420">
                            <views:RichDescriptionView x:Name="OverviewBrowser"/>
                        </Border>
                    </TabItem>

                    <TabItem x:Name="ScreenshotsTab" Header="Screenshots">
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                       Text="No screenshots are available for this modpack."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ScreenshotList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <slate:SlateBorder Width="220" Margin="0,0,10,10" Style="{StaticResource Card}" Padding="8"
                                                    Cursor="Hand" ToolTip="Open screenshot"
                                                    MouseLeftButtonUp="OnOpenScreenshot">
                                                <StackPanel>
                                                    <slate:SlateBorder Height="116" Background="{DynamicResource Surface0Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                    </slate:SlateBorder>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </slate:SlateBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="LinksTab" Header="Links">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            </WrapPanel>
                            <TextBlock x:Name="LinksEmptyText" Style="{StaticResource Muted}"
                                       Text="This project has not published extra links through the selected provider."
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem x:Name="VersionsTab" Header="Versions">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" x:Name="VersionsToolbar" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                                    <TextBlock x:Name="VersionFilterNote" Style="{StaticResource Caption}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowAllVersionsBox" Grid.Column="1" Content="Show all"
                                          VerticalAlignment="Center"
                                          Checked="OnShowAllVersionsChanged" Unchecked="OnShowAllVersionsChanged"/>
                            </Grid>
                            <!-- CloudLauncher packs have no release history (the server keeps one live
                            copy), so they get a plain fact sheet instead of a version grid. -->
                            <slate:SlateBorder Grid.Row="0" Grid.RowSpan="2" x:Name="InternalDetailsHost"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              anim:Animate.SmoothScroll="True">
                                    <ItemsControl x:Name="InternalDetailsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Style="{StaticResource Caption}"
                                                               VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding Hint}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </slate:SlateBorder>

                            <slate:SlateBorder Grid.Row="1" x:Name="VersionsGridHost"
                                    Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <DataGrid x:Name="VersionsGrid"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" RowHeaderWidth="0"
                                          SelectionMode="Single" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                        <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="150"/>
                                        <DataGridTextColumn Header="Loader" Binding="{Binding LoaderList}" Width="100"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding ReleaseChannel}" Width="74"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="96"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
                                        <DataGridTemplateColumn Width="104">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding ActionLabel}"
                                                            Style="{StaticResource AccentButton}"
                                                            Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                            Visibility="{Binding ActionVisibility}"
                                                            Click="OnDownloadVersion"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </slate:SlateBorder>
                        </Grid>
                    </TabItem>
                </TabControl>

                <DockPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <ProgressBar Grid.Row="2" x:Name="DownloadProgress" Height="3"
                             Margin="0,0,0,-10" VerticalAlignment="Bottom"
                             Visibility="Collapsed" IsIndeterminate="False"/>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="18,8">
            <DockPanel>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <!-- SetStatus / PageState set the colour as a resource reference, so it matches
                the kind of message and follows theme changes. -->
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
