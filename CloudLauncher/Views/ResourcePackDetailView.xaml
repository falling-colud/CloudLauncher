<Page x:Class="CloudLauncher.Views.ResourcePackDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      Title="Resource pack"
      Background="{DynamicResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,16,22,28">

            <slate:SlateBorder Style="{StaticResource ElevatedCard}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                Background="{DynamicResource Surface4Brush}">
                            <TextBlock x:Name="VisibilityLabel" Style="{StaticResource PillText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </slate:SlateBorder>
                        <TextBlock x:Name="PackNameLabel" Style="{StaticResource H2}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="MetaLabel" Style="{StaticResource Muted}"/>
                </StackPanel>
            </slate:SlateBorder>

            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Overview" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Name"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,12" MaxLength="128"
                             ToolTip="The name collaborators see. 1-128 characters."/>
                    <TextBlock Style="{StaticResource Caption}" Text="Summary"/>
                    <TextBox x:Name="SummaryBox" Margin="0,4,0,12" MaxLength="512"/>
                    <TextBlock Style="{StaticResource Caption}" Text="Description"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,4,0,12"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="90" MaxHeight="220" MaxLength="4096"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Minecraft versions"/>
                    <TextBox x:Name="McVersionsBox" Margin="0,4,0,12" MaxLength="256"
                             ToolTip="Comma-separated, e.g. 1.21.1, 1.21 - this is what decides which instances can install it"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Visibility"/>
                    <ComboBox x:Name="VisibilityBox" Margin="0,4,0,12">
                        <ComboBoxItem Content="Private"/>
                        <ComboBoxItem Content="Team"/>
                        <ComboBoxItem Content="Public"/>
                    </ComboBox>

                    <DockPanel>
                        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save"
                                Style="{StaticResource AccentButton}" Click="OnSave" Padding="14,5"/>
                        <Button x:Name="PermissionsButton" DockPanel.Dock="Right"
                                Content="Manage collaborators..." Click="OnEditPermissions"
                                Margin="0,0,8,0" Padding="14,5"
                                ToolTipService.ShowOnDisabled="True"/>
                        <Button x:Name="DeletePackButton" DockPanel.Dock="Right"
                                Content="Delete resource pack..." Click="OnDeletePack"
                                Foreground="{DynamicResource DangerBrush}"
                                Margin="0,0,8,0" Padding="14,5"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Removes the hosted pack and every uploaded version"/>
                        <!--  Only for somebody on the pack's collaborator list: access from a team or
                             from the pack being public is not theirs to give back here.  -->
                        <Button x:Name="LeaveButton" DockPanel.Dock="Right" Content="Leave..."
                                Click="OnLeave" Style="{StaticResource SubtleButton}"
                                Margin="0,0,8,0" Padding="14,5" Visibility="Collapsed"/>
                        <TextBlock x:Name="SaveStatus" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </slate:SlateBorder>

            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="UploadVersionButton" DockPanel.Dock="Right"
                                Content="Upload version (.zip)"
                                Style="{StaticResource AccentButton}"
                                Click="OnUploadVersion" Padding="14,5"
                                ToolTipService.ShowOnDisabled="True"/>
                        <TextBlock Style="{StaticResource H3}" Text="Versions" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="VersionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,1"
                                        Background="{DynamicResource Surface1Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        ToolTip="{Binding Tooltip}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="OnVersionMenuOpened">
                                            <MenuItem Header="Save as..." Click="OnCtxSaveVersion"
                                                      IsEnabled="{Binding CanDownload}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy download link" Click="OnCtxCopyVersionLink"/>
                                            <MenuItem Header="Copy version string" Click="OnCtxCopyVersionString"/>
                                            <Separator x:Name="VersionCtxDeleteSeparator"/>
                                            <MenuItem x:Name="VersionCtxDelete" Header="Delete version..."
                                                      Click="OnCtxDeleteVersion"
                                                      Foreground="{DynamicResource DangerBrush}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding VersionString}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <slate:SlateBorder Grid.Column="1" Style="{StaticResource Pill}"
                                                Background="{DynamicResource Surface4Brush}"
                                                Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReleaseChannel}"
                                                       Style="{StaticResource PillText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </slate:SlateBorder>
                                        <Button Grid.Column="2" Content="Open" Click="OnDownloadVersionTemp"
                                                Tag="{Binding}" Padding="10,4" MinWidth="0" MinHeight="0"
                                                FontSize="11" ToolTip="{Binding DownloadHint}"
                                                IsEnabled="{Binding CanDownload}"
                                                ToolTipService.ShowOnDisabled="True"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="VersionsEmpty" Style="{StaticResource Muted}"
                               Text="No versions uploaded yet."
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </slate:SlateBorder>

            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                       Margin="0,4,0,0" Foreground="{DynamicResource DangerBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
