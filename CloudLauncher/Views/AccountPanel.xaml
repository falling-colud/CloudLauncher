<Page x:Class="CloudLauncher.Views.AccountPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Account"
      Background="{StaticResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">

            <!-- Profile card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28"
                            Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <TextBlock x:Name="ProfileInitial" Text="?" FontSize="24" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UsernameLabel" Style="{StaticResource H2}" Text="Signed out"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Minecraft account -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Minecraft account" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Required to launch Minecraft. Pick Microsoft for online servers, or offline for cracked servers."
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Manage" Style="{StaticResource AccentButton}"
                                Click="OnManageMcAccount"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="McAccountLine" Text="(loading)"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="McAccountKind" Style="{StaticResource Caption}" Text=""/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Account actions -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Account" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Sign out of CloudLauncher on this device."
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="Sign out" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Click="OnSignOut"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
