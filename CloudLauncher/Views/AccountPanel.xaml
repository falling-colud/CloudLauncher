<Page x:Class="CloudLauncher.Views.AccountPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Account"
      Background="{DynamicResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" anim:Animate.SmoothScroll="True">
        <StackPanel Margin="18">

            <!-- Profile card -->
            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <slate:SlateBorder DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="28"
                                Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top"
                                Margin="0,0,16,0">
                            <TextBlock x:Name="ProfileInitial" Text="?" FontSize="24" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </slate:SlateBorder>

                        <!-- Row actions at the right edge -->
                        <Button DockPanel.Dock="Right" x:Name="RefreshButton" Style="{StaticResource IconButton}"
                                Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                VerticalAlignment="Top" Click="OnRefreshClicked"
                                ToolTip="Re-read your profile and storage use from the server"/>

                        <StackPanel VerticalAlignment="Center">
                            <DockPanel>
                                <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}" x:Name="VerifiedPill"
                                        VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="VerifiedPillText" Style="{StaticResource PillText}"/>
                                </slate:SlateBorder>
                                <TextBlock x:Name="UsernameLabel" Style="{StaticResource H2}" Text="Signed out"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <TextBlock x:Name="ServerLabel" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="The CloudLauncher server this launcher talks to"/>

                            <!-- The address the verified pill refers to; hidden if the server sent none. -->
                            <TextBlock x:Name="EmailLabel" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="The address this account was registered with"/>

                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" x:Name="CopyIdButton" Style="{StaticResource IconButton}"
                                        Content="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        Click="OnCopyUserId" HorizontalAlignment="Left" Margin="6,0,0,0"
                                        ToolTip="Copy your user ID - paste it when reporting a problem"/>
                                <TextBlock x:Name="UserIdLabel" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>

                            <Button x:Name="ResendVerificationButton" Style="{StaticResource LinkButton}"
                                    Content="Resend verification email" HorizontalAlignment="Left"
                                    Margin="0,6,0,0" Visibility="Collapsed" Click="OnResendVerification"
                                    ToolTip="Sends the confirmation link again to the address you registered with"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Storage. Hidden when the server can't answer, so it never shows a misleading zero. -->
                    <StackPanel x:Name="StorageSection" Margin="0,16,0,0" Visibility="Collapsed">
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" x:Name="StorageLabel"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="Server storage" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DockPanel>
                        <ProgressBar x:Name="StorageBar" Height="6" Minimum="0" Maximum="100"
                                     Background="{DynamicResource Surface3Brush}"
                                     Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="StorageHint" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </slate:SlateBorder>

            <!-- Minecraft account -->
            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Minecraft account" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Required to launch Minecraft. A Microsoft account joins any server. An offline account only joins offline-mode servers."
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Manage" Style="{StaticResource AccentButton}"
                                Click="OnManageMcAccount"
                                ToolTip="Add, switch between or remove Minecraft accounts"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="McAccountLine" Text="(loading)"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="McAccountKind" Style="{StaticResource Caption}" Text=""/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </slate:SlateBorder>

            <!-- Account actions -->
            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Account" Margin="0,0,0,8"/>

                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" x:Name="ChangeUsernameButton"
                                Content="Change username..." Click="OnChangeUsername"
                                VerticalAlignment="Center"
                                ToolTip="Pick a new name to sign in with and to be found by"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="Your username is how you sign in and how people find you to share."/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" x:Name="ChangePasswordButton"
                                Content="Change password..." Click="OnChangePassword"
                                VerticalAlignment="Center"
                                ToolTip="You stay signed in here; every other device is signed out"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="Changing your password signs out every other device."/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" x:Name="SignOutButton" Content="Sign out"
                                Style="{StaticResource DangerButton}" Click="OnSignOut"
                                VerticalAlignment="Center"
                                ToolTip="Ends this session on the server and forgets the tokens on this PC"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="Sign out of CloudLauncher on this device."/>
                    </DockPanel>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="SignOutEverywhereButton"
                                Content="Sign out everywhere" Style="{StaticResource DangerButton}"
                                Click="OnSignOutEverywhere" VerticalAlignment="Center"
                                ToolTip="Use this if a machine you signed in on was lost or shared"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="Sign out on every device, including this one. Anything still signed in has to sign in again."/>
                    </DockPanel>
                </StackPanel>
            </slate:SlateBorder>

            <!-- Your data -->
            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Your data" Margin="0,0,0,8"/>

                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" x:Name="DownloadDataButton"
                                Content="Download my data..." Click="OnDownloadData"
                                VerticalAlignment="Center"
                                ToolTip="Saves what the server holds about your account as a JSON file"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="Get a copy of everything the server holds about your account."/>
                    </DockPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="DeleteAccountButton"
                                Content="Delete account..." Style="{StaticResource DangerButton}"
                                Click="OnDeleteAccount" VerticalAlignment="Center"
                                ToolTip="Asks for confirmation first"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="Delete your account and everything it owns on the server. This cannot be undone."/>
                    </DockPanel>
                </StackPanel>
            </slate:SlateBorder>

            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
