<UserControl x:Class="CloudLauncher.Views.ManualDownloadsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:views="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"
                               Text="Download by hand"/>
                </DockPanel>
                <TextBlock x:Name="PackLabel" Style="{StaticResource Caption}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="CurseForge only lets its own website and app download these: their authors switched off downloads in other launchers. Click Download on each one. The page starts the download by itself, and the launcher picks the file up from your Downloads folder and puts it in the instance."/>
            </StackPanel>

            <!--  Footer: the watched folder, then the buttons.  -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Open" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                        Click="OnOpenWatchFolder" ToolTip="Open this folder in Explorer"/>
                                <Button Content="Change..." Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                        Click="OnChangeWatchFolder" ToolTip="Look in another folder, if your browser saves downloads somewhere else"/>
                            </StackPanel>
                            <TextBlock Text="&#xE890;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="WatchLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <CheckBox x:Name="RemoveBox" Content="Remove each file from that folder once it is added"
                                  Margin="0,8,0,0" Checked="OnRemoveChanged" Unchecked="OnRemoveChanged"/>
                    </StackPanel>
                </slate:SlateBorder>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusLabel" Grid.Column="0" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="AddFilesButton" Content="Add files..." Click="OnAddFiles" Margin="0,0,8,0"
                                Padding="14,5" ToolTip="Pick files you already downloaded. You can also drop them on this window."/>
                        <Button x:Name="OpenAllButton" Content="Download all" Click="OnOpenAll" Margin="0,0,8,0"
                                Padding="14,5" ToolTip="Open every waiting file's download page in your browser"/>
                        <Button x:Name="CloseButton" Content="Close" Click="OnClose" Padding="14,5"/>
                        <Button x:Name="PlayButton" Content="Play anyway" Style="{StaticResource AccentButton}"
                                Click="OnPlay" Margin="8,0,0,0" Padding="14,5" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" anim:Animate.SmoothScroll="True">
                    <ItemsControl x:Name="FileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,8" Margin="0,0,0,1" CornerRadius="6" Background="Transparent">
                                    <DockPanel>
                                        <slate:SlateBorder DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0"
                                                Background="{DynamicResource Surface0Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image views:IconLoader.Url="{Binding IconUrl}" views:IconLoader.DecodeWidth="36"
                                                       Stretch="Uniform"/>
                                            </Grid>
                                        </slate:SlateBorder>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <slate:SlateBorder Style="{StaticResource Pill}" Background="{Binding PillBackground}"
                                                               Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource PillText}"
                                                           Foreground="{Binding PillForeground}"/>
                                            </slate:SlateBorder>
                                            <Button Style="{StaticResource AccentButton}" Padding="12,4" Margin="0,0,4,0"
                                                    Visibility="{Binding DownloadVisibility}" Click="OnDownloadRow"
                                                    ToolTip="{Binding DownloadTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Download" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                                    Padding="0" Content="&#xE712;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                    ToolTip="More" Click="OnRowMenu" Tag="{Binding}"
                                                    AutomationProperties.Name="More options"/>
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Meta}"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                                       Visibility="{Binding NoteVisibility}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </slate:SlateBorder>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
