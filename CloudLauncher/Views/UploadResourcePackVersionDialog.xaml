<Window x:Class="CloudLauncher.Views.UploadResourcePackVersionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload version" Width="560" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface0Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource H2}" Text="Upload a version"/>
            <TextBlock x:Name="FileLabel" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource Caption}" Text="Version string" Margin="0,0,0,4"/>
            <TextBox x:Name="VersionBox" Margin="0,0,0,12" MaxLength="64"
                     TextChanged="OnFormTextChanged"
                     ToolTip="What collaborators see in the version list, e.g. 1.2.0"/>

            <TextBlock Style="{StaticResource Caption}" Text="Release channel" Margin="0,0,0,4"/>
            <ComboBox x:Name="ChannelBox" Margin="0,0,0,12"
                      ToolTip="Beta and alpha are still downloadable - the label is how somebody knows what they are taking">
                <ComboBoxItem Content="release" IsSelected="True"/>
                <ComboBoxItem Content="beta"/>
                <ComboBoxItem Content="alpha"/>
            </ComboBox>

            <TextBlock Style="{StaticResource Caption}" Text="Minecraft versions" Margin="0,0,0,4"/>
            <TextBox x:Name="McVersionsBox" Margin="0,0,0,12" MaxLength="256"
                     ToolTip="Comma-separated, e.g. 1.21.1, 1.21 - decides which instances are offered this version"/>

            <TextBlock Style="{StaticResource Caption}" Text="Changelog" Margin="0,0,0,4"/>
            <TextBox x:Name="ChangelogBox" Margin="0,0,0,12"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="120" MaxLength="4096"
                     ToolTip="What changed in this build. Optional, but it is the only thing that tells a collaborator whether to update."/>

            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" Padding="14,5" IsCancel="True"/>
            <Button x:Name="UploadButton" Content="Upload" Style="{StaticResource AccentButton}"
                    Click="OnUpload" Padding="14,5" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
