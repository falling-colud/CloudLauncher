<Window x:Class="CloudLauncher.Views.DevWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        xmlns:local="clr-namespace:CloudLauncher.Views"
        Title="Dev tools" Height="760" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource H2}" Text="Dev tools"/>
                <TextBlock Style="{StaticResource Muted}" Text="Only visible to administrators."/>
            </StackPanel>

            <slate:SlateBorder Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Mod platform API keys" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Stored on the server and used by every launcher to download mods. Keys are never returned to clients - leave the box empty unless changing the key."/>
                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="CurseForge API key" Width="180" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button DockPanel.Dock="Right" Content="Save" Click="OnSaveApiKeys" Style="{StaticResource AccentButton}"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource DangerButton}"
                                Margin="0,0,6,0" Click="OnClearCfKey"/>
                        <TextBox x:Name="CfKeyBox" Margin="0,0,8,0"
                                 ToolTip="Free key at https://console.curseforge.com/"/>
                    </DockPanel>
                    <TextBlock x:Name="CfStatusLabel" Style="{StaticResource Caption}" Margin="180,0,0,8"/>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock Text="Modrinth token (optional)" Width="180" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Button DockPanel.Dock="Right" Content="Save" Click="OnSaveApiKeys" Style="{StaticResource AccentButton}"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource DangerButton}"
                                Margin="0,0,6,0" Click="OnClearMrToken"/>
                        <TextBox x:Name="MrTokenBox"
                                 ToolTip="Optional - generate at https://modrinth.com/settings/pats"/>
                    </DockPanel>
                    <TextBlock x:Name="MrStatusLabel" Style="{StaticResource Caption}" Margin="180,0,0,0"/>
                    <TextBlock x:Name="ApiKeyStatus" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                </StackPanel>
            </slate:SlateBorder>

            <TextBlock Grid.Row="2" Style="{StaticResource H3}" Text="Global default rules" Margin="0,0,0,6"/>

            <slate:SlateBorder Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Muted}" Margin="14,10,14,4" TextWrapping="Wrap">
                        These rules are copied to any new instance that has no instance-specific rules yet.
                        Patterns: exact file (<Run FontFamily="{DynamicResource MonoFont}">options.txt</Run>),
                        folder prefix (<Run FontFamily="{DynamicResource MonoFont}">mods/</Run>),
                        or glob (<Run FontFamily="{DynamicResource MonoFont}">config/*.json</Run>).
                    </TextBlock>

                    <DataGrid Grid.Row="1" x:Name="DefaultRulesGrid"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0"
                              MinHeight="120" MaxHeight="220"
                              Background="Transparent" BorderThickness="0"
                              Margin="6,0,6,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pattern"
                                                Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                            <DataGridComboBoxColumn Header="Action" Width="130"
                                                    SelectedValueBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                                    ItemsSource="{x:Static local:DevWindow.ActionValues}"/>
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}"
                                                Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                Click="OnDeleteDefaultRule"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Padding="12,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <TextBlock Text="Add rule" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="NewActionBox2" Width="130" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <Button Content="Add" Style="{StaticResource AccentButton}"
                                    DockPanel.Dock="Right" Click="OnAddDefaultRule"/>
                            <TextBox x:Name="NewPatternBox2" ToolTip="e.g. mods/ or options.txt"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,8,12,12">
                        <Button Content="Reset to hardcoded defaults" Click="OnResetToHardcoded"/>
                        <Button Content="Clear all" Style="{StaticResource DangerButton}" Click="OnClearAll"/>
                        <TextBlock x:Name="DevStatusLabel" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
            </slate:SlateBorder>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource H3}" Text="User storage quotas" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                            Click="OnRefreshQuotas" ToolTip="Refresh"/>
                </DockPanel>

                <slate:SlateBorder Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <DataGrid x:Name="QuotaGrid"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" RowHeaderWidth="0"
                              MinHeight="120" MaxHeight="200"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username"   Binding="{Binding Username}"  Width="*"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Used"       Binding="{Binding UsedLabel}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Quota (MB)" Binding="{Binding QuotaMb, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                            <DataGridTextColumn Header="% used"     Binding="{Binding PercentLabel}" Width="80" IsReadOnly="True"/>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Save" Style="{StaticResource AccentButton}"
                                                Padding="8,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                Click="OnSaveQuota"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Unlimited" Padding="6,2"
                                                MinWidth="0" MinHeight="0" FontSize="11"
                                                Click="OnSetUnlimited"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </slate:SlateBorder>

                <TextBlock Grid.Row="2" x:Name="QuotaStatusLabel" Style="{StaticResource ErrorText}" Margin="0,6,0,0"/>
            </Grid>

            <DockPanel Grid.Row="5" Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="Save and close"
                        Style="{StaticResource AccentButton}" Click="OnSaveClose"/>
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
