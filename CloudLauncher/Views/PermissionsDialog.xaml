<Window x:Class="CloudLauncher.Views.PermissionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CloudLauncher.Views"
        Title="Permissions" Height="660" Width="760" MinHeight="480" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Closing="OnWindowClosing"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Style="{StaticResource H2}" Text="Permissions"/>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Text="Control who can see, download from, or upload to this item. Every change is saved as you make it."/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource H3}" Text="Collaborators" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="CollaboratorsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="View" Binding="{Binding View, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Download" Binding="{Binding Download, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Upload" Binding="{Binding UploadShared, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Manage" Binding="{Binding ManageCollaborators, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Row actions stay at the right edge -->
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Style="{StaticResource DangerButton}"
                                                    Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                    HorizontalAlignment="Right"
                                                    ToolTip="Revokes this person's access completely"
                                                    Click="OnRemoveCollaborator"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="CollaboratorsEmptyLabel" Style="{StaticResource Muted}"
                                   Text="Nobody else has been given access yet."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource AccentButton}"
                            Click="OnAddCollaborator" ToolTip="Grants this person the access chosen on the left"/>
                    <ComboBox DockPanel.Dock="Right" x:Name="NewCollaboratorPermissionBox" Width="210"
                              Margin="8,0,8,0" DisplayMemberPath="Label"
                              ItemsSource="{x:Static local:PermissionsDialog.PermissionChoices}"
                              ToolTip="What the new collaborator may do. You can change it afterwards with the tick boxes."/>
                    <TextBlock Text="Add by username" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NewCollaboratorBox" MaxWidth="220" HorizontalAlignment="Left"
                             KeyDown="OnNewCollaboratorKeyDown"
                             ToolTip="The CloudLauncher username of an existing account"/>
                </DockPanel>
            </Grid>

            <TextBlock Grid.Row="2" Style="{StaticResource H3}" Text="Teams" Margin="0,18,0,6"/>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid x:Name="TeamsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0"
                                  BorderThickness="0" Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Team" Binding="{Binding TeamName}" Width="*" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="View" Binding="{Binding View, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Download" Binding="{Binding Download, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Upload" Binding="{Binding UploadShared, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridCheckBoxColumn Header="Manage" Binding="{Binding ManageCollaborators, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Style="{StaticResource DangerButton}"
                                                    Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                    HorizontalAlignment="Right"
                                                    ToolTip="Revokes access for every member of this team"
                                                    Click="OnRemoveTeam"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="TeamsEmptyLabel" Style="{StaticResource Muted}"
                                   Text="No team has been given access yet."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="1" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource AccentButton}"
                            Click="OnAddTeam" ToolTip="Grants every member of the chosen team this access"/>
                    <ComboBox DockPanel.Dock="Right" x:Name="NewTeamPermissionBox" Width="210"
                              Margin="8,0,8,0" DisplayMemberPath="Label"
                              ItemsSource="{x:Static local:PermissionsDialog.PermissionChoices}"
                              ToolTip="What the team's members may do. You can change it afterwards with the tick boxes."/>
                    <TextBlock Text="Grant team access" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="AvailableTeamsBox" MaxWidth="260" HorizontalAlignment="Left"
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </DockPanel>
            </Grid>

            <DockPanel Grid.Row="4" Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" IsCancel="True"/>
                <Button DockPanel.Dock="Right" x:Name="RetryButton" Content="Retry unsaved changes"
                        Style="{StaticResource AccentButton}" Margin="0,0,8,0"
                        Click="OnRetry" Visibility="Collapsed"
                        ToolTip="Re-sends the rows whose last change the server refused"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
        </Grid>

        <!-- Confirmations render inside this window: it is modal, so an overlay on the main window
             would be visible but unclickable. -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
