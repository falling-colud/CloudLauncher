<UserControl x:Class="CloudLauncher.Views.ResourcePackListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             Background="Transparent">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- The same switch the Mods tab uses for enable/disable, so the two tabs read as one app. -->
        <Style x:Key="PackToggleSwitch" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel PreviewKeyDown="OnPreviewKeyDown">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SortButton" Style="{StaticResource IconButton}" Content="&#xE8CB;"
                        FontFamily="{StaticResource IconFont}" FontSize="13"
                        Click="OnSortButtonClick"
                        ToolTip="Sort the packs that are turned off — the enabled stack always stays in priority order">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSortMenuOpened">
                            <MenuItem x:Name="SortModifiedMenuItem" Header="Last modified" Tag="Modified"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="Name"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortSizeMenuItem" Header="Size" Tag="Size"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortPackMenuItem" Header="Folder" Tag="Pack"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                        FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Refresh (F5)" Click="OnRefresh"/>
                <Button Content="Browse resource packs" Style="{StaticResource AccentButton}" Click="OnBrowseResourcePacks">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse resource packs" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Import…" Click="OnImportZip"
                        ToolTip="Copy .zip packs into this instance's resourcepacks/ folder"/>
            </StackPanel>
            <Border x:Name="CompactSearchHost" DockPanel.Dock="Left"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" MinHeight="32" Width="36" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SearchToggleButton" Grid.Column="0"
                            Style="{StaticResource IconButton}" Click="OnSearchToggle"
                            Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Search installed resource packs (Ctrl+F)"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Visibility="Collapsed"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchPreviewKeyDown"
                             LostKeyboardFocus="OnSearchLostKeyboardFocus"
                             ToolTip="Filter by name, file, folder — or type &quot;on&quot; / &quot;off&quot; / &quot;local&quot;">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Folder chips: the same user-defined folders the global Resource packs screen files packs
             into, narrowed to the ones that actually contain something from this instance. -->
        <ScrollViewer DockPanel.Dock="Top" Margin="0,0,0,10"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="FolderStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Selected state comes from a trigger on IsActive rather than a Brush on the
                             row, so recolouring the accent in Settings repaints these immediately. -->
                        <Border Padding="0" Margin="0,2,8,2" Cursor="Hand"
                                Background="{DynamicResource Surface2Brush}"
                                BorderThickness="1" CornerRadius="14"
                                MouseLeftButtonUp="OnFolderChipClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Margin="12,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Label}" Margin="0,0,4,0" Padding="0,5,0,5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding CountLabel}" Margin="0,0,12,0"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bulk actions. Hidden until more than one row is selected, exactly like the Mods tab. -->
        <Border x:Name="SelectionBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Turn on" Click="OnBulkEnable" Padding="10,3" MinHeight="0" MinWidth="0"
                            Margin="0,0,6,0" ToolTip="Add every selected pack to the top of the stack"/>
                    <Button Content="Turn off" Click="OnBulkDisable" Padding="10,3" MinHeight="0" MinWidth="0"
                            Margin="0,0,6,0"/>
                    <Button x:Name="BulkCopyButton" Content="Copy to…" Click="OnBulkCopyTo"
                            Padding="10,3" MinHeight="0" MinWidth="0" Margin="0,0,6,0"/>
                    <Button x:Name="BulkDeleteButton" Content="Delete" Click="OnBulkDelete"
                            Padding="10,3" MinHeight="0" MinWidth="0"
                            Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Content="Select all" Click="OnSelectAll" Style="{StaticResource LinkButton}"
                            Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="Clear" Click="OnClearSelection" Style="{StaticResource LinkButton}"
                            Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6"
                AllowDrop="True" DragOver="OnGridDragOver" Drop="OnGridDrop">
            <Grid>
                <DataGrid x:Name="ResourcePackGrid"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          SelectionChanged="OnGridSelectionChanged"
                          PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                          MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="28" Height="28"
                                            Background="{DynamicResource Surface3Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- pack.png, when the pack ships one. Layered over the letter
                                                 so a pack without an icon still reads as something. -->
                                            <Image Source="{Binding IconSource}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Name" Width="*" MinWidth="140" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding PackDescription}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="16"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="170"/>
                        <DataGridTemplateColumn Header="Where" Width="98" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Surface4Brush}"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource PillText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Surface4Brush}"
                                                ToolTip="An unpacked pack folder rather than a zip"
                                                Visibility="{Binding IsFolder, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="FOLDER" Style="{StaticResource PillText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="80"/>

                        <!-- Priority and the row actions, right-aligned into one column down the edge. -->
                        <DataGridTemplateColumn Header="Priority" Width="104" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Higher rows override lower ones — row 1 is the pack that wins"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="14"
                                                   TextAlignment="Right"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                                Padding="5,2" MinWidth="0" MinHeight="0"
                                                Click="OnMoveUp" IsEnabled="{Binding Enabled}"
                                                ToolTip="Move up — override the packs below it"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                                FontFamily="{StaticResource IconFont}" FontSize="11"
                                                Padding="5,2" MinWidth="0" MinHeight="0"
                                                Click="OnMoveDown" IsEnabled="{Binding Enabled}"
                                                ToolTip="Move down"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="112" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                FontFamily="{StaticResource IconFont}" FontSize="12"
                                                Padding="6,3" MinWidth="0" MinHeight="0"
                                                Click="OnRowCopyTo" ToolTip="Copy to another instance…"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8DA;"
                                                FontFamily="{StaticResource IconFont}" FontSize="12"
                                                Padding="6,3" MinWidth="0" MinHeight="0"
                                                Click="OnRowReveal" ToolTip="Show in Explorer"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                FontFamily="{StaticResource IconFont}" FontSize="12"
                                                Padding="6,3" MinWidth="0" MinHeight="0"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Click="OnRowDelete" ToolTip="Delete from this instance…"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="On" Width="56" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource PackToggleSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Click="OnEnabledToggle"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="Turn this pack on or off in options.txt"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="ToolTip" Value="{Binding RowTooltip}"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="OnContextMenuOpened">
                            <MenuItem x:Name="CtxToggle" Header="Turn on" Click="OnCtxToggle">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxMoveTop" Header="Move to top of stack" Click="OnCtxMoveTop">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxMoveBottom" Header="Move to bottom of stack" Click="OnCtxMoveBottom">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="CtxEdit" Header="Edit details…" Click="OnCtxEdit">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxRename" Header="Rename…" Click="OnCtxRename"
                                      InputGestureText="F2">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxRenameFile" Header="Rename file on disk…" Click="OnCtxRenameFile">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxAddToFolder" Header="Add to folder"
                                      SubmenuOpened="OnCtxAddToFolderOpened">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                                <MenuItem Header="(placeholder)"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="CtxCopyTo" Header="Copy to instance…" Click="OnCtxCopyTo">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxCreateHosted"
                                      Header="Create hosted resource pack from zip"
                                      Click="OnCtxCreateHosted">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy file path" Click="OnCtxCopyPath">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Reveal in Explorer" Click="OnCtxReveal">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8DA;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="CtxDelete" Header="Delete file" Click="OnCtxDelete"
                                      InputGestureText="Del"
                                      Foreground="{DynamicResource DangerBrush}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="&#xE7C9;" FontFamily="{StaticResource IconFont}" FontSize="40"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H3}" Text="No resource packs yet"
                               HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock x:Name="EmptyDetail" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                               Text="Drop a .zip here, use Import, or browse the catalog to install one."/>
                </StackPanel>

                <ProgressBar x:Name="BusyBar" Height="2" VerticalAlignment="Top"
                             IsIndeterminate="True" Visibility="Collapsed" Background="Transparent"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
