<UserControl x:Class="CloudLauncher.Views.ResourcePackListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel PreviewKeyDown="OnPreviewKeyDown">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                        FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Refresh" Click="OnRefresh"/>
                <Button Content="Browse resource packs" Style="{StaticResource AccentButton}" Click="OnBrowseResourcePacks">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Browse resource packs" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Import…" Click="OnImportZip"/>
            </StackPanel>
            <Border x:Name="CompactSearchHost" DockPanel.Dock="Left"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" MinHeight="32" Width="36" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SearchToggleButton" Grid.Column="0"
                            Style="{StaticResource IconButton}" Click="OnSearchToggle"
                            Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Search installed resource packs"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Visibility="Collapsed"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchPreviewKeyDown"
                             LostKeyboardFocus="OnSearchLostKeyboardFocus"
                             ToolTip="Filter by name or folder">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="ResourcePackGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      SelectionMode="Single" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      PreviewMouseRightButtonDown="OnGridPreviewMouseRightButtonDown"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="28" Height="28"
                                        Background="{StaticResource Surface3Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name"   Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="File"   Binding="{Binding FileName}"    Width="180"/>
                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}"      Width="80"/>
                    <DataGridTextColumn Header="Size"   Binding="{Binding SizeLabel}" SortMemberPath="SizeBytes" Width="90"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="OnContextMenuOpened">
                        <MenuItem Header="Edit details…" Click="OnCtxEdit"/>
                        <MenuItem x:Name="CtxCreateHosted"
                                  Header="Create hosted resource pack from zip"
                                  Click="OnCtxCreateHosted"/>
                        <Separator/>
                        <MenuItem Header="Reveal in Explorer" Click="OnCtxReveal"/>
                        <MenuItem Header="Delete file" Click="OnCtxDelete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
