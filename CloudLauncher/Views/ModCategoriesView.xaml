<UserControl x:Class="CloudLauncher.Views.ModCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             Background="Transparent">
    <UserControl.Resources>
        <local:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <local:PriorityToVisibilityConverter x:Key="PriorityVis"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>

        <!-- One row in either mod list: priority stripe, icon, name, then the size meter -->
        <DataTemplate x:Key="ModRow">
            <Grid Margin="0,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="2" Margin="0,1,7,1"
                        Background="{Binding Priority, Converter={StaticResource PriorityBrush}}"
                        Visibility="{Binding Priority, Converter={StaticResource PriorityVis}}"/>
                <Border Grid.Column="1" Width="24" Height="24" CornerRadius="5" Margin="0,0,9,0"
                        Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CategoriesLabel}" FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding CategoriesLabel, Converter={StaticResource NotEmptyVis}}"/>
                </StackPanel>
                <local:ContentSizeMeter Grid.Column="3" Size="{Binding ContentSize}" Margin="8,0,4,0"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ───────────────────────────── header ───────────────────────────── -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="Summary" Style="{StaticResource Caption}"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="Status" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,12,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <Button Content="Import from instance…" Padding="12,5" MinHeight="0"
                        Margin="0,0,8,0" Click="OnImportCategories"
                        ToolTip="Copy another instance&apos;s categories — and which mods are in them — into this one"/>
                <Button Content="New category" Style="{StaticResource AccentButton}"
                        Padding="12,5" MinHeight="0" Click="OnNewCategory"/>
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────── categories ─────────────────────── -->
            <Border Grid.Column="0" Margin="0,0,10,0"
                    Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIES" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,2,0,8"/>
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                             AllowDrop="True" DragOver="OnCategoryDragOver" Drop="OnCategoryDrop"
                             DragLeave="OnCategoryDragLeave"
                             PreviewMouseLeftButtonDown="OnCategoryMouseDown"
                             PreviewMouseMove="OnCategoryMouseMove"
                             SelectionChanged="OnCategorySelected"
                             MouseRightButtonUp="OnCategoryRightClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Drag to reorder · drop mods here to tag them · right-click for rename, colour and delete">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="9" Height="9" CornerRadius="3"
                                            Background="{Binding Swatch}" Margin="2,0,9,0"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Detail, Converter={StaticResource NotEmptyVis}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─────────────────────── members ─────────────────────── -->
            <Border Grid.Column="1" Margin="0,0,10,0"
                    Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="8">
                    <TextBlock x:Name="MembersHeader" DockPanel.Dock="Top" Text="IN THIS CATEGORY"
                               Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="4,2,0,8" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="RemoveButton" DockPanel.Dock="Bottom" Content="Remove from category"
                            Style="{StaticResource SubtleButton}" Padding="10,6" MinHeight="0"
                            Margin="0,8,0,0" Click="OnRemoveSelected" IsEnabled="False"/>
                    <ListBox x:Name="MemberList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             ItemTemplate="{StaticResource ModRow}"
                             SelectionChanged="OnModSelectionChanged"
                             MouseDoubleClick="OnMemberDoubleClick"
                             PreviewMouseLeftButtonDown="OnModListMouseDown"
                             PreviewMouseMove="OnModListMouseMove"
                             KeyDown="OnModListKeyDown"
                             MouseRightButtonUp="OnModRightClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Enter or double-click to remove · drag onto a category to move it there · right-click for everything else"/>
                </DockPanel>
            </Border>

            <!-- ─────────────────────── candidates ─────────────────────── -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="4,2,0,8">
                        <TextBlock Text="EVERYTHING ELSE" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="OnlyUntagged" Content="Only untagged" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" FontSize="11" Click="OnFilterChanged"
                                  ToolTip="Show only mods that aren't in any category yet"/>
                    </Grid>

                    <Border DockPanel.Dock="Top" MinHeight="30" Margin="0,0,0,8"
                            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="9,0,7,0"/>
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="SearchHint" Text="Search mods…" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                         TextChanged="OnSearchChanged">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Button x:Name="AddButton" DockPanel.Dock="Bottom" Content="Add to category"
                            Style="{StaticResource AccentButton}" Padding="10,6" MinHeight="0"
                            Margin="0,8,0,0" Click="OnAddSelected" IsEnabled="False"/>
                    <ListBox x:Name="CandidateList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             ItemTemplate="{StaticResource ModRow}"
                             SelectionChanged="OnModSelectionChanged"
                             MouseDoubleClick="OnCandidateDoubleClick"
                             PreviewMouseLeftButtonDown="OnModListMouseDown"
                             PreviewMouseMove="OnModListMouseMove"
                             KeyDown="OnModListKeyDown"
                             MouseRightButtonUp="OnModRightClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Enter or double-click to add · drag onto any category on the left · right-click for everything else"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
