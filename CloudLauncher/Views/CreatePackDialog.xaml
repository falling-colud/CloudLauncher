<Window x:Class="CloudLauncher.Views.CreatePackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        Title="Create instance" Height="760" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="Create a new instance" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <Label Content="Instance name"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,12"
                     MaxLength="128"
                     ToolTip="Shown in your instance list, and to anyone you publish this to"/>

            <DockPanel>
                <Label Content="Summary"/>
                <TextBlock x:Name="SummaryCounter" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </DockPanel>
            <TextBox x:Name="SummaryBox" Margin="0,0,0,12"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="52" MaxHeight="90"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="OnSummaryChanged"
                     ToolTip="One or two lines describing the instance. This is the subtitle people see in the pack browser."/>

            <Label x:Name="VisibilityLabel" Content="Who can see it"/>
            <ComboBox x:Name="VisibilityBox" Margin="0,0,0,4"
                      SelectionChanged="OnVisibilityChanged"
                      ToolTip="You can change this later in the instance's Options">
                <ComboBoxItem Content="Private - only me" Tag="Private" IsSelected="True"/>
                <ComboBoxItem Content="Team - the teams I share it with" Tag="Team"/>
                <ComboBoxItem Content="Public - anyone on this server" Tag="Public"/>
            </ComboBox>
            <TextBlock x:Name="VisibilityNote" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="Collapsed"
                       Text="Publishing also turns on server hosting, so the files you put in this instance are uploaded for the people who add it."/>
            <!-- Signed out, in place of the visibility choice: nobody else can see a local instance. -->
            <TextBlock x:Name="LocalNote" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"
                       Text="It is kept on this PC. Sign in later to add it to an account and share it."/>
        </StackPanel>

        <slate:SlateBorder Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <RadioButton x:Name="PlayableRadio" GroupName="Kind" IsChecked="True" Checked="OnKindChanged">
                    <StackPanel>
                        <TextBlock Text="Playable instance" FontWeight="SemiBold"/>
                        <TextBlock Text="Pick a Minecraft version + (optional) mod loader."
                                   Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="EmptyRadio" GroupName="Kind" Checked="OnKindChanged" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Empty instance" FontWeight="SemiBold"/>
                        <TextBlock Text="Just a shared folder. Can't launch Minecraft."
                                   Style="{StaticResource Caption}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </slate:SlateBorder>

        <slate:SlateBorder Grid.Row="3" x:Name="PlayablePanel" Style="{StaticResource Card}" IsEnabled="True" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Label Content="Minecraft version" Width="140"/>
                    <ComboBox x:Name="McVersionBox" SelectionChanged="OnMcChanged"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <Label Content="Loader" Width="140"/>
                    <ComboBox x:Name="LoaderBox" SelectionChanged="OnLoaderChanged">
                        <ComboBoxItem Content="None (Vanilla)" Tag="None" IsSelected="True"/>
                        <ComboBoxItem Content="Fabric" Tag="Fabric"/>
                        <ComboBoxItem Content="Forge" Tag="Forge"/>
                        <ComboBoxItem Content="NeoForge" Tag="NeoForge"/>
                    </ComboBox>
                </DockPanel>
                <DockPanel x:Name="LoaderVersionRow">
                    <Label Content="Loader version" Width="140"/>
                    <ComboBox x:Name="LoaderVersionBox"/>
                </DockPanel>
            </StackPanel>
        </slate:SlateBorder>

        <TextBlock Grid.Row="4" x:Name="StatusLabel" Style="{StaticResource ErrorText}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" IsCancel="True"/>
            <Button Content="Create" Style="{StaticResource AccentButton}" Click="OnCreate" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
