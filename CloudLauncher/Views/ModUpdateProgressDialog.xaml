<UserControl x:Class="CloudLauncher.Views.ModUpdateProgressDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="720" MaxHeight="640">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"
                       Text="Updating mods"/>
            <TextBlock x:Name="SubLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                       Margin="0,2,0,12" TextWrapping="Wrap"/>

            <!-- Overall -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="OverallPercent" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OverallLabel" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
                <ProgressBar x:Name="OverallBar" Grid.Row="1" Height="6" Maximum="100" Value="0"/>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock x:Name="FooterNote" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,180,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Stop" Style="{StaticResource SubtleButton}"
                            Click="OnCancel" Margin="0,0,8,0"
                            ToolTip="Finish the downloads already running, then stop"/>
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource AccentButton}"
                            Click="OnClose" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Per-mod rows -->
            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl x:Name="JobList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="280"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VersionsLabel}" Style="{StaticResource Caption}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <ProgressBar Grid.Row="1" Height="4"
                                                 Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
