<Window x:Class="CloudLauncher.Views.ModpackImportProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importing modpack" Height="400" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="Import modpack" Margin="0,0,0,8"/>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Instance name" VerticalAlignment="Center" Width="100"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBox x:Name="NameBox"/>
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="OverallProgressLabel" Style="{StaticResource Caption}"
                           Text="Ready to import" TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"/>
                <TextBlock x:Name="OverallProgressPercent" Grid.Column="1"
                           Style="{StaticResource Caption}"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <ProgressBar x:Name="Progress" Height="6" IsIndeterminate="True"/>
            <Grid x:Name="CurrentProgressHeader" Margin="0,8,0,6" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentProgressLabel" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                <TextBlock x:Name="CurrentProgressPercent" Grid.Column="1"
                           Style="{StaticResource Caption}"/>
            </Grid>
            <ProgressBar x:Name="CurrentProgress" Height="4" Visibility="Collapsed"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                     Background="Transparent" BorderThickness="0"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontFamily="{StaticResource MonoFont}" FontSize="11"/>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="ImportButton" Content="Import"
                    Style="{StaticResource AccentButton}" Click="OnImport" IsDefault="True"/>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
