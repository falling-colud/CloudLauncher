<Page x:Class="CloudLauncher.Views.SharingStoragePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:v="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Storage"
      Background="{DynamicResource Surface0Brush}">
    <Page.Resources>
        <v:BoolToVisibilityConverter x:Key="BoolVis"/>
        <v:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>

        <!--  A bar has three segments: unique, shared, and the rest up to the widest row. The widths
        are computed in code-behind because they depend on the biggest row on the page.  -->
        <Style x:Key="MeterTrack" TargetType="Grid">
            <Setter Property="Height" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SizeText" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!--  Icon button that opens the item in Explorer. Nothing on this page deletes.  -->
        <Style x:Key="RevealButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
            <Setter Property="Content" Value="&#xE838;"/>
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="ToolTip" Value="Open this in Explorer"/>
        </Style>

        <!--  One category. The swatch matches its band in the bar above.  -->
        <DataTemplate x:Key="CategoryTemplate">
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <slate:SlateBorder Grid.Column="0" Width="10" Height="10" CornerRadius="3"
                        Background="{Binding Swatch}" VerticalAlignment="Center" Margin="2,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,1,0,0"/>
                </StackPanel>

                <Grid Grid.Column="2" Style="{StaticResource MeterTrack}" Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fill}"/>
                        <ColumnDefinition Width="{Binding Rest}"/>
                    </Grid.ColumnDefinitions>
                    <slate:SlateBorder Grid.Column="0" CornerRadius="3" Background="{Binding Swatch}"/>
                    <slate:SlateBorder Grid.Column="1" CornerRadius="3"
                            Background="{DynamicResource Surface4Brush}"/>
                </Grid>

                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" Style="{StaticResource SizeText}"
                           MinWidth="72"/>
                <TextBlock Grid.Column="4" Text="{Binding PercentLabel}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           MinWidth="42" Margin="8,0,0,0"/>
            </Grid>
        </DataTemplate>

        <!--  One instance: unique bytes in the accent, then a paler band for bytes it shares.  -->
        <DataTemplate x:Key="OwnerTemplate">
            <Border Background="Transparent" Padding="0,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                               FontFamily="{DynamicResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="2,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubLine}" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,5"/>
                        <Grid Style="{StaticResource MeterTrack}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Unique}"/>
                                <ColumnDefinition Width="{Binding Shared}"/>
                                <ColumnDefinition Width="{Binding Rest}"/>
                            </Grid.ColumnDefinitions>
                            <slate:SlateBorder Grid.Column="0" CornerRadius="3"
                                    Background="{DynamicResource AccentBrush}"/>
                            <!--  Accent at reduced opacity. AccentSoftBrush is darker than the empty
                            track, which made the shared band look like less than nothing.  -->
                            <slate:SlateBorder Grid.Column="1" CornerRadius="3" Opacity="0.45"
                                    Background="{DynamicResource AccentBrush}"/>
                            <slate:SlateBorder Grid.Column="2" CornerRadius="3"
                                    Background="{DynamicResource Surface4Brush}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="86">
                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource SizeText}"/>
                        <TextBlock Text="unique" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <Button Content="Open" Padding="12,5" Click="OnOpenOwner"
                                Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"
                                ToolTip="Open this instance"/>
                        <Button Style="{StaticResource RevealButton}" Click="OnReveal"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One of the biggest items, ranked.  -->
        <DataTemplate x:Key="ItemTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Rank}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubLine}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <slate:SlateBorder Grid.Column="2" Style="{StaticResource Pill}" Margin="0,0,10,0"
                        Visibility="{Binding IsShared, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="shared" Style="{StaticResource PillText}"/>
                </slate:SlateBorder>

                <TextBlock Grid.Column="3" Text="{Binding SizeLabel}"
                           Style="{StaticResource SizeText}" MinWidth="72"/>
                <Button Grid.Column="4" Style="{StaticResource RevealButton}" Click="OnReveal"/>
            </Grid>
        </DataTemplate>

        <!--  A folder the launcher regenerates, with the reason it is safe to delete on the row.  -->
        <DataTemplate x:Key="ReclaimTemplate">
            <Border Background="Transparent" Padding="0,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubLine}" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" MaxWidth="560" Margin="0,3,0,0"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding SizeLabel}"
                               Style="{StaticResource SizeText}" MinWidth="72"/>
                    <Button Grid.Column="2" Style="{StaticResource RevealButton}" Click="OnReveal"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--  Master-page rows: 0 PageHeaderPanel, 1 PageFilterBar, 2 PageDivider, 3 content,
    4 PageStatusBar  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Row 0 - title. The count is in the status bar, as on the other master pages.  -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel>
                <TextBlock Text="Storage" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Where your disk went - what the launcher is using on this PC, what it is, and what deleting a thing would actually give back."/>
            </StackPanel>
        </DockPanel>

        <!--  Row 1 - no actions since the page is read-only, just Refresh on the right.  -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        Click="OnRefresh"
                        ToolTip="Read every folder again (F5). Nothing here is live - a launch, a sync or a save moves these numbers and the launcher does not watch for it."/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!--  Row 3 - content. PageStateView is last so it draws over the cards.  -->
        <Grid Grid.Row="3" Margin="28,0,28,16">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          anim:Animate.SmoothScroll="True">
                <StackPanel Margin="0,0,10,0">

                    <!--  Totals  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TotalLabel" Style="{StaticResource H1}"/>
                                    <TextBlock x:Name="TotalNote" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <!--  Free space goes under the total so the two can be compared.  -->
                                    <TextBlock x:Name="DriveLabel" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                            HorizontalAlignment="Right" Margin="18,2,0,0">
                                    <TextBlock x:Name="SharedLabel" Style="{StaticResource Body}"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="SharedNote" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right" TextAlignment="Right"
                                               TextWrapping="Wrap" MaxWidth="300" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!--  Stacked bar, built in code with a band only for categories that
                            have bytes.  -->
                            <Grid x:Name="CompositionHost" Height="14" Margin="0,16,0,0"/>
                            <TextBlock x:Name="CompositionNote" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  By category  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="CategoryCountLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="What the space is" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,2"
                                       TextWrapping="Wrap"
                                       Text="Each row counts a file once, wherever it appears. The runtime and Java rows are global - every instance uses them, so they are not divided up between instances and deleting an instance does not shrink them."/>
                            <ItemsControl x:Name="CategoryList"
                                          ItemTemplate="{StaticResource CategoryTemplate}"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  By instance  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="InstanceCountLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="By instance" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                       TextWrapping="Wrap"
                                       Text="'Unique' is what deleting this instance would actually give back. The paler band beside it is content it shares with another instance, or with the launcher's own copy: those bytes exist once, are counted once in the total above, and stay on the disk until the last instance holding them is gone."/>
                            <ItemsControl x:Name="InstanceList" ItemTemplate="{StaticResource OwnerTemplate}"/>
                            <TextBlock x:Name="InstanceNote" Style="{StaticResource Muted}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  Global items not owned by any instance  -->
                    <slate:SlateBorder x:Name="GlobalCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Shared, and not owned by any instance" Style="{StaticResource H3}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                       TextWrapping="Wrap"
                                       Text="These four are kept once and used by everything. The runtime is frequently the largest single thing on the disk, and it belongs here rather than spread thinly across forty instances that would each look bigger than they are."/>
                            <ItemsControl x:Name="GlobalList" ItemTemplate="{StaticResource OwnerTemplate}"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  Biggest first  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ItemCountLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="Biggest things" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                                       TextWrapping="Wrap"
                                       Text="One row per world, pack, mods folder or runtime tree. A row marked 'shared' is bytes more than one instance reaches, so removing it from one of them frees nothing."/>
                            <ItemsControl x:Name="ItemList" ItemTemplate="{StaticResource ItemTemplate}"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  Regenerated folders  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ReclaimTotalLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="Written by the launcher, and written again" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                       TextWrapping="Wrap"
                                       Text="Every row here is a folder this launcher regenerates, and the reason is on the row. Nothing on this page deletes anything - the button opens the folder in Explorer. An instance's Files page has a Cleanup tab that ticks files individually and moves them to that instance's .trash, which is the safe way to do this in bulk."/>
                            <TextBlock x:Name="ReclaimNever" Style="{StaticResource Caption}"
                                       Margin="0,0,0,4" TextWrapping="Wrap"
                                       Text="Worlds, mods, configs, screenshots and anything the launcher shares into instances are never listed here, whatever their size."/>
                            <ItemsControl x:Name="ReclaimList" ItemTemplate="{StaticResource ReclaimTemplate}"/>
                            <TextBlock x:Name="ReclaimMore" Style="{StaticResource Muted}"
                                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  How it was counted  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="How this was counted" Style="{StaticResource H3}"/>
                            <TextBlock x:Name="MethodLabel" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ProblemsLabel" Style="{StaticResource ErrorText}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NotEmptyVis}}"/>
                        </StackPanel>
                    </slate:SlateBorder>
                </StackPanel>
            </ScrollViewer>

            <v:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!--  Row 4 - status bar. The status label has no Foreground because PageState colours it
        (red on errors).  -->
        <Border Grid.Row="4" Style="{StaticResource PageStatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Style="{StaticResource Caption}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountLabel" Grid.Column="1" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ProgressBar x:Name="BusyBar" Grid.Column="2" Width="140" Height="4"
                             Minimum="0" Maximum="1" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="BusyCancelButton" Grid.Column="3" Content="Stop" Padding="12,4"
                        Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"
                        ToolTip="Stop counting. What is already on screen stays; nothing half-counted is kept."/>
            </Grid>
        </Border>
    </Grid>
</Page>
