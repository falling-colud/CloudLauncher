<UserControl x:Class="CloudLauncher.Views.ModUpdateReviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:views="clr-namespace:CloudLauncher.Views">
    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"
                       TextTrimming="CharacterEllipsis" Text="Update mods"/>
            <TextBlock x:Name="SubLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,2,0,12"
                       Text="Tick the mods to update. Select one to read what changed."/>

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock x:Name="FooterNote" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="UpdateButton" Content="Update selected" Style="{StaticResource AccentButton}" Click="OnUpdate"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: the updates, each with a checkbox -->
                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBlock x:Name="CountLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Select all" Style="{StaticResource LinkButton}" FontSize="11" Click="OnSelectAll" Margin="0,0,10,0"/>
                            <Button Content="None" Style="{StaticResource LinkButton}" FontSize="11" Click="OnSelectNone"/>
                        </StackPanel>
                    </Grid>
                    <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnSelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="2,0,10,0" Click="OnCheckChanged"/>
                                        <slate:SlateBorder Grid.Column="1" Width="30" Height="30" CornerRadius="6" ClipToBounds="True"
                                                Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </slate:SlateBorder>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="210"/>
                                                <slate:SlateBorder Style="{StaticResource Pill}" Background="{Binding ChannelBrush}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Channel}" Style="{StaticResource PillText}" Foreground="White"/>
                                                </slate:SlateBorder>
                                                <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                        Visibility="{Binding LockedVisibility}"
                                                        ToolTip="Locked in Modpack Management - left unticked, tick it to update anyway">
                                                    <TextBlock Text="LOCKED" Style="{StaticResource PillText}"/>
                                                </slate:SlateBorder>
                                                <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                        Background="{DynamicResource DangerBrush}"
                                                        Visibility="{Binding IncompatibleVisibility}"
                                                        ToolTip="Marked update-incompatible - updating it may break your setup">
                                                    <TextBlock Text="RISKY" Style="{StaticResource PillText}" Foreground="White"/>
                                                </slate:SlateBorder>
                                            </StackPanel>
                                            <TextBlock Text="{Binding VersionsLabel}" Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </slate:SlateBorder>
                </DockPanel>

                <!-- Right: the selected update's changelog -->
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="ChangelogTitle" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"
                                   Text="Changelog"/>
                        <TextBlock x:Name="ChangelogMeta" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <slate:SlateBorder CornerRadius="8" ClipToBounds="True"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{DynamicResource Surface0Brush}">
                        <Grid>
                            <views:RichDescriptionView x:Name="ChangelogView"/>
                            <TextBlock x:Name="ChangelogStatus" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                                       Text="Select an update to read its changelog."/>
                        </Grid>
                    </slate:SlateBorder>
                </DockPanel>
            </Grid>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
