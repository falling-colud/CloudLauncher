<UserControl x:Class="CloudLauncher.Views.UploadModVersionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="560" MaxHeight="660">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Upload version"/>
            <TextBlock x:Name="SubLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,2,0,14"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Footer: status on the left, actions right-aligned -->
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SubtleButton}"
                            Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="UploadButton" Content="Upload" Style="{StaticResource AccentButton}"
                            Click="OnUpload" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="UploadProgress" DockPanel.Dock="Bottom" Height="3" Margin="0,12,0,0"
                         Visibility="Collapsed" IsIndeterminate="False"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">

                    <!-- Jar drop zone. Dropping is the fast path; Browse is the discoverable one. -->
                    <Border x:Name="DropZone" AllowDrop="True"
                            DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop"
                            Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Margin="0,0,0,14" MinHeight="96">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE896;" FontFamily="{StaticResource IconFont}"
                                       FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="FileNameLabel" Text="Drop a .jar here"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="FileMetaLabel" Style="{StaticResource Caption}"
                                           Text="or use Browse to pick the file to publish"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse…" Click="OnBrowse"
                                    Padding="12,5" MinWidth="0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Caption}" Text="Version" Margin="0,0,0,4"/>
                            <TextBox x:Name="VersionBox" MaxLength="64" TextChanged="OnFormChanged"
                                     ToolTip="The version string collaborators will see, e.g. 1.2.0 or 0.5.8+mc1.20.1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Caption}" Text="Channel" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ChannelBox"
                                      ToolTip="Beta and alpha builds are only picked up by instances set to that update channel">
                                <ComboBoxItem Content="release" IsSelected="True"/>
                                <ComboBoxItem Content="beta"/>
                                <ComboBoxItem Content="alpha"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Text="Changelog" Margin="0,0,0,4"/>
                    <TextBox x:Name="ChangelogBox" Margin="0,0,0,12" MaxLength="4096"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" MinHeight="86" MaxHeight="140"
                             ToolTip="What changed in this build — shown next to the version everywhere it is listed"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Minecraft versions" Margin="0,0,0,4"/>
                    <TextBox x:Name="McVersionsBox" Margin="0,0,0,12" MaxLength="256" TextChanged="OnFormChanged"
                             ToolTip="Comma-separated, e.g. 1.20.1, 1.21.1 — this build is only offered to matching instances"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Loaders" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="LoaderFabric" Content="fabric" Margin="0,0,12,0"
                                  Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                        <CheckBox x:Name="LoaderForge" Content="forge" Margin="0,0,12,0"
                                  Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                        <CheckBox x:Name="LoaderNeoForge" Content="neoforge" Margin="0,0,12,0"
                                  Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                        <CheckBox x:Name="LoaderQuilt" Content="quilt"
                                  Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
