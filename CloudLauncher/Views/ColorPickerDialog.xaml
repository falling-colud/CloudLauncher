<UserControl x:Class="CloudLauncher.Views.ColorPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="380">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleLabel" Style="{StaticResource H2}" Margin="0,0,0,14"/>

            <!-- saturation / value square with the hue strip beside it -->
            <Grid Height="170" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Canvas x:Name="ShadeCanvas" Background="Transparent"
                            MouseLeftButtonDown="OnShadeDown" MouseMove="OnShadeMove"
                            MouseLeftButtonUp="OnShadeUp" Cursor="Cross">
                        <!-- pure hue, then white across, then black down -->
                        <Rectangle x:Name="HueFill" Width="{Binding ActualWidth, ElementName=ShadeCanvas}"
                                   Height="{Binding ActualHeight, ElementName=ShadeCanvas}"/>
                        <Rectangle Width="{Binding ActualWidth, ElementName=ShadeCanvas}"
                                   Height="{Binding ActualHeight, ElementName=ShadeCanvas}"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                    <GradientStop Offset="1" Color="#00FFFFFF"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Width="{Binding ActualWidth, ElementName=ShadeCanvas}"
                                   Height="{Binding ActualHeight, ElementName=ShadeCanvas}"
                                   IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#FF000000"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Ellipse x:Name="ShadeThumb" Width="14" Height="14" IsHitTestVisible="False"
                                 Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                    </Canvas>
                </Border>

                <Border Grid.Column="1" Width="26" Margin="12,0,0,0" CornerRadius="8" ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                    <Canvas x:Name="HueCanvas" Cursor="Cross"
                            MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp">
                        <Rectangle Width="{Binding ActualWidth, ElementName=HueCanvas}"
                                   Height="{Binding ActualHeight, ElementName=HueCanvas}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0.00" Color="#FFFF0000"/>
                                    <GradientStop Offset="0.17" Color="#FFFFFF00"/>
                                    <GradientStop Offset="0.33" Color="#FF00FF00"/>
                                    <GradientStop Offset="0.50" Color="#FF00FFFF"/>
                                    <GradientStop Offset="0.67" Color="#FF0000FF"/>
                                    <GradientStop Offset="0.83" Color="#FFFF00FF"/>
                                    <GradientStop Offset="1.00" Color="#FFFF0000"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="HueThumb" Width="26" Height="4" CornerRadius="2" IsHitTestVisible="False"
                                Background="White" BorderBrush="#60000000" BorderThickness="1"/>
                    </Canvas>
                </Border>
            </Grid>

            <!-- preview + hex entry -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" x:Name="Preview" Width="40" Height="34" CornerRadius="7"
                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,10,0"/>
                <Border Grid.Column="1" Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                        MinHeight="34">
                    <TextBox x:Name="HexBox" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Margin="11,0,10,0" FontFamily="{StaticResource MonoFont}"
                             TextChanged="OnHexChanged" MaxLength="7"
                             ToolTip="Type or paste a #RRGGBB value">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>
            </Grid>

            <TextBlock Text="PRESETS" Style="{StaticResource Caption}"
                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0,0,6"/>
            <ItemsControl x:Name="Swatches" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid>
                <Button x:Name="ClearButton" Content="No colour" Style="{StaticResource SubtleButton}"
                        HorizontalAlignment="Left" Padding="12,6" Click="OnClear"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="OnCancel" Margin="0,0,8,0"/>
                    <Button Content="Use colour" Style="{StaticResource AccentButton}" Click="OnAccept"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
