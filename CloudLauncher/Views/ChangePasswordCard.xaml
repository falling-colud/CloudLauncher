<UserControl x:Class="CloudLauncher.Views.ChangePasswordCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="24" MinWidth="380" MaxWidth="440">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Change password" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="You stay signed in on this PC. Every other device is signed out and has to sign in again."/>

            <TextBlock Style="{StaticResource Caption}" Text="Current password"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,4"/>
            <PasswordBox x:Name="CurrentBox"/>

            <TextBlock Style="{StaticResource Caption}" Text="New password"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <PasswordBox x:Name="NewBox" PasswordChanged="OnTyping"/>

            <TextBlock Style="{StaticResource Caption}" Text="Repeat the new password"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <PasswordBox x:Name="ConfirmBox" PasswordChanged="OnTyping"/>

            <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SubtleButton}"
                        Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="SubmitButton" Content="Change password" Style="{StaticResource AccentButton}"
                        Click="OnSubmit"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
