<UserControl x:Class="CloudLauncher.Views.ModVersionPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="520" Height="614">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,2,0,12"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <!-- Without this, deliberately going back to an older version is undone by the next
                     "Update all" — the user had to separately remember to right-click the mod and
                     tick "Lock updates". Choosing a version IS the intent, so it is offered here. -->
                <CheckBox x:Name="KeepVersionBox" Content="Keep this version — bulk updates skip it"
                          HorizontalAlignment="Left" Margin="0,0,0,10"
                          ToolTip="Locks the mod to whatever you install here. Untick to let &quot;Update all&quot; move it again."/>
                <Grid>
                    <CheckBox x:Name="ShowAllBox" Content="Show all versions" VerticalAlignment="Center"
                              HorizontalAlignment="Left" Click="OnShowAllChanged"
                              ToolTip="Include versions for other Minecraft versions / loaders"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="OnCancel" Margin="0,0,8,0"/>
                        <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}" Click="OnInstall"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnListDoubleClick"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3" Opacity="{Binding Dim}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Pill}" Background="{Binding ChannelBrush}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Channel}" Style="{StaticResource PillText}" Foreground="White"/>
                                        </Border>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentSoftBrush}" Margin="6,0,0,0"
                                                Visibility="{Binding CurrentVisibility}">
                                            <TextBlock Text="Current" Style="{StaticResource PillText}" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Style="{StaticResource Caption}"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
