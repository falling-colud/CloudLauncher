<UserControl x:Class="CloudLauncher.Views.ModVersionPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:views="clr-namespace:CloudLauncher.Views">
    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SubLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,2,0,12"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <!-- Otherwise the next "Update all" undoes picking an older version. -->
                <CheckBox x:Name="KeepVersionBox" Content="Keep this version - bulk updates skip it"
                          HorizontalAlignment="Left" Margin="0,0,0,10"
                          ToolTip="Locks the mod to whatever you install here. Untick to let &quot;Update all&quot; move it again."/>
                <Grid>
                    <CheckBox x:Name="ShowAllBox" Content="Show all versions" VerticalAlignment="Center"
                              HorizontalAlignment="Left" Click="OnShowAllChanged"
                              ToolTip="Include versions for other Minecraft versions / loaders"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="OnCancel" Margin="0,0,8,0"/>
                        <Button x:Name="InstallButton" Content="Install" Style="{StaticResource AccentButton}" Click="OnInstall"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--  The list, and the selected version's changelog beside it, or under it when the card is
            too narrow for two columns (see OnBodySizeChanged).  -->
            <Grid x:Name="Body" SizeChanged="OnBodySizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PaneColumn" Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="PaneRow" Height="0"/>
                </Grid.RowDefinitions>

                <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <!--  Double-click installs; right-click offers the changelog first.  -->
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" MouseDoubleClick="OnListDoubleClick"
                             SelectionChanged="OnSelectionChanged" MouseRightButtonUp="OnListRightClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3" Opacity="{Binding Dim}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <slate:SlateBorder Style="{StaticResource Pill}" Background="{Binding ChannelBrush}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Channel}" Style="{StaticResource PillText}" Foreground="White"/>
                                            </slate:SlateBorder>
                                            <slate:SlateBorder Style="{StaticResource Pill}" Background="{DynamicResource AccentSoftBrush}" Margin="6,0,0,0"
                                                    Visibility="{Binding CurrentVisibility}">
                                                <TextBlock Text="Current" Style="{StaticResource PillText}" Foreground="{DynamicResource AccentTextBrush}"/>
                                            </slate:SlateBorder>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </slate:SlateBorder>

                <views:VersionChangelogPane x:Name="ChangelogPane" Grid.Column="1" Margin="14,0,0,0"/>
            </Grid>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
