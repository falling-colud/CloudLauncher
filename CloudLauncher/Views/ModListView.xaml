<UserControl x:Class="CloudLauncher.Views.ModListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             Background="Transparent">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <DockPanel PreviewKeyDown="OnPreviewKeyDown">
        <!-- Toolbar. The pack page usually opens in the side panel (~420 px by default), so the actions
             wrap onto a second line when narrow instead of being clipped. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
            <Border x:Name="CompactSearchHost"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" MinHeight="32" Width="36" Margin="0,0,8,6" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SearchToggleButton" Grid.Column="0"
                            Style="{StaticResource IconButton}" Click="OnSearchToggle"
                            Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Search installed mods"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Visibility="Collapsed"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchPreviewKeyDown"
                             LostKeyboardFocus="OnSearchLostKeyboardFocus"
                             ToolTip="Filter by name, version, source, category or folder">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <ComboBox x:Name="SourceFilterBox" Width="120" Margin="0,0,12,6"
                      VerticalAlignment="Top" SelectionChanged="OnSourceFilterChanged"
                      ToolTip="Show only mods from one store">
                <ComboBoxItem Content="All sources" IsSelected="True"/>
                <ComboBoxItem Content="CurseForge"/>
                <ComboBoxItem Content="Modrinth"/>
                <ComboBoxItem Content="External"/>
            </ComboBox>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- Only shown for the one pack the profile was tuned for; see LowModeService.AppliesTo. -->
                    <StackPanel x:Name="LowModePanel" Orientation="Horizontal" Margin="0,0,10,6"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <CheckBox x:Name="LowModeBox" Content="Low mode"
                                  VerticalAlignment="Center" Margin="0,0,2,0"
                                  Click="OnLowModeToggled"
                                  ToolTip="Turn the pack's heaviest visual settings down before each launch, and switch a few purely decorative client-side mods off, so it runs on a modest machine. Your own values are backed up and put back when you turn it off. Click the ? for exactly what changes."/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE897;"
                                FontFamily="{StaticResource IconFont}" FontSize="12"
                                ToolTip="What does low mode do?" Click="OnExplainLowMode"/>
                    </StackPanel>
                    <Button x:Name="UpdateAllButton" Content="Update all" Visibility="Collapsed"
                            Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="OnUpdateAll"
                            ToolTip="Review every available update, read the changelogs, and pick which ones to install"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="0,0,8,6"
                            FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Refresh" Click="OnRefresh"/>
                    <Button Content="Modpack Management" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="OnOpenManagement">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Modpack Management" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button Content="Import…" Margin="0,0,0,6" Click="OnImportModpack"/>
                </WrapPanel>
            </Grid>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="2,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Border Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="ModGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      SelectionMode="Single" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      SizeChanged="OnGridSizeChanged"
                      PreviewMouseRightButtonDown="OnModGridPreviewMouseRightButtonDown"
                      MouseDoubleClick="OnModDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="28" Height="28"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn x:Name="VersionColumn" Header="Version" Binding="{Binding VersionLabel}"
                                        SortMemberPath="VersionSortKey" Width="140"/>
                    <DataGridTextColumn x:Name="SourceColumn" Header="Source" Binding="{Binding SourceLabel}" Width="96"/>
                    <DataGridTemplateColumn x:Name="UpdateColumn" Header="Update" Width="88" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Update" Click="OnModAction"
                                        IsEnabled="{Binding HasUpdate}" Padding="6,2"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}"
                                        MinHeight="0" MinWidth="0" FontSize="11"
                                        ToolTip="{Binding LatestVersion.VersionNumber}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Click="OnModEnabledToggle"
                                              ToolTip="Enable or disable mod"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Width="36" Height="20" Padding="0" MinWidth="0" MinHeight="0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                                                Background="{DynamicResource Surface3Brush}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip MaxWidth="440">
                                    <TextBlock Text="{Binding TooltipText}" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <!-- "has an update" is highlighted in the theme's accent, not a fixed blue -->
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                <Setter Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsExternal}" Value="True"/>
                                    <Condition Binding="{Binding Enabled}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="OnModContextMenuOpened">
                        <MenuItem x:Name="CtxOpenPage" Header="Open mod page" Click="OnCtxOpenPage"/>
                        <MenuItem x:Name="CtxOpenWebsite" Header="Open website" Click="OnCtxOpenWebsite"/>
                        <Separator/>
                        <MenuItem x:Name="CtxUpdate" Header="Update to latest" Click="OnCtxUpdate"/>
                        <MenuItem x:Name="CtxUpdateToVersion" Header="Update to version…" Click="OnCtxUpdateToVersion"/>
                        <MenuItem x:Name="CtxStore" Header="Store">
                            <MenuItem x:Name="CtxStoreAuto" Header="Pack default" Click="OnCtxStoreAuto"/>
                            <MenuItem x:Name="CtxStoreCurse" Header="CurseForge" Click="OnCtxStoreCurse"/>
                            <MenuItem x:Name="CtxStoreModrinth" Header="Modrinth" Click="OnCtxStoreModrinth"/>
                        </MenuItem>
                        <MenuItem x:Name="CtxEnableMod" Header="Enable mod" Click="OnCtxEnable"/>
                        <MenuItem x:Name="CtxDisableMod" Header="Disable mod" Click="OnCtxDisable"/>
                        <MenuItem x:Name="CtxCreateHostedMod"
                                  Header="Create hosted mod from jar"
                                  Click="OnCtxCreateHostedMod"/>
                        <Separator/>
                        <MenuItem Header="Reveal in Explorer" Click="OnCtxReveal"/>
                        <MenuItem Header="Delete file" Click="OnCtxDelete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
