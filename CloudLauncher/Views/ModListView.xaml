<UserControl x:Class="CloudLauncher.Views.ModListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             Background="Transparent">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <DockPanel PreviewKeyDown="OnPreviewKeyDown">
        <!-- Toolbar. The pack page usually opens in the side panel (~420 px by default), so the actions
             wrap onto a second line when narrow instead of being clipped. -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <ComboBox x:Name="SourceFilterBox" Width="120" Margin="0,0,8,6"
                              VerticalAlignment="Top" SelectionChanged="OnSourceFilterChanged"
                              ToolTip="Show only mods from one store">
                        <ComboBoxItem Content="All sources" IsSelected="True"/>
                        <ComboBoxItem Content="CurseForge"/>
                        <ComboBoxItem Content="Modrinth"/>
                        <ComboBoxItem Content="External"/>
                    </ComboBox>
                    <!--  The shared search control. It filters an in-memory list, so the default 200ms
                    debounce is fine.  -->
                    <local:CompactSearchBox x:Name="SearchBox" Margin="0,0,0,6" VerticalAlignment="Top"
                                            Placeholder="Filter mods"
                                            SearchToolTip="Filter by name, version, source, category or folder"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- Only shown for the one pack the profile was tuned for; see LowModeService.AppliesTo. -->
                    <StackPanel x:Name="LowModePanel" Orientation="Horizontal" Margin="0,0,10,6"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <CheckBox x:Name="LowModeBox" Content="Low mode"
                                  VerticalAlignment="Center" Margin="0,0,2,0"
                                  Click="OnLowModeToggled"
                                  ToolTip="Turn the pack's heaviest visual settings down before each launch, and switch a few purely decorative client-side mods off, so it runs on a modest machine. Your own values are backed up and put back when you turn it off. Click the ? for exactly what changes."/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE897;"
                                FontFamily="{DynamicResource IconFont}" FontSize="12"
                                ToolTip="What does low mode do?" Click="OnExplainLowMode"/>
                    </StackPanel>
                    <!-- No accent button on this tab: the Modpack Management hub is reached from the Overview
                    tab. Per-mod updating stays on the row (Update button, right-click menu, highlight).
                    Order: labelled buttons first, then the icon-only utilities (open folder, then refresh). -->
                    <Button Style="{StaticResource HeaderActionButton}" Margin="0,0,8,6"
                            Click="OnImportModpack" ToolTip="Import mods from a modpack file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Import..." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                            Content="&#xE8DA;" Margin="0,0,4,6"
                            FontFamily="{DynamicResource IconFont}"
                            ToolTip="Open this instance's mods folder"
                            Click="OnOpenModsFolder"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                            Content="&#xE72C;" Margin="0,0,0,6"
                            FontFamily="{DynamicResource IconFont}"
                            ToolTip="Re-scan the mods folder and check every mod against its store again (F5)"
                            Click="OnRefresh"/>
                </WrapPanel>
            </Grid>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="2,0,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <slate:SlateBorder Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
          <Grid>
            <DataGrid x:Name="ModGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      SelectionMode="Single" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      SizeChanged="OnGridSizeChanged"
                      PreviewMouseRightButtonDown="OnModGridPreviewMouseRightButtonDown"
                      MouseRightButtonUp="OnModGridRightClick"
                      MouseDoubleClick="OnModDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <slate:SlateBorder Width="28" Height="28"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!--  Never bind a URL straight to Image.Source; see IconLoader. The cell is 28px.  -->
                                        <Image local:IconLoader.Url="{Binding IconUrl}"
                                               local:IconLoader.DecodeWidth="28" Stretch="Uniform"/>
                                    </Grid>
                                </slate:SlateBorder>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  A template column so the name can use the link style; SortMemberPath keeps sorting
                    by name. No Foreground here: the cell template already passes the cell's Foreground
                    down, and a local value would override the hover trigger below.  -->
                    <DataGridTemplateColumn Header="Name" SortMemberPath="DisplayName" Width="*" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MouseLeftButtonUp="OnModNameClick"
                                           ToolTip="{Binding PageUrl}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- No store page (an external jar) means nowhere to go, so
                                                     the name stays inert: no hand, no accent, no underline. -->
                                                <DataTrigger Binding="{Binding HasPage}" Value="True">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasPage}" Value="True"/>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="VersionColumn" Header="Version" Binding="{Binding VersionLabel}"
                                        SortMemberPath="VersionSortKey" Width="140"/>
                    <DataGridTextColumn x:Name="SourceColumn" Header="Source" Binding="{Binding SourceLabel}" Width="96"/>
                    <DataGridTemplateColumn x:Name="UpdateColumn" Header="Update" Width="88" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Update" Click="OnModAction"
                                        IsEnabled="{Binding HasUpdate}" Padding="6,2"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}"
                                        MinHeight="0" MinWidth="0" FontSize="11"
                                        ToolTip="{Binding LatestVersion.VersionNumber}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Click="OnModEnabledToggle"
                                              ToolTip="Enable or disable mod"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Width="36" Height="20" Padding="0" MinWidth="0" MinHeight="0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <slate:SlateBorder x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                                                Background="{DynamicResource Surface3Brush}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                        </slate:SlateBorder>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip">
                            <Setter.Value>
                                <ToolTip MaxWidth="440">
                                    <TextBlock Text="{Binding TooltipText}" TextWrapping="Wrap"/>
                                </ToolTip>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <!-- "has an update" is highlighted in the theme's accent, not a fixed blue -->
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <!--  A derived style's triggers run after the BasedOn style's, so the accent Background
                            above hides the base style's hover. The hover is restated here with AccentPressedBrush,
                            so the row still reads as having an update under the cursor. The Enabled=False trigger
                            only touches Foreground and Opacity, so it needs no twin.  -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasUpdate}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                <Setter Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsExternal}" Value="True"/>
                                    <Condition Binding="{Binding Enabled}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <!--  No ContextMenu here: OnModGridRightClick builds the shared ModOptionsMenu, so
                there is one mod menu in the app.  -->
            </DataGrid>

            <!--  Last in the cell so it overlays the grid.  -->
            <local:PageStateView x:Name="PageStateHost"/>
          </Grid>
        </slate:SlateBorder>
    </DockPanel>
</UserControl>
