<UserControl x:Class="CloudLauncher.Views.ModListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel PreviewKeyDown="OnPreviewKeyDown">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                        FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Refresh" Click="OnRefresh"/>
                <Button Content="Mods Management" Style="{StaticResource AccentButton}" Click="OnOpenManagement">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mods Management" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Content="Import…" Click="OnImportModpack"/>
            </StackPanel>
            <Border x:Name="CompactSearchHost" DockPanel.Dock="Left"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" MinHeight="32" Width="36" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SearchToggleButton" Grid.Column="0"
                            Style="{StaticResource IconButton}" Click="OnSearchToggle"
                            Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Search installed mods"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Visibility="Collapsed"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchPreviewKeyDown"
                             LostKeyboardFocus="OnSearchLostKeyboardFocus"
                             ToolTip="Filter by name, version, source, or folder">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6">
            <DataGrid x:Name="ModGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      SelectionMode="Single" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      SizeChanged="OnGridSizeChanged"
                      PreviewMouseRightButtonDown="OnModGridPreviewMouseRightButtonDown"
                      MouseDoubleClick="OnModDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="28" Height="28"
                                        Background="{StaticResource Surface3Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"       Width="*" MinWidth="120"/>
                    <DataGridTextColumn x:Name="VersionColumn" Header="Version" Binding="{Binding Version}" SortMemberPath="VersionSortKey" Width="140"/>
                    <DataGridTemplateColumn x:Name="UpdateColumn" Header="Update" Width="88" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Update" Click="OnModAction"
                                        IsEnabled="{Binding HasUpdate}" Padding="6,2"
                                        MinHeight="0" MinWidth="0" FontSize="11"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="56" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Click="OnModEnabledToggle"
                                              ToolTip="Enable or disable mod"
                                              VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Width="36" Height="20" Padding="0" MinWidth="0" MinHeight="0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                                                Background="{StaticResource Surface3Brush}"
                                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                <Setter Property="Background" Value="#332E7CF0"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                <Setter Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsExternal}" Value="True"/>
                                    <Condition Binding="{Binding IsEnabled}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu Opened="OnModContextMenuOpened">
                        <MenuItem Header="Open mod page" Click="OnCtxOpenPage"/>
                        <MenuItem Header="Update to latest" Click="OnCtxUpdate"/>
                        <MenuItem x:Name="CtxEnableMod" Header="Enable mod" Click="OnCtxEnable"/>
                        <MenuItem x:Name="CtxDisableMod" Header="Disable mod" Click="OnCtxDisable"/>
                        <MenuItem x:Name="CtxCreateHostedMod"
                                  Header="Create hosted mod from jar"
                                  Click="OnCtxCreateHostedMod"/>
                        <Separator/>
                        <MenuItem Header="Reveal in Explorer" Click="OnCtxReveal"/>
                        <MenuItem Header="Delete file" Click="OnCtxDelete"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
