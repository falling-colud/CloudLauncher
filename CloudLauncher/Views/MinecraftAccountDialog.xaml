<Window x:Class="CloudLauncher.Views.MinecraftAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        xmlns:svc="clr-namespace:CloudLauncher.Services"
        Title="Minecraft account" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource H2}" Text="Minecraft account"/>
            <TextBlock x:Name="CurrentAccountLabel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <slate:SlateBorder Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <slate:SlateBorder DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE748;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </slate:SlateBorder>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Microsoft account" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Required to play on online-mode servers."/>
                    </StackPanel>
                </DockPanel>
                <Button x:Name="MicrosoftButton" Content="Sign in with Microsoft"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                        Click="OnMicrosoftSignIn" Margin="0,12,0,0"/>
            </StackPanel>
        </slate:SlateBorder>

        <slate:SlateBorder Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <slate:SlateBorder DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                            Background="{DynamicResource Surface4Brush}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </slate:SlateBorder>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Offline play" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Pick any username. Only joins offline-mode servers."/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Content="Use offline" Click="OnOffline"/>
                    <TextBox x:Name="OfflineNameBox" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="{x:Static svc:MinecraftAccountService.OfflineNeedsMicrosoftReason}"/>
            </StackPanel>
        </slate:SlateBorder>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" IsCancel="True"/>
            <Button DockPanel.Dock="Right" x:Name="SignOutButton" Style="{StaticResource DangerButton}"
                    Content="Sign out" Click="OnSignOut"/>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
