<Page x:Class="CloudLauncher.Views.ServersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Servers"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="28,24,28,12">
            <TextBlock Style="{StaticResource H1}" Text="Servers"/>
            <TextBlock x:Name="SubLabel" Style="{StaticResource Muted}"
                       Text="Every server your instances can join, in one place."/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="ContentHost" Margin="28,0,28,16"/>
    </Grid>
</Page>
