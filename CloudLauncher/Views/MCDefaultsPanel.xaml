<Page x:Class="CloudLauncher.Views.MCDefaultsPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Minecraft defaults"
      Background="{DynamicResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,28">

            <TextBlock Style="{StaticResource H2}" Text="Minecraft defaults"/>
            <TextBlock Style="{StaticResource Muted}"
                       Text="These settings are stamped into the options.txt of new instances you create. You can also apply them to a specific instance at any time."
                       TextWrapping="Wrap" Margin="0,6,0,18"/>

            <!-- VIDEO -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Video" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Field of view" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="FovValue" DockPanel.Dock="Right" Text="70"
                                   MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="FovSlider" Minimum="30" Maximum="110" IsSnapToTickEnabled="True"
                                TickFrequency="1" Value="70" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Render distance" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="RenderDistanceValue" DockPanel.Dock="Right" Text="12 chunks"
                                   MinWidth="80" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="RenderDistanceSlider" Minimum="2" Maximum="32" IsSnapToTickEnabled="True"
                                TickFrequency="1" Value="12" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Simulation distance" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SimDistanceValue" DockPanel.Dock="Right" Text="10 chunks"
                                   MinWidth="80" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="SimDistanceSlider" Minimum="5" Maximum="32" IsSnapToTickEnabled="True"
                                TickFrequency="1" Value="10" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Brightness" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="BrightnessValue" DockPanel.Dock="Right" Text="50%"
                                   MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" IsSnapToTickEnabled="True"
                                TickFrequency="1" Value="50" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="GUI scale" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="GuiScaleBox" Width="180" HorizontalAlignment="Left"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Auto"/>
                            <ComboBoxItem Content="1×"/>
                            <ComboBoxItem Content="2×"/>
                            <ComboBoxItem Content="3×"/>
                            <ComboBoxItem Content="4×"/>
                        </ComboBox>
                    </DockPanel>

                    <CheckBox x:Name="FullscreenBox" Content="Fullscreen" Margin="0,4,0,8"/>
                    <CheckBox x:Name="VSyncBox" Content="Enable VSync" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ViewBobbingBox" Content="View bobbing" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoJumpBox" Content="Auto-jump" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- AUDIO -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Audio" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Master volume" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="MasterVolumeValue" DockPanel.Dock="Right" Text="100%"
                                   MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100"
                                Value="100" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock DockPanel.Dock="Left" Text="Music" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="MusicVolumeValue" DockPanel.Dock="Right" Text="100%"
                                   MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="100"
                                Value="100" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Sound effects" Width="160"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="SoundFxValue" DockPanel.Dock="Right" Text="100%"
                                   MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="SoundFxSlider" Minimum="0" Maximum="100"
                                Value="100" ValueChanged="OnSliderChanged"
                                VerticalAlignment="Center" Margin="12,0,12,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- CONTROLS -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Controls" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Click a binding then press a key. The launcher saves Minecraft-format identifiers."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Left column -->
                        <local:KeybindRow x:Name="KeyForward"   Label="Forward"    Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyBack"      Label="Back"       Grid.Row="1" Grid.Column="0" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyLeft"      Label="Strafe left"  Grid.Row="2" Grid.Column="0" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyRight"     Label="Strafe right" Grid.Row="3" Grid.Column="0" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyJump"      Label="Jump"       Grid.Row="4" Grid.Column="0" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeySneak"     Label="Sneak"      Grid.Row="5" Grid.Column="0" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyTogglePerspective" Label="Toggle perspective" Grid.Row="6" Grid.Column="0"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>

                        <!-- Right column -->
                        <local:KeybindRow x:Name="KeySprint"    Label="Sprint"     Grid.Row="0" Grid.Column="2" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyInventory" Label="Inventory"  Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyChat"      Label="Chat"       Grid.Row="2" Grid.Column="2" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyDrop"      Label="Drop item"  Grid.Row="3" Grid.Column="2" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyAttack"    Label="Attack"     Grid.Row="4" Grid.Column="2" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                        <local:KeybindRow x:Name="KeyUse"       Label="Use / place" Grid.Row="5" Grid.Column="2" Margin="0,0,0,10"
                                          xmlns:local="clr-namespace:CloudLauncher.Views"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ACTIONS -->
            <DockPanel Margin="0,4,0,0">
                <Button Click="OnResetDefaults" Content="Reset to Minecraft defaults" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Click="OnApplyToPack" Content="Apply to an instance..." Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Click="OnSave"
                        Content="Save defaults" Style="{StaticResource AccentButton}"/>
            </DockPanel>

            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
