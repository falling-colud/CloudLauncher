<Window x:Class="CloudLauncher.Views.ScreenshotPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        Title="Screenshot"
        Width="980" Height="680"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="Backdrop"
          Background="#B8000000"
          Opacity="0"
          MouseLeftButtonUp="OnBackdropMouseLeftButtonUp">
        <slate:SlateBorder x:Name="PreviewCard"
                Width="900"
                MaxWidth="1120"
                MaxHeight="760"
                Margin="28"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonUp="OnPreviewCardMouseLeftButtonUp">
            <slate:SlateBorder.RenderTransform>
                <ScaleTransform x:Name="PreviewScale" ScaleX="0.96" ScaleY="0.96"/>
            </slate:SlateBorder.RenderTransform>
            <slate:SlateBorder.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#FF000000"/>
            </slate:SlateBorder.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="PreviousButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76B;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                ToolTip="Previous screenshot (Left arrow)"
                                Click="OnPreviousClicked"
                                Visibility="Collapsed"/>
                        <Button x:Name="NextButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE76C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                ToolTip="Next screenshot (Right arrow)"
                                Click="OnNextClicked"
                                Margin="4,0,12,0"
                                Visibility="Collapsed"/>
                        <Button Content="Close"
                                MinWidth="78"
                                Padding="14,7"
                                Click="OnCloseClicked"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource H2}"
                                   Text="Screenshot"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HintText"
                                   Text="Press Esc or click outside the image to close."
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <slate:SlateBorder Grid.Row="1"
                        Background="{DynamicResource Surface0Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="ImageStatusText"
                                   Style="{StaticResource Muted}"
                                   Text=""
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="520"/>
                    </Grid>
                </slate:SlateBorder>

                <!-- Actions on the right, captions filling the rest, like the other footers. -->
                <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="CopyImageButton"
                                Content="Copy image"
                                Padding="14,7"
                                Margin="0,0,8,0"
                                ToolTip="Put the picture on the clipboard, ready to paste"
                                Click="OnCopyImageClicked"/>
                        <Button x:Name="SaveCopyButton"
                                Content="Save a copy..."
                                Padding="14,7"
                                Margin="0,0,8,0"
                                ToolTip="Write a copy of this image somewhere else"
                                Click="OnSaveCopyClicked"/>
                        <Button x:Name="OpenExternallyButton"
                                Content="Open in browser"
                                Padding="14,7"
                                Click="OnOpenExternallyClicked"/>
                    </StackPanel>
                    <TextBlock x:Name="UrlText"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </slate:SlateBorder>
    </Grid>
</Window>
