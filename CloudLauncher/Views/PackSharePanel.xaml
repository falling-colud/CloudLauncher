<UserControl x:Class="CloudLauncher.Views.PackSharePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:v="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <UserControl.Resources>
        <!--  One entry in a list inside a card (a person, a team, an invitation, a file). A shared
        style rather than inline so a live theme change repaints all of them.  -->
        <Style x:Key="ShareRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!--  Warning-bordered note for something to read before clicking, as in ShaderPacksView.  -->
        <Style x:Key="ShareNoteBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="ShareWarnBox" TargetType="Border" BasedOn="{StaticResource ShareNoteBox}">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
        </Style>

        <!--  Explanation line under each option in the visibility list.  -->
        <Style x:Key="VisibilityNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="26,1,0,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!--  Who has access: owner, people, teams and the public row in one list. The role box binds
        two-way to the row, which raises its own edit event, so filling the list fires no
        SelectionChanged.  -->
        <DataTemplate x:Key="AccessRowTemplate">
            <Border Style="{StaticResource ShareRow}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding RemoveVisibility}"
                            IsEnabled="{Binding CanEdit}"
                            ToolTip="{Binding RemoveHint}" ToolTipService.ShowOnDisabled="True"
                            Click="OnRemoveAccess"/>
                    <ComboBox DockPanel.Dock="Right" Width="196" Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Roles}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}"
                              Visibility="{Binding RoleVisibility}"
                              ToolTip="{Binding RoleHint}" ToolTipService.ShowOnDisabled="True"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FixedRoleLabel}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="8,0,0,0" Visibility="{Binding FixedRoleVisibility}"/>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!--  Pending invitations. Resend mints a new invitation and the server revokes the old one,
        so a person never has two live tokens.  -->
        <DataTemplate x:Key="InviteRowTemplate">
            <Border Style="{StaticResource ShareRow}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Revoke" Padding="10,3" FontSize="11"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            IsEnabled="{Binding CanAct}"
                            ToolTip="{Binding ActHint}" ToolTipService.ShowOnDisabled="True"
                            Click="OnRevokeInvite"/>
                    <Button DockPanel.Dock="Right" Content="Resend" Padding="10,3" FontSize="11"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ResendVisibility}"
                            IsEnabled="{Binding CanAct}"
                            ToolTip="{Binding ActHint}" ToolTipService.ShowOnDisabled="True"
                            Click="OnResendInvite"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Content="&#xE71B;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                            Margin="6,0,0,0" VerticalAlignment="Center"
                            ToolTip="Copy this invitation's link" Click="OnCopyInviteLink"/>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!--  One file that will be uploaded, or one that is being held back.  -->
        <DataTemplate x:Key="SyncFileRowTemplate">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                           Style="{StaticResource Caption}" Width="78" TextAlignment="Right"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
            </DockPanel>
        </DataTemplate>

        <!--  One path the server and this PC disagree about, after a 409.  -->
        <DataTemplate x:Key="ConflictRowTemplate">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeLabel}"
                           Style="{StaticResource Caption}" Width="150" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
            </DockPanel>
        </DataTemplate>

        <!--  One line of the activity feed.  -->
        <DataTemplate x:Key="ActivityRowTemplate">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{StaticResource Caption}"
                           Width="104" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>

        <!--  One user the search turned up.  -->
        <DataTemplate x:Key="UserResultTemplate">
            <DockPanel Margin="2,3">
                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                           Margin="0,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding Username}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Row 0: what this tab is, and its two main actions.  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}"
                        Click="OnPrimary" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PrimaryGlyph" Text="&#xE898;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PrimaryLabel" Text="Upload changes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DownloadButton" Margin="8,0,0,0" Click="OnDownload"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Download latest" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarIconButton}" Margin="8,0,0,0"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        Click="OnRefresh" ToolTip="Re-read the sharing state from the server (F5)"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Share this instance with other people" Style="{StaticResource H3}"/>
                <TextBlock x:Name="SubLabel" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!--  Row 1: content. PageStateView is last so it draws over the cards.  -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          anim:Animate.SmoothScroll="True">
                <StackPanel Margin="0,0,10,0">

                    <!--  ══ PUBLISHING ══ The master switch. Worded as publishing rather than hosting so it
                    is not confused with starting a Minecraft server.  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PublishPill" Style="{StaticResource PillText}"/>
                                </slate:SlateBorder>
                                <TextBlock Text="Publishing" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="Publishing puts a copy of this instance's files on CloudLauncher, so the people below can download it and stay in step with your changes. It does not make it public: that is 'Who can find it', below. Nothing is uploaded until you press Upload."/>
                            <CheckBox x:Name="PublishBox" Click="OnPublishToggled"
                                      Content="Publish this instance to CloudLauncher"/>
                            <TextBlock x:Name="PublishEffectLabel" Style="{StaticResource Caption}"
                                       Margin="26,6,0,0" TextWrapping="Wrap"/>

                            <!--  Published and Private: the files are up but nobody new can find
                            them. "Publish" reads like "make public", so say which it is and offer
                            the other rather than changing visibility for them.  -->
                            <Border x:Name="UnlistedNote" Style="{StaticResource ShareNoteBox}"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="ListPubliclyButton"
                                            Content="Also list it publicly" Padding="12,4"
                                            Margin="12,0,0,0" VerticalAlignment="Center"
                                            Click="OnListPublicly"/>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;"
                                               FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Margin="0,0,9,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource InfoBlueBrush}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Published, but not listed" FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Its files are on CloudLauncher, but it is private: only you and the people below can find it. It does not show up in Browse."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource ShareNoteBox}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;"
                                               FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Margin="0,0,9,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource InfoBlueBrush}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="This has nothing to do with running a Minecraft server. That lives on the Hosting tab; this is about sharing the instance's files with people."/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ WHO CAN FIND IT ══  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Who can find it" Style="{StaticResource H3}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="This is about who can come across the instance on their own. Anyone you invite below gets in whatever this says."/>

                            <RadioButton x:Name="VisPrivateBox" GroupName="Visibility" Click="OnVisibilityPicked"
                                         Content="Private"/>
                            <TextBlock Style="{StaticResource VisibilityNote}"
                                       Text="Only you and the people and teams listed below."/>

                            <RadioButton x:Name="VisTeamBox" GroupName="Visibility" Click="OnVisibilityPicked"
                                         Content="My teams"/>
                            <TextBlock Style="{StaticResource VisibilityNote}"
                                       Text="Everyone on the teams listed below can find it and download it, even the members you never added by name."/>

                            <RadioButton x:Name="VisPublicBox" GroupName="Visibility" Click="OnVisibilityPicked"
                                         Content="Everyone on this CloudLauncher server"/>
                            <TextBlock Style="{StaticResource VisibilityNote}"
                                       Text="Anyone with an account can find it in Browse, and download it once it is published. They cannot change it."/>

                            <Border x:Name="TeamVisibilityWarning" Style="{StaticResource ShareWarnBox}"
                                    Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;"
                                               FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Margin="0,0,9,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="No team has been given access yet, so &quot;My teams&quot; currently grants nothing. Add one below."/>
                                </DockPanel>
                            </Border>

                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" x:Name="AddTeamButton" Content="Give access"
                                        Padding="12,4" Margin="8,0,0,0" Click="OnAddTeam"/>
                                <ComboBox DockPanel.Dock="Right" x:Name="TeamRoleBox" Width="196"
                                          Margin="8,0,0,0" DisplayMemberPath="Label"/>
                                <!--  Fixed width rather than MaxWidth: sized to its content, the box
                                shrinks to a bare chevron when the list is empty.  -->
                                <ComboBox x:Name="AvailableTeamsBox" Width="240"
                                          HorizontalAlignment="Left" DisplayMemberPath="Name"/>
                            </DockPanel>
                            <TextBlock x:Name="TeamsHintLabel" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ WHO HAS ACCESS ══ Owner, people, teams and, when it applies, the public
                    row, all in one list.  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="AdvancedPermsButton"
                                        Content="Advanced..." Padding="12,4" VerticalAlignment="Center"
                                        Click="OnAdvancedPermissions"
                                        ToolTip="The per-permission grid: view, download, upload and manage, one tick box each"/>
                                <TextBlock x:Name="AccessCountLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="Who has access" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="A role, not a row of tick boxes. Upload lets somebody push their own changes to everyone else; manage lets them share it further."/>
                            <ItemsControl x:Name="AccessList" ItemTemplate="{StaticResource AccessRowTemplate}"/>
                            <TextBlock x:Name="AccessEmptyLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed" TextWrapping="Wrap"
                                       Text="Nobody else has been given access yet."/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ INVITE ══  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Invite someone" Style="{StaticResource H3}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="Start typing a username and pick them from the list. They get an invitation they can accept or decline - nothing lands in their launcher until they do."/>

                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="SendInviteButton" Content="Send invite"
                                        Padding="12,4" Margin="8,0,0,0" Click="OnSendInvite"/>
                                <ComboBox DockPanel.Dock="Right" x:Name="InviteExpiryBox" Width="150"
                                          Margin="8,0,0,0" DisplayMemberPath="Label"
                                          ToolTip="How long the invitation stays open"/>
                                <ComboBox DockPanel.Dock="Right" x:Name="InviteRoleBox" Width="196"
                                          Margin="8,0,0,0" DisplayMemberPath="Label"
                                          ToolTip="What they will be able to do"/>
                                <v:CompactSearchBox x:Name="UserSearch" HorizontalAlignment="Left"
                                                    ExpandedWidth="240" Placeholder="Username"
                                                    SearchToolTip="Find someone by username"/>
                            </DockPanel>

                            <slate:SlateBorder x:Name="UserResultsCard" Margin="0,8,0,0" CornerRadius="8"
                                    Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    Visibility="Collapsed">
                                <ListBox x:Name="UserResults" MaxHeight="150" BorderThickness="0"
                                         Background="Transparent"
                                         ItemTemplate="{StaticResource UserResultTemplate}"
                                         SelectionChanged="OnUserPicked"/>
                            </slate:SlateBorder>
                            <TextBlock x:Name="InvitePickLabel" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="Pending invitations" Style="{StaticResource H3}" Margin="0,16,0,6"/>
                            <ItemsControl x:Name="InviteList" ItemTemplate="{StaticResource InviteRowTemplate}"/>
                            <TextBlock x:Name="InviteEmptyLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed" TextWrapping="Wrap"
                                       Text="No invitation is waiting for an answer."/>

                            <Border Style="{StaticResource ShareNoteBox}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="RevokeLinkButton" Content="Revoke link"
                                                    Padding="10,3" FontSize="11" Margin="8,0,0,0"
                                                    Click="OnRevokeShareLink"/>
                                            <Button x:Name="CopyLinkButton" Padding="10,3" FontSize="11"
                                                    Margin="8,0,0,0" Click="OnCopyShareLink">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource IconFont}"
                                                               FontSize="12" Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Copy share link" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="Share link" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ShareLinkLabel" Style="{StaticResource Caption}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ WHAT WILL SYNC ══ The exact file set before Upload, including the files
                    that are held back.  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="RulesButton" Padding="12,4"
                                        VerticalAlignment="Center" Click="OnEditRules">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E1;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Rules..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="SyncTotalLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="What will sync" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock x:Name="SyncExplainLabel" Style="{StaticResource Caption}"
                                       Margin="0,2,0,10" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="SharedFilesList" ItemTemplate="{StaticResource SyncFileRowTemplate}"/>
                            <TextBlock x:Name="SharedFilesMoreLabel" Style="{StaticResource Caption}"
                                       Margin="0,6,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="Collapsed"/>

                            <Border x:Name="PrivatePanel" Style="{StaticResource ShareNoteBox}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE946;"
                                                   FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                   Margin="0,0,9,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource InfoBlueBrush}"/>
                                        <TextBlock x:Name="PrivateLabel" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <ItemsControl x:Name="PrivateList" Margin="22,6,0,0"
                                                  ItemTemplate="{StaticResource SyncFileRowTemplate}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ UPLOAD AND DOWNLOAD ══  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Upload and download" Style="{StaticResource H3}"/>
                            <TextBlock x:Name="LastUploadLabel" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SyncStateLabel" Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>

                            <!--  Shown on a 409: what differs from the server, with a way to
                            resolve it.  -->
                            <Border x:Name="ConflictPanel" Style="{StaticResource ShareWarnBox}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;"
                                                   FontFamily="{DynamicResource IconFont}" FontSize="14"
                                                   Margin="0,0,9,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="This instance changed on the server"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock x:Name="ConflictSummaryLabel" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl x:Name="ConflictList" Margin="22,8,0,0"
                                                  ItemTemplate="{StaticResource ConflictRowTemplate}"/>
                                    <TextBlock x:Name="ConflictMoreLabel" Style="{StaticResource Caption}"
                                               Margin="22,6,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                                               Visibility="Collapsed"/>
                                    <TextBlock x:Name="ConflictAdviceLabel" Style="{StaticResource Caption}"
                                               Margin="22,8,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="22,10,0,0">
                                        <Button x:Name="ConflictDownloadButton" Content="Download the server's copy first"
                                                Padding="12,4" Click="OnResolveConflict"/>
                                        <Button Content="Dismiss" Padding="12,4" Margin="8,0,0,0"
                                                Click="OnDismissConflict"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Expander x:Name="LogExpander" Header="Transfer log" Margin="0,12,0,0"
                                      Visibility="Collapsed">
                                <TextBox x:Name="LogBox" IsReadOnly="True" MaxHeight="160"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                         Background="{DynamicResource Surface1Brush}" Margin="0,8,0,0"/>
                            </Expander>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ ACTIVITY ══  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Recent activity" Style="{StaticResource H3}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap"
                                       Text="Who shared this with whom, who uploaded, and when. Downloads are not recorded."/>
                            <ItemsControl x:Name="ActivityList" ItemTemplate="{StaticResource ActivityRowTemplate}"/>
                            <TextBlock x:Name="ActivityEmptyLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  ══ HANDING IT OVER ══  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Hand this instance to someone else" Style="{StaticResource H3}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                                       Text="The new owner takes over its files, its storage quota and who may change it. You stay on with full access. They have to be on the list above already."/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" x:Name="TransferButton" Padding="12,4"
                                        Margin="8,0,0,0" Click="OnTransferOwnership">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D7;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Transfer ownership..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ComboBox x:Name="TransferTargetBox" Width="240" HorizontalAlignment="Left"
                                          DisplayMemberPath="Username"/>
                            </DockPanel>
                        </StackPanel>
                    </slate:SlateBorder>
                </StackPanel>
            </ScrollViewer>

            <v:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!--  Row 2: status bar.  -->
        <Border Grid.Row="2" Style="{StaticResource PageStatusBar}" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="OfflineLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Visibility="Collapsed"
                           Foreground="{DynamicResource WarningBrush}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <ProgressBar x:Name="BusyBar" Width="140" Height="4" IsIndeterminate="True"
                                 Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="BusyCancelButton" Content="Cancel" Padding="10,3" FontSize="11"
                            Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
