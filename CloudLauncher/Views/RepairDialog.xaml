<Window x:Class="CloudLauncher.Views.RepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        Title="Repair CloudLauncher" Height="380" Width="500"
        MinHeight="280" MinWidth="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="Some of CloudLauncher's files are missing"
                   TextWrapping="Wrap" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" x:Name="MessageLabel" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <slate:SlateBorder Grid.Row="2" x:Name="FilesCard" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="FilesLabel" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </ScrollViewer>
        </slate:SlateBorder>

        <StackPanel Grid.Row="3" x:Name="ProgressArea" Visibility="Collapsed" Margin="0,0,0,8">
            <ProgressBar x:Name="DownloadBar" Height="6" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="ProgressLabel" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" x:Name="WebsiteButton" Content="Open website"
                    Style="{StaticResource AccentButton}" Visibility="Collapsed" Click="OnOpenWebsite"/>
            <Button DockPanel.Dock="Right" x:Name="RepairButton" Content="Repair"
                    Style="{StaticResource AccentButton}" IsDefault="True" Click="OnRepair"/>
            <Button DockPanel.Dock="Right" x:Name="LaterButton" Content="Not now"
                    IsCancel="True" Click="OnLater" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</Window>
