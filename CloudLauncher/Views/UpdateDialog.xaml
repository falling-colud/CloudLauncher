<Window x:Class="CloudLauncher.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface1Brush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="Update available" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="1" x:Name="VersionLabel" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesLabel" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" x:Name="ProgressArea" Visibility="Collapsed" Margin="0,0,0,8">
            <ProgressBar x:Name="DownloadBar" Height="6" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="ProgressLabel" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" x:Name="UpdateButton" Content="Update now"
                    Style="{StaticResource AccentButton}" IsDefault="True" Click="OnUpdate"/>
            <Button DockPanel.Dock="Right" x:Name="LaterButton" Content="Later"
                    IsCancel="True" Click="OnLater" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</Window>
