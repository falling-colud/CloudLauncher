<UserControl x:Class="CloudLauncher.Views.FileCleanupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:v="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <UserControl.Resources>
        <!-- One file offered for deletion: path on the left, size and tick on the right.
        A resource because every sweep group has its own ItemsControl. -->
        <DataTemplate x:Key="SweepRowTemplate">
            <DockPanel Margin="0,3">
                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,2,0"
                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          IsEnabled="{Binding CanDelete}"
                          ToolTip="{Binding CheckHint}" ToolTipService.ShowOnDisabled="True"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}" Style="{StaticResource Caption}"
                           Width="72" TextAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayPath}" FontFamily="{DynamicResource MonoFont}"
                               FontSize="11" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FullPath}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding NoteVisibility}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Row 0 - what this tab is, plus the two utilities.  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="OpenFolderButton" Style="{StaticResource ToolbarIconButton}"
                        Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                        Click="OnOpenFolder" ToolTip="Open the instance folder"/>
                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarIconButton}" Margin="0"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        Click="OnRefresh" ToolTip="Re-measure this instance (F5)"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Where the disk went, and what is safe to delete"
                           Style="{StaticResource H3}"/>
                <TextBlock x:Name="SubLabel" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!--  Row 1 - content. PageStateView is last so it draws over the cards.  -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          anim:Animate.SmoothScroll="True">
                <StackPanel Margin="0,0,10,0">

                    <!--  DISK USAGE  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="UsageTotalLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="Where the space went" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                       Text="Every folder in this instance, measured recursively. game/ is broken down one level further because it is almost always the bulk."/>
                            <ItemsControl x:Name="UsageList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                                           Style="{StaticResource Caption}" Width="86"
                                                           TextAlignment="Right"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding FileCountLabel}"
                                                           Style="{StaticResource Caption}" Width="96"
                                                           TextAlignment="Right"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource MonoFont}"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <!-- A ProgressBar rather than star-width columns: a binding
                                            on ColumnDefinition.Width inside a DataTemplate fails
                                            silently (it's a FrameworkContentElement). -->
                                            <ProgressBar Grid.Row="1" Height="6" Margin="0,5,0,0"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         IsIndeterminate="False"
                                                         Background="{DynamicResource Surface1Brush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  SWEEPS: junk, orphans, duplicates  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="SweepTotalLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="What can go" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12"
                                       Text="Nothing here is ticked for you. Open a group to see exactly which files it means and untick the ones you want to keep."/>

                            <ItemsControl x:Name="SweepList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,7" HorizontalContentAlignment="Stretch"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                                               Style="{StaticResource Caption}" Width="86"
                                                               TextAlignment="Right" VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"/>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Style="{StaticResource Caption}"
                                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Expander.Header>
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Content="Tick all" Style="{StaticResource LinkButton}"
                                                                FontSize="11" Margin="0,0,10,0"
                                                                Click="OnSweepSelectAll"/>
                                                        <Button Content="None" Style="{StaticResource LinkButton}"
                                                                FontSize="11" Click="OnSweepSelectNone"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SelectionLabel}"
                                                               Style="{StaticResource Caption}"
                                                               FontWeight="Normal" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding Rows}"
                                                              ItemTemplate="{StaticResource SweepRowTemplate}"/>
                                                <TextBlock Text="{Binding MoreLabel}" Style="{StaticResource Caption}"
                                                           FontWeight="Normal" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding MoreVisibility}"/>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoSweepsLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed"
                                       Text="Nothing to sweep - no temporary files, no logs, no leftovers from a sync."/>

                            <!-- Finding duplicates reads the whole instance, so it only runs
                            on request. -->
                            <slate:SlateBorder Margin="0,10,0,0" CornerRadius="8" Padding="12,10"
                                    Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Button x:Name="DuplicatesButton" DockPanel.Dock="Right"
                                            Style="{StaticResource HeaderActionButton}" Margin="10,0,0,0"
                                            Click="OnFindDuplicates" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Find duplicates" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Duplicate files" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock x:Name="DuplicatesHint" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </slate:SlateBorder>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  BACKUPS  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,4">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="BackupTotalLabel" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="Backups" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap"
                                       Text="Every .bak- copy the launcher has written, newest first by the time stamped into its name. Restoring one backs up the file as it stands now, so a restore is itself reversible."/>
                            <ItemsControl x:Name="BackupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,0,0,7" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                                               Style="{StaticResource Caption}" Width="86"
                                                               TextAlignment="Right" VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}"/>
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Style="{StaticResource Caption}"
                                                                   FontWeight="Normal" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel Margin="0,3">
                                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                                                      Margin="10,0,2,0"
                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                      IsEnabled="{Binding CanDelete}"
                                                                      ToolTip="{Binding CheckHint}"
                                                                      ToolTipService.ShowOnDisabled="True"/>
                                                            <Button DockPanel.Dock="Right" Content="Restore"
                                                                    Padding="10,3" FontSize="11"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    IsEnabled="{Binding CanDelete}"
                                                                    ToolTip="{Binding RestoreHint}"
                                                                    ToolTipService.ShowOnDisabled="True"
                                                                    Click="OnRestoreBackup"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                                                       Style="{StaticResource Caption}" Width="72"
                                                                       TextAlignment="Right" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Note}" FontSize="12"/>
                                                                <TextBlock Text="{Binding DisplayPath}"
                                                                           Style="{StaticResource Caption}"
                                                                           FontFamily="{DynamicResource MonoFont}"
                                                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoBackupsLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed"
                                       Text="No backups in this instance yet. One is written every time the launcher overwrites a file for you."/>
                        </StackPanel>
                    </slate:SlateBorder>
                </StackPanel>
            </ScrollViewer>

            <v:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!--  Row 2 - the receipt, and the one destructive action.  -->
        <Border Grid.Row="2" Style="{StaticResource PageStatusBar}" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionLabel" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                            Content="Delete ticked files..." Padding="14,5" IsEnabled="False"
                            Click="OnDeleteChecked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BusyBar" Width="140" Height="4" IsIndeterminate="True"
                                 Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="BusyCancelButton" Content="Cancel" Padding="10,3" FontSize="11"
                            Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
