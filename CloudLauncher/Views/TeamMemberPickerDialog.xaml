<Window x:Class="CloudLauncher.Views.TeamMemberPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a member" Height="420" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="22">
        <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"
                   Text="Choose a member" Margin="0,0,0,8"/>
        <TextBlock x:Name="DescriptionLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Choose"
                    Style="{StaticResource AccentButton}" Click="OnApply" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancel" IsCancel="True"/>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                MinHeight="34" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="11,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center" Margin="0,0,10,0" TextChanged="OnSearch"
                         PreviewKeyDown="OnSearchKeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>
        </Border>

        <Grid>
            <ListBox x:Name="MemberList" MouseDoubleClick="OnListDoubleClick"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding JoinedLabel}"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyLabel" Style="{StaticResource Muted}" Visibility="Collapsed"
                       Text="Nobody matches that search."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
        </Grid>
    </DockPanel>
</Window>
