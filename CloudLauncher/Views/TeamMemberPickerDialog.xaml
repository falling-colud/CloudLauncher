<UserControl x:Class="CloudLauncher.Views.TeamMemberPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls">
    <!--  One people picker for both jobs: choosing a current member (to hand the team over) and
    finding someone who is not on the team yet (to invite them).  -->
    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="440" MaxHeight="560">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"/>
            <TextBlock x:Name="DescriptionLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                       TextWrapping="Wrap" Margin="0,4,0,12"/>

            <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SubtleButton}"
                            Click="OnCancel" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Content="Choose" Style="{StaticResource AccentButton}"
                            Click="OnApply" IsDefault="True"/>
                </StackPanel>
            </Grid>

            <!--  Role only matters for invitations; only an owner can make someone an admin.  -->
            <DockPanel x:Name="RoleRow" DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Left" Text="Joins as" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="RoleBox" SelectedIndex="0"
                          ToolTip="An admin can invite people and remove ordinary members. Ownership is handed over separately.">
                    <ComboBoxItem Content="Member - can see what the team can see"/>
                    <ComboBoxItem Content="Admin - can also invite and remove members"/>
                </ComboBox>
            </DockPanel>

            <slate:SlateBorder DockPanel.Dock="Top" Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    MinHeight="34" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="11,0,8,0"/>
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="SearchPlaceholder" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Grid>
            </slate:SlateBorder>

            <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" MinHeight="180">
                <Grid>
                    <ListBox x:Name="PeopleList" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="OnListDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,3">
                                    <slate:SlateBorder DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="13"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </slate:SlateBorder>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Shows "Searching..." while a search runs, not an empty-result message.  -->
                    <TextBlock x:Name="ListNote" Style="{StaticResource Muted}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </slate:SlateBorder>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
