<Page x:Class="CloudLauncher.Views.PackDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:local="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Instance"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════ HERO ════════════ -->
        <slate:SlateBorder Grid.Row="0" Panel.ZIndex="1" Style="{StaticResource ElevatedCard}"
                Margin="24,18,24,16" Padding="24">
            <DockPanel LastChildFill="True">
                <slate:SlateBorder Width="72" Height="72" DockPanel.Dock="Left" Margin="0,0,18,0"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock x:Name="HeroIconFallback" Style="{StaticResource H1}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="HeroIconImage" Stretch="UniformToFill"/>
                        <!-- Owner-only: left-click to pick a custom cover, right-click to change/remove. -->
                        <Button x:Name="HeroIconEditButton" Click="OnChangeImage"
                                Visibility="Collapsed" Cursor="Hand" ToolTip="Change image"
                                Background="Transparent" BorderThickness="0" Padding="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="HoverScrim" Background="#A6000000" Opacity="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="18" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Change" FontSize="10" Foreground="White"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Change image..." Click="OnChangeImage"/>
                                    <MenuItem x:Name="RemoveImageMenuItem" Header="Remove image" Click="OnRemoveImage"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </slate:SlateBorder>
                <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <ItemsControl x:Name="HeroTags" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <slate:SlateBorder Style="{StaticResource Pill}" Background="{Binding Background}"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource PillText}"
                                               Foreground="{Binding Foreground}"/>
                                </slate:SlateBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="RenameInstanceButton"
                            DockPanel.Dock="Right"
                            Style="{StaticResource IconButton}"
                            Click="OnRenameInstance"
                            Content="&#xE70F;"
                            FontFamily="{DynamicResource IconFont}"
                            FontSize="13"
                            ToolTip="Rename instance"
                            Visibility="Collapsed"
                            Margin="8,0,0,0"/>
                    <TextBlock x:Name="PackNameLabel" Style="{StaticResource H1}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock x:Name="PackVersionLabel" Style="{StaticResource Body}"
                           Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"/>
                <TextBlock x:Name="PackMetaLabel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                <TextBlock x:Name="PackStatsLabel" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                <TextBlock x:Name="PackSummaryLabel" Style="{StaticResource Body}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,12,0,0" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Progress strip - visible during downloads, install or launch -->
                <Grid x:Name="ProgressArea" Margin="0,18,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressLabel" Text="Working..."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock x:Name="ProgressPercent" Grid.Column="1"
                                   Text="" Foreground="{DynamicResource AccentTextBrush}"
                                   FontWeight="SemiBold" FontSize="12"/>
                    </Grid>
                    <ProgressBar x:Name="DetailProgressBar" Grid.Row="1"
                                 Style="{StaticResource DetailProgressBar}"
                                 Maximum="100" Value="0"/>
                    <Grid x:Name="CurrentProgressHeader" Grid.Row="2" Margin="0,8,0,6"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentProgressLabel"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock x:Name="CurrentProgressPercent" Grid.Column="1"
                                   Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" FontSize="11"/>
                    </Grid>
                    <ProgressBar x:Name="DetailCurrentProgressBar" Grid.Row="3"
                                 Height="4" Maximum="100" Value="0"
                                 Visibility="Collapsed"/>
                </Grid>

                <!-- Action row -->
                <!--  Two groups: left is play and where it is on disk, right is managing the instance.  -->
                <!--  Row 3 stays empty until the card is narrow; then LayoutHeroActions moves the file
                actions into it, under Play.  -->
                <Grid x:Name="HeroActionsGrid" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <!--  Row 0, top-aligned like the file column beside it, so Play sits right under the
                meta lines rather than at the bottom of the card.  -->
                <WrapPanel x:Name="HeroPlayRow" Grid.Column="0" Grid.Row="0" VerticalAlignment="Top">
                    <!-- While a transfer is running these take the Play slot, since the instance can't be
                    played yet. -->
                    <Button x:Name="PauseJobButton" Style="{StaticResource PlayButton}" Click="OnPauseJob"
                            MinWidth="160" Margin="0,0,10,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseJobIcon" Text="&#xE769;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="14"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="PauseJobText" Text="Pause"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopJobButton" Style="{StaticResource DangerButton}" Click="OnStopJob"
                            Margin="0,0,10,10" Visibility="Collapsed"
                            ToolTip="Stop the transfer and remove the files it downloaded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="StopJobText" Text="Stop" VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LaunchButton" Style="{StaticResource PlayButton}" Click="OnLaunch"
                            MinWidth="160" Margin="0,0,10,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LaunchButtonIcon" Text="&#xE768;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="14"
                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="LaunchButtonText" Text="Play"
                                       VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateButton" Click="OnDownload"
                            ToolTip="Download the latest version from CloudLauncher"
                            Visibility="Collapsed" Margin="0,0,10,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateButtonGlyph" Text="&#xE777;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock x:Name="UpdateButtonText" Text="Update available" VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>
                    </Button>
                    <!-- Shown only while this instance's server is running. Opens File Management > Hosting,
                    where the server is started and stopped. -->
                    <Button x:Name="ServerStatusChip" Click="OnOpenServerHosting"
                            Visibility="Collapsed" Margin="0,0,10,10"
                            ToolTip="Open this instance's server console">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ServerStatusChipGlyph" Text="&#xE968;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ServerStatusChipText" Text="Server running"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!--  Beside Play, and the only other accent button on the card.  -->
                    <Button x:Name="OverviewModHubButton" Style="{StaticResource AccentButton}"
                            Click="OnOpenModHub" Margin="0,0,10,10"
                            ToolTip="Mods, categories, the planning board and bulk updates for this instance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="OverviewModHubGlyph" Text="&#xE8FD;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OverviewModHubText" Text="Manage modpack"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!--  File actions stacked in one column: Export, Open folder, Manage files. Spans every
                row and hangs from the top beside Play. The buttons share one width (the StackPanel
                stretches them) and are a size smaller than Play to keep the column short.  -->
                <StackPanel x:Name="FileActionsStack" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <!--  Export hands the whole instance to another launcher as a CurseForge .zip or
                         a Modrinth .mrpack.  -->
                    <Button x:Name="ExportPackButton" Click="OnExportPack" Margin="0,0,0,6"
                            MinHeight="30" Padding="12,5"
                            HorizontalContentAlignment="Center" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Save this instance as a CurseForge .zip or Modrinth .mrpack that other launchers can install">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFolderButton"
                            Click="OnOpenPackFolder" Margin="0,0,0,6"
                            MinHeight="30" Padding="12,5"
                            HorizontalContentAlignment="Center"
                            ToolTip="Open this instance&apos;s game folder in Explorer (mods, config, saves, kubejs...)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Open folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditFilesButton"
                            Click="OnEditPackFiles" Margin="0,0,0,10"
                            MinHeight="30" Padding="12,5"
                            HorizontalContentAlignment="Center"
                            ToolTip="Browse, edit, share and clean up this instance&apos;s files">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Manage files" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>
                </StackPanel>
            </DockPanel>
        </slate:SlateBorder>

        <!-- ════════════ TABS ════════════ -->
        <TabControl x:Name="DetailTabs" Grid.Row="1" Margin="24,0,24,0" Padding="0,12,0,0"
                    Background="Transparent" BorderThickness="0"
                    SelectionChanged="OnDetailTabChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="20,7"/>
                </Style>
            </TabControl.Resources>

            <!-- OVERVIEW -->
            <TabItem Header="Overview">
                <Grid Margin="2,0,2,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="OverviewSummarySection" Grid.Row="0">
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock x:Name="OverviewSaveStatusLabel"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBlock x:Name="OverviewSummaryCountLabel"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Summary" Style="{StaticResource H3}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBox x:Name="OverviewSummaryBox"
                                     MaxLength="2048"
                                     MaxHeight="96"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Margin="0,0,0,12"
                                     TextChanged="OnOverviewSummaryChanged"
                                     LostFocus="OnOverviewSummaryLostFocus">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Background="Transparent"
                                                                  Focusable="False"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <Border x:Name="OverviewSummaryDivider"
                                Grid.Row="1"
                                Height="1"
                                Background="{DynamicResource BorderBrush}"/>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel x:Name="OverviewDescriptionHeader" Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ImportDescriptionButton"
                                            Style="{StaticResource IconButton}" Click="OnImportDescription"
                                            Content="&#xE8E5;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                            ToolTip="Import description from a file (Markdown or HTML, including commands)"/>
                                    <Button x:Name="ExportDescriptionButton"
                                            Style="{StaticResource IconButton}" Click="OnExportDescription"
                                            Content="&#xE74E;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                            ToolTip="Export description to a file (Markdown, including commands)"/>
                                </StackPanel>
                                <TextBlock Text="Description" Style="{StaticResource H3}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>

                            <slate:SlateBorder Grid.Row="1"
                                    CornerRadius="12"
                                    ClipToBounds="True"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Border x:Name="OverviewDescriptionHost"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Surface0Brush}"
                                        Visibility="Visible">
                                    <local:RichDescriptionEditor x:Name="OverviewDescriptionEditor"/>
                                </Border>
                            </slate:SlateBorder>
                        </Grid>
                    </Grid>

                    <DockPanel Grid.Row="1" Margin="0,12,0,8">
                        <TextBlock x:Name="OverviewCharacterCountLabel" DockPanel.Dock="Right"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- MODS -->
            <TabItem Header="Mods">
                <local:ModListView x:Name="ModListCtrl"/>
            </TabItem>

            <!-- RESOURCES -->
            <TabItem Header="Resources">
                <local:ResourcePackListView x:Name="ResourcePackListCtrl"/>
            </TabItem>

            <!-- SCREENSHOTS -->
            <TabItem Header="Screenshots">
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <slate:SlateBorder Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Click="OnOpenPackScreenshotsFolder" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRefreshPackScreenshots" Style="{StaticResource IconButton}"
                                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                        ToolTip="Refresh screenshots"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Screenshots" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PackScreenshotCountLabel" Style="{StaticResource Caption}"
                                           Text="Minecraft screenshots from this instance."/>
                            </StackPanel>
                        </DockPanel>
                    </slate:SlateBorder>

                    <Grid Grid.Row="1">
                        <TextBlock x:Name="PackScreenshotsEmptyText" Style="{StaticResource Muted}"
                                   Text="No screenshots yet. Press F2 in Minecraft to capture one."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" anim:Animate.SmoothScroll="True">
                            <ItemsControl x:Name="PackScreenshotList" anim:Animate.EntranceStagger="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <slate:SlateBorder Width="230" Margin="0,0,12,12" Style="{StaticResource Card}" Padding="8"
                                                Cursor="Hand" ToolTip="{Binding ToolTipText}"
                                                anim:Animate.HoverLift="True"
                                                MouseLeftButtonUp="OnOpenPackScreenshot">
                                            <slate:SlateBorder.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Click="OnScreenshotOpen">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy image" Click="OnScreenshotCopyImage"
                                                              ToolTip="Put the picture itself on the clipboard, ready to paste into Discord">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy file path" Click="OnScreenshotCopyPath"/>
                                                    <Separator/>
                                                    <MenuItem Header="Reveal in Explorer" Click="OnScreenshotReveal">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Set as instance image" Click="OnScreenshotSetAsIcon"
                                                              IsEnabled="{Binding CanSetAsIcon}"
                                                              ToolTip="Use this screenshot as the instance's cover art">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xEB9F;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Rename..." Click="OnScreenshotRename">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Delete..." Click="OnScreenshotDelete"
                                                              Foreground="{DynamicResource DangerBrush}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                                       Foreground="{DynamicResource DangerBrush}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </slate:SlateBorder.ContextMenu>
                                            <StackPanel>
                                                <slate:SlateBorder Height="124" Background="{DynamicResource Surface0Brush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                    <!-- Thumbnail, not ImageUrl: binding the file directly would decode every 4K
                                                    capture at full size for a 230px card. -->
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </slate:SlateBorder>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                           FontWeight="SemiBold" Margin="0,6,0,0"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </slate:SlateBorder>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- WORLDS -->
            <TabItem x:Name="WorldsTab" Header="Worlds">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,0">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="640"
                                       HorizontalAlignment="Left"
                                       Text="Saves inside this instance's game/saves folder. Use the compatibility editor to let other instances launch them."/>
                        </DockPanel>
                        <ItemsControl x:Name="WorldsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <slate:SlateBorder Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}"
                                                        Content="&#xE8A7;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                        ToolTip="Open save folder"
                                                        Tag="{Binding Source.FolderPath}" Click="OnWorldOpenFolder"/>
                                                <Button Content="Compatibility..." Padding="14,6"
                                                        Margin="8,0,0,0"
                                                        Tag="{Binding Source.Key}" Click="OnWorldEditCompatibility"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <DockPanel>
                                                    <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding CompatibilityLabel}" Style="{StaticResource PillText}"/>
                                                    </slate:SlateBorder>
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </slate:SlateBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="WorldsEmptyLabel" Style="{StaticResource Caption}"
                                   Text="No saves yet. Launch the instance and create a world."
                                   HorizontalAlignment="Center" Margin="0,24,0,12"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="WorldCountLabel" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- FILES - always shown. It works on this PC's own instance folder, so it doesn't depend
            on publishing or on the server. -->
            <TabItem x:Name="FilesTab" Header="Files">
                <DockPanel Margin="0,0,0,0">
                    <!-- A summary of the folder and one accent button into the full page, like the Mods tab
                    does for Modpack Management. -->
                    <slate:SlateBorder DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                        <DockPanel>
                            <Button x:Name="OpenFileManagementButton" DockPanel.Dock="Right"
                                    Style="{StaticResource AccentButton}" Click="OnOpenFileManagement"
                                    VerticalAlignment="Center" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="File Management" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource H3}" Text="This instance's files"/>
                                <TextBlock x:Name="PackRootHint" Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="FileSummaryLabel" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </slate:SlateBorder>

                    <!-- Bottom action bar: Rules + Apply rules on the left, Upload on the right -->
                    <slate:SlateBorder DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,10" Margin="0,14,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="EditRulesButton" Click="OnEditRules"
                                        ToolTip="Configure auto-routing rules"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8E1;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Rules..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ApplyRulesButton" Content="Apply rules" Click="OnApplyRules"
                                        ToolTip="Move files matching rules"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Click="OnRefreshFiles" Style="{StaticResource IconButton}"
                                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                        ToolTip="Refresh file lists" Margin="0,0,6,0"/>
                                <Button x:Name="UploadButton" Style="{StaticResource AccentButton}"
                                        Click="OnUpload">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="UploadButtonGlyph" Text="&#xE898;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UploadButtonText" Text="Upload to CloudLauncher" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </slate:SlateBorder>

                    <!-- Main grid: game on left, shared on right. Stays here until File Management's Files
                    tab has its own browser. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- GAME card -->
                        <slate:SlateBorder Grid.Column="0"
                                Style="{StaticResource Card}" Padding="0">
                            <DockPanel>
                                <slate:SlateBorder DockPanel.Dock="Top"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,10" CornerRadius="10,10,0,0">
                                    <DockPanel>
                                        <slate:SlateBorder DockPanel.Dock="Left" Width="28" Height="28"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </slate:SlateBorder>
                                        <Button x:Name="OpenServerButton" DockPanel.Dock="Right"
                                                Style="{StaticResource IconButton}"
                                                Click="OnOpenServerOverride"
                                                ToolTip="Open server-override folder in Explorer"
                                                Padding="5,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="S" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="1,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="OpenLocalButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                Click="OnOpenGame" ToolTip="Open game folder in Explorer"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Game" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Live instance files"
                                                       Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </slate:SlateBorder>
                                <local:FolderView x:Name="GameView" Margin="6">
                                    <!--  Tag="sharing" marks the items that write sharing rules, so the code-behind can
                                    disable them for collaborators without upload rights. A Tag rather than x:Name
                                    because this ContextMenu is in the UserControl's name scope, where naming anything
                                    is build error MC3093.  -->
                                    <local:FolderView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit file" Click="OnEditSelectedGameFile">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy to shared"   Click="OnMoveGameToShared" Tag="sharing"/>
                                            <Separator/>
                                            <MenuItem Header="Add rule: > shared"  Click="OnQuickRuleShared" Tag="sharing"/>
                                            <MenuItem Header="Add rule: ignored"   Click="OnQuickRuleIgnored" Tag="sharing"/>
                                            <MenuItem Header="Add rule for parent folder" Click="OnQuickRuleFolder" Tag="sharing"/>
                                            <Separator/>
                                            <MenuItem Header="New folder..." Click="OnGameNewFolder">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8F4;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Rename..." InputGestureText="F2" Click="OnGameRename"/>
                                            <MenuItem Header="Copy full path" Click="OnGameCopyPath"/>
                                            <MenuItem Header="Reveal in Explorer" Click="OnRevealGame">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Delete..." InputGestureText="Del" Click="OnGameDelete"
                                                      Foreground="{DynamicResource DangerBrush}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </local:FolderView.ContextMenu>
                                </local:FolderView>
                            </DockPanel>
                        </slate:SlateBorder>

                        <!-- SHARED card -->
                        <slate:SlateBorder Grid.Column="2"
                                Style="{StaticResource Card}" Padding="0">
                            <DockPanel>
                                <slate:SlateBorder DockPanel.Dock="Top"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,10" CornerRadius="10,10,0,0">
                                    <DockPanel>
                                        <slate:SlateBorder DockPanel.Dock="Left" Width="28" Height="28"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                CornerRadius="6" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE753;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </slate:SlateBorder>
                                        <Button x:Name="OpenSharedButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                                Click="OnOpenShared" ToolTip="Open shared folder in Explorer"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Shared" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="Synced with CloudLauncher"
                                                       Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </slate:SlateBorder>
                                <local:FolderView x:Name="SharedView" Margin="6">
                                    <local:FolderView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remove from shared" Click="OnMoveSharedToGame" Tag="sharing"
                                                      ToolTip="Stop uploading this file. It stays on this PC."/>
                                            <MenuItem Header="Edit file" Click="OnEditSelectedSharedFile">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Rename..." InputGestureText="F2" Click="OnSharedRename"/>
                                            <MenuItem Header="Copy full path" Click="OnSharedCopyPath"/>
                                            <MenuItem Header="Reveal in Explorer" Click="OnRevealShared">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Delete from disk..." InputGestureText="Del" Click="OnSharedDelete"
                                                      Foreground="{DynamicResource DangerBrush}"
                                                      ToolTip="Deletes the file itself, not just its shared rule">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </local:FolderView.ContextMenu>
                                </local:FolderView>
                            </DockPanel>
                        </slate:SlateBorder>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- OPTIONS -->
            <TabItem x:Name="OptionsTab" Header="Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,0" MaxWidth="640" HorizontalAlignment="Left">
                        <slate:SlateBorder x:Name="LoaderCard" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Mod loader" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Switch this instance to a different loader build. The new build is downloaded the next time you launch - your mods, worlds and configs stay where they are, but mods made for the old build may stop loading."
                                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Minecraft" Width="120"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="LoaderMcVersionLabel" VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Loader" Width="120"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox x:Name="PackLoaderBox" Width="220" HorizontalAlignment="Left"
                                              SelectionChanged="OnPackLoaderChanged">
                                        <ComboBoxItem Content="None (vanilla)" Tag="None"/>
                                        <ComboBoxItem Content="Fabric" Tag="Fabric"/>
                                        <ComboBoxItem Content="Forge" Tag="Forge"/>
                                        <ComboBoxItem Content="NeoForge" Tag="NeoForge"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="PackLoaderVersionRow" Margin="0,0,0,14">
                                    <TextBlock DockPanel.Dock="Left" Text="Version" Width="120"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox x:Name="PackLoaderVersionBox" Width="220" HorizontalAlignment="Left"
                                              SelectionChanged="OnPackLoaderVersionChanged"/>
                                </DockPanel>
                                <DockPanel>
                                    <Button x:Name="ApplyLoaderButton" DockPanel.Dock="Left"
                                            Content="Apply loader change" Click="OnApplyLoaderChange"
                                            Style="{StaticResource AccentButton}" IsEnabled="False"/>
                                    <TextBlock x:Name="LoaderStatusLabel" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </slate:SlateBorder>

                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Memory" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Maximum RAM allocated to Minecraft when launching this instance."
                                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <DockPanel>
                                    <TextBlock x:Name="RamValueLabel" DockPanel.Dock="Right"
                                               Text="4096 MB" MinWidth="96" TextAlignment="Right"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                    <Slider x:Name="RamSlider" Minimum="1024" Maximum="32768"
                                            TickFrequency="512" IsSnapToTickEnabled="True"
                                            Value="4096" ValueChanged="OnRamChanged"
                                            LostMouseCapture="OnRamCommit" KeyUp="OnRamKeyUp"
                                            VerticalAlignment="Center" Margin="0,0,16,0"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Extra JVM arguments (advanced) - added on top of the stock flags, e.g. -D system properties. Applied on the next launch."
                                           TextWrapping="Wrap" Margin="0,16,0,6"/>
                                <TextBox x:Name="JvmArgsBox" FontFamily="Consolas"
                                         LostFocus="OnJvmArgsCommit" KeyUp="OnJvmArgsKeyUp"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Java" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Which Java runs this instance (and its server). Automatic picks the version this Minecraft release needs and downloads it if it is missing; choose a specific installation only when a mod asks for another one."
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Runtime" Width="120"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox x:Name="JavaBox" DisplayMemberPath="Label"
                                              SelectionChanged="OnJavaChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="JavaHint" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <slate:SlateBorder x:Name="AutoUpdateCard" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Auto-update" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Pull the latest shared files from CloudLauncher every time before you launch."
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <CheckBox x:Name="AutoUpdateBox"
                                          Content="Auto-update before launch"
                                          Click="OnAutoUpdateToggled"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <!-- An instance on this PC only has no sharing options; this says why and offers the
                             step that brings them (see LocalInstanceNote). -->
                        <ContentControl x:Name="LocalInstanceHost" Focusable="False" IsTabStop="False"
                                        Visibility="Collapsed"/>

                        <StackPanel x:Name="SharingOptionsPanel">
                            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3}" Text="Who can see this instance" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Private hides it from everyone but you and the people you invite. Team shows it to your teammates. Public lists it for everyone on this server in Browse; they can download it once it is published below."
                                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="Visibility" Width="120"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="VisibilityBox" Width="220"
                                                  SelectionChanged="OnVisibilityChanged"
                                                  HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Private"/>
                                            <ComboBoxItem Content="Team"/>
                                            <ComboBoxItem Content="Public"/>
                                        </ComboBox>
                                    </DockPanel>
                                </StackPanel>
                            </slate:SlateBorder>

                            <!-- Publishes the instance to the CloudLauncher backend so collaborators get the same
                            files. Unrelated to the Minecraft server. -->
                            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3}" Text="Cloud sync" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Publishing puts this instance on CloudLauncher, so the files you mark shared travel between you and your collaborators. It does not make it public: that is 'Who can see this instance', above. This is not a Minecraft server - running one from this instance lives in File Management > Hosting."
                                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <CheckBox x:Name="IsSharedBox"
                                              Content="Publish this instance to CloudLauncher"
                                              Click="OnIsSharedToggled"/>
                                </StackPanel>
                            </slate:SlateBorder>

                            <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H3}" Text="Collaborators" Margin="0,0,0,4"/>
                                    <TextBlock Style="{StaticResource Muted}"
                                               Text="Grant individual users or whole teams permission to view, download, or upload files."
                                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                                    <Button Content="Manage collaborators..." Click="OnEditPermissions"
                                            HorizontalAlignment="Left" Style="{StaticResource AccentButton}"/>
                                </StackPanel>
                            </slate:SlateBorder>
                        </StackPanel>

                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Minecraft window" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Override launcher defaults for this instance's custom Minecraft window."
                                           TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Left" Text="Launcher chrome" Width="150"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox x:Name="PackPageCollapsedBox" Width="250"
                                              SelectionChanged="OnPackPageCollapsedChanged">
                                        <ComboBoxItem Content="Use launcher default"/>
                                        <ComboBoxItem Content="Start visible"/>
                                        <ComboBoxItem Content="Start hidden"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="Borderless fullscreen" Width="150"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox x:Name="BorderlessFullscreenBox" Width="250"
                                              SelectionChanged="OnBorderlessFullscreenChanged">
                                        <ComboBoxItem Content="Use launcher default"/>
                                        <ComboBoxItem Content="Start windowed"/>
                                        <ComboBoxItem Content="Start fullscreen"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </slate:SlateBorder>

                        <slate:SlateBorder x:Name="AutoApplyRow" Style="{StaticResource Card}" Padding="22,18">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Auto-apply rules" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Re-run file routing rules every 30 seconds while this instance is open."
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>
                                <DockPanel>
                                    <CheckBox x:Name="AutoApplyBox"
                                              Content="Run file rules every 30s"
                                              Checked="OnAutoApplyToggled"
                                              Unchecked="OnAutoApplyToggled"/>
                                    <TextBlock x:Name="AutoApplyLabel" DockPanel.Dock="Right"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center"
                                               MinWidth="160" TextAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>
                        </slate:SlateBorder>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- LOGS - Minecraft logs inside game/logs/ + the sync log -->
            <TabItem Header="Logs">
                <DockPanel Margin="0,0,0,0">
                    <slate:SlateBorder DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                        <!-- Title, find + level, actions: one row when wide enough, two when not (LayoutLogHeader
                        moves the find row between the two slots). The buttons fold to icons when even the
                        title row is too narrow. -->
                        <Grid x:Name="LogHeaderGrid" SizeChanged="OnLogHeaderSizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <StackPanel x:Name="LogTitleBlock" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Logs" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LogsCountLabel" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <!-- Actions at the right edge, like the other headers. A WrapPanel with the -3/+3 margin
                                trick, so on a very narrow panel they wrap instead of overlapping the title. -->
                                <WrapPanel x:Name="LogActions" DockPanel.Dock="Right" Orientation="Horizontal"
                                           VerticalAlignment="Center" Margin="0,-3,0,-3">
                                    <Button x:Name="CopyLogButton" Click="OnCopyLog" Margin="0,3,8,3"
                                            ToolTip="Copy what is shown - with a filter on, that is the filtered lines only">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CopyLogLabel" Text="Copy" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SaveLogButton" Click="OnSaveLogAs" Margin="0,3,8,3"
                                            ToolTip="Save this log to a file you can attach to a bug report">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SaveLogLabel" Text="Save as..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnOpenLogsFolder" Margin="0,3,8,3"
                                            ToolTip="Open the folder the game writes its logs to">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="OpenLogsFolderLabel" Text="Open folder" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnRefreshLogs" Style="{StaticResource IconButton}" Margin="0,3,0,3"
                                            Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                            ToolTip="Refresh logs (F5)"/>
                                </WrapPanel>
                                <!-- Wide: the find row fills the gap between the title and the actions. -->
                                <Border x:Name="LogFilterWideSlot" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <!-- Find + level filter. The find box stretches between a usable minimum and a cap and
                                    takes room before the gap column, which keeps the line count and level box at the
                                    right edge. The level box is last so it stays put while the count text grows. -->
                                    <Grid x:Name="LogFilterRow" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100*" MinWidth="140" MaxWidth="340"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="LogFilterBox" Padding="26,3,7,3"
                                                     VerticalContentAlignment="Center"
                                                     TextChanged="OnLogFilterChanged"
                                                     KeyDown="OnLogFilterKeyDown"
                                                     ToolTip="Show only lines containing this text. Esc clears it."/>
                                            <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" Margin="9,0,0,0"
                                                       IsHitTestVisible="False"/>
                                            <TextBlock Text="Find in this log..." Margin="26,0,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=LogFilterBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock x:Name="LogLinesLabel" Grid.Column="2" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <ComboBox x:Name="LogLevelBox" Grid.Column="3" Width="150" Margin="10,0,0,0"
                                                  SelectionChanged="OnLogLevelChanged"
                                                  ToolTip="Narrow the log to the lines that report a problem">
                                            <ComboBoxItem Content="All lines" IsSelected="True"/>
                                            <ComboBoxItem Content="Warnings + errors"/>
                                            <ComboBoxItem Content="Errors only"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </DockPanel>
                            <!-- Narrow: the find row gets a line of its own under the title. -->
                            <Border x:Name="LogFilterNarrowSlot" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </slate:SlateBorder>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <slate:SlateBorder Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                            <ListBox x:Name="LogsList" SelectionChanged="OnLogsSelected"
                                     PreviewMouseRightButtonDown="OnLogsListRightButtonDown"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open in the editor" Click="OnLogOpenInEditor">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy contents" Click="OnLogCopyContents">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy path" Click="OnLogCopyPath"/>
                                        <Separator/>
                                        <MenuItem Header="Reveal in Explorer" Click="OnLogReveal">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Delete..." Click="OnLogDelete"
                                                  Foreground="{DynamicResource DangerBrush}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                           Foreground="{DynamicResource DangerBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="2,4">
                                            <!-- Icon colours come from triggers on the row's kind, not brushes stored in the
                                            row, so they follow theme changes. -->
                                            <slate:SlateBorder DockPanel.Dock="Left" Width="22" Height="22"
                                                    CornerRadius="4" Margin="0,0,8,0">
                                                <slate:SlateBorder.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Launcher">
                                                                <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="Sync">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Kind}" Value="CrashReport">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </slate:SlateBorder.Style>
                                                <TextBlock Text="{Binding IconGlyph}" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Launcher">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Sync">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="CrashReport">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </slate:SlateBorder>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </slate:SlateBorder>

                        <slate:SlateBorder Grid.Column="1" Background="{DynamicResource LogBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4">
                            <!-- Colour-coded by level (colours in Settings -> Colours). -->
                            <local:LogTextView x:Name="LogContent"/>
                        </slate:SlateBorder>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Hidden log buffer - content is exposed via the Logs tab. -->
        <TextBox x:Name="LogBox" Visibility="Collapsed" IsReadOnly="True" IsUndoEnabled="False"
                 AcceptsReturn="True" TextChanged="OnLogBoxTextChanged"/>

        <!-- Bottom status bar -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,8" Margin="0,12,0,0">
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
