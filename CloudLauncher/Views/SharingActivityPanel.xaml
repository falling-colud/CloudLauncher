<UserControl x:Class="CloudLauncher.Views.SharingActivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:v="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations"
             Background="Transparent">
    <UserControl.Resources>
        <!--  Implicit templates keyed on the row type: the feed is one list of two kinds of thing,
             a day heading and an entry, and WPF picks the right one per item without a selector.  -->
        <DataTemplate DataType="{x:Type v:ActivityDayHeader}">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource H3}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type v:ActivityRowView}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                           FontSize="12" Margin="0,1,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>

                <!--  The sentence, with the thing it is about as the one clickable part of it.
                     Split rather than linked separately so the line still reads as a sentence.  -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding Before}" VerticalAlignment="Center"/>
                    <!--  SemiBold rather than a colour: the implicit TextBlock style overrides
                    the foreground LinkButton gives string Content, so the accent never shows.  -->
                    <Button Style="{StaticResource LinkButton}" Content="{Binding SubjectName}"
                            FontWeight="SemiBold"
                            Click="OnSubjectClick" Visibility="{Binding SubjectVisibility}"
                            IsEnabled="{Binding CanOpenSubject}" ToolTip="{Binding SubjectHint}"
                            ToolTipService.ShowOnDisabled="True" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding After}" VerticalAlignment="Center"/>
                </WrapPanel>

                <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           ToolTip="{Binding ExactTime}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Row 0 - what this tab is.  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarIconButton}" Margin="0"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        Click="OnRefresh" ToolTip="Reload the feed (F5)"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleLabel" Text="What has been happening" Style="{StaticResource H3}"/>
                <TextBlock x:Name="SubLabel" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!--  Row 1 - scope and filter.  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackToMineButton" Grid.Column="0" Padding="12,5" Visibility="Collapsed"
                    Click="OnBackToMine" Content="Back to everything"/>
            <v:CompactSearchBox x:Name="SearchBox" Grid.Column="2" HorizontalAlignment="Right"
                                Placeholder="Filter this feed..."
                                SearchToolTip="Filter the feed (Ctrl+F)"/>
        </Grid>

        <!--  Row 2 - the feed.  -->
        <Grid Grid.Row="2">
            <slate:SlateBorder Style="{StaticResource Card}" Padding="18,4,18,14">
                <ScrollViewer x:Name="FeedScroller" VerticalScrollBarVisibility="Auto"
                              anim:Animate.SmoothScroll="True">
                    <StackPanel>
                        <ItemsControl x:Name="FeedList"/>
                        <Button x:Name="LoadMoreButton" Content="Show older" Margin="0,14,0,0"
                                Padding="14,5" HorizontalAlignment="Center" Visibility="Collapsed"
                                Click="OnLoadMore" ToolTipService.ShowOnDisabled="True"/>
                    </StackPanel>
                </ScrollViewer>
            </slate:SlateBorder>
            <v:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!--  Row 3 - the receipt.  -->
        <Border Grid.Row="3" Style="{StaticResource PageStatusBar}" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="BusyBar" Width="140" Height="4" IsIndeterminate="True"
                                 Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="BusyCancelButton" Content="Cancel" Padding="10,3" FontSize="11"
                            Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
