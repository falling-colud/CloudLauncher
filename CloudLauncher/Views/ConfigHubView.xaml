<Page x:Class="CloudLauncher.Views.ConfigHubView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      xmlns:v="clr-namespace:CloudLauncher.Views"
      Title="Config &amp; scripts"
      Background="{DynamicResource Surface0Brush}">
    <Page.Resources>
        <!-- One chip in the kind strip. Selection is themed here rather than on the row object so a
             live theme change repaints it; a Brush stored on the row would keep the old colour. -->
        <Style x:Key="KindChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="KindChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "same / differs / only here" badge on a file row. -->
        <Style x:Key="StateBadge" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateName}" Value="Differs">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateName}" Value="Identical">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateBadgeText" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateName}" Value="Differs">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateName}" Value="Identical">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
                <!-- Row 0 - title and subtitle; the actions live in the bar below, as on Instances. -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Config &amp; scripts"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Every instance's config, KubeJS scripts and default configs, side by side."/>
            </StackPanel>
        </DockPanel>

        <!-- Row 1 - actions left, search and the icon-only utilities right. -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-3,0,-3">
                <Button x:Name="SearchInFilesButton" Click="OnToggleContentSearch"
                        Style="{StaticResource AccentButton}" Margin="0,3,8,3"
                        ToolTip="Search inside every config and script across all instances at once">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SearchInFilesLabel" Text="Search in files" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HeaderActionButton}" Click="OnNewFile"
                        ToolTip="Create an empty config file or script in the selected instance" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New file..." VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <v:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0" Placeholder="Filter by name or folder"
                                    SearchToolTip="Filter by file name or folder (Ctrl+F)"/>
                <Button Style="{StaticResource HeaderIconButton}" Content="&#xE8DA;" Click="OnOpenFolder"
                        ToolTip="Open this instance's config folder in Explorer"/>
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}" Content="&#xE72C;"
                        Click="OnRefresh"
                        ToolTip="Re-read every file in every instance (F5). A remembered list can miss an edit that did not change a file's size."/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!-- Row 3 - sort first, then the one on/off filter, then which instance's files, then the
             kind chips: the same strip, in the same place, as the one under the Instances actions. -->
        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}" Click="OnSortButtonClick"
                        Content="&#xE8CB;" ToolTip="Sort the file list">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSortMenuOpened">
                            <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="Name"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortPathMenuItem" Header="Folder, then name" Tag="Path"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortModifiedMenuItem" Header="Last modified" Tag="Modified"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortSizeMenuItem" Header="Size" Tag="Size"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortDiffMenuItem" Header="Differences first" Tag="Diff"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ToggleButton x:Name="DiffersToggle" Style="{StaticResource ToolbarToggleButton}"
                              Content="&#xE71C;" Click="OnDiffersOnlyClick"
                              ToolTip="Show only files that differ between instances"/>
                <ComboBox x:Name="PackFilterBox" Width="240" Margin="8,0,0,0" VerticalAlignment="Center"
                          DisplayMemberPath="Label" SelectionChanged="OnPackFilterChanged"
                          ToolTip="Which instance's files to list. With 'All instances' every file is listed once, with a badge saying how many instances have it."/>
            </StackPanel>

            <ItemsControl x:Name="KindStrip" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource KindChip}" ToolTip="{Binding Hint}"
                                MouseLeftButtonUp="OnKindChipClick" Tag="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource KindChipText}"/>
                                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource KindChipText}"
                                           Margin="6,0,0,0" Opacity="0.75"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Content search bar: only visible while the user is grepping file contents. -->
        <slate:SlateBorder x:Name="ContentSearchBar" Grid.Row="4" Visibility="Collapsed"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="28,0,28,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                           FontSize="13" VerticalAlignment="Center" Margin="2,0,10,0"
                           Foreground="{DynamicResource AccentTextBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ContentSearchGoButton" Content="Search" Style="{StaticResource AccentButton}"
                            Click="OnRunContentSearch" Padding="14,4" Margin="8,0,0,0"/>
                    <Button x:Name="ContentSearchCancelButton" Content="Stop" Click="OnCancelContentSearch"
                            Padding="12,4" Margin="8,0,0,0" Visibility="Collapsed"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                            FontFamily="{DynamicResource IconFont}" FontSize="12" Margin="8,0,0,0"
                            Click="OnToggleContentSearch" ToolTip="Close the content search"/>
                </StackPanel>
                <TextBox x:Name="ContentQueryBox" VerticalAlignment="Center" Margin="0,0,8,0"
                         KeyDown="OnContentQueryKey"
                         ToolTip="Text to look for inside every config and script. Case-insensitive."/>
            </DockPanel>
        </slate:SlateBorder>

        <!-- File list + detail -->
        <Grid Grid.Row="5" Margin="28,0,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="380"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.35*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: the files -->
            <slate:SlateBorder Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             anim:Animate.SmoothScroll="True"
                             anim:Animate.EntranceStagger="True"
                             SelectionChanged="OnFileSelected"
                             MouseDoubleClick="OnFileDoubleClick"
                             PreviewKeyDown="OnFileListKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <slate:SlateBorder Padding="12,8" Margin="4,3" CornerRadius="8"
                                        Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <slate:SlateBorder.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit" Click="OnRowEdit">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE70F;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Compare across instances..." Click="OnRowCompare">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8EC;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy to other instances..." Click="OnRowCopyTo">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy the whole folder to other instances..." Click="OnRowCopyFolder"/>
                                            <Separator/>
                                            <MenuItem Header="Pin / unpin" Click="OnRowPin">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE718;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Show in Explorer" Click="OnRowReveal">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy full path" Click="OnRowCopyPath"/>
                                            <MenuItem Header="Restore a backup..." Click="OnRowRestoreBackup"/>
                                            <Separator/>
                                            <MenuItem Header="Rename..." Click="OnRowRename">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8AC;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Delete..." Click="OnRowDelete">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </slate:SlateBorder.ContextMenu>
                                    <DockPanel>
                                        <!-- Row actions live at the right edge. -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                    FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                    Click="OnRowEdit" Tag="{Binding}" ToolTip="Open in the editor"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8EC;"
                                                    FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                    Click="OnRowCompare" Tag="{Binding}"
                                                    Visibility="{Binding CompareVisibility}"
                                                    ToolTip="{Binding CompareHint}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                                    FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                    Click="OnRowCopyTo" Tag="{Binding}"
                                                    ToolTip="Copy this file into other instances"/>
                                            <Button Style="{StaticResource IconButton}" Content="{Binding PinGlyph}"
                                                    FontFamily="{DynamicResource IconFont}" FontSize="12"
                                                    Click="OnRowPin" Tag="{Binding}" ToolTip="{Binding PinHint}"/>
                                        </StackPanel>

                                        <slate:SlateBorder DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8"
                                                Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="13" Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </slate:SlateBorder>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                           Opacity="{Binding MissingOpacity}"/>
                                                <Border Style="{StaticResource StateBadge}"
                                                        Visibility="{Binding StateVisibility}"
                                                        ToolTip="{Binding StateHint}">
                                                    <TextBlock Text="{Binding StateLabel}"
                                                               Style="{StaticResource StateBadgeText}"/>
                                                </Border>
                                                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding ErrorVisibility}"
                                                           ToolTip="{Binding ErrorHint}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPathHint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </slate:SlateBorder>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Drawn over the list: the loading, empty, error and offline panels. -->
                    <v:PageStateView x:Name="PageStateHost"/>
                </Grid>
            </slate:SlateBorder>

            <!-- Right: the selected file -->
            <slate:SlateBorder Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DockPanel x:Name="DetailPanel" Margin="16,14,16,14" Visibility="Collapsed">
                        <DockPanel DockPanel.Dock="Top">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                                        Margin="10,0,0,0">
                                <Button Content="Edit" Style="{StaticResource AccentButton}" Click="OnDetailEdit"
                                        Padding="14,4" Margin="0,0,6,0"
                                        ToolTip="Open this file in the launcher's text editor"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8EC;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        x:Name="DetailCompareButton" Click="OnDetailCompare"
                                        ToolTip="Compare this file across instances"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        Click="OnDetailCopyTo" ToolTip="Copy into other instances"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8DA;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        Click="OnDetailReveal" ToolTip="Show in Explorer"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE712;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        Click="OnDetailMore" ToolTip="More actions">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy full path" Click="OnRowCopyPath"/>
                                            <MenuItem Header="Copy the whole folder to other instances..." Click="OnRowCopyFolder"/>
                                            <MenuItem Header="Restore a backup..." Click="OnRowRestoreBackup"/>
                                            <Separator/>
                                            <MenuItem Header="Rename..." Click="OnRowRename"/>
                                            <MenuItem Header="Delete..." Click="OnRowDelete"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="DetailName" Style="{StaticResource H3}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailPath" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock x:Name="DetailMeta" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- A KubeJS error that names this script. -->
                        <slate:SlateBorder x:Name="ErrorPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,12,0,0"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,9">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="KubeJS logged an error for this script"
                                               FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" FontFamily="Consolas"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <!-- Where else this file exists. -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                            <TextBlock x:Name="CopiesHeader" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ACROSS INSTANCES" FontWeight="SemiBold"/>
                            <ItemsControl x:Name="CopiesList" Margin="0,6,0,0" MaxHeight="180">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      anim:Animate.SmoothScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <slate:SlateBorder Padding="10,6" Margin="0,0,0,4" CornerRadius="6"
                                                Background="{DynamicResource Surface2Brush}">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="0,0,6,0"
                                                            ToolTip="{Binding StateHint}">
                                                        <TextBlock Text="{Binding StateLabel}"
                                                                   Style="{StaticResource PillText}"/>
                                                    </slate:SlateBorder>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE8EC;"
                                                            FontFamily="{DynamicResource IconFont}" FontSize="11"
                                                            Click="OnCopyCompare" Tag="{Binding}"
                                                            Visibility="{Binding CompareVisibility}"
                                                            ToolTip="Compare with the selected instance's copy"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                            FontFamily="{DynamicResource IconFont}" FontSize="11"
                                                            Click="OnCopyEdit" Tag="{Binding}"
                                                            ToolTip="Open this instance's copy in the editor"/>
                                                </StackPanel>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PackName}" FontSize="12"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </slate:SlateBorder>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Content search hits inside this file. -->
                        <StackPanel x:Name="HitsPanel" DockPanel.Dock="Top" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="HitsHeader" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ItemsControl x:Name="HitsList" Margin="0,6,0,0" MaxHeight="140">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      anim:Animate.SmoothScroll="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding LineLabel}"
                                                       Style="{StaticResource Caption}" Width="46"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Line}" FontFamily="Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Preview -->
                        <slate:SlateBorder Margin="0,14,0,0" CornerRadius="8" Padding="0"
                                Background="{DynamicResource LogBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="PreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource LogTextBrush}"
                                         FontFamily="Consolas" FontSize="12" Padding="12,10"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                                <TextBlock x:Name="PreviewNote" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </slate:SlateBorder>
                    </DockPanel>

                    <StackPanel x:Name="DetailPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="360">
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}" FontSize="26"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Style="{StaticResource H3}" Text="Pick a file" HorizontalAlignment="Center"
                                   Margin="0,10,0,6"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Select a config or script to preview it, see which other instances have it, and copy it across."/>
                    </StackPanel>
                </Grid>
            </slate:SlateBorder>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="6" Style="{StaticResource PageStatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- No Foreground: PageState colours this line (red for errors, then back). -->
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The count slot, in the same place as on the other pages. -->
                    <TextBlock x:Name="CountLabel" Style="{StaticResource Caption}"
                               VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BusyBar" Width="140" Height="4" IsIndeterminate="True"
                                 Visibility="Collapsed" Margin="12,0,8,0"/>
                    <!-- No Click here: PageState owns this button, and a markup handler as well
                         would request the cancel twice. -->
                    <Button x:Name="BusyCancelButton" Content="Cancel" Padding="10,3"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
