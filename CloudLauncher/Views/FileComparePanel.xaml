<UserControl x:Class="CloudLauncher.Views.FileComparePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:v="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <UserControl.Resources>
        <!--  One count chip. The selected look comes from the style, not the row, so a theme change
        repaints it.  -->
        <Style x:Key="StateChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Surface1Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Per-row verdict. Only identical (green) and changed (amber) get a colour. "Only here" and
        "only there" stay plain: they aren't warnings, and InfoBrush and InfoBlueBrush share one
        colour, so the two couldn't be told apart anyway.  -->
        <Style x:Key="VerdictBadge" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateName}" Value="Differs">
                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateName}" Value="Same">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VerdictBadgeText" TargetType="TextBlock" BasedOn="{StaticResource PillText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateName}" Value="Differs">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateName}" Value="Same">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Row 0 - what this tab is.  -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarIconButton}"
                    Margin="0" Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                    Click="OnRefresh" ToolTip="Compare again (F5)" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="How this instance differs from another" Style="{StaticResource H3}"/>
                <TextBlock x:Name="SubLabel" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </DockPanel>

        <!--  Row 1 - what is being compared against what.  -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Compare with" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="OtherBox" Grid.Column="1" DisplayMemberPath="Label"
                      SelectionChanged="OnOtherChanged"
                      ToolTip="The instance this one is measured against. Its files are the right-hand side of every diff."/>
            <TextBlock Grid.Column="2" Text="Looking at" Style="{StaticResource Caption}"
                       VerticalAlignment="Center" Margin="16,0,8,0"/>
            <ComboBox x:Name="ScopeBox" Grid.Column="3" DisplayMemberPath="Label"
                      SelectionChanged="OnScopeChanged"
                      ToolTip="Which part of the instance to compare. Narrower is faster - the whole tree reads every file that is the same size on both sides."/>
            <v:CompactSearchBox x:Name="SearchBox" Grid.Column="4" HorizontalAlignment="Right"
                                Placeholder="Filter by path..."
                                SearchToolTip="Filter this list by path (Ctrl+F)"/>
        </Grid>

        <!--  Row 2 - the verdict counts, which double as filters.  -->
        <ItemsControl x:Name="StateStrip" Grid.Row="2" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StateChip}" ToolTip="{Binding Hint}"
                            MouseLeftButtonUp="OnStateChipClick" Tag="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Style="{StaticResource StateChipText}"/>
                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource StateChipText}"
                                       Margin="6,0,0,0" Opacity="0.75"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Row 3 - the list on the left, the diff on the right.  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <slate:SlateBorder Style="{StaticResource Card}" Padding="0">
                    <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended" SelectionChanged="OnFileSelected"
                             anim:Animate.SmoothScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource VerdictBadge}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateLabel}"
                                                   Style="{StaticResource VerdictBadgeText}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FolderLabel}" Style="{StaticResource Caption}"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </slate:SlateBorder>
                <v:PageStateView x:Name="PageStateHost"/>
            </Grid>

            <!--  Diff pane: hosts ConfigCompareCard in embedded mode (no floating-card size or shadow).  -->
            <Grid Grid.Column="2">
                <Grid x:Name="DiffHost"/>

                <!--  Shown when the selected row has no diff to show. Not a PageStateView, which belongs to
                the list on the left.  -->
                <slate:SlateBorder x:Name="DetailPanel" Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <TextBlock x:Name="DetailGlyph" Text="&#xE8EC;"
                                   FontFamily="{DynamicResource IconFont}" FontSize="34"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource H3}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,12,0,6"
                                   Text="Pick a file to see what changed"/>
                        <TextBlock x:Name="DetailBody" Style="{StaticResource Muted}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Text files open as a line-by-line diff. Anything else is compared by size and contents only."/>
                    </StackPanel>
                </slate:SlateBorder>
            </Grid>
        </Grid>

        <!--  Row 4 - status text and the two copy directions.  -->
        <Border Grid.Row="4" Style="{StaticResource PageStatusBar}" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyFromButton" Content="Copy from..." Padding="12,5" Margin="0,0,8,0"
                            IsEnabled="False" Click="OnCopyFromOther"/>
                    <Button x:Name="CopyToButton" Content="Copy to..." Style="{StaticResource AccentButton}"
                            Padding="14,5" IsEnabled="False" Click="OnCopyToOther"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BusyBar" Width="140" Height="4" IsIndeterminate="True"
                                 Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="BusyCancelButton" Content="Cancel" Padding="10,3" FontSize="11"
                            Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
