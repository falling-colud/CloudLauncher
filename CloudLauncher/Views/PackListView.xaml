<Page x:Class="CloudLauncher.Views.PackListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      Title="Instances"
      Background="{DynamicResource Surface0Brush}">
    <!-- Reference page for the master-page layout. Shared measurements come from Style keys in
    Themes/Controls.xaml (PageHeaderPanel, PageFilterBar, PageDivider, PageStatusBar,
    HeaderActionButton, HeaderIconButton, ToolbarIconButton), so copies stay consistent.
    Rows: header / actions / divider / folder strip / content / status bar. -->
    <Page.Resources>
        <!-- Right-click menu for an instance. The card and the row both use it. -->
        <ContextMenu x:Key="PackContextMenu" x:Shared="False">
            <MenuItem Header="Play" Click="OnCtxPlay"/>
            <MenuItem Header="Open instance" Click="OnCtxOpen"/>
            <MenuItem Header="Rename instance" Click="OnCtxRename"/>
            <MenuItem Header="Change image..." Click="OnCtxChangeImage"/>
            <MenuItem Header="{Binding PlacementTarget.DataContext.PinMenuHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      IsCheckable="True"
                      IsChecked="{Binding PlacementTarget.DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                      Click="OnCtxTogglePin"/>
            <Separator/>
            <MenuItem Header="Open game folder" Click="OnCtxOpenGameFolder"/>
            <MenuItem Header="Instance management" Click="OnCtxPackManagement"/>
            <MenuItem Header="Mod browser" Click="OnCtxBrowseMods"/>
            <MenuItem Header="Export..." Click="OnCtxExport"
                      ToolTip="Save this instance as a CurseForge .zip or Modrinth .mrpack"/>
            <Separator/>
            <MenuItem Header="Add to folder"
                      SubmenuOpened="OnCtxAddToFolderOpened"/>
            <Separator/>
            <MenuItem Header="Copy instance ID" Click="OnCtxCopyId"/>
            <MenuItem Header="Delete..." Click="OnCtxDelete"/>
        </ContextMenu>

        <ItemsPanelTemplate x:Key="PackGridPanel">
            <UniformGrid x:Name="PackGrid" Columns="4" Loaded="OnPackGridLoaded"/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="PackRowsPanel">
            <StackPanel/>
        </ItemsPanelTemplate>

        <!-- Play / Kill / transfer progress, shared by both layouts. -->
        <DataTemplate x:Key="PackPlayCluster">
            <Grid>
                <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}"
                        Click="OnCardPlay" Tag="{Binding Source.Id}"
                        Padding="12,5" MinHeight="30" MinWidth="0"
                        IsEnabled="{Binding IsPlayable}"
                        Visibility="{Binding PlayVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="11" Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Play" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource KillInstanceButton}"
                        Click="OnCardKill" Tag="{Binding Source.Id}"
                        Padding="12,5" MinHeight="30" MinWidth="0"
                        ToolTip="Kill instance"
                        Visibility="{Binding KillVisibility}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="11" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="Kill" VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
                <Grid Visibility="{Binding ProgressVisibility}"
                      ToolTip="{Binding ProgressToolTip}">
                    <ProgressBar Style="{StaticResource PlayProgressBar}"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Tag="{Binding ProgressPercentLabel, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminate}"/>
                    <!-- Pause and stop, shown on hovering the transfer bar. Hidden by
                    opacity rather than visibility so the row never reflows. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding TransferControlsVisibility}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                 Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="IsHitTestVisible" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource TransferMiniButton}"
                                Content="{Binding PauseGlyph}"
                                ToolTip="{Binding PauseToolTip}"
                                IsEnabled="{Binding CanPauseJob}"
                                Click="OnCardPauseJob" Tag="{Binding Source.Id}"/>
                        <Button Style="{StaticResource TransferMiniButton}"
                                Content="&#xE71A;" Margin="4,0,0,0"
                                ToolTip="{Binding StopToolTip}"
                                IsEnabled="{Binding CanStopJob}"
                                Click="OnCardStopJob" Tag="{Binding Source.Id}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PackCardTemplate">
            <slate:SlateBorder x:Name="CardRoot" Margin="6" Cursor="Hand"
                    Height="260" VerticalAlignment="Top"
                    anim:Animate.HoverLift="True"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10"
                    MouseLeftButtonUp="OnCardClick"
                    MouseRightButtonUp="OnCardRightClick"
                    ContextMenu="{StaticResource PackContextMenu}">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cover artwork: generated gradient + first letter -->
                    <slate:SlateBorder Grid.Row="0" Background="{Binding CoverBackground}"
                            CornerRadius="9,9,0,0" ClipToBounds="True"
                            MinHeight="120">
                        <Grid>
                            <Border Background="{DynamicResource AccentGlowBrush}" Opacity="0.05"/>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                   Visibility="{Binding CoverImageVisibility}"/>
                            <TextBlock Text="{Binding Initial}"
                                       FontFamily="{DynamicResource HeadingFont}"
                                       FontSize="64" FontWeight="Bold"
                                       Foreground="White" Opacity="0.92"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding InitialVisibility}"/>
                            <!-- Tag pill, top-right -->
                            <slate:SlateBorder Style="{StaticResource Pill}"
                                    Background="{Binding TagBackground}"
                                    Margin="0,10,10,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding TagText}" Style="{StaticResource PillText}"
                                           Foreground="{Binding TagForeground}"/>
                            </slate:SlateBorder>
                            <!-- Pin toggle, top-left -->
                            <Button Content="&#xE718;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                    Width="28" Height="28" Padding="0"
                                    Margin="10,10,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Click="OnPinToggle" Tag="{Binding Source.Id}"
                                    ToolTip="{Binding PinToolTip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Background" Value="#66000000"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                                <Setter Property="Opacity" Value="0.82"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Loader badge, bottom-left -->
                            <slate:SlateBorder Background="#66000000" CornerRadius="4"
                                    Margin="10,0,0,10" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Visibility="{Binding LoaderBadgeVisibility}">
                                <TextBlock Text="{Binding LoaderBadge}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </slate:SlateBorder>
                        </Grid>
                    </slate:SlateBorder>

                    <!-- Info strip -->
                    <Grid Grid.Row="1" Margin="12,10,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Name}"
                                   FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Text="{Binding VersionLabel}"
                                   Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                            <ContentControl DockPanel.Dock="Right" MinWidth="110"
                                            Content="{Binding}" Focusable="False" IsTabStop="False"
                                            ContentTemplate="{StaticResource PackPlayCluster}"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Content="&#xE777;" FontFamily="{DynamicResource IconFont}"
                                    FontSize="13" ToolTip="Update available"
                                    Click="OnCardUpdate" Tag="{Binding Source.Id}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Visibility="{Binding UpdateButtonVisibility}"/>
                            <TextBlock Text="{Binding OwnerShortLabel}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </slate:SlateBorder>
        </DataTemplate>

        <!-- List layout: one compact row per instance, same actions as the card. -->
        <DataTemplate x:Key="PackRowTemplate">
            <slate:SlateBorder Margin="6,0,6,6" Height="58" Cursor="Hand"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8"
                    MouseLeftButtonUp="OnCardClick"
                    MouseRightButtonUp="OnCardRightClick"
                    ContextMenu="{StaticResource PackContextMenu}">
                <slate:SlateBorder.Style>
                    <Style TargetType="slate:SlateBorder">
                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </slate:SlateBorder.Style>
                <Grid Margin="7,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <slate:SlateBorder Grid.Column="0" Width="42" Height="42" CornerRadius="6"
                            Background="{Binding CoverBackground}" ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                   Visibility="{Binding CoverImageVisibility}"/>
                            <TextBlock Text="{Binding Initial}"
                                       FontFamily="{DynamicResource HeadingFont}"
                                       FontSize="20" FontWeight="Bold"
                                       Foreground="White" Opacity="0.92"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding InitialVisibility}"/>
                        </Grid>
                    </slate:SlateBorder>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE718;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Visibility="{Binding PinnedVisibility}"
                                       ToolTip="Pinned"/>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding RowSubtitle}" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding LastPlayedLabel}"
                               Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,16,0" MinWidth="110" TextAlignment="Right"
                               TextTrimming="CharacterEllipsis"/>

                    <slate:SlateBorder Grid.Column="3" Style="{StaticResource Pill}"
                            Background="{Binding TagBackground}"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TagText}" Style="{StaticResource PillText}"
                                   Foreground="{Binding TagForeground}"/>
                    </slate:SlateBorder>

                    <Button Grid.Column="4" Style="{StaticResource IconButton}"
                            Content="&#xE777;" FontFamily="{DynamicResource IconFont}"
                            FontSize="13" ToolTip="Update available" Margin="0,0,6,0"
                            Click="OnCardUpdate" Tag="{Binding Source.Id}"
                            Foreground="{DynamicResource AccentTextBrush}"
                            Visibility="{Binding UpdateButtonVisibility}"/>

                    <ContentControl Grid.Column="5" MinWidth="110" VerticalAlignment="Center"
                                    Content="{Binding}" Focusable="False" IsTabStop="False"
                                    ContentTemplate="{StaticResource PackPlayCluster}"/>
                </Grid>
            </slate:SlateBorder>
        </DataTemplate>

        <!-- Glyphs for the layout switch, drawn on a 12 px grid so they stay crisp in both looks. -->
        <Geometry x:Key="CardsGlyph">M0,0 H5 V5 H0 Z M7,0 H12 V5 H7 Z M0,7 H5 V12 H0 Z M7,7 H12 V12 H7 Z</Geometry>
        <Geometry x:Key="RowsGlyph">M0,1 H2 V3 H0 Z M4,1 H12 V3 H4 Z M0,5 H2 V7 H0 Z M4,5 H12 V7 H4 Z M0,9 H2 V11 H0 Z M4,9 H12 V11 H4 Z</Geometry>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero header - title and one line saying what the page lists. No buttons, no counts. -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Instances"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Minecraft instances you own, are shared with you, or have downloaded."/>
            </StackPanel>
        </DockPanel>

        <!-- Actions / search bar: primary action, labelled secondaries, icon-only utilities,
             then the search box and Refresh pinned to the far right. -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-3,0,-3">
                <!-- The page's only AccentButton, first and at default padding; its size
                against HeaderActionButton sets the header's hierarchy. -->
                <Button Style="{StaticResource AccentButton}" Click="OnCreatePack" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Create instance" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HeaderActionButton}" Click="OnDownloadPack"
                        ToolTip="Browse CurseForge, Modrinth and CloudLauncher for a modpack" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource HeaderActionButton}" Click="OnImportModpack"
                        ToolTip="Import a .mrpack or CurseForge .zip from this PC" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <views:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0"
                                        Placeholder="Search instances"
                                        SearchToolTip="Filter instances by name, summary or description"/>
                <!-- Icon-only utilities, in this order: open folder, then refresh. The folder
                button opens the folder all instances live in. -->
                <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnOpenInstancesFolder" Content="&#xE8DA;"
                        ToolTip="Open the folder your instances live in"/>
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnRefresh" Content="&#xE72C;" ToolTip="Refresh"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!-- Folder strip - sort control at the strip's left edge, then All + user folders +
             computed team folders. -->
        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SortButton" Grid.Column="0" VerticalAlignment="Center"
                    Style="{StaticResource ToolbarIconButton}" Click="OnSortButtonClick"
                    Content="&#xE8CB;"
                    ToolTip="Sort instances">
                <Button.ContextMenu>
                    <ContextMenu Opened="OnSortMenuOpened">
                        <MenuItem x:Name="SortLastPlayedMenuItem" Header="Last played" Tag="LastPlayed"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortVersionMenuItem" Header="Version" Tag="Version"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortPlayCountMenuItem" Header="Times played" Tag="PlayCount"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortTimePlayedMenuItem" Header="Time played" Tag="TimePlayed"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <slate:SlateBorder Style="{StaticResource FolderChipBorder}"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <slate:SlateBorder.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename folder" Click="OnFolderRename"/>
                                        <MenuItem Header="Delete folder" Click="OnFolderDelete"/>
                                    </ContextMenu>
                                </slate:SlateBorder.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource FolderChipGlyph}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FolderChipLabel}"/>
                                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource FolderChipCount}"/>
                                </StackPanel>
                            </slate:SlateBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Cards or list. Remembered in settings (PackListLayout). -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <RadioButton x:Name="LayoutCardsButton" GroupName="PackListLayout"
                             Style="{StaticResource ToolbarToggleButton}" Margin="0,0,4,0"
                             ToolTip="Show instances as cards" AutomationProperties.Name="Cards"
                             Click="OnLayoutCardsClick">
                    <Path Data="{StaticResource CardsGlyph}" Width="12" Height="12"
                          SnapsToDevicePixels="True" UseLayoutRounding="True"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </RadioButton>
                <RadioButton x:Name="LayoutListButton" GroupName="PackListLayout"
                             Style="{StaticResource ToolbarToggleButton}" Margin="0"
                             ToolTip="Show instances as a list" AutomationProperties.Name="List"
                             Click="OnLayoutListClick">
                    <Path Data="{StaticResource RowsGlyph}" Width="12" Height="12"
                          SnapsToDevicePixels="True" UseLayoutRounding="True"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                </RadioButton>
            </StackPanel>
        </Grid>

        <!-- Content row. The content gutter is 28 from the page edge: cards carry Margin="6",
        so the ScrollViewer holds back 22. Pages whose rows have no margin use
        Margin="28,0,28,16". PageStateView is a sibling of the ScrollViewer so its
        loading/empty/error panel is centred in the viewport, not in a collapsed scroll extent. -->
        <Grid Grid.Row="4">
            <ScrollViewer Margin="22,0,22,10" VerticalScrollBarVisibility="Auto"
                          SizeChanged="OnPackListContainerSizeChanged">
                <!-- Cards sit in a UniformGrid whose Columns follow the width (UpdateColumns), so
                     rows are always full. The list layout swaps in PackRowsPanel/PackRowTemplate. -->
                <ItemsControl x:Name="PackList" HorizontalAlignment="Stretch"
                              anim:Animate.EntranceStagger="True"
                              ItemsPanel="{StaticResource PackGridPanel}"
                              ItemTemplate="{StaticResource PackCardTemplate}"/>
            </ScrollViewer>

            <!-- Loading / empty / folder-is-empty / nothing-matched / error / offline, all driven
                 by Views/PageState.cs. The page never touches this control. -->
            <views:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!-- Status bar: transfer progress on the left, the page's one message line, then the count. -->
        <Border Grid.Row="5" Style="{StaticResource PageStatusBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="BottomProgressArea" Grid.Column="0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BottomProgressLabel" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"/>
                        <ProgressBar x:Name="BottomProgressBar" Width="180" Height="8"
                                     Margin="12,0,0,0" Maximum="100"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="BottomProgressPercent" Style="{StaticResource Caption}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="BottomCurrentProgressArea"
                                Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="BottomCurrentProgressLabel" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <ProgressBar x:Name="BottomCurrentProgressBar" Width="180" Height="4"
                                     Margin="12,0,0,0" Maximum="100"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="BottomCurrentProgressPercent" Style="{StaticResource Caption}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <!-- No Foreground here: SetStatus and PageState colour this line by resource
                reference, so it matches the message kind and follows live theme changes. -->
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           Grid.Column="1" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="560"/>
                <TextBlock x:Name="CountLabel" Style="{StaticResource Caption}"
                           Grid.Column="2" VerticalAlignment="Center"
                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Page>
