<Page x:Class="CloudLauncher.Views.PackListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Instances"
      Background="{StaticResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero header -->
        <Grid Grid.Row="0" Margin="28,24,28,18">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Instances"/>
                <TextBlock Style="{StaticResource Muted}" Text="Minecraft instances you own, are shared with you, or have downloaded."/>
            </StackPanel>
        </Grid>

        <!-- Actions / search bar -->
        <Grid Grid.Row="1" Margin="28,12,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Create instance" Style="{StaticResource AccentButton}" Click="OnCreatePack">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Create instance" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnDownloadPack"
                        Content="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Download a pack from CurseForge, Modrinth, or CloudLauncher"/>
                <Button Style="{StaticResource IconButton}" Click="OnImportModpack"
                        Content="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Import a .mrpack or CurseForge .zip"/>
                <Button Style="{StaticResource IconButton}" Click="OnCreateFolder"
                        Content="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Create folder"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border x:Name="CompactSearchHost"
                        Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" MinHeight="36" Width="36"
                        HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SearchToggleButton" Grid.Column="0"
                                Style="{StaticResource IconButton}" Click="OnSearchToggle"
                                Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                ToolTip="Search instances"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Visibility="Collapsed"
                                 TextChanged="OnSearchTextChanged"
                                 PreviewKeyDown="OnSearchPreviewKeyDown"
                                 LostKeyboardFocus="OnSearchLostKeyboardFocus"
                                 ToolTip="Filter instances by name">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Style="{StaticResource IconButton}" Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Refresh"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Height="1" Margin="28,4,28,10"
                Background="{StaticResource BorderSubtleBrush}"/>

        <!-- Folder strip — sort control + All + user folders + computed team folders -->
        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SortButton" Grid.Column="0"
                    Style="{StaticResource IconButton}" Click="OnSortButtonClick"
                    Content="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="13"
                    Margin="0,2,8,2" Padding="8,5"
                    ToolTip="Sort instances">
                <Button.ContextMenu>
                    <ContextMenu Opened="OnSortMenuOpened">
                        <MenuItem x:Name="SortLastPlayedMenuItem" Header="Last played" Tag="LastPlayed"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortVersionMenuItem" Header="Version" Tag="Version"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortPlayCountMenuItem" Header="Times played" Tag="PlayCount"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortTimePlayedMenuItem" Header="Time played" Tag="TimePlayed"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0" Margin="0,2,8,2" Cursor="Hand"
                                    Background="{Binding Background}"
                                    BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                    CornerRadius="14"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename folder" Click="OnFolderRename"/>
                                        <MenuItem Header="Delete folder" Click="OnFolderDelete"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Margin="12,0,6,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground}"/>
                                    <TextBlock Text="{Binding Label}" Margin="0,0,4,0"
                                               Padding="0,5,0,5"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground}"
                                               FontWeight="{Binding FontWeight}"/>
                                    <TextBlock Text="{Binding CountLabel}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding CountForeground}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Card grid — UniformGrid with column count recomputed on resize so rows are always full -->
        <ScrollViewer Grid.Row="4" Padding="20,14,20,16" VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnPackListContainerSizeChanged">
            <Grid>
                <ItemsControl x:Name="PackList" HorizontalAlignment="Stretch"
                              anim:Animate.EntranceStagger="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="PackGrid" Columns="4" Loaded="OnPackGridLoaded"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardRoot" Margin="6" Cursor="Hand"
                                    Height="260" VerticalAlignment="Top"
                                    anim:Animate.HoverLift="True"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10"
                                    MouseLeftButtonUp="OnCardClick"
                                    MouseRightButtonUp="OnCardRightClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Play" Click="OnCtxPlay"/>
                                        <MenuItem Header="Open instance" Click="OnCtxOpen"/>
                                        <MenuItem Header="Rename instance" Click="OnCtxRename"/>
                                        <MenuItem Header="Change image…" Click="OnCtxChangeImage"/>
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.PinMenuHeader, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding PlacementTarget.DataContext.IsPinned, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}"
                                                  Click="OnCtxTogglePin"/>
                                        <Separator/>
                                        <MenuItem Header="Open game folder" Click="OnCtxOpenGameFolder"/>
                                        <MenuItem Header="Instance management" Click="OnCtxPackManagement"/>
                                        <MenuItem Header="Mod browser" Click="OnCtxBrowseMods"/>
                                        <Separator/>
                                        <MenuItem x:Name="CtxAddToFolderMenu" Header="Add to folder"
                                                  SubmenuOpened="OnCtxAddToFolderOpened"/>
                                        <Separator/>
                                        <MenuItem Header="Copy instance ID" Click="OnCtxCopyId"/>
                                        <MenuItem Header="Delete..." Click="OnCtxDelete"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Cover artwork: generated gradient + first letter -->
                                    <Border Grid.Row="0" Background="{Binding CoverBackground}"
                                            CornerRadius="9,9,0,0" ClipToBounds="True"
                                            MinHeight="120">
                                        <Grid>
                                            <Border Background="{StaticResource AccentGlowBrush}" Opacity="0.05"/>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                                   Visibility="{Binding CoverImageVisibility}"/>
                                            <TextBlock Text="{Binding Initial}"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontSize="64" FontWeight="Bold"
                                                       Foreground="White" Opacity="0.92"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding InitialVisibility}"/>
                                            <!-- Tag pill, top-right -->
                                            <Border Style="{StaticResource Pill}"
                                                    Background="{Binding TagBackground}"
                                                    Margin="0,10,10,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding TagText}" Style="{StaticResource PillText}"
                                                           Foreground="{Binding TagForeground}"/>
                                            </Border>
                                            <!-- Pin toggle, top-left -->
                                            <Button Content="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                    Width="28" Height="28" Padding="0"
                                                    Margin="10,10,0,0"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Click="OnPinToggle" Tag="{Binding Source.Id}"
                                                    ToolTip="{Binding PinToolTip}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Opacity" Value="0"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="Background" Value="#66000000"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True">
                                                                <Setter Property="Opacity" Value="0.82"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <!-- Loader badge, bottom-left -->
                                            <Border Background="#66000000" CornerRadius="4"
                                                    Margin="10,0,0,10" Padding="6,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Visibility="{Binding LoaderBadgeVisibility}">
                                                <TextBlock Text="{Binding LoaderBadge}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Info strip -->
                                    <Grid Grid.Row="1" Margin="12,10,12,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding Name}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding VersionLabel}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                            <!-- Right cluster: Play OR progress bar (swap based on IsWorking) -->
                                            <Grid DockPanel.Dock="Right" MinWidth="110">
                                                <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}"
                                                        Click="OnCardPlay" Tag="{Binding Source.Id}"
                                                        Padding="12,5" MinHeight="30" MinWidth="0"
                                                        IsEnabled="{Binding IsPlayable}"
                                                        Visibility="{Binding PlayVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="11" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="Play" VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource KillInstanceButton}"
                                                        Click="OnCardKill" Tag="{Binding Source.Id}"
                                                        Padding="12,5" MinHeight="30" MinWidth="0"
                                                        ToolTip="Kill instance"
                                                        Visibility="{Binding KillVisibility}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="11" Margin="0,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                        <TextBlock Text="Kill" VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Grid Visibility="{Binding ProgressVisibility}"
                                                      ToolTip="{Binding ProgressLabel}">
                                                    <ProgressBar Style="{StaticResource PlayProgressBar}"
                                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Tag="{Binding ProgressPercentLabel, Mode=OneWay}"
                                                                 IsIndeterminate="{Binding IsIndeterminate}"/>
                                                </Grid>
                                            </Grid>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                    Content="&#xE777;" FontFamily="{StaticResource IconFont}"
                                                    FontSize="13" ToolTip="Update available"
                                                    Click="OnCardUpdate" Tag="{Binding Source.Id}"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Visibility="{Binding UpdateButtonVisibility}"/>
                                            <TextBlock Text="{Binding OwnerShortLabel}"
                                                       Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state — when there are NO instances at all -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="48"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock Style="{StaticResource H2}" Text="No instances yet"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                               Text="Create your first instance or import a modpack from a file."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="Create instance" Style="{StaticResource AccentButton}" Click="OnCreatePack"/>
                        <Button Content="Import…" Click="OnImportModpack"/>
                    </StackPanel>
                </StackPanel>

                <!-- Empty state — when an active folder has no instances -->
                <StackPanel x:Name="EmptyFolderState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="48"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock Style="{StaticResource H2}" x:Name="EmptyFolderTitle"
                               Text="Folder is empty"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                               Text="Right-click an instance on the All page and pick &quot;Add to folder&quot; to link it here."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="5" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="BottomProgressArea" Grid.Column="0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BottomProgressLabel" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"/>
                        <ProgressBar x:Name="BottomProgressBar" Width="180" Height="8"
                                     Margin="12,0,0,0" Maximum="100"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="BottomProgressPercent" Style="{StaticResource Caption}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="BottomCurrentProgressArea"
                                Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="BottomCurrentProgressLabel" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" Foreground="{StaticResource TextTertiaryBrush}"/>
                        <ProgressBar x:Name="BottomCurrentProgressBar" Width="180" Height="4"
                                     Margin="12,0,0,0" Maximum="100"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="BottomCurrentProgressPercent" Style="{StaticResource Caption}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           Grid.Column="1"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Page>
