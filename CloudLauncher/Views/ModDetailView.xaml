<Page x:Class="CloudLauncher.Views.ModDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Mod"
      PreviewKeyDown="OnPageKeyDown"
      Background="{DynamicResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" anim:Animate.SmoothScroll="True">
        <StackPanel Margin="22,16,22,28">

            <Border Style="{StaticResource ElevatedCard}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource Pill}"
                                    Background="{DynamicResource Surface4Brush}" VerticalAlignment="Center">
                                <TextBlock x:Name="VisibilityLabel" Style="{StaticResource PillText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Button x:Name="DeleteModButton" Content="Delete mod…"
                                    Style="{StaticResource DangerButton}" Click="OnDeleteMod"
                                    Margin="10,0,0,0" Padding="12,5" MinWidth="0" MinHeight="0"
                                    ToolTip="Permanently delete this mod and every version uploaded to it"/>
                        </StackPanel>
                        <TextBlock x:Name="ModNameLabel" Style="{StaticResource H2}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock x:Name="MetaLabel" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="SlugLabel" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               ToolTip="The mod's stable identifier on this server"/>
                </StackPanel>
            </Border>

            <!-- Overview editor (owner) / viewer -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Overview" Margin="0,0,0,8"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Name"/>
                    <TextBox x:Name="NameBox" Margin="0,4,0,12" MaxLength="128"
                             TextChanged="OnFieldChanged"
                             ToolTip="The name shown wherever this mod is listed"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Summary"/>
                    <TextBox x:Name="SummaryBox" Margin="0,4,0,12" MaxLength="512"
                             TextChanged="OnFieldChanged"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Description"/>
                    <TextBox x:Name="DescriptionBox" Margin="0,4,0,12"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="90" MaxHeight="220" MaxLength="4096"
                             TextChanged="OnFieldChanged"/>

                    <TextBlock Style="{StaticResource Caption}" Text="Visibility"/>
                    <ComboBox x:Name="VisibilityBox" Margin="0,4,0,12"
                              SelectionChanged="OnFieldSelectionChanged">
                        <ComboBoxItem Content="Private"/>
                        <ComboBoxItem Content="Team"/>
                        <ComboBoxItem Content="Public"/>
                    </ComboBox>

                    <Border Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12" Margin="0,2,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Compatibility"
                                       FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="What this mod advertises overall. An instance can only install it when both lines match, and an uploaded version can narrow it further."/>

                            <TextBlock Style="{StaticResource Caption}" Text="Minecraft versions"/>
                            <TextBox x:Name="McVersionsBox" Margin="0,4,0,10" MaxLength="256"
                                     TextChanged="OnFieldChanged"
                                     ToolTip="Comma-separated, e.g. 1.20.1, 1.21.1"/>

                            <TextBlock Style="{StaticResource Caption}" Text="Loaders"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <CheckBox x:Name="LoaderFabric" Content="fabric" Margin="0,0,12,0"
                                          Checked="OnFieldChecked" Unchecked="OnFieldChecked"/>
                                <CheckBox x:Name="LoaderForge" Content="forge" Margin="0,0,12,0"
                                          Checked="OnFieldChecked" Unchecked="OnFieldChecked"/>
                                <CheckBox x:Name="LoaderNeoForge" Content="neoforge" Margin="0,0,12,0"
                                          Checked="OnFieldChecked" Unchecked="OnFieldChecked"/>
                                <CheckBox x:Name="LoaderQuilt" Content="quilt"
                                          Checked="OnFieldChecked" Unchecked="OnFieldChecked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel>
                        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save"
                                Style="{StaticResource AccentButton}" Click="OnSave" Padding="14,5"
                                IsEnabled="False" ToolTip="Save changes (Ctrl+S)"/>
                        <Button x:Name="PermissionsButton" DockPanel.Dock="Right"
                                Content="Manage collaborators..." Click="OnEditPermissions"
                                Margin="0,0,8,0" Padding="14,5"/>
                        <TextBlock x:Name="SaveStatus" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Versions -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="UploadVersionButton" DockPanel.Dock="Right"
                                Content="Upload version" Style="{StaticResource AccentButton}"
                                Click="OnUploadVersion" Padding="14,5"
                                ToolTip="Publish a new jar with its own changelog, channel and compatibility"/>
                        <TextBlock x:Name="VersionsHeader" Style="{StaticResource H3}" Text="Versions"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="VersionsList" anim:Animate.EntranceStagger="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,1"
                                        Background="{DynamicResource Surface1Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Install to instance…" Click="OnCtxInstallVersion"/>
                                            <MenuItem Header="Save as…" Click="OnCtxSaveVersionAs"/>
                                            <Separator/>
                                            <MenuItem Header="Copy version string" Click="OnCtxCopyVersionString"/>
                                            <MenuItem Header="Copy SHA-256" Click="OnCtxCopyHash"/>
                                            <Separator Visibility="{Binding OwnerActionVisibility}"/>
                                            <MenuItem Header="Delete version…" Click="OnCtxDeleteVersion"
                                                      Visibility="{Binding OwnerActionVisibility}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding VersionString}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Pill}"
                                                    Background="{DynamicResource Surface4Brush}"
                                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ReleaseChannel}"
                                                           Style="{StaticResource PillText}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                    Content="{Binding ExpandGlyph}"
                                                    FontFamily="{StaticResource IconFont}" FontSize="11"
                                                    Click="OnToggleChangelog" Tag="{Binding}"
                                                    Margin="0,0,4,0" VerticalAlignment="Center"
                                                    ToolTip="Show the changelog for this version"/>
                                            <Button Grid.Column="3" Content="Install"
                                                    Style="{StaticResource AccentButton}"
                                                    Click="OnInstallVersion" Tag="{Binding}"
                                                    Padding="10,4" MinWidth="0" MinHeight="0" FontSize="11"
                                                    Margin="0,0,4,0" VerticalAlignment="Center"
                                                    ToolTip="Copy this jar into one of your instances"/>
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}"
                                                    Content="&#xE712;" FontFamily="{StaticResource IconFont}"
                                                    FontSize="13" Click="OnVersionOptions" Tag="{Binding}"
                                                    VerticalAlignment="Center" ToolTip="More actions"/>
                                        </Grid>
                                        <Border Margin="0,8,0,2" Padding="10"
                                                Background="{DynamicResource Surface0Brush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="6"
                                                Visibility="{Binding ChangelogVisibility}">
                                            <TextBlock Text="{Binding Changelog}" TextWrapping="Wrap"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="VersionsEmpty" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Muted}" Text="No versions uploaded yet."/>
                        <TextBlock x:Name="VersionsEmptyHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="Until a jar is uploaded this mod cannot be installed anywhere — Upload version publishes the first one."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,4,0,0">
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Bottom" Height="3" Margin="0,6,0,0"
                             Visibility="Collapsed" IsIndeterminate="True"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
