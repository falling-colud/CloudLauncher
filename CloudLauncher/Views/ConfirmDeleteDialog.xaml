<Window x:Class="CloudLauncher.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete instance" Height="320" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with warning icon -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="12"
                    Background="{DynamicResource AccentSoftBrush}"
                    VerticalAlignment="Top" Margin="0,0,16,0">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="22"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderLabel" Style="{StaticResource H2}" Text="Delete this instance?"/>
                <TextBlock x:Name="PackNameLabel" Style="{StaticResource Muted}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="BodyLabel" Style="{StaticResource Body}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}">
                This will remove the instance from the server. Anyone you shared it with will lose access.
            </TextBlock>
            <Border Background="{DynamicResource Surface0Brush}" CornerRadius="6"
                    Padding="12,10" Margin="0,12,0,0"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Foreground="{DynamicResource InfoBlueBrush}"
                               VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        Local files inside the instance folder on your machine are <Run FontWeight="SemiBold">kept</Run>.
                        Delete them yourself if you no longer need them.
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}"
                    Content="Delete instance" Click="OnDelete" IsDefault="False"
                    FontWeight="SemiBold" MinWidth="120"/>
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="OnCancel"
                    MinWidth="100"/>
        </DockPanel>
    </Grid>
</Window>
