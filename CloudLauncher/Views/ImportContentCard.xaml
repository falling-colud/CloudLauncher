<UserControl x:Class="CloudLauncher.Views.ImportContentCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <UserControl.Resources>
        <!--  One instance the import can land in. The second line says whether it already uses the
        library copy or has its own copy of the file.  -->
        <DataTemplate x:Key="ImportTargetTemplate">
            <CheckBox Margin="0,3" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding CanTake}" ToolTip="{Binding Hint}"
                      ToolTipService.ShowOnDisabled="True"
                      Checked="OnTargetTicked" Unchecked="OnTargetTicked">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock x:Name="StepLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleLabel" Style="{StaticResource H2}" Text="Import"/>
                </DockPanel>
                <TextBlock x:Name="SubtitleLabel" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>

            <!--  Buttons pinned to the bottom so every step grows into what is left of the card.  -->
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Content="Back" Padding="14,5"
                        Margin="0,0,12,0" Click="OnBack" Visibility="Collapsed"/>

                <TextBlock x:Name="StatusLabel" Grid.Column="1" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"
                            Margin="0,0,8,0" Padding="14,5"/>
                    <!--  Optional route into hosting. A secondary button, so a plain import never has to go
                    through the publishing form.  -->
                    <Button x:Name="PublishJumpButton" Content="Publish it online..." Click="OnPublishJump"
                            Margin="0,0,8,0" Padding="14,5" Visibility="Collapsed"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource AccentButton}"
                            Click="OnNext" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </Grid>

            <!--  The four steps, switched by panel visibility the same way UploadBundleVersionDialog does.  -->
            <Grid>

                <!--  STEP 1 - the file  -->
                <Grid x:Name="FileStep">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <slate:SlateBorder Grid.Row="0" Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" AllowDrop="True"
                            DragOver="OnDropZoneDragOver" Drop="OnDropZoneDrop">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource IconFont}"
                                           FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="FileNameLabel" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="Nothing chosen yet"/>
                                    <TextBlock x:Name="FileMetaLabel" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PickFileButton" Content="Choose a file..." Padding="12,5"
                                        Margin="0,0,8,0" Click="OnPickFile"/>
                                <!--  Zip or folder as two buttons, since they open different pickers.  -->
                                <Button x:Name="PickFolderButton" Content="Choose a folder..." Padding="12,5"
                                        Click="OnPickFolder" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <!--  Only a warning: odd archives can be intentional, so this never blocks.  -->
                        <TextBlock x:Name="FileWarning" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="FileHint" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!--  STEP 2 - where it goes  -->
                <Grid x:Name="WhereStep" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--  The pinned first row, in its own box above the list so "no instance" doesn't
                    look like one more instance to tick.  -->
                    <slate:SlateBorder Grid.Row="0" Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <CheckBox x:Name="LibraryOnlyBox" ToolTipService.ShowOnDisabled="True"
                                  Checked="OnLibraryOnlyChanged" Unchecked="OnLibraryOnlyChanged">
                            <StackPanel>
                                <TextBlock Text="Do not put it in an instance yet"/>
                                <TextBlock x:Name="LibraryOnlyNote" Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                    </slate:SlateBorder>

                    <slate:SlateBorder Grid.Row="1" Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" anim:Animate.SmoothScroll="True">
                                <ItemsControl x:Name="TargetList" ItemTemplate="{StaticResource ImportTargetTemplate}"/>
                            </ScrollViewer>
                            <TextBlock x:Name="TargetListNote" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </slate:SlateBorder>

                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="TargetCountLabel" DockPanel.Dock="Right"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SelectAllTargets" Content="Select all" Padding="10,4"
                                    Margin="0,0,6,0" Click="OnSelectAllTargets"/>
                            <Button x:Name="SelectNoTargets" Content="Clear" Padding="10,4"
                                    Click="OnSelectNoTargets"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!--  STEP 3 - publish it online  -->
                <Grid x:Name="PublishStep" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" anim:Animate.SmoothScroll="True">
                        <StackPanel Margin="0,0,4,0">
                            <!--  Says why hosting is unavailable instead of only disabling the controls.  -->
                            <TextBlock x:Name="HostBlockedNote" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                            <Expander x:Name="HostExpander" IsExpanded="False"
                                      Header="Also publish this to CloudLauncher"
                                      Expanded="OnHostExpansionChanged" Collapsed="OnHostExpansionChanged"
                                      ToolTipService.ShowOnDisabled="True">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"
                                               Text="Close this box again to import without publishing anything."/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HostNameBox" MaxLength="128" Margin="0,0,0,10"
                                                     TextChanged="OnHostFormChanged"/>

                                            <TextBlock Text="One-line summary" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HostSummaryBox" MaxLength="512" Margin="0,0,0,10"
                                                     TextChanged="OnHostFormChanged"
                                                     ToolTip="What the browse list shows under the name"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Width="230">
                                            <TextBlock Text="Who can see it" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="HostVisibilityBox" Margin="0,0,0,10"/>

                                            <TextBlock x:Name="HostMcLabel" Text="Minecraft versions"
                                                       Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HostMcBox" MaxLength="512"
                                                     TextChanged="OnHostFormChanged"
                                                     ToolTip="Comma-separated, e.g. 1.21.1, 1.21 - it decides which instances are offered this"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Description" Style="{StaticResource Caption}" Margin="0,10,0,4"/>
                                    <TextBox x:Name="HostDescriptionBox" MaxLength="4096" AcceptsReturn="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             MinHeight="60" MaxHeight="120" Margin="0,0,0,10"
                                             ToolTip="The long text on its page - Markdown is rendered"/>

                                    <StackPanel x:Name="HostLoaderPanel" Visibility="Collapsed">
                                        <TextBlock Text="Loaders" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <CheckBox x:Name="LoaderFabric" Content="fabric" Margin="0,0,12,0"
                                                      Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                                            <CheckBox x:Name="LoaderForge" Content="forge" Margin="0,0,12,0"
                                                      Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                                            <CheckBox x:Name="LoaderNeoForge" Content="neoforge" Margin="0,0,12,0"
                                                      Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                                            <CheckBox x:Name="LoaderQuilt" Content="quilt"
                                                      Checked="OnLoaderChanged" Unchecked="OnLoaderChanged"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Bundle kinds only (anything besides mods, resource
                                    packs and worlds), defined by their kind plus the folder
                                    they unpack into.  -->
                                    <Grid x:Name="HostBundlePanel" Visibility="Collapsed" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Published as" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="HostBundleKindBox"
                                                      SelectionChanged="OnBundleKindChanged"
                                                      ToolTip="Only what gets published changes - the copy that goes into your instances follows the page you started from"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="230">
                                            <TextBlock Text="Unpacks into" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HostRootBox" MaxLength="128"
                                                     TextChanged="OnHostFormChanged"
                                                     ToolTip="A folder inside the instance, e.g. config or kubejs. Never an absolute path."/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="HostVersionBox" MaxLength="64" Margin="0,0,0,10"
                                                     TextChanged="OnHostFormChanged"
                                                     ToolTip="What collaborators see in the version list, e.g. 1.2.0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="HostChannelPanel" Grid.Column="1" Width="230">
                                            <TextBlock Text="Release channel" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="HostChannelBox" Margin="0,0,0,10"
                                                      ToolTip="Beta and alpha are still downloadable - the label is how somebody knows what they are taking">
                                                <ComboBoxItem Content="release" IsSelected="True"/>
                                                <ComboBoxItem Content="beta"/>
                                                <ComboBoxItem Content="alpha"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="What changed" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="HostChangelogBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" MinHeight="60" MaxLength="4096"
                                             ToolTip="Optional, but it is the only thing that tells somebody whether to take this version"/>

                                    <TextBlock x:Name="HostError" Style="{StaticResource ErrorText}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!--  STEP 4 - do it  -->
                <Grid x:Name="RunStep" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <ProgressBar x:Name="RunBar" Height="4" IsIndeterminate="True" Margin="0,4,0,12"/>
                        <TextBlock x:Name="RunLog" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <slate:SlateBorder Grid.Row="1" Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,12,0,0"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="What happened" Style="{StaticResource H3}" Margin="0,0,0,6"/>
                            <!--  One receipt line from the library's apply summary or the
                            bundle install summary: what was linked, copied, already there
                            or shadowed.  -->
                            <TextBlock x:Name="ReceiptLabel" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ReceiptExtra" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </slate:SlateBorder>
                </Grid>
            </Grid>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
