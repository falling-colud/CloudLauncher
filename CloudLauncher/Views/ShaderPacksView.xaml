<Page x:Class="CloudLauncher.Views.ShaderPacksView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      Title="Shaders"
      Background="{DynamicResource Surface0Brush}">

    <!--  Same six-row layout as Worlds and Resource packs (header, actions, divider, strip, content,
    status), so buttons sit in the same places. Rows are grouped into user folders and each has a
    selection circle: the chosen pack is on by default in every compatible instance. A circle
    rather than a switch because an instance has one shader slot, so choosing a pack unchooses the
    previous one, and clicking the chosen pack again means no shader. Clicking a row opens the
    pack's page, where its instances can be narrowed. Folders are named lists in
    AppSettings.ShaderFolders, like the folders on the Instances page.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: title and a one-line description ── -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource H1}" Text="Shaders"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Every shader pack on this PC, across all your instances. File them into folders, and click one to open its own page."/>
            </StackPanel>
        </DockPanel>

        <!-- ── Row 1: actions bar ────────────────────────────── -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-3,0,-3">
                <!--  The one accent button, always Import on a content page: pick the file, then the
                instances (or none). Hosting is a step inside it.  -->
                <Button x:Name="ImportButton" Style="{StaticResource AccentButton}"
                        Margin="0,3,8,3" Click="OnImport"
                        ToolTip="Bring a shader zip (or an unpacked shader folder) in, and into any instances you choose. You can also drop one onto this page.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BrowseButton" Style="{StaticResource HeaderActionButton}"
                        Click="OnBrowse"
                        ToolTip="Search CurseForge and Modrinth for shader packs" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <views:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0"
                                        Placeholder="Filter shaders"
                                        SearchToolTip="Filter by name, file or instance (Ctrl+F)"/>
                <!--  Icon-only utilities: open folder, then refresh. shaderpacks/ is per instance, so
                Open folder resolves an instance first (OnOpenFolder).  -->
                <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnOpenFolder"
                        Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Open an instance's shaderpacks folder"/>
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Re-read every instance's shaderpacks folder and your own packs (F5)"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!-- ── Row 3: sort, instance scope, folders ─────────────────────── -->
        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}"
                        Click="OnSortButtonClick"
                        Content="&#xE8CB;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Sort shader packs">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSortMenuOpened">
                            <MenuItem x:Name="SortRecentMenuItem" Header="Recently added" Tag="RecentlyAdded"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="Name"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortSizeMenuItem" Header="Size" Tag="Size"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortInstanceMenuItem" Header="Instances using it" Tag="Instance"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ComboBox x:Name="PackScopeBox" Width="240" Margin="0,0,8,0"
                          SelectionChanged="OnPackScopeChanged"
                          ToolTip="Narrow the page to one instance - only that instance's shader packs are listed"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Active state is an accent border plus a bolder label, set by
                            DataTriggers on DynamicResource brushes. ThemeService creates new
                            brushes on every apply, so a brush baked into the row would keep the
                            previous accent until the page is rebuilt.  -->
                            <slate:SlateBorder Style="{StaticResource FolderChipBorder}"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <slate:SlateBorder.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename folder..." Click="OnFolderRename"/>
                                        <MenuItem Header="Delete folder..." Click="OnFolderDelete"/>
                                    </ContextMenu>
                                </slate:SlateBorder.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource FolderChipGlyph}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FolderChipLabel}"/>
                                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource FolderChipCount}"/>
                                    <!--  No settings pane: rename and delete are on this chip's
                                    right-click menu, and packs are filed in from their own row
                                    menu.  -->
                                </StackPanel>
                            </slate:SlateBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── Row 4: the loader banner, then the list ─────────────────────── -->
        <!--  AllowDrop is on this Grid, not the list, because PageState collapses the list while
        the page is empty and the empty panel invites dropping a zip.  -->
        <Grid Grid.Row="4" Margin="28,0,28,16"
              Background="Transparent"
              AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--  Shown when an instance has no Iris, Oculus or OptiFine. Without one, turning a shader
            on changes nothing in game and the game gives no hint, so the page says so; the defaults
            engine never auto-activates a shader there either. Collapsed otherwise.  -->
            <slate:SlateBorder x:Name="LoaderWarning" Grid.Row="0" Margin="0,0,0,10" Padding="12,9" CornerRadius="8"
                    Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="LoaderWarningButton" DockPanel.Dock="Right" Content="Open mods"
                            Click="OnOpenModsForLoader" Padding="12,4" Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Open that instance's mods so you can install Iris (or Oculus on Forge)"/>
                    <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="LoaderWarningText" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </DockPanel>
            </slate:SlateBorder>

            <Grid Grid.Row="1">
                <views:ContentListView x:Name="PackList"/>

                <!--  Last child so it draws over the list. Loading, empty, error and offline states are
                all this control, driven by Views/PageState.cs.  -->
                <views:PageStateView x:Name="PageStateHost"/>
            </Grid>
        </Grid>

        <!-- ── Row 5: status left, count and progress right ───────────────── -->
        <!--  The count lives here rather than in the header, where a change would go unnoticed.  -->
        <Border Grid.Row="5" Style="{StaticResource PageStatusBar}">
            <DockPanel>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <!--  No Click handler: PageState.Slots routes this button to its own
                     CancelRequested, and a handler here as well would cancel twice.  -->
                <Button x:Name="BusyCancelButton" DockPanel.Dock="Right" Content="Cancel"
                        Padding="10,2" MinHeight="0" MinWidth="0" Margin="12,0,0,0"
                        Visibility="Collapsed" VerticalAlignment="Center"
                        ToolTip="Stop the operation in progress"/>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4"
                             IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
