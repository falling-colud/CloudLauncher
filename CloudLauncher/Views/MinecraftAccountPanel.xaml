<Page x:Class="CloudLauncher.Views.MinecraftAccountPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Minecraft accounts"
      Background="{DynamicResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,28">

            <TextBlock Style="{StaticResource H2}" Text="Minecraft accounts"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="Add as many Microsoft or offline accounts as you like, then switch between them from this page or the title-bar chip."/>

            <!-- ACCOUNT LIST -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12" CornerRadius="10,10,0,0">
                        <DockPanel>
                            <TextBlock Text="Saved accounts" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AccountsCount" DockPanel.Dock="Right"
                                       Style="{StaticResource Caption}"/>
                        </DockPanel>
                    </Border>
                    <ItemsControl x:Name="AccountsList" Padding="6" anim:Animate.EntranceStagger="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="14,10" Margin="0,3"
                                        BorderThickness="1" ToolTip="{Binding RowTooltip}"
                                        anim:Animate.HoverLift="True">
                                    <!-- Colours come through DynamicResource so a theme change while
                                         this page is open repaints the rows with everything else. -->
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Use this account" Click="OnCtxUse"
                                                      Visibility="{Binding UseButtonVisibility}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy username" Click="OnCtxCopyUsername">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy UUID" Click="OnCtxCopyUuid"
                                                      IsEnabled="{Binding HasUuid}"
                                                      ToolTip="The Minecraft profile ID this account launches with"/>
                                            <Separator/>
                                            <MenuItem Header="Remove..." Click="OnCtxRemove">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Kind icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface4Brush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMicrosoft}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Content="Use" Click="OnUseAccount" Tag="{Binding Id}"
                                                    Style="{StaticResource AccentButton}"
                                                    Visibility="{Binding UseButtonVisibility}"
                                                    ToolTip="Launch Minecraft as this account from now on"
                                                    Margin="0,0,8,0"/>
                                            <TextBlock Text="In use" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                                       Visibility="{Binding ActiveLabelVisibility}"/>
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                                    FontSize="13" ToolTip="Remove account"
                                                    Click="OnRemoveAccount" Tag="{Binding Id}"
                                                    Foreground="{DynamicResource DangerBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyLabel" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,12,0,16"
                               Text="No accounts yet — add one below."
                               Visibility="Collapsed"/>
                </DockPanel>
            </Border>

            <!-- ADD MICROSOFT -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE748;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Button x:Name="MicrosoftButton" DockPanel.Dock="Right"
                                Content="Add Microsoft account" Style="{StaticResource AccentButton}"
                                Click="OnAddMicrosoft" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Microsoft" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Opens a sign-in window. Required for online servers."/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ADD OFFLINE -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource Surface4Brush}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Offline" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="Any username. Joins offline-mode servers only."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="Add offline" Click="OnAddOffline"
                                ToolTip="Adds the username on the left as an offline account"/>
                        <TextBox x:Name="OfflineNameBox" Margin="0,0,8,0" KeyDown="OnOfflineNameKeyDown"
                                 ToolTip="3 to 16 characters, the same rules Minecraft uses"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="0,16,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Page>
