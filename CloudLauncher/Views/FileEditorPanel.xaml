<UserControl x:Class="CloudLauncher.Views.FileEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}"
                            Click="OnSave" Margin="0,0,8,0" Padding="14,5"
                            ToolTip="Save this file (Ctrl+S)"/>
                    <Button x:Name="SaveAllButton" Content="Save all" Click="OnSaveAll" Margin="0,0,8,0"
                            Padding="12,5" ToolTip="Save every file with unsaved changes (Ctrl+Shift+S)"/>
                    <Button x:Name="RevertButton" Content="Revert" Click="OnRevert" Margin="0,0,8,0" Padding="12,5"
                            Style="{StaticResource SubtleButton}"
                            ToolTip="Throw away the changes to this file and reload it from disk"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8DA;"
                            FontFamily="{DynamicResource IconFont}" FontSize="13"
                            Click="OnRevealInExplorer" ToolTip="Show this file in Explorer"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PackLabel" VerticalAlignment="Center" FontWeight="SemiBold"
                               Margin="0,0,14,0" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                    <Button x:Name="RecentButton" Click="OnRecent" Margin="0,0,14,0" Padding="10,5"
                            ToolTip="Files you have edited in this instance before">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Recent &#x25BE;" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="ShowAllBox" Content="All files" VerticalAlignment="Center"
                              Margin="0,0,14,0" Click="OnShowAllToggled"
                              ToolTip="Also list files the editor does not recognise as text (jars, images and world data stay hidden)"/>
                    <CheckBox x:Name="WrapBox" Content="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="OnWrapToggled" ToolTip="Wrap long lines"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!--  File tree  -->
            <DockPanel Grid.Column="0" Background="{DynamicResource Surface1Brush}">
                <Border DockPanel.Dock="Top" Padding="8,7"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown"
                                 Padding="26,5,7,5"
                                 ToolTip="Filter by file name - searches the whole instance"/>
                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search files..." Margin="26,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <TextBlock x:Name="TreeStatus" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                           Margin="10,6,10,8" TextWrapping="Wrap"/>
                <TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          VirtualizingStackPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{Binding GlyphBrush}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{Binding NameBrush}"/>
                                <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" Width="5"/>

            <!--  Editor  -->
            <DockPanel Grid.Column="2">
                <!--  Open files. A ListBox rather than a TabControl: every tab shows the same editor
                     (one TextBox, contents swapped), so there is no per-tab content to host.  -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="OpenTabs" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnTabChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Background="Transparent"
                                                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                                        Padding="12,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{DynamicResource Surface0Brush}"/>
                                                        <Setter TargetName="bg" Property="BorderBrush"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        <Button Content="&#xE8BB;" FontFamily="{DynamicResource IconFont}"
                                                FontSize="8" Margin="8,0,0,0" Padding="3"
                                                MinWidth="0" MinHeight="0"
                                                Style="{StaticResource IconButton}"
                                                Click="OnCloseTab" Tag="{Binding}"
                                                ToolTip="Close"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!--  "The game is running" is a banner, not a status line, which the next
                RefreshStatus would overwrite.  -->
                <Border x:Name="RunningBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1"
                        Padding="12,9">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="This instance is running. Minecraft read its configs at startup and writes them back when it exits, so an edit made now is likely to be overwritten."/>
                    </DockPanel>
                </Border>

                <!--  Changed on disk. Two answers, both explicit: take theirs, or keep yours and
                     overwrite on the next save. Silently reloading would lose an edit; silently
                     doing nothing loses whatever the game just wrote.  -->
                <Border x:Name="DiskBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Reload from disk" Click="OnReloadFromDisk" Padding="10,4"
                                    Margin="10,0,0,0"
                                    ToolTip="Throw away what is in the editor and read the file again"/>
                            <Button Content="Keep mine" Click="OnKeepMine" Padding="10,4" Margin="8,0,0,0"
                                    ToolTip="Leave the editor as it is. Saving will overwrite the version on disk."/>
                        </StackPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="DiskBannerText" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!--  Find and replace: Ctrl+F shows it, Esc hides it. The box above the tree
                searches file names instead.  -->
                <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE74B;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        Click="OnFindPrevious" ToolTip="Previous match (Shift+F3)"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE74A;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="12"
                                        Margin="4,0,0,0"
                                        Click="OnFindNext" ToolTip="Next match (F3)"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="10"
                                        Margin="10,0,0,0"
                                        Click="OnCloseFind" ToolTip="Close the find bar (Esc)"/>
                            </StackPanel>
                            <TextBlock x:Name="FindStatus" DockPanel.Dock="Right"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"
                                       MinWidth="110" TextAlignment="Right" Margin="10,0,10,0"/>
                            <CheckBox x:Name="MatchCaseBox" DockPanel.Dock="Right" Content="Match case"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      Click="OnMatchCaseToggled"
                                      ToolTip="Treat upper and lower case as different"/>
                            <CheckBox x:Name="ReplaceBox" DockPanel.Dock="Right" Content="Replace"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      Click="OnToggleReplace"
                                      ToolTip="Show the replace row"/>
                            <Grid>
                                <TextBox x:Name="FindTextBox" Padding="26,3,7,3" VerticalContentAlignment="Center"
                                         TextChanged="OnFindTextChanged"
                                         KeyDown="OnFindBoxKeyDown"
                                         ToolTip="Search the text of the open file (Ctrl+F). F3 and Shift+F3 step through the matches."/>
                                <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="9,0,0,0"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Find in this file..." Margin="26,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FindTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>

                        <DockPanel x:Name="ReplaceRow" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Replace" Click="OnReplace" Padding="10,4"
                                        ToolTip="Replace the selected match and move to the next one"/>
                                <Button Content="Replace all" Click="OnReplaceAll" Padding="10,4" Margin="8,0,0,0"
                                        ToolTip="Replace every match in this file"/>
                            </StackPanel>
                            <Grid Margin="0,0,10,0">
                                <TextBox x:Name="ReplaceTextBox" Padding="10,3,7,3" VerticalContentAlignment="Center"
                                         KeyDown="OnReplaceBoxKeyDown"
                                         ToolTip="What each match becomes"/>
                                <TextBlock Text="Replace with..." Margin="11,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ReplaceTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  Go to line (Ctrl+G). A config error names a line number; this is how you get there.  -->
                <Border x:Name="GoToBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Go" Click="OnGoToGo" Padding="12,4"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                    FontFamily="{DynamicResource IconFont}" FontSize="10"
                                    Margin="10,0,0,0"
                                    Click="OnCloseGoTo" ToolTip="Close (Esc)"/>
                        </StackPanel>
                        <TextBlock x:Name="GoToHint" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <TextBox x:Name="GoToTextBox" Width="120" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" KeyDown="OnGoToKeyDown"
                                 ToolTip="Line number"/>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                    <DockPanel>
                        <TextBlock x:Name="CursorLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="SyntaxLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                   Margin="0,0,14,0"/>
                        <TextBlock x:Name="DirtyDot" DockPanel.Dock="Left" Text="&#x25CF;" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource WarningBrush}" Visibility="Collapsed"
                                   ToolTip="This file has unsaved changes"/>
                        <TextBlock x:Name="EditorStatus" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                    </DockPanel>
                </Border>

                <Grid x:Name="EditorSurface" Background="{DynamicResource LogBackgroundBrush}">
                    <!--  The syntax layer is inserted here in code, before the TextBox, so the
                    box's selection and caret draw over the coloured text.  -->
                    <TextBox x:Name="Editor"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource TextSelectionBrush}" SelectionOpacity="0.5"
                             BorderThickness="0" Padding="10,8"
                             VerticalContentAlignment="Top" HorizontalContentAlignment="Left"
                             TextChanged="OnEditorTextChanged"
                             SelectionChanged="OnEditorSelectionChanged"
                             IsInactiveSelectionHighlightEnabled="True"
                             Visibility="Collapsed"/>

                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="420" Margin="24">
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Style="{StaticResource H3}" Text="Pick a file to edit"
                                   HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Configs, KubeJS scripts, server lists - anything text inside this instance. Changes are saved straight into the instance folder, so close the game first if it is running."/>
                    </StackPanel>

                    <!--  Not a text file: shown instead of a screen of replacement characters.  -->
                    <StackPanel x:Name="BinaryPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="420" Margin="24" Visibility="Collapsed">
                        <TextBlock Text="&#xE8A5;" FontFamily="{DynamicResource IconFont}" FontSize="34"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="BinaryTitle" Style="{StaticResource H3}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,12,0,6" Text="This is not a text file"/>
                        <TextBlock x:Name="BinaryBody" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="BinaryMeta" Style="{StaticResource Caption}" TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Click="OnRevealInExplorer" Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Show in Explorer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenExternallyButton" Click="OnOpenExternally" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Open with Windows" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
