<Window x:Class="CloudLauncher.Views.FileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit files" Height="720" Width="1120" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface0Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButton}"
                            Click="OnSave" Margin="0,0,8,0" Padding="14,5"
                            ToolTip="Save this file (Ctrl+S)"/>
                    <Button x:Name="SaveAllButton" Content="Save all" Click="OnSaveAll" Margin="0,0,8,0"
                            Padding="12,5" ToolTip="Save every file with unsaved changes"/>
                    <Button Content="Revert" Click="OnRevert" Margin="0,0,8,0" Padding="12,5"
                            Style="{StaticResource SubtleButton}"
                            ToolTip="Throw away the changes to this file and reload it from disk"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8DA;"
                            FontFamily="{StaticResource IconFont}" FontSize="13"
                            Click="OnRevealInExplorer" ToolTip="Show this file in Explorer"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PackLabel" VerticalAlignment="Center" FontWeight="SemiBold"
                               Margin="0,0,14,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                    <CheckBox x:Name="ShowAllBox" Content="All files" VerticalAlignment="Center"
                              Margin="0,0,14,0" Click="OnShowAllToggled"
                              ToolTip="Also list files the editor does not recognise as text (jars, images and world data stay hidden)"/>
                    <CheckBox x:Name="WrapBox" Content="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"
                              Click="OnWrapToggled" ToolTip="Wrap long lines"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- File tree -->
            <DockPanel Grid.Column="0" Background="{DynamicResource Surface1Brush}">
                <Border DockPanel.Dock="Top" Padding="8,7"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                             Tag="Search files…"
                             ToolTip="Filter by file name — searches the whole instance"/>
                </Border>
                <TextBlock x:Name="TreeStatus" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                           Margin="10,6,10,8" TextWrapping="Wrap"/>
                <TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0"
                          SelectedItemChanged="OnTreeSelectionChanged"
                          VirtualizingStackPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"
                                           Foreground="{Binding GlyphBrush}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{Binding NameBrush}"/>
                                <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" Width="5"/>

            <!-- Editor -->
            <DockPanel Grid.Column="2">
                <!-- Open files. A ListBox rather than a TabControl: every tab shows the same editor
                     (one TextBox, contents swapped), so there is no per-tab content to host. -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="OpenTabs" Background="Transparent" BorderThickness="0"
                                 SelectionChanged="OnTabChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Background="Transparent"
                                                        BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                                        Padding="12,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{DynamicResource Surface0Brush}"/>
                                                        <Setter TargetName="bg" Property="BorderBrush"
                                                                Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                        <Button Content="&#xE8BB;" FontFamily="{StaticResource IconFont}"
                                                FontSize="8" Margin="8,0,0,0" Padding="3"
                                                MinWidth="0" MinHeight="0"
                                                Style="{StaticResource IconButton}"
                                                Click="OnCloseTab" Tag="{Binding}"
                                                ToolTip="Close"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <!-- Find bar. Ctrl+F shows it, Esc puts it away; the box at the top of the window
                     searches file NAMES, which is a different question and was the only one the
                     editor could answer until now. -->
                <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE74B;"
                                    FontFamily="{StaticResource IconFont}" FontSize="12"
                                    Click="OnFindPrevious" ToolTip="Previous match (Shift+F3)"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74A;"
                                    FontFamily="{StaticResource IconFont}" FontSize="12"
                                    Margin="4,0,0,0"
                                    Click="OnFindNext" ToolTip="Next match (F3)"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                    FontFamily="{StaticResource IconFont}" FontSize="10"
                                    Margin="10,0,0,0"
                                    Click="OnCloseFind" ToolTip="Close the find bar (Esc)"/>
                        </StackPanel>
                        <TextBlock x:Name="FindStatus" DockPanel.Dock="Right"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   MinWidth="110" TextAlignment="Right" Margin="10,0,10,0"/>
                        <CheckBox x:Name="MatchCaseBox" DockPanel.Dock="Right" Content="Match case"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  Click="OnMatchCaseToggled"
                                  ToolTip="Treat upper and lower case as different"/>
                        <Grid>
                            <TextBox x:Name="FindBox" Padding="26,3,7,3" VerticalContentAlignment="Center"
                                     TextChanged="OnFindTextChanged"
                                     KeyDown="OnFindBoxKeyDown"
                                     ToolTip="Search the text of the open file (Ctrl+F). F3 and Shift+F3 step through the matches."/>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="9,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="Find in this file…" Margin="26,0,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FindBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
                    <DockPanel>
                        <TextBlock x:Name="CursorLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="EditorStatus" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                    </DockPanel>
                </Border>

                <Grid>
                    <TextBox x:Name="Editor"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Background="{DynamicResource LogBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource AccentSoftBrush}"
                             BorderThickness="0" Padding="10,8"
                             TextChanged="OnEditorTextChanged"
                             SelectionChanged="OnEditorSelectionChanged"
                             IsInactiveSelectionHighlightEnabled="True"
                             Visibility="Collapsed"/>
                    <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="420">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="28"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock Style="{StaticResource H3}" Text="Pick a file to edit"
                                   HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Configs, KubeJS scripts, server lists — anything text inside this instance. Changes are saved straight into the instance folder, so close the game first if it is running."/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>

        <!-- Confirmations render inside this window: it is its own top-level window, so an overlay
             drawn on the main one would appear behind it. -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
