<Window x:Class="CloudLauncher.Views.FileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CloudLauncher.Views"
        Title="Edit files" Height="720" Width="1120" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface0Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <!--  The editor is a UserControl, also shown as a tab on the File Management page.  -->
        <local:FileEditorPanel x:Name="Panel"/>

        <!--  Confirmations render here; an overlay on the main window would be behind this one.  -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
