<Window x:Class="CloudLauncher.Views.PackPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        Title="Choose an instance" Height="470" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="22">
        <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}"
                   Text="Apply defaults to..." Margin="0,0,0,8"/>
        <TextBlock x:Name="DescriptionLabel" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                   Text="Pick an instance - the options.txt inside its game folder will be merged with the launcher defaults."
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply" Style="{StaticResource AccentButton}"
                    Click="OnApply" IsDefault="True"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Click="OnCancel" IsCancel="True"/>
        </DockPanel>

        <!-- Search box above the list: typing a few letters is quicker than scrolling for the row. -->
        <slate:SlateBorder DockPanel.Dock="Top" Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                MinHeight="34" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="11,0,8,0"/>
                <Grid Grid.Column="1">
                    <TextBlock x:Name="SearchPlaceholder" Text="Search instances..." IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Margin="0,0,10,0" TextChanged="OnSearch"
                             PreviewKeyDown="OnSearchKeyDown"
                             GotKeyboardFocus="OnSearchFocus" LostKeyboardFocus="OnSearchFocus">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Grid>
        </slate:SlateBorder>

        <Grid>
            <ListBox x:Name="PackList" MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionLabel}"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyLabel" Style="{StaticResource Muted}" Visibility="Collapsed"
                       Text="No instances match that search."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
        </Grid>
    </DockPanel>
</Window>
