<UserControl x:Class="CloudLauncher.Views.ConfigCompareCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <UserControl.Resources>
        <!-- The tint behind an added or removed line. Drawn as a separate rectangle rather than as the
             row's own background so the line's text keeps full contrast, and themed with
             DynamicResource so a theme switch repaints an open diff. -->
        <Style x:Key="DiffTint" TargetType="Rectangle">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.18"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindName}" Value="Added">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="Removed">
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DiffSign" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindName}" Value="Added">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindName}" Value="Removed">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="1040" Height="680">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;"
                        FontFamily="{StaticResource IconFont}" FontSize="13" Click="OnClose"
                        VerticalAlignment="Top" ToolTip="Close (Esc)"/>
                <StackPanel>
                    <TextBlock x:Name="TitleLabel" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PathLabel" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Which two instances -->
            <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Caption}" Text="LEFT — the file as it is here"
                               FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                    <ComboBox x:Name="LeftBox" Margin="0,4,0,0" DisplayMemberPath="Label"
                              SelectionChanged="OnSideChanged"
                              ToolTip="Removed lines come from this instance"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8AB;"
                        FontFamily="{StaticResource IconFont}" FontSize="13" Click="OnSwap"
                        VerticalAlignment="Bottom" Margin="0,0,0,2" ToolTip="Swap the two sides"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Caption}" Text="RIGHT — compared against this"
                               FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    <ComboBox x:Name="RightBox" Margin="0,4,0,0" DisplayMemberPath="Label"
                              SelectionChanged="OnSideChanged"
                              ToolTip="Added lines come from this instance"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock x:Name="SummaryLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,420,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyLeftButton" Content="Copy left over right" Click="OnCopyLeftToRight"
                            Margin="0,0,8,0" Padding="12,5"
                            ToolTip="Replace the right instance's file with the left one. The replaced file is backed up first."/>
                    <Button x:Name="CopyRightButton" Content="Copy right over left" Click="OnCopyRightToLeft"
                            Margin="0,0,8,0" Padding="12,5"
                            ToolTip="Replace the left instance's file with the right one. The replaced file is backed up first."/>
                    <Button Content="Close" Style="{StaticResource AccentButton}" Click="OnClose" Padding="16,5"/>
                </StackPanel>
            </Grid>

            <!-- The diff -->
            <Border Margin="0,14,0,0" CornerRadius="8"
                    Background="{DynamicResource LogBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Grid>
                    <ListBox x:Name="DiffList" Background="Transparent" BorderThickness="0"
                             Padding="4,6" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             anim:Animate.SmoothScroll="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Rectangle Style="{StaticResource DiffTint}"/>
                                    <DockPanel Margin="6,0">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding LeftNumberLabel}"
                                                   FontFamily="Consolas" FontSize="11" Width="42"
                                                   TextAlignment="Right" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding RightNumberLabel}"
                                                   FontFamily="Consolas" FontSize="11" Width="42"
                                                   TextAlignment="Right" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Sign}"
                                                   Style="{StaticResource DiffSign}"/>
                                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                                   Foreground="{DynamicResource LogTextBrush}"
                                                   TextWrapping="NoWrap"/>
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="SameState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="440" Visibility="Collapsed">
                        <TextBlock x:Name="SameGlyph" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                   FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock x:Name="SameTitle" Style="{StaticResource H3}" Text="These files are identical"
                                   HorizontalAlignment="Center" Margin="0,12,0,6" TextAlignment="Center"/>
                        <TextBlock x:Name="SameBody" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
