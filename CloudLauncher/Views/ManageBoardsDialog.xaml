<UserControl x:Class="CloudLauncher.Views.ManageBoardsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="20" Width="460" MaxHeight="600">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Manage boards" Style="{StaticResource H2}"/>
                    <TextBlock Text="Reorder, group and organise your planning boards"
                               Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="Status" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                           MaxWidth="180" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="New board" Style="{StaticResource SubtleButton}" Padding="12,6"
                            Click="OnNewBoard"/>
                    <Button Content="New category" Style="{StaticResource SubtleButton}" Padding="12,6"
                            Margin="8,0,0,0" Click="OnNewCategory"/>
                </StackPanel>
                <Button Content="Done" Style="{StaticResource AccentButton}" Padding="16,6"
                        HorizontalAlignment="Right" Click="OnDone"/>
            </Grid>

            <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel x:Name="ListHost" AllowDrop="True"
                                DragOver="OnListDragOver" Drop="OnListDrop" DragLeave="OnListDragLeave"/>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
