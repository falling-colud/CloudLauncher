<Page x:Class="CloudLauncher.Views.WorldsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:v="clr-namespace:CloudLauncher.Views"
      Title="Worlds"
      Background="{DynamicResource Surface0Brush}">

    <!--  Standard six-row page: header / actions / divider / strip / content / status.
    Every world on this PC, grouped into folders you make (they work as on the Instances page);
    clicking a world opens its page on the right. One row per world: its copies in several
    instances fold into one row (see WorldsView.WorldGroup), but the saves are never shared.
    The actions bar matches the other content pages: accent Import, then Browse, with
    search / open folder / refresh on the right. Spacing and sizes come from
    Themes/Controls.xaml.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: title and a one-line description ───────────────────── -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource H1}" Text="Worlds"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Every world on this PC, across all your instances. File them into folders, and click one to open its own page."/>
            </StackPanel>
        </DockPanel>

        <!-- ── Row 1: actions bar ──────────────────────────────────────────── -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-3,0,-3">
                <!--  The one accent button; on content pages it is always Import. Picking a .zip or a
                save folder, and publishing, happen in the import wizard.  -->
                <Button x:Name="ImportButton" Style="{StaticResource AccentButton}"
                        Margin="0,3,8,3" Click="OnImport"
                        ToolTip="Bring a world in from a .zip or an unzipped save folder, into any instances you choose, and published if you want. You can also drop either onto this page.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BrowseButton" Style="{StaticResource HeaderActionButton}"
                        Click="OnBrowse"
                        ToolTip="Browse CurseForge and CloudLauncher for a world" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <v:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0"
                                    Placeholder="Filter worlds"
                                    SearchToolTip="Filter by name, save folder or instance (Ctrl+F)"/>
                <!--  Icon-only utilities, in this order: open folder, then refresh. saves/ is per
                instance, so OnOpenFolder picks an instance first.  -->
                <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnOpenFolder"
                        Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Open an instance's saves folder"/>
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Re-read every instance's saves folder (F5). A remembered list can miss an edit that changed no file's size."/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!-- ── Row 3: sort · instance scope · folders ─────────────────────── -->
        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}"
                        Click="OnSortButtonClick"
                        Content="&#xE8CB;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Sort worlds">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSortMenuOpened">
                            <MenuItem x:Name="SortModifiedMenuItem" Header="Last played" Tag="Modified"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="Name"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortSizeMenuItem" Header="Size" Tag="Size"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortPackMenuItem" Header="Instance" Tag="Pack"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!--  Scoping to an instance filters rows without regrouping them. A row then acts on
                the copy in that instance, so rename renames the save you are looking at. See
                WorldsView.BuildRows.  -->
                <ComboBox x:Name="PackScopeBox" Width="240" Margin="0,0,8,0"
                          SelectionChanged="OnPackScopeChanged"
                          ToolTip="Narrow the page to one instance - only the worlds it holds are listed, and each row is that instance's copy"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Active state is an accent border and a bolder label, set by
                            DataTriggers on DynamicResource brushes. ThemeService creates new
                            brushes on every apply, so a brush stored on the row would keep
                            the old accent.  -->
                            <slate:SlateBorder Style="{StaticResource FolderChipBorder}"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <slate:SlateBorder.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename folder..." Click="OnFolderRename"/>
                                        <MenuItem Header="Delete folder..." Click="OnFolderDelete"/>
                                    </ContextMenu>
                                </slate:SlateBorder.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource FolderChipGlyph}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FolderChipLabel}"/>
                                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource FolderChipCount}"/>
                                    <!--  No settings gear: rename and delete are on this chip's
                                    right-click menu, and adding a world to a folder is on the
                                    world's row menu.  -->
                                </StackPanel>
                            </slate:SlateBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── Row 4: the list ────────────────────────────────────────────── -->
        <!--  AllowDrop is on this Grid because PageState collapses the list while the page
        is empty, and the empty panel offers dropping a world here.  -->
        <Grid Grid.Row="4" Margin="28,0,28,16"
              Background="Transparent"
              AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
            <v:ContentListView x:Name="WorldList"/>

            <!--  Last child so it draws over the list. The loading, empty, filtered-empty, error
            and offline states all come from Views/PageState.cs.  -->
            <v:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!-- ── Row 5: status left, count and progress right ───────────────── -->
        <Border Grid.Row="5" Style="{StaticResource PageStatusBar}">
            <DockPanel>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <!--  No Click handler: PageState.Slots wires this button to CancelRequested, and a
                second handler here would cancel twice.  -->
                <Button x:Name="BusyCancelButton" DockPanel.Dock="Right" Content="Cancel"
                        Padding="10,2" MinHeight="0" MinWidth="0" Margin="12,0,0,0"
                        Visibility="Collapsed" VerticalAlignment="Center"
                        ToolTip="Stop the operation in progress"/>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4"
                             IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
