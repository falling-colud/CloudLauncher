<Page x:Class="CloudLauncher.Views.WorldsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Worlds"
      Background="{StaticResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,18">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Worlds"/>
                <TextBlock Style="{StaticResource Muted}"
                           Text="Saves discovered across your instances. Pick which instances can launch each world."/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,12,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Click="OnDownloadWorld"
                        Content="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Download a world from CurseForge or CloudLauncher"/>
                <Button Style="{StaticResource IconButton}" Click="OnImportWorld"
                        Content="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Import a world from disk"/>
                <Button Style="{StaticResource IconButton}" Click="OnCreateFolder"
                        Content="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Create folder"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border x:Name="CompactSearchHost"
                        Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" MinHeight="36" Width="36"
                        HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SearchToggleButton" Grid.Column="0"
                                Style="{StaticResource IconButton}" Click="OnSearchToggle"
                                Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                ToolTip="Search worlds"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Visibility="Collapsed"
                                 TextChanged="OnSearchTextChanged"
                                 PreviewKeyDown="OnSearchPreviewKeyDown"
                                 LostKeyboardFocus="OnSearchLostKeyboardFocus"
                                 ToolTip="Filter worlds by name">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Style="{StaticResource IconButton}" Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Refresh"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Height="1" Margin="28,4,28,10"
                Background="{StaticResource BorderSubtleBrush}"/>

        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SortButton" Grid.Column="0"
                    Style="{StaticResource IconButton}" Click="OnSortButtonClick"
                    Content="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="13"
                    Margin="0,2,8,2" Padding="8,5"
                    ToolTip="Sort worlds">
                <Button.ContextMenu>
                    <ContextMenu Opened="OnSortMenuOpened">
                        <MenuItem x:Name="SortModifiedMenuItem" Header="Last modified" Tag="Modified"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="Name"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortSizeMenuItem" Header="Size" Tag="Size"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                        <MenuItem x:Name="SortPackMenuItem" Header="Source instance" Tag="Pack"
                                  IsCheckable="True" Click="OnSortMenuItemClick"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0" Margin="0,2,8,2" Cursor="Hand"
                                    Background="{Binding Background}"
                                    BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                    CornerRadius="14"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename folder" Click="OnFolderRename"/>
                                        <MenuItem Header="Delete folder" Click="OnFolderDelete"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               Margin="12,0,6,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground}"/>
                                    <TextBlock Text="{Binding Label}" Margin="0,0,4,0"
                                               Padding="0,5,0,5"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground}"
                                               FontWeight="{Binding FontWeight}"/>
                                    <TextBlock Text="{Binding CountLabel}" Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding CountForeground}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="4" Padding="20,14,20,16" VerticalScrollBarVisibility="Auto"
                      SizeChanged="OnWorldListContainerSizeChanged">
            <Grid>
                <ItemsControl x:Name="WorldList" HorizontalAlignment="Stretch"
                              anim:Animate.EntranceStagger="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid x:Name="WorldGrid" Columns="4" Loaded="OnWorldGridLoaded"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CardRoot" Margin="6" Cursor="Hand"
                                    Height="260" VerticalAlignment="Top"
                                    anim:Animate.HoverLift="True"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10"
                                    MouseLeftButtonUp="OnWorldCardClick">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Effect" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open world" Click="OnCtxEdit"/>
                                        <MenuItem Header="Edit compatibility" Click="OnCtxEdit"/>
                                        <MenuItem Header="Launch with..." Click="OnCtxLaunch"/>
                                        <Separator/>
                                        <MenuItem Header="Reveal in Explorer" Click="OnCtxReveal"/>
                                        <MenuItem Header="Rename" Click="OnCtxRename"/>
                                        <Separator/>
                                        <MenuItem x:Name="CtxAddToFolderMenu" Header="Add to folder"
                                                  SubmenuOpened="OnCtxAddToFolderOpened"/>
                                        <Separator/>
                                        <MenuItem Header="Copy world key" Click="OnCtxCopyKey"/>
                                        <MenuItem Header="Delete world..." Click="OnCtxDelete"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid ClipToBounds="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{Binding CoverBackground}"
                                            CornerRadius="9,9,0,0" ClipToBounds="True"
                                            MinHeight="120">
                                        <Grid>
                                            <Image Source="{Binding IconImage}"
                                                   Visibility="{Binding IconImageVisibility}"
                                                   Stretch="UniformToFill"/>
                                            <Border Background="{StaticResource AccentGlowBrush}" Opacity="0.05"/>
                                            <TextBlock Text="{Binding Initial}"
                                                       Visibility="{Binding FallbackVisibility}"
                                                       FontFamily="{StaticResource HeadingFont}"
                                                       FontSize="64" FontWeight="Bold"
                                                       Foreground="White" Opacity="0.92"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Style="{StaticResource Pill}"
                                                    Background="{StaticResource Surface4Brush}"
                                                    Margin="0,10,10,0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding SourcePackName}" Style="{StaticResource PillText}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="#66000000" CornerRadius="4"
                                                    Margin="10,0,0,10" Padding="6,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                                <TextBlock Text="WORLD" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="12,10,12,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding MetaLabel}"
                                                   Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource PlayButton}" Padding="12,5"
                                                    MinHeight="30" MinWidth="0"
                                                    Click="OnPlayClick">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Play" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CompatibilityLabel}"
                                                           Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE909;" FontFamily="{StaticResource IconFont}" FontSize="48"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock Style="{StaticResource H2}" Text="No worlds yet"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                               Text="Launch an instance and create a world - it'll show up here."/>
                    <Button Content="Import world" Style="{StaticResource AccentButton}"
                            Click="OnImportWorld" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <StackPanel x:Name="EmptyFolderState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,80,0,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="48"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock Style="{StaticResource H2}" x:Name="EmptyFolderTitle"
                               Text="Folder is empty"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                               Text="Right-click a world on the All page and pick &quot;Add to folder&quot; to link it here."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="5" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,8">
            <DockPanel>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
