<UserControl x:Class="CloudLauncher.Views.ModDownloadOptionsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="24" MinWidth="340" MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,16"
                       Text="Set the options to apply to this mod, then download."/>

            <TextBlock Style="{StaticResource Caption}" Text="Priority"/>
            <ComboBox x:Name="PriorityBox" Margin="0,4,0,14">
                <ComboBoxItem Content="Normal (0)" IsSelected="True"/>
                <ComboBoxItem Content="P1"/>
                <ComboBoxItem Content="P2"/>
                <ComboBoxItem Content="P3"/>
                <ComboBoxItem Content="P4"/>
                <ComboBoxItem Content="P5"/>
            </ComboBox>

            <TextBlock Style="{StaticResource Caption}" Text="Side"/>
            <StackPanel Margin="0,6,0,14">
                <RadioButton x:Name="SideBoth" Content="Client + Server" GroupName="side" IsChecked="True" Margin="0,3"/>
                <RadioButton x:Name="SideClient" Content="Client only" GroupName="side" Margin="0,3"/>
                <RadioButton x:Name="SideServer" Content="Server only" GroupName="side" Margin="0,3"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Caption}" Text="Flags"/>
            <StackPanel Margin="0,6,0,18">
                <CheckBox x:Name="LibraryBox" Content="Library" Margin="0,3"/>
                <CheckBox x:Name="TestingBox" Content="Testing" Margin="0,3"/>
                <CheckBox x:Name="ExtraBox" Content="Extra (optional)" Margin="0,3"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnCancel"/>
                <Button Content="Download" Style="{StaticResource AccentButton}" Click="OnDownload"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
