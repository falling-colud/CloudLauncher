<UserControl x:Class="CloudLauncher.Views.DataPacksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:local="clr-namespace:CloudLauncher.Views">
    <UserControl.Resources>
        <!--  Same switch as the Resources tab and the Mods tab.  -->
        <Style x:Key="PackToggleSwitch" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <slate:SlateBorder x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </slate:SlateBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,18,0,18">
            <!--  This world's own packs.  -->
            <slate:SlateBorder x:Name="WorldCard" Style="{StaticResource Card}" Padding="0"
                    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
                <DockPanel>
                    <slate:SlateBorder DockPanel.Dock="Top"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="14,10" CornerRadius="10,10,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Click="OnRefresh" VerticalAlignment="Center"
                                    Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                    ToolTip="Read the list again"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Click="OnOpenFolder" VerticalAlignment="Center"
                                    Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                    ToolTip="Open this world's datapacks folder in Explorer"/>
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add from file..."
                                    Click="OnAdd" Margin="0,0,8,0" Padding="10,4" VerticalAlignment="Center"
                                    ToolTip="Copy a data pack (.zip) into this world. You can also drop a zip or a pack folder on this box."/>
                            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                                    Click="OnBrowse" Margin="0,0,8,0" Padding="10,4" VerticalAlignment="Center"
                                    ToolTip="Search CurseForge and Modrinth for data packs">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                               Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Data packs in this world" Style="{StaticResource H3}"/>
                                <TextBlock x:Name="HintText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Text="Loaded when the world opens. A change here takes effect the next time it loads."/>
                            </StackPanel>
                        </DockPanel>
                    </slate:SlateBorder>

                    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                               Margin="14,6,14,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                               Margin="14" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="No data packs in this world. Browse the stores, add a .zip from a file, or drop one here."/>

                    <ItemsControl x:Name="PackList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" Background="{DynamicResource Surface1Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                        ToolTip="{Binding Tooltip}">
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PackToggleSwitch}"
                                                      IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                                      Click="OnToggle" Tag="{Binding}" VerticalAlignment="Center"
                                                      Margin="8,0,0,0" ToolTip="{Binding ToggleTip}"/>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE712;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                                Padding="6,3" MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                                Click="OnRowMenu" Tag="{Binding}" ToolTip="More"/>
                                        <slate:SlateBorder DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </slate:SlateBorder>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <slate:SlateBorder Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                        Background="{DynamicResource Surface4Brush}"
                                                        Visibility="{Binding StateVisibility}">
                                                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource PillText}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </slate:SlateBorder>
                                                <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                        Visibility="{Binding WarningVisibility}"
                                                        ToolTip="{Binding WarningTip}">
                                                    <TextBlock Text="NO PACK.MCMETA" Style="{StaticResource PillText}"
                                                               Foreground="{DynamicResource WarningBrush}"/>
                                                </slate:SlateBorder>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </slate:SlateBorder>

            <!--  Every world, through a mod like Paxi; or why there is no such thing here.  -->
            <local:AlwaysOnPacksPanel x:Name="GlobalPanel" Margin="0,14,0,0" Visibility="Collapsed"/>
            <slate:SlateBorder x:Name="NoGlobalCard" Style="{StaticResource Card}" Margin="0,14,0,0"
                    Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Every world" Style="{StaticResource H3}"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Data packs are per world: a pack added here is only in this world, and worlds you make later start without it. To load a pack in every world, new ones too, add a mod such as Paxi, Global Packs or Open Loader to this instance - then its folder shows up here."/>
                </StackPanel>
            </slate:SlateBorder>
        </StackPanel>
    </ScrollViewer>
</UserControl>
