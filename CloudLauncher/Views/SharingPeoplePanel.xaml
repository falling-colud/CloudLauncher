<UserControl x:Class="CloudLauncher.Views.SharingPeoplePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:v="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations"
             SizeChanged="OnPanelSizeChanged">
    <!--  The teams screen as one control, hosted both as the Teams side panel (TeamsView) and as the
    sharing hub's "People & teams" tab. The layout adapts to the width: the team list sits beside
    the detail when wide and above it when narrow.  -->
    <UserControl.Resources>
        <!--  Row-level pills. Declared here rather than inline so a live theme change repaints them.  -->
        <Style x:Key="RowPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!--  ShowOnDisabled: buttons disabled while the server is unreachable explain why in their
        tooltip, and WPF hides tooltips on disabled controls by default.  -->
        <Style x:Key="RowAction" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
        <Style x:Key="RowDangerAction" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ ROW 0: INVITATIONS WAITING FOR ME ══ -->
        <!--  At the top because it is the only thing here that someone else is waiting on. Collapsed
        when there are none.  -->
        <slate:SlateBorder x:Name="MyInvitesCard" Grid.Row="0" Style="{StaticResource Card}"
                Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE716;" FontFamily="{DynamicResource IconFont}"
                               FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MyInvitesHeadline" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl x:Name="MyInvitesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowAction}" Content="Join"
                                            Click="OnAcceptMyInvite" ToolTip="{Binding JoinTip}"/>
                                    <Button Style="{StaticResource RowAction}" Content="Decline"
                                            Click="OnDeclineMyInvite" ToolTip="{Binding DeclineTip}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </slate:SlateBorder>

        <!-- ══ ROW 1: READ-ONLY / OFFLINE BANNER ══ -->
        <!--  Warning border because nothing is broken: the list is the last one the server sent, and
        the buttons that need the server are disabled with a reason.  -->
        <slate:SlateBorder x:Name="StaleBanner" Grid.Row="1"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,9" Margin="0,0,0,12" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="StaleRetryButton" DockPanel.Dock="Right" Content="Retry"
                        Style="{StaticResource LinkButton}" Click="OnRefresh"
                        VerticalAlignment="Center" Margin="12,0,0,0"
                        ToolTip="Ask the server for your teams again"/>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}"
                           FontSize="14" Foreground="{DynamicResource WarningBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="StaleText" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </slate:SlateBorder>

        <!-- ══ ROW 2: TOOLBAR ══ -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!--  Secondary style, since both hosting pages already have an accent button of their own.  -->
                <Button x:Name="NewTeamButton" Style="{StaticResource HeaderActionButton}"
                        Click="OnNewTeam"
                        ToolTip="Create a team. The name only has to be unique among your own teams.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New team" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="JoinButton" Style="{StaticResource HeaderActionButton}"
                        Click="OnJoinWithCode"
                        ToolTip="Join a team somebody sent you an invite code for">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Join with a code" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="CountLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}"
                        Content="&#xE8CB;" FontFamily="{DynamicResource IconFont}"
                        Click="OnSortMenu" ToolTip="How the team list is ordered">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="SortByName" Header="Name" IsCheckable="True"
                                      IsChecked="True" Click="OnSortPicked"/>
                            <MenuItem x:Name="SortByMembers" Header="Members" IsCheckable="True"
                                      Click="OnSortPicked"/>
                            <MenuItem x:Name="SortByShared" Header="Shared items" IsCheckable="True"
                                      Click="OnSortPicked"/>
                            <MenuItem x:Name="SortByRole" Header="Teams I own first" IsCheckable="True"
                                      Click="OnSortPicked"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <v:CompactSearchBox x:Name="SearchBox" ExpandedWidth="220" Margin="0,0,8,0"
                                    Placeholder="Filter teams"
                                    SearchToolTip="Filter your teams by name or owner (Ctrl+F)"/>
                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarIconButton}" Margin="0"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        Click="OnRefresh" ToolTip="Refresh your teams (F5)"/>
            </StackPanel>
        </Grid>

        <!-- ══ ROW 3: LIST + DETAIL ══ -->
        <!--  Row/column sizes and the panes' Grid.Row/Column are re-assigned in OnPanelSizeChanged;
             the values here are the wide layout, which is also what the designer shows.  -->
        <Grid x:Name="ContentGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="340"/>
                <ColumnDefinition x:Name="DetailColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ListRow" Height="*"/>
                <RowDefinition x:Name="DetailRow" Height="0"/>
            </Grid.RowDefinitions>

            <slate:SlateBorder x:Name="ListPane" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                    Style="{StaticResource Card}" Padding="0" Margin="0,0,12,0">
                <Grid>
                    <ListBox x:Name="TeamsList" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" Padding="6"
                             SelectionChanged="OnTeamSelected"
                             anim:Animate.EntranceStagger="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="6,5"
                                        anim:Animate.HoverLift="True" ToolTip="{Binding RowTooltip}">
                                    <Border.ContextMenu>
                                        <!--  Only the actions this viewer's role permits.  -->
                                        <ContextMenu>
                                            <MenuItem Header="Rename..." Click="OnCtxRename"
                                                      Visibility="{Binding RenameVisibility}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8AC;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Transfer ownership..." Click="OnCtxTransfer"
                                                      Visibility="{Binding TransferVisibility}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8D7;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Invite people..." Click="OnCtxInvite"
                                                      Visibility="{Binding InviteVisibility}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE716;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Copy team ID" Click="OnCtxCopyTeamId">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="Leave team" Click="OnCtxLeave"
                                                      Visibility="{Binding LeaveVisibility}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE89B;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Delete team..." Click="OnCtxDelete"
                                                      Visibility="{Binding DeleteVisibility}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <!--  Colour derived from the team id, so teams with the
                                        same name still look different. Not stored: the server has
                                        no colour column, and it should match on every PC.  -->
                                        <slate:SlateBorder DockPanel.Dock="Left" Width="4" CornerRadius="2"
                                                Background="{Binding ColourBrush}" Margin="0,1,10,1"/>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource RowPill}">
                                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource PillText}"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubLabel}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Last in the cell so it draws over the list - see PageStateView.  -->
                    <v:PageStateView x:Name="TeamsStateHost"/>
                </Grid>
            </slate:SlateBorder>

            <Grid x:Name="DetailPane" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              anim:Animate.SmoothScroll="True">
                    <StackPanel x:Name="DetailStack" Visibility="Collapsed">

                        <!-- ── team header ── -->
                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <slate:SlateBorder DockPanel.Dock="Left" x:Name="DetailColour"
                                            Width="6" Height="30" CornerRadius="3"
                                            Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource RowPill}">
                                        <TextBlock x:Name="DetailRolePill" Style="{StaticResource PillText}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DetailName" Style="{StaticResource H3}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DetailSub" Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>

                                <!--  Team actions, including ownership transfer, sit in the header instead of a
                                row context menu.  -->
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="InviteButton" Style="{StaticResource HeaderActionButton}"
                                            Click="OnInvite" Margin="0,0,8,6"
                                            ToolTip="Invite somebody by username, or mint a code anybody can use">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE716;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Invite people" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TransferButton" Style="{StaticResource HeaderActionButton}"
                                            Click="OnTransfer" Margin="0,0,8,6"
                                            ToolTip="Hand the team to another member. You stay on it as an admin.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D7;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Transfer ownership..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RenameButton" Style="{StaticResource HeaderActionButton}"
                                            Click="OnRename" Margin="0,0,8,6"
                                            ToolTip="Rename the team (F2). Only has to be unique among your own.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AC;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Rename..." VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LeaveButton" Style="{StaticResource HeaderActionButton}"
                                            Click="OnLeave" Margin="0,0,8,6"
                                            ToolTip="Take yourself off this team. You lose whatever it shares with you.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE89B;" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Leave team" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteButton" Style="{StaticResource DangerButton}"
                                            Content="Delete team..." Click="OnDelete"
                                            Padding="12,6" Margin="0,0,8,6"
                                            ToolTip="Delete the team. Everything shared with it loses that access."/>
                                    <Button x:Name="CopyIdButton" Style="{StaticResource ToolbarIconButton}"
                                            Content="&#xE8C8;" FontFamily="{DynamicResource IconFont}"
                                            Margin="0,0,0,6" Click="OnCopyTeamId"
                                            ToolTip="Copy this team's ID - works offline"/>
                                </WrapPanel>
                            </StackPanel>
                        </slate:SlateBorder>

                        <!-- ── members ── -->
                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="MembersCount" DockPanel.Dock="Right"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Members" Style="{StaticResource H3}"/>
                                </DockPanel>
                                <ItemsControl x:Name="MembersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3" ToolTip="{Binding RowTooltip}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarIconButton}"
                                                        Margin="6,0,0,0" Content="&#xE712;"
                                                        FontFamily="{DynamicResource IconFont}"
                                                        Visibility="{Binding MenuVisibility}"
                                                        Click="OnMemberMenu"
                                                        ToolTip="What you can do with this member">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Make an admin" Click="OnMakeAdmin"
                                                                      Visibility="{Binding MakeAdminVisibility}"/>
                                                            <MenuItem Header="Make an ordinary member" Click="OnMakeMember"
                                                                      Visibility="{Binding MakeMemberVisibility}"/>
                                                            <MenuItem Header="Hand the team over..." Click="OnMakeOwner"
                                                                      Visibility="{Binding MakeOwnerVisibility}">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8D7;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="Copy user ID" Click="OnCopyUserId">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowDangerAction}"
                                                        Content="Remove" Click="OnRemoveMember"
                                                        Visibility="{Binding RemoveVisibility}"
                                                        IsEnabled="{Binding ActionsEnabled}"
                                                        ToolTip="{Binding RemoveTip}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowDangerAction}"
                                                        Content="Leave team" Click="OnLeave"
                                                        Visibility="{Binding LeaveVisibility}"
                                                        IsEnabled="{Binding ActionsEnabled}"
                                                        ToolTip="{Binding LeaveTip}"/>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource RowPill}">
                                                    <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource PillText}"/>
                                                </Border>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding JoinedLabel}"
                                                           Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <slate:SlateBorder Width="26" Height="26" CornerRadius="13"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}"
                                                                   FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </slate:SlateBorder>
                                                    <TextBlock Text="{Binding Username}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="you" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                               Visibility="{Binding YouVisibility}"/>
                                                    <TextBlock Text="unverified email" Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Visibility="{Binding UnverifiedVisibility}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="MembersNote" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <!-- ── invitations this team has sent ── -->
                        <slate:SlateBorder x:Name="InvitesCard" Style="{StaticResource Card}" Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" x:Name="NewLinkButton"
                                            Style="{StaticResource RowAction}" Margin="0"
                                            Content="New invite code" Click="OnMintLink"
                                            ToolTip="Mint a code anybody can use to join, until you revoke it"/>
                                    <TextBlock Text="Invitations" Style="{StaticResource H3}"/>
                                </DockPanel>
                                <ItemsControl x:Name="InvitesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3" ToolTip="{Binding RowTooltip}">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <!--  Copying works offline, so it's never disabled.  -->
                                                    <Button Style="{StaticResource RowAction}" Content="Copy code"
                                                            Click="OnCopyInviteCode"
                                                            Visibility="{Binding CopyVisibility}"
                                                            ToolTip="Copy the code so you can send it however you like"/>
                                                    <Button Style="{StaticResource RowAction}" Content="Send again"
                                                            Click="OnResendInvite"
                                                            Visibility="{Binding ResendVisibility}"
                                                            IsEnabled="{Binding ActionsEnabled}"
                                                            ToolTip="{Binding ResendTip}"/>
                                                    <Button Style="{StaticResource RowDangerAction}" Content="Revoke"
                                                            Click="OnRevokeInvite"
                                                            Visibility="{Binding RevokeVisibility}"
                                                            IsEnabled="{Binding ActionsEnabled}"
                                                            ToolTip="{Binding RevokeTip}"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource RowPill}">
                                                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource PillText}"/>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Who}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="InvitesNote" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <!-- ── what this team can reach ── -->
                        <!--  Everything shared with the team, with a way to unshare each item.  -->
                        <slate:SlateBorder x:Name="SharedCard" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="SharedCount" DockPanel.Dock="Right"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Shared with this team" Style="{StaticResource H3}"/>
                                </DockPanel>
                                <ItemsControl x:Name="SharedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3" ToolTip="{Binding RowTooltip}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource RowDangerAction}"
                                                        Content="Unshare" Click="OnUnshare"
                                                        Visibility="{Binding UnshareVisibility}"
                                                        IsEnabled="{Binding ActionsEnabled}"
                                                        ToolTip="{Binding UnshareTip}"/>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource RowPill}">
                                                    <TextBlock Text="{Binding PermissionLabel}" Style="{StaticResource PillText}"/>
                                                </Border>
                                                <slate:SlateBorder DockPanel.Dock="Left" Style="{StaticResource Pill}"
                                                        VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource PillText}"/>
                                                </slate:SlateBorder>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SharedNote" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </slate:SlateBorder>
                    </StackPanel>
                </ScrollViewer>

                <!--  Shown while no team is selected. "No teams at all" is the list's own state panel.  -->
                <StackPanel x:Name="NoSelectionPanel" Style="{StaticResource PageStatePanel}">
                    <TextBlock Style="{StaticResource PageStateGlyph}" Text="&#xE716;"/>
                    <TextBlock Style="{StaticResource PageStateTitle}" Text="Pick a team"/>
                    <TextBlock Style="{StaticResource PageStateBody}"
                               Text="Choose a team to see who is on it, who has been invited, and everything it can reach."/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ══ ROW 4: STATUS ══ -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="140" Height="4"
                         IsIndeterminate="True" Visibility="Collapsed"
                         VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
