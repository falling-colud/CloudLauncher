<UserControl x:Class="CloudLauncher.Views.BundleDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:v="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations"
             Background="Transparent">
    <UserControl.Resources>
        <!--  One published version. Disabled buttons keep their tooltip so they can say why.  -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0" GroupName="BundleVersion" VerticalAlignment="Center"
                             Margin="0,0,10,0" IsChecked="{Binding IsChosen, Mode=TwoWay}"
                             ToolTip="Install this version"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VersionString}" Style="{StaticResource H3}"/>
                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Channel}" Style="{StaticResource PillText}"/>
                        </slate:SlateBorder>
                    </StackPanel>
                    <TextBlock Text="{Binding Facts}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Changelog}" Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                               Visibility="{Binding ChangelogVisibility}" MaxWidth="520"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnDownloadVersion" Content="Save as zip..." Padding="10,4" Margin="0,0,6,0"
                            IsEnabled="{Binding CanDownload}" ToolTip="{Binding DownloadHint}"
                            ToolTipService.ShowOnDisabled="True"/>
                    <Button Style="{StaticResource IconButton}" Click="OnDeleteVersion"
                            Content="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                            IsEnabled="{Binding CanDelete}" ToolTip="{Binding DeleteHint}"
                            ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  One instance the bundle can be installed into.  -->
        <DataTemplate x:Key="InstanceRowTemplate">
            <CheckBox Margin="0,3" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding CanInstall}" ToolTip="{Binding Hint}"
                      ToolTipService.ShowOnDisabled="True">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!--  One person or team with access.  -->
        <DataTemplate x:Key="AccessRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <!--  Managers get a combo box to change the grant in place; everyone else sees a label.  -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding PermissionLabel}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Visibility="{Binding LabelVisibility}"/>
                    <ComboBox Width="190" ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                              SelectedItem="{Binding Selected, Mode=OneTime}"
                              Visibility="{Binding EditVisibility}"
                              SelectionChanged="OnAccessGrantChanged"
                              ToolTip="What they may do. A change is saved straight away."/>
                </Grid>
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnRemoveAccess"
                        Content="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                        IsEnabled="{Binding CanRemove}" ToolTip="{Binding RemoveHint}"
                        ToolTipService.ShowOnDisabled="True"/>
            </Grid>
        </DataTemplate>

        <!--  One invitation still waiting for its answer.  -->
        <DataTemplate x:Key="PendingInviteTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE715;" FontFamily="{DynamicResource IconFont}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,9,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"/>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PermissionLabel}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Grid.Column="3" Content="Copy link" Padding="10,3" FontSize="11" Margin="0,0,6,0"
                        Click="OnCopyInviteLink" IsEnabled="{Binding CanCopy}"
                        ToolTip="{Binding CopyHint}" ToolTipService.ShowOnDisabled="True"/>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Click="OnRevokeInvite"
                        Content="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="12"
                        IsEnabled="{Binding CanRevoke}" ToolTip="{Binding RevokeHint}"
                        ToolTipService.ShowOnDisabled="True"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Row 0 - title, then the actions on their own line, since the side panel is too narrow
        for both. The right margin clears the panel's floating close and back buttons. The page's
        own Back button is only for hosts without one.  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel Margin="0,0,20,0">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource ToolbarIconButton}"
                        Content="&#xE72B;" FontFamily="{DynamicResource IconFont}" Margin="0,0,10,0"
                        Click="OnBack" ToolTip="Back" Visibility="Collapsed"/>
                <!--  DockPanel fill so a long name trims instead of running under the close button.  -->
                <TextBlock x:Name="TitleLabel" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,2,20,0">
                <slate:SlateBorder Style="{StaticResource Pill}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="KindChipText" Style="{StaticResource PillText}"/>
                </slate:SlateBorder>
                <TextBlock x:Name="SubLabel" Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!--  The -3/+3 margins put a wrapped second line 6 px under the first and leave a single
            line where a StackPanel would put it.  -->
            <WrapPanel Orientation="Horizontal" Margin="0,7,0,-3">
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Margin="0,3,6,3"
                        Content="Install into instances" Click="OnPrimary"
                        ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="PublishButton" Click="OnPublishVersion" Margin="0,3,6,3" Padding="12,6"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Publish a version" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteBundleButton" Style="{StaticResource ToolbarIconButton}"
                        Content="&#xE74D;" FontFamily="{DynamicResource IconFont}" Margin="0,3,0,3"
                        Click="OnDeleteBundle" ToolTip="Delete it from the server"
                        ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="ReloadButton" Style="{StaticResource ToolbarIconButton}" Margin="0,3,0,3"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        Click="OnReload" ToolTip="Read it again from the server"
                        ToolTipService.ShowOnDisabled="True"/>
            </WrapPanel>
        </StackPanel>

        <!--  Row 1 - the bundle itself. PageStateView last so it covers the cards.  -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                          anim:Animate.SmoothScroll="True">
                <StackPanel Margin="0,0,10,0">

                    <!--  ABOUT  -->
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource H3}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NameBox" MaxLength="128" Margin="0,0,0,10"
                                             TextChanged="OnFormChanged"/>

                                    <TextBlock Text="One-line summary" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SummaryBox" MaxLength="512" Margin="0,0,0,10"
                                             TextChanged="OnFormChanged"
                                             ToolTip="The line shown under the name wherever it is listed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Width="230">
                                    <TextBlock Text="Kind" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="KindBox" Margin="0,0,0,10"
                                              SelectionChanged="OnKindChanged"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTip="The kind decides where it unpacks and where it is listed, so it is fixed once it exists."/>

                                    <TextBlock Text="Who can see it" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="VisibilityBox" Margin="0,0,0,10"
                                              SelectionChanged="OnFormSelectionChanged"/>

                                    <TextBlock Text="Unpacks into" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TargetRootBox" MaxLength="128"
                                             TextChanged="OnFormChanged"
                                             ToolTip="A folder inside the instance, e.g. config or kubejs. Never an absolute path."/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="FormError" Style="{StaticResource ErrorText}"
                                       Margin="0,4,0,0" Visibility="Collapsed"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SaveButton" Content="Save changes" Padding="14,5"
                                        Click="OnSaveMetadata" IsEnabled="False"
                                        ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock x:Name="OwnerNote" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  INSTALL  -->
                    <slate:SlateBorder x:Name="InstallCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Install into instances" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="InstallHint" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>

                            <ItemsControl x:Name="InstanceList" ItemTemplate="{StaticResource InstanceRowTemplate}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="SelectAllInstances" Content="Select all" Padding="10,4"
                                        Margin="0,0,6,0" Click="OnSelectAllInstances"/>
                                <Button x:Name="SelectNoInstances" Content="Clear" Padding="10,4"
                                        Click="OnSelectNoInstances"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  VERSIONS  -->
                    <slate:SlateBorder x:Name="VersionsCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="VersionsCount" DockPanel.Dock="Right"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                            </DockPanel>
                            <ItemsControl x:Name="VersionList" ItemTemplate="{StaticResource VersionRowTemplate}"/>
                            <TextBlock x:Name="NoVersionsLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed" TextWrapping="Wrap"
                                       Text="Nothing uploaded yet. Publish a version and it becomes something people can install."/>
                        </StackPanel>
                    </slate:SlateBorder>

                    <!--  PEOPLE AND TEAMS  -->
                    <slate:SlateBorder x:Name="AccessCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Who has access" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="The owner always has full access. Everyone below was added on top of whatever the visibility already allows."/>

                            <ItemsControl x:Name="AccessList" ItemTemplate="{StaticResource AccessRowTemplate}"/>
                            <TextBlock x:Name="NoAccessLabel" Style="{StaticResource Caption}"
                                       Visibility="Collapsed"
                                       Text="Nobody else has been added yet."/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="GrantBox" Grid.Column="0" Width="200" Margin="0,0,8,0"
                                          ToolTip="What the person or team you add may do"/>
                                <Button x:Name="AddPersonButton" Grid.Column="1" Padding="12,5" Margin="0,0,6,0"
                                        Click="OnAddPerson" Content="Add a person..."
                                        ToolTipService.ShowOnDisabled="True"/>
                                <Button x:Name="InvitePersonButton" Grid.Column="2" Padding="12,5" Margin="0,0,6,0"
                                        Click="OnInvitePerson" Content="Invite..."
                                        ToolTipService.ShowOnDisabled="True"/>
                                <Button x:Name="AddTeamButton" Grid.Column="3" Padding="12,5"
                                        Click="OnAddTeam" ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE716;" FontFamily="{DynamicResource IconFont}"
                                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add a team..." VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ShareLinkButton" Grid.Column="0" Padding="12,5" Margin="0,0,6,0"
                                        Click="OnShareLink" Content="Create a share link"
                                        ToolTipService.ShowOnDisabled="True"/>
                                <Button x:Name="RevokeShareLinkButton" Grid.Column="1" Padding="12,5" Margin="0,0,8,0"
                                        Click="OnRevokeShareLink" Content="Revoke link"
                                        Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock x:Name="ShareLinkLabel" Grid.Column="2" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>

                            <!--  Invitations sent and not yet answered, so a wrong one can be withdrawn.  -->
                            <StackPanel x:Name="PendingPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                <TextBlock Text="Waiting for an answer" Style="{StaticResource H3}" Margin="0,0,0,4"/>
                                <ItemsControl x:Name="PendingList" ItemTemplate="{StaticResource PendingInviteTemplate}"/>
                                <TextBlock x:Name="NoPendingLabel" Style="{StaticResource Caption}"
                                           Visibility="Collapsed"
                                           Text="No invitation is waiting to be accepted."/>
                            </StackPanel>

                            <!--  For someone the owner added directly. Leaving needs no permission.  -->
                            <StackPanel x:Name="LeavePanel" Orientation="Horizontal" Margin="0,16,0,0"
                                        Visibility="Collapsed">
                                <Button x:Name="LeaveButton" Content="Leave..." Padding="12,5"
                                        Style="{StaticResource SubtleButton}" Click="OnLeave"
                                        ToolTipService.ShowOnDisabled="True"/>
                                <TextBlock x:Name="LeaveNote" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>
                </StackPanel>
            </ScrollViewer>

            <v:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!--  Row 2 - status bar.  -->
        <Border Grid.Row="2" Style="{StaticResource PageStatusBar}" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="BusyBar" Width="140" Height="4" IsIndeterminate="True"
                                 Visibility="Collapsed" VerticalAlignment="Center"/>
                    <Button x:Name="BusyCancelButton" Content="Cancel" Padding="10,3" FontSize="11"
                            Margin="10,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
