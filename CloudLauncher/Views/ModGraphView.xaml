<UserControl x:Class="CloudLauncher.Views.ModGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             Background="Transparent">
    <DockPanel>
        <!-- Two columns, so the left group can't run under the count and zoom buttons on a
        narrow window. The hint is the fill, so it trims first. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="Cluster by" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox DockPanel.Dock="Left" x:Name="ClusterBox" Width="168" SelectionChanged="OnClusterChanged">
                    <ComboBoxItem Content="Categories" IsSelected="True"/>
                    <ComboBoxItem Content="Dependencies" ToolTip="Layered rows: the mods everything needs on top, what needs them below"/>
                    <ComboBoxItem Content="Dependency circles" ToolTip="Each dependency in the middle of a circle of the mods that need it"/>
                    <ComboBoxItem Content="Custom layout"/>
                </ComboBox>
                <CheckBox DockPanel.Dock="Left" x:Name="ShowLines" Content="Dependency lines" IsChecked="True"
                          Margin="16,0,0,0" VerticalAlignment="Center" Click="OnToggleLines"/>
                <Button DockPanel.Dock="Left" x:Name="CollapseAllButton" Content="Collapse all" Style="{StaticResource SubtleButton}"
                        Padding="10,4" MinHeight="0" Margin="16,0,0,0" VerticalAlignment="Center"
                        Click="OnCollapseAll"
                        ToolTip="Fold every category down to its header - or open them all again"/>

                <!-- Find: dims everything that doesn't match and centres a single hit. -->
                <slate:SlateBorder DockPanel.Dock="Left" Width="190" MinHeight="28" Margin="16,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="9,0,7,0"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="FindPlaceholder" Text="Find a mod..."
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBox x:Name="FindBox" Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" TextChanged="OnFindChanged"
                                     PreviewKeyDown="OnFindKeyDown"
                                     ToolTip="Dim every node except the mods whose name matches">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                        <Button x:Name="FindClearButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                Content="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                Margin="0,0,2,0" Visibility="Collapsed" Click="OnFindClear"
                                ToolTip="Clear (Esc)"/>
                    </Grid>
                </slate:SlateBorder>

                <TextBlock x:Name="HintLabel" Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Text="Scroll to zoom · drag background to pan"/>
            </DockPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="GraphStatus" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE71F;" FontFamily="{DynamicResource IconFont}"
                        FontSize="13" ToolTip="Zoom out" Click="OnZoomOut"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" FontFamily="{DynamicResource IconFont}"
                        FontSize="13" ToolTip="Zoom in" Click="OnZoomIn"/>
                <Button Style="{StaticResource SubtleButton}" Content="Fit" Padding="12,6" Margin="6,0,0,0"
                        ToolTip="Fit graph to view" Click="OnFit"/>
            </StackPanel>
        </Grid>

        <slate:SlateBorder x:Name="Viewport" ClipToBounds="True" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                MouseWheel="OnViewportWheel"
                MouseLeftButtonDown="OnViewportMouseDown"
                MouseMove="OnViewportMouseMove"
                MouseLeftButtonUp="OnViewportMouseUp"
                MouseRightButtonUp="OnViewportRightClick">
            <Canvas x:Name="GraphCanvas" Background="Transparent" RenderTransformOrigin="0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomT" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="PanT" X="0" Y="0"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
        </slate:SlateBorder>
    </DockPanel>
</UserControl>
