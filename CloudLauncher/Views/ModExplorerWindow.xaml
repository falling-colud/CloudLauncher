<Window x:Class="CloudLauncher.Views.ModExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CloudLauncher.Views"
        Title="Mod Explorer" Height="780" Width="1260"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource H2}" Text="Browse mods" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PackContextLabel" Style="{StaticResource Muted}" Margin="0,0,0,12"
                               TextTrimming="CharacterEllipsis"/>

                    <DockPanel Margin="0,0,0,8">
                        <ComboBox x:Name="SourceBox" SelectionChanged="OnFilterChanged" Width="130"
                                  DockPanel.Dock="Left" Margin="0,0,8,0">
                            <ComboBoxItem Content="Modrinth"/>
                            <ComboBoxItem Content="CurseForge" IsSelected="True"/>
                        </ComboBox>
                        <Button DockPanel.Dock="Right" Content="Search"
                                Style="{StaticResource AccentButton}" Click="OnSearch" IsDefault="True"/>
                        <TextBox x:Name="SearchBox" Margin="8,0,8,0" KeyDown="OnSearchKeyDown"
                                 ToolTip="Search mod name or description"/>
                    </DockPanel>

                    <TextBlock x:Name="SearchStatus" Style="{StaticResource Caption}"/>
                </StackPanel>

                <Border Background="{DynamicResource Surface0Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6">
                    <ListBox x:Name="ResultsList" SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,5,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Pill}" Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource PillText}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#xE896;" Style="{StaticResource IconButton}"
                                                    Width="34" Height="34" MinWidth="34" MinHeight="34"
                                                    Padding="0" FontSize="14"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                                    ToolTip="Download the latest compatible file"
                                                    Click="OnQuickDownloadMod"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="DetailHeader" Visibility="Collapsed" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10"
                        ClipToBounds="True" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H2}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ModNameLabel" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ModMetaLabel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1" x:Name="DetailPlaceholder"
                       Text="Select or double-click a mod to see overview, screenshots, issues, and versions."
                       Style="{StaticResource Muted}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"/>

            <TabControl Grid.Row="1" x:Name="ModTabs" Visibility="Collapsed">
                <TabItem Header="Overview">
                    <Border CornerRadius="8" ClipToBounds="True" Margin="0,12,0,0"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border x:Name="OverviewHost" ClipToBounds="True"
                                Background="{DynamicResource Surface0Brush}">
                            <views:RichDescriptionView x:Name="OverviewBrowser"/>
                        </Border>
                    </Border>
                </TabItem>

                <TabItem Header="Screenshots">
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                   Text="No screenshots are available for this mod."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ScreenshotList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="250" Margin="0,0,12,12" Style="{StaticResource Card}" Padding="8"
                                                Cursor="Hand" ToolTip="Open screenshot"
                                                MouseLeftButtonUp="OnOpenScreenshot">
                                            <StackPanel>
                                                <Border Height="132" Background="{DynamicResource Surface1Brush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <TabItem Header="Links">
                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,2,0,0">
                            <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                        </WrapPanel>
                        <TextBlock x:Name="IssuesEmptyText" Style="{StaticResource Muted}"
                                   Text="This project has not published issue/source links through the selected provider."
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Versions">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                                <TextBlock x:Name="VersionFilterNote" Style="{StaticResource Caption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowAllVersionsBox" Grid.Column="1" Content="Show all versions"
                                      VerticalAlignment="Center"
                                      Checked="OnShowAllVersionsChanged" Unchecked="OnShowAllVersionsChanged"/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <DataGrid x:Name="VersionsGrid"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" RowHeaderWidth="0"
                                      SelectionMode="Single" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                    <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="160"/>
                                    <DataGridTextColumn Header="Loader" Binding="{Binding LoaderList}" Width="110"/>
                                    <DataGridTextColumn Header="Channel" Binding="{Binding ReleaseChannel}" Width="80"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="100"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="80"/>
                                    <DataGridTemplateColumn Width="112">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Download" Style="{StaticResource AccentButton}"
                                                        Padding="8,3" MinWidth="0" MinHeight="0" FontSize="11"
                                                        Click="OnDownloadVersion"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="2" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Download to" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="DownloadTargetBox" Width="140">
                        <ComboBoxItem Content="game/mods/" IsSelected="True"/>
                        <ComboBoxItem Content="local/mods/"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
            </DockPanel>
            <ProgressBar Grid.Row="2" x:Name="DownloadProgress" Height="4"
                         Margin="0,0,0,-12" VerticalAlignment="Bottom"
                         Visibility="Collapsed" IsIndeterminate="False"/>
        </Grid>
    </Grid>
</Window>
