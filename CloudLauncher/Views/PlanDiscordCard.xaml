<UserControl x:Class="CloudLauncher.Views.PlanDiscordCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls">
    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="560">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>

        <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Show in Discord"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Every board becomes a message in the channel: a picture of it and how far along each section is. The messages follow every change to the boards by themselves, and link to a live view anyone there can zoom around."/>

            <!--  Channels the boards are shown in.  -->
            <TextBlock Style="{StaticResource H3}" Text="Channels" Margin="0,18,0,6"/>
            <slate:SlateBorder x:Name="LinkBox" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" Visibility="Collapsed">
                <StackPanel x:Name="LinkList"/>
            </slate:SlateBorder>
            <TextBlock x:Name="EmptyLabel" Style="{StaticResource Caption}" Text="Loading..."/>

            <!--  A channel through its webhook: works on any server, nothing to install.  -->
            <TextBlock Style="{StaticResource H3}" Text="Add a channel" Margin="0,18,0,6"/>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="In Discord, open the channel's settings, then Integrations, Webhooks, New Webhook, Copy Webhook URL. Paste it here."/>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="LinkButton" DockPanel.Dock="Right" Content="Link" Style="{StaticResource AccentButton}"
                        Margin="8,0,0,0" Padding="16,5" Click="OnLinkWebhook"/>
                <TextBox x:Name="WebhookBox" ToolTip="https://discord.com/api/webhooks/..."/>
            </DockPanel>
            <CheckBox x:Name="OnlyBoardBox" Margin="0,8,0,0" Content="Only this board"/>

            <!--  Or through the CloudLauncher app, when the server has one set up.  -->
            <StackPanel x:Name="BotPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Text="Or use the CloudLauncher app: add it to the server, get a code, and type the command in the channel. Boards the app posts have a button that opens them right inside Discord."/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add the app to a server" Click="OnInviteBot" Padding="12,5"/>
                    <Button x:Name="CodeButton" Content="Get a code" Click="OnGetCode" Margin="8,0,0,0" Padding="12,5"/>
                </StackPanel>
                <slate:SlateBorder x:Name="CodePanel" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Click="OnCopyCommand"/>
                        <TextBlock x:Name="CommandText" FontFamily="{DynamicResource MonoFont}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </slate:SlateBorder>
            </StackPanel>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Close" Click="OnClose" Padding="14,5"/>
            </Grid>
        </StackPanel>
    </slate:SlateBorder>
</UserControl>
