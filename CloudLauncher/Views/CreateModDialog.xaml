<Window x:Class="CloudLauncher.Views.CreateModDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="clr-namespace:CloudLauncher.Animations"
        Title="Create mod" Width="520" Height="660"
        WindowStartupLocation="CenterOwner"
        anim:Animate.WindowFadeIn="True"
        Background="{DynamicResource Surface0Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource H2}" Text="Create a mod"/>
            <TextBlock Style="{StaticResource Muted}"
                       Text="Set up the project shell — you can upload the first version now or later."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" anim:Animate.SmoothScroll="True">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource Caption}" Text="Name" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,12" MaxLength="128"
                         TextChanged="OnFormTextChanged"/>

                <TextBlock Style="{StaticResource Caption}" Text="Summary" Margin="0,0,0,4"/>
                <TextBox x:Name="SummaryBox" Margin="0,0,0,12" MaxLength="512"
                         ToolTip="One-line description"
                         TextChanged="OnFormTextChanged"/>

                <TextBlock Style="{StaticResource Caption}" Text="Description" Margin="0,0,0,4"/>
                <TextBox x:Name="DescriptionBox" Margin="0,0,0,12" MaxLength="4096"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="140"
                         ToolTip="The long text shown on the mod's page — Markdown is rendered"/>

                <TextBlock Style="{StaticResource Caption}" Text="Visibility" Margin="0,0,0,4"/>
                <ComboBox x:Name="VisibilityBox" Margin="0,0,0,12"
                          SelectionChanged="OnFormSelectionChanged">
                    <ComboBoxItem Content="Private" IsSelected="True"/>
                    <ComboBoxItem Content="Team"/>
                    <ComboBoxItem Content="Public"/>
                </ComboBox>

                <TextBlock Style="{StaticResource Caption}" Text="Initial MC version" Margin="0,0,0,4"/>
                <ComboBox x:Name="McVersionBox" Margin="0,0,0,12"
                          ToolTip="Pick the Minecraft version this mod supports"
                          SelectionChanged="OnFormSelectionChanged"/>

                <TextBlock Style="{StaticResource Caption}" Text="Loaders" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox x:Name="LoaderFabric" Content="fabric" Margin="0,0,12,0"
                              Checked="OnFormCheckedChanged" Unchecked="OnFormCheckedChanged"/>
                    <CheckBox x:Name="LoaderForge" Content="forge" Margin="0,0,12,0"
                              Checked="OnFormCheckedChanged" Unchecked="OnFormCheckedChanged"/>
                    <CheckBox x:Name="LoaderNeoForge" Content="neoforge" Margin="0,0,12,0"
                              Checked="OnFormCheckedChanged" Unchecked="OnFormCheckedChanged"/>
                    <CheckBox x:Name="LoaderQuilt" Content="quilt"
                              Checked="OnFormCheckedChanged" Unchecked="OnFormCheckedChanged"/>
                </StackPanel>

                <!-- Optional first jar. Kept optional on purpose: the mod page is useful on its own
                     (collaborators, visibility), and the upload card opens straight after Create. -->
                <Border Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <Button x:Name="ClearJarButton" Style="{StaticResource IconButton}"
                                    Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                    Click="OnClearFirstJar" Visibility="Collapsed"
                                    ToolTip="Don't upload a jar yet"/>
                            <Button Content="Choose jar…" Click="OnPickFirstJar" Padding="12,5" MinWidth="0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" Text="First version (optional)"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="FirstJarLabel" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="Pick a jar and the upload dialog opens once the mod exists."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="0,14,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0" Padding="14,5" IsCancel="True"/>
            <Button x:Name="CreateButton" Content="Create" Style="{StaticResource AccentButton}"
                    Click="OnCreate" Padding="14,5" IsEnabled="False" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
