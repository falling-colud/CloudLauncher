<Window x:Class="CloudLauncher.Views.MinecraftHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Minecraft"
        Height="720" Width="1280" MinHeight="480" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface0Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="OnLoaded"
        Closing="OnClosing"
        Closed="OnClosed"
        StateChanged="OnStateChanged"
        LocationChanged="OnLocationChanged"
        SizeChanged="OnHostSizeChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{DynamicResource Surface0Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopRow" Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="BottomRow" Height="30"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButton}"
                                Content="&#xE921;"
                                ToolTip="Minimize"
                                Click="OnMinimize"/>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButton}"
                                Content="&#xE922;"
                                ToolTip="Maximize"
                                Click="OnMaximize"/>
                        <Button Style="{StaticResource CaptionCloseButton}"
                                Content="&#xE8BB;"
                                ToolTip="Close Minecraft"
                                Click="OnClose"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,16,0">
                        <Ellipse Width="8" Height="8"
                                 Fill="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleLabel"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <TextBlock x:Name="OverlayHintLabel"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition x:Name="RightToggleColumn" Width="0"/>
                    <ColumnDefinition x:Name="RightColumn" Width="760"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="GameSurface"
                        Grid.Column="0"
                        Background="Black"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,1,0"
                        SizeChanged="OnGameSurfaceSizeChanged">
                    <TextBlock x:Name="AttachStatusLabel"
                               Text="Waiting for Minecraft window..."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="RightCollapseRail"
                        Grid.Column="1"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="Collapsed">
                    <Button x:Name="CollapsedRightCollapseButton"
                            Style="{StaticResource IconButton}"
                            Width="28"
                            MinWidth="28"
                            Height="64"
                            MinHeight="32"
                            Padding="0"
                            FontSize="12"
                            VerticalAlignment="Top"
                            Margin="0,8,0,0"
                            Content="&#xE76B;"
                            ToolTip="Show instance page"
                            Click="OnRightCollapseClick"/>
                </Border>

                <Border x:Name="RightPanel"
                        Grid.Column="2"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="8,5">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="ExpandedRightCollapseButton"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource IconButton}"
                                        Width="28"
                                        MinWidth="28"
                                        Height="24"
                                        MinHeight="24"
                                        Padding="0"
                                        FontSize="12"
                                        Content="&#xE76C;"
                                        ToolTip="Hide instance page"
                                        Click="OnRightCollapseClick"/>
                                <Button x:Name="PackPanelBackButton"
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource IconButton}"
                                        Width="28"
                                        MinWidth="28"
                                        Height="24"
                                        MinHeight="24"
                                        Padding="0"
                                        FontSize="12"
                                        Margin="0,0,6,0"
                                        Content="&#xE72B;"
                                        ToolTip="Back"
                                        Visibility="Collapsed"
                                        Click="OnPackPanelBack"/>
                                <TextBlock x:Name="RightPanelTitle"
                                           Text="Instance"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                        <Frame x:Name="PackFrame"
                               NavigationUIVisibility="Hidden"
                               Background="{DynamicResource Surface0Brush}"/>
                    </DockPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Border x:Name="BottomBar"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="HotkeyLabel"
                                   DockPanel.Dock="Right"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Time"
                                       Style="{StaticResource Caption}"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="ClockLabel"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,1,22,0"/>
                            <TextBlock Text="Playing"
                                       Style="{StaticResource Caption}"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="ElapsedLabel"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border x:Name="BottomCollapsedStrip"
                        Height="10"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        MouseLeftButtonDown="OnBottomStripMouseDown"
                        ToolTip="Show time bar"/>
            </Grid>
        </Grid>
    </Border>
</Window>
