<UserControl x:Class="CloudLauncher.Views.ExportPackDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <UserControl.Resources>
        <!--  One file or folder of the instance folder, at its depth in the tree. The box is a
        separate element, not a CheckBox wrapping the row: the CheckBox template measures content
        at unbounded width, so the name could never trim.  -->
        <DataTemplate x:Key="ExportTreeRowTemplate">
            <DockPanel Margin="{Binding Indent}" Background="Transparent">
                <!--  Open / close. Hidden, not collapsed, on a file so every name lines up.  -->
                <Button DockPanel.Dock="Left" Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                        Style="{StaticResource IconButton}" Focusable="False"
                        Content="{Binding Caret}" FontFamily="{DynamicResource IconFont}" FontSize="9"
                        Visibility="{Binding CaretVisibility}" ToolTip="{Binding CaretTip}"
                        Click="OnToggleExpand"/>
                <slate:SelectionCheckBox DockPanel.Dock="Left" Style="{StaticResource {x:Type CheckBox}}"
                                         IsChecked="{Binding CheckState, Mode=OneWay}" IsEnabled="{Binding CanTick}"
                                         Margin="2,0,8,0" VerticalAlignment="Center" Click="OnRowCheckClick" Focusable="False"
                                         AutomationProperties.Name="{Binding Name}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                   Background="{DynamicResource WarningBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Visibility="{Binding PrivateVisibility}">
                    <TextBlock Text="private" Style="{StaticResource PillText}"
                               Foreground="{DynamicResource TextOnAccentBrush}"/>
                </slate:SlateBorder>
                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock x:Name="StageLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                               VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource H2}" Text="Export as a modpack"/>
                </DockPanel>
                <TextBlock x:Name="SubtitleLabel" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
                <!--  Informational only: the export just reads, so the game can keep running.  -->
                <TextBlock x:Name="GameRunningNote" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0" Visibility="Collapsed"
                           Text="Minecraft is running this instance. Exporting only reads it, but close the game first for a clean copy of its configs."/>
            </StackPanel>

            <!--  Buttons pinned to the bottom, so every step grows into what is left of the card.  -->
            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLabel" Grid.Column="0" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SecondaryButton" Content="Cancel" Click="OnSecondary"
                            Margin="0,0,8,0" Padding="14,5"/>
                    <Button x:Name="PrimaryButton" Content="Export..." Style="{StaticResource AccentButton}"
                            Click="OnPrimary" Padding="14,5" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </Grid>

            <Grid>
                <!--  Options step  -->
                <ScrollViewer x:Name="OptionsStep" VerticalScrollBarVisibility="Auto"
                              anim:Animate.SmoothScroll="True">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Format" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <!--  Tiles rather than radio buttons: each format needs a wrapping
                        sentence, and a RadioButton's template can't wrap text (like CheckBox).  -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <slate:SlateBorder x:Name="CurseForgeTile" Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Cursor="Hand"
                                    MouseLeftButtonUp="OnCurseForgeTileClick">
                                <StackPanel>
                                    <RadioButton x:Name="CurseForgeRadio" GroupName="exportFormat"
                                                 FontWeight="SemiBold" Content="CurseForge (.zip)"
                                                 Checked="OnFormatChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,4,0,0"
                                               Text="Opens in the CurseForge app, Prism and CloudLauncher. Mods on CurseForge download from there; the rest are packed in."/>
                                </StackPanel>
                            </slate:SlateBorder>
                            <slate:SlateBorder x:Name="ModrinthTile" Grid.Column="2" Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Cursor="Hand"
                                    MouseLeftButtonUp="OnModrinthTileClick">
                                <StackPanel>
                                    <RadioButton x:Name="ModrinthRadio" GroupName="exportFormat"
                                                 FontWeight="SemiBold" Content="Modrinth (.mrpack)"
                                                 Checked="OnFormatChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,4,0,0"
                                               Text="Opens in the Modrinth App, Prism and CloudLauncher. Mods on Modrinth download from there; the rest are packed in."/>
                                </StackPanel>
                            </slate:SlateBorder>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" MaxLength="100" TextChanged="OnFieldChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Version" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <TextBox x:Name="VersionBox" MaxLength="40" TextChanged="OnFieldChanged"
                                         ToolTip="What players see as this pack's version, e.g. 1.0.0"/>
                            </StackPanel>
                        </Grid>

                        <!--  One of these two shows, by format: a CurseForge manifest has an author and no
                             summary, a .mrpack a summary and no author.  -->
                        <StackPanel x:Name="AuthorPanel" Margin="0,10,0,0">
                            <TextBlock Text="Author" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox x:Name="AuthorBox" MaxLength="100"/>
                        </StackPanel>
                        <StackPanel x:Name="SummaryPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Summary" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <TextBox x:Name="SummaryBox" MaxLength="250"
                                     ToolTip="One line shown under the name when the pack is installed"/>
                        </StackPanel>

                        <TextBlock Text="Mods" Style="{StaticResource Caption}" Margin="0,16,0,6"/>
                        <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="ModSummaryLabel" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="PlanBar" Height="3" IsIndeterminate="True" Margin="0,8,0,0"/>
                                <TextBlock x:Name="ModWarningLabel" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningBrush}" Margin="0,6,0,0"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="LicenceNote" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0"
                                           Visibility="Collapsed"
                                           Text="Packed-in mods are other people's work. Check their licences before you share the pack publicly."/>
                                <CheckBox x:Name="DisabledBox" Margin="0,10,0,0" Content="Include disabled mods"
                                          Checked="OnModOptionChanged" Unchecked="OnModOptionChanged"
                                          ToolTipService.ShowOnDisabled="True"/>
                                <CheckBox x:Name="LocalBox" Margin="0,6,0,0" Content="Include this PC's own mods (local/mods)"
                                          Checked="OnModOptionChanged" Unchecked="OnModOptionChanged"
                                          ToolTipService.ShowOnDisabled="True"/>
                            </StackPanel>
                        </slate:SlateBorder>

                        <DockPanel Margin="0,16,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Recommended" Style="{StaticResource LinkButton}" FontSize="11"
                                        Click="OnRecommendedEntries" Margin="0,0,10,0"
                                        ToolTip="Tick the folders a modpack is made of, and nothing else"/>
                                <Button Content="None" Style="{StaticResource LinkButton}" FontSize="11"
                                        Click="OnNoEntries"/>
                            </StackPanel>
                            <TextBlock Text="Also include from the instance folder" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <!--  The instance folder as a tree; a partly ticked folder shows a dash.
                        Virtualized, so folders with thousands of files stay quick.  -->
                        <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <Grid>
                                <ListBox x:Name="EntryTree" ItemTemplate="{StaticResource ExportTreeRowTemplate}"
                                         MinHeight="40" MaxHeight="340"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         PreviewKeyDown="OnTreeKeyDown">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="4,1"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="ToolTip" Value="{Binding Hint}"/>
                                            <EventSetter Event="MouseDoubleClick" Handler="OnTreeRowDoubleClick"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="EntryListEmpty" Style="{StaticResource Caption}" Margin="8,6"
                                           Visibility="Collapsed" Text="There is nothing else in this instance's folder."/>
                            </Grid>
                        </slate:SlateBorder>
                        <TextBlock x:Name="EntryNote" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="Open a folder to choose what inside it goes in. Worlds, logs, caches, map data and your own settings are left unticked on purpose. Files marked private never leave this PC."/>
                    </StackPanel>
                </ScrollViewer>

                <!--  Working step, and the one question it can stop to ask  -->
                <StackPanel x:Name="WorkStep" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock x:Name="WorkStepLabel" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="WorkProgressPanel">
                        <ProgressBar x:Name="WorkBar" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,8"/>
                        <DockPanel>
                            <TextBlock x:Name="WorkPercent" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                       FontWeight="SemiBold" Margin="10,0,0,0"/>
                            <TextBlock x:Name="WorkDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock x:Name="WorkTarget" Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,14,0,0"/>

                    <slate:SlateBorder x:Name="GapPanel" Visibility="Collapsed" Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="14" Margin="0,18,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="GapTitle" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="GapText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </slate:SlateBorder>
                </StackPanel>

                <!--  Done, stopped or failed: one receipt, three glyphs  -->
                <slate:SlateBorder x:Name="DoneStep" Visibility="Collapsed" VerticalAlignment="Top"
                        Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="DoneGlyph" DockPanel.Dock="Left" FontFamily="{DynamicResource IconFont}"
                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="DoneTitle" Style="{StaticResource H3}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock x:Name="DoneBody" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="DoneExtra" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="Collapsed"/>
                        <Button x:Name="ShowInFolderButton" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Padding="12,5" Click="OnShowInFolder" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Show in folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </slate:SlateBorder>
            </Grid>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
