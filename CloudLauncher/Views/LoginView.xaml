<Page x:Class="CloudLauncher.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sign in"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <!-- Subtle dark gradient backdrop -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0D11" Offset="0"/>
                <GradientStop Color="#11141B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="12" Padding="28">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <!-- Brand -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="56" Height="56" CornerRadius="14"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}"
                                   FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock Style="{StaticResource H1}" Text="CloudLauncher"
                               HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock x:Name="ModeLabel" Style="{StaticResource Muted}"
                               Text="Sign in" HorizontalAlignment="Center"/>
                </StackPanel>

                <Label Content="Username"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,8"/>

                <Label Content="Password"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"/>

                <Label x:Name="EmailLabel" Content="Email" Visibility="Collapsed"/>
                <TextBox x:Name="EmailBox" Visibility="Collapsed" Margin="0,0,0,8"/>

                <TextBlock x:Name="InfoLabel" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" Margin="0,4,0,0"/>

                <Button x:Name="SubmitButton" Content="Sign in" Style="{StaticResource AccentButton}"
                        Click="OnSubmit" IsDefault="True" Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="ResendButton" Style="{StaticResource LinkButton}"
                        Content="Resend verification email" Click="OnResendVerification"
                        HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource BorderStrongBrush}"/>
                    <TextBlock Grid.Column="1" Text="or" Style="{StaticResource Muted}"
                               Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource BorderStrongBrush}"/>
                </Grid>

                <Button x:Name="GoogleButton" Content="Continue with Google"
                        Click="OnGoogleSignIn" Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="SwitchButton" Style="{StaticResource LinkButton}"
                        Content="Need an account? Create one" Click="OnSwitchMode"
                        HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
