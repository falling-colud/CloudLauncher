<Page x:Class="CloudLauncher.Views.LoginView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      Title="Sign in"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <!-- Subtle dark gradient backdrop -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0D11" Offset="0"/>
                <GradientStop Color="#11141B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <slate:SlateBorder Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="12" Padding="28">
            <slate:SlateBorder.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </slate:SlateBorder.Effect>
            <StackPanel>
                <!-- Brand -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <slate:SlateBorder Width="56" Height="56" CornerRadius="14"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE753;" FontFamily="{DynamicResource IconFont}"
                                   FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </slate:SlateBorder>
                    <TextBlock Style="{StaticResource H1}" Text="CloudLauncher"
                               HorizontalAlignment="Center" Margin="0,10,0,2"/>
                    <TextBlock x:Name="ModeLabel" Style="{StaticResource Muted}"
                               Text="Sign in" HorizontalAlignment="Center"/>
                </StackPanel>

                <Label Content="Username"/>
                <TextBox x:Name="UsernameBox" Margin="0,0,0,8"/>

                <Label Content="Password"/>
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8"/>

                <Label x:Name="EmailLabel" Content="Email" Visibility="Collapsed"/>
                <TextBox x:Name="EmailBox" Visibility="Collapsed" Margin="0,0,0,8"/>

                <!--  Sign-up only. Create account stays disabled until this is ticked. A click on a
                     link opens the page without ticking the box.  -->
                <CheckBox x:Name="TermsBox" Visibility="Collapsed" Margin="0,4,0,4"
                          Click="OnTermsToggled">
                    <TextBlock FontSize="12">
                        <Run Text="I agree to the"/>
                        <Hyperlink Click="OnOpenTerms" Foreground="{DynamicResource AccentTextBrush}"
                                   ToolTip="Opens the Terms in your browser">Terms</Hyperlink>
                        <Run Text="and the"/>
                        <Hyperlink Click="OnOpenPrivacy" Foreground="{DynamicResource AccentTextBrush}"
                                   ToolTip="Opens the Privacy Policy in your browser">Privacy Policy</Hyperlink>
                    </TextBlock>
                </CheckBox>

                <TextBlock x:Name="InfoLabel" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Margin="0,4,0,0" Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" Margin="0,4,0,0"/>

                <Button x:Name="SubmitButton" Content="Sign in" Style="{StaticResource AccentButton}"
                        Click="OnSubmit" IsDefault="True" Margin="0,16,0,0"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="ResendButton" Style="{StaticResource LinkButton}"
                        Content="Resend verification email" Click="OnResendVerification"
                        HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>

                <!-- The Google block stays hidden until the server says it offers Google sign-in. -->
                <Grid x:Name="GoogleDivider" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource BorderStrongBrush}"/>
                    <TextBlock Grid.Column="1" Text="or" Style="{StaticResource Muted}"
                               Margin="12,0"/>
                    <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                            Background="{DynamicResource BorderStrongBrush}"/>
                </Grid>

                <Button x:Name="GoogleButton" Content="Continue with Google"
                        Click="OnGoogleSignIn" Margin="0,14,0,0"
                        HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                <TextBlock x:Name="GoogleCaption" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                    Continuing with Google means you accept the
                    <Hyperlink Click="OnOpenTerms" Foreground="{DynamicResource AccentTextBrush}">Terms</Hyperlink>
                    and the
                    <Hyperlink Click="OnOpenPrivacy" Foreground="{DynamicResource AccentTextBrush}">Privacy Policy</Hyperlink>.
                </TextBlock>

                <Button x:Name="SwitchButton" Style="{StaticResource LinkButton}"
                        Content="Need an account? Create one" Click="OnSwitchMode"
                        HorizontalAlignment="Center" Margin="0,12,0,0"/>

                <!--  Signing in is optional: everything that needs no account works without one.  -->
                <Button x:Name="OfflineButton" Style="{StaticResource LinkButton}"
                        Content="Continue without signing in" Click="OnContinueOffline"
                        HorizontalAlignment="Center" Margin="0,6,0,0"
                        ToolTip="Use the launcher on this PC. Sharing, syncing and hosting wait until you sign in."/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0" Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="An account is for sharing instances, syncing them between PCs and hosting content. Everything else works without one."/>
            </StackPanel>
        </slate:SlateBorder>
    </Grid>
</Page>
