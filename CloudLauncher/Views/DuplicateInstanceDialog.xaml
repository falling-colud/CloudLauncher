<Window x:Class="CloudLauncher.Views.DuplicateInstanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate instance" Width="460"
        SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <!-- Same shape as SimpleInputDialog: every row Auto so SizeToContent can add them up. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="Duplicate instance" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" x:Name="SourceLabel" Style="{StaticResource Muted}" Margin="0,0,0,14"
                   TextTrimming="CharacterEllipsis"/>
        <Label Grid.Row="2" Content="Name of the copy" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" x:Name="NameBox"
                 MinHeight="40" Padding="12,8" FontSize="14"
                 Background="{DynamicResource Surface0Brush}"
                 BorderBrush="{DynamicResource BorderStrongBrush}"
                 TextChanged="OnNameChanged"/>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <CheckBox x:Name="WorldsBox" Content="Copy its worlds" IsChecked="True" Margin="0,0,0,8"
                      ToolTip="The saves folder. Leave it off for a fresh start with the same mods and settings."/>
            <CheckBox x:Name="ScreenshotsBox" Content="Copy its screenshots" IsChecked="False"/>
        </StackPanel>
        <TextBlock Grid.Row="5" x:Name="NoteLabel" Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Margin="0,14,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <DockPanel Grid.Row="6" Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" x:Name="OkButton" Content="Duplicate" Style="{StaticResource AccentButton}"
                    MinWidth="110" IsDefault="True" Click="OnOk"/>
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="96" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancel"/>
        </DockPanel>
    </Grid>
</Window>
