<Page x:Class="CloudLauncher.Views.ModsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Mods"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,24,28,18">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Mods"/>
                <TextBlock Style="{StaticResource Muted}"
                           Text="Browse, install, import, and host mods across CurseForge, Modrinth, CloudLauncher, and your teams."/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,12,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Create mod" Style="{StaticResource AccentButton}" Click="OnCreateMod">
                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Create mod" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnImportMod"
                        Content="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="14"
                        ToolTip="Import a .jar into a specific instance"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border x:Name="CompactSearchHost"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" MinHeight="36" Width="36"
                        HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SearchToggleButton" Grid.Column="0"
                                Style="{StaticResource IconButton}" Click="OnSearchToggle"
                                Content="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                ToolTip="Search mods"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" Margin="0,0,10,0"
                                 Visibility="Collapsed"
                                 TextChanged="OnSearchTextChanged"
                                 PreviewKeyDown="OnSearchPreviewKeyDown"
                                 LostKeyboardFocus="OnSearchLostKeyboardFocus"
                                 ToolTip="Search mods">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                </Border>
                <Button Style="{StaticResource IconButton}" Click="OnFiltersClick"
                        Content="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Filters"/>
                <Button Style="{StaticResource IconButton}" Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                        ToolTip="Refresh"/>
                <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="0" VerticalOffset="-8">
                    <Border Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" MinWidth="260">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Minecraft version"/>
                            <TextBox x:Name="FilterMcBox" Margin="0,4,0,10"
                                     ToolTip="e.g. 1.20.1 - leave empty for any"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Loader"/>
                            <ComboBox x:Name="FilterLoaderBox" Margin="0,4,0,10">
                                <ComboBoxItem Content="(any)" IsSelected="True"/>
                                <ComboBoxItem Content="fabric"/>
                                <ComboBoxItem Content="forge"/>
                                <ComboBoxItem Content="neoforge"/>
                                <ComboBoxItem Content="quilt"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Apply" Style="{StaticResource AccentButton}"
                                        Click="OnApplyFilters" Padding="14,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Height="1" Margin="28,4,28,10"
                Background="{DynamicResource BorderSubtleBrush}"/>

        <ScrollViewer Grid.Row="3" Margin="28,4,28,16"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SourceStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="0" Margin="0,2,8,2"
                                Cursor="{Binding CursorHint}"
                                Background="{Binding Background}"
                                BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                CornerRadius="14"
                                MouseLeftButtonUp="OnSourceChipClick"
                                Visibility="{Binding ChipVisibility}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Margin="12,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground}"
                                           Visibility="{Binding IconVisibility}"/>
                                <TextBlock Text="{Binding Label}" Margin="0,0,12,0"
                                           Padding="0,5,0,5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground}"
                                           FontWeight="{Binding FontWeight}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="28,0,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ResultsList"
                             SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             anim:Animate.EntranceStagger="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnResultsScroll">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Background="Transparent"
                                        anim:Animate.HoverLift="True"
                                        MouseRightButtonUp="OnRowRightButtonUp"
                                        ToolTip="{Binding RowToolTip}">
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="OnRowMenuOpened">
                                            <MenuItem x:Name="CtxManage" Header="Manage" Click="OnCtxManage"/>
                                            <MenuItem x:Name="CtxInstall" Header="Install" Click="OnCtxInstall"/>
                                            <MenuItem x:Name="CtxUploadVersion" Header="Upload version…"
                                                      Click="OnCtxUploadVersion"/>
                                            <Separator x:Name="CtxOwnerSeparator"/>
                                            <MenuItem x:Name="CtxRename" Header="Rename…" Click="OnCtxRename"
                                                      InputGestureText="F2"/>
                                            <MenuItem x:Name="CtxVisibility" Header="Visibility">
                                                <MenuItem Header="Private" Tag="Private" Click="OnCtxSetVisibility"/>
                                                <MenuItem Header="Team" Tag="Team" Click="OnCtxSetVisibility"/>
                                                <MenuItem Header="Public" Tag="Public" Click="OnCtxSetVisibility"/>
                                            </MenuItem>
                                            <MenuItem x:Name="CtxPermissions" Header="Manage collaborators…"
                                                      Click="OnCtxPermissions"/>
                                            <Separator/>
                                            <MenuItem x:Name="CtxOpenPage" Header="Open page" Click="OnCtxOpenPage"/>
                                            <MenuItem x:Name="CtxCopyId" Header="Copy mod ID" Click="OnCtxCopyId"/>
                                            <MenuItem x:Name="CtxCopySlug" Header="Copy slug" Click="OnCtxCopySlug"/>
                                            <Separator x:Name="CtxDeleteSeparator"/>
                                            <MenuItem x:Name="CtxDelete" Header="Delete…" Click="OnCtxDelete"
                                                      InputGestureText="Del"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="44" Height="44"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                        Background="{Binding SourceBadgeBackground}"
                                                        Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding SourceBadge}"
                                                               Style="{StaticResource PillText}"
                                                               Foreground="{Binding SourceBadgeForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Row action, right edge. Disabled with a reason when the
                                             hosted mod has no uploaded version to install. -->
                                        <Button Grid.Column="2" Content="Install"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnQuickInstallMod" Tag="{Binding}"
                                                Padding="12,5" MinHeight="30" MinWidth="0"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding IsInstallable}"
                                                ToolTip="{Binding InstallToolTip}"
                                                ToolTipService.ShowOnDisabled="True"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,80,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" Text="No mods found"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock x:Name="EmptyDetail" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"
                                   Text="Try a different search, filter, or source."/>
                    </StackPanel>

                    <ProgressBar x:Name="LoadingBar" Height="2" VerticalAlignment="Top"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Background="Transparent"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="1"
                    Background="{DynamicResource BorderSubtleBrush}"
                    HorizontalAlignment="Center"/>

            <Border Grid.Column="2"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <Grid>
                    <TextBlock x:Name="DetailPlaceholder"
                               Text="Select a mod to see overview, screenshots, links, versions, and profile-specific install options."
                               Style="{StaticResource Muted}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="420"/>

                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44"
                                    Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    ClipToBounds="True" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button x:Name="OpenProjectButton" Content="Open page"
                                                Click="OnOpenSelectedProject"
                                                Padding="10,4" MinWidth="0" MinHeight="0"/>
                                        <Button x:Name="ManageHostedButton" Content="Manage"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnManageHostedMod"
                                                Padding="10,4" MinWidth="0" MinHeight="0"/>
                                        <Button x:Name="InstallSelectedButton" Content="Install"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnInstallSelectedMod"
                                                Padding="10,4" MinWidth="0" MinHeight="0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ModNameLabel" Style="{StaticResource H2}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock x:Name="ModMetaLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <TabControl Grid.Row="1" x:Name="ModTabs" anim:Animate.TabTransition="True">
                            <TabItem Header="Overview">
                                <Border CornerRadius="8" ClipToBounds="True" Margin="0,12,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Border x:Name="OverviewHost" ClipToBounds="True"
                                            Background="{DynamicResource Surface0Brush}">
                                        <views:RichDescriptionView x:Name="OverviewBrowser"/>
                                    </Border>
                                </Border>
                            </TabItem>

                            <TabItem x:Name="ScreenshotsTab" Header="Screenshots">
                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                               Text="No screenshots are available for this mod."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScreenshotList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="210" Margin="0,0,10,10" Style="{StaticResource Card}" Padding="8"
                                                            Cursor="Hand" ToolTip="Open screenshot"
                                                            MouseLeftButtonUp="OnOpenScreenshot">
                                                        <StackPanel>
                                                            <Border Height="112" Background="{DynamicResource Surface0Brush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="LinksTab" Header="Links">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="LinksEmptyText" Style="{StaticResource Muted}"
                                               Text="This project has not published extra links through the selected provider."
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Versions">
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                                            <TextBlock x:Name="VersionFilterNote" Style="{StaticResource Caption}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ShowAllVersionsBox" Grid.Column="1" Content="Show all"
                                                  VerticalAlignment="Center"
                                                  Checked="OnShowAllVersionsChanged" Unchecked="OnShowAllVersionsChanged"/>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="6">
                                        <DataGrid x:Name="VersionsGrid"
                                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                                  HeadersVisibility="Column" RowHeaderWidth="0"
                                                  SelectionMode="Single" IsReadOnly="True"
                                                  Background="Transparent" BorderThickness="0">
                                            <DataGrid.RowStyle>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="ToolTip" Value="{Binding ChangelogToolTip}"/>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                                <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="120"/>
                                                <DataGridTextColumn Header="Loader" Binding="{Binding LoaderList}" Width="96"/>
                                                <DataGridTextColumn Header="Channel" Binding="{Binding ReleaseChannel}" Width="74"/>
                                                <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="96"/>
                                                <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
                                                <!-- Row actions, right edge: the changelog the server
                                                     already stores, then Install. -->
                                                <DataGridTemplateColumn Width="34">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource IconButton}"
                                                                    Content="&#xE7C3;" FontFamily="{StaticResource IconFont}"
                                                                    FontSize="12" Width="26" Height="24" Padding="0"
                                                                    Click="OnShowChangelog" Tag="{Binding}"
                                                                    Visibility="{Binding ChangelogButtonVisibility}"
                                                                    ToolTip="Show this version's changelog"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="88">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Install" Style="{StaticResource AccentButton}"
                                                                    Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                                    Click="OnDownloadVersion"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <DockPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Bottom" Height="3"
                                         Margin="0,0,0,-8" VerticalAlignment="Bottom"
                                         Visibility="Collapsed" IsIndeterminate="False"/>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="5" Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,8">
            <DockPanel>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Foreground="{DynamicResource DangerBrush}"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
