<Page x:Class="CloudLauncher.Views.ModsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Mods"
      Background="{DynamicResource Surface0Brush}">

    <!--  Header, actions, divider, filter strip, tabs, status. The page has the per-pack hub's shape
    over every mod on this PC: the hub's launcher-wide surfaces are the tabs here, with the same
    names and order, and the store browser is one of them. Row 1 is the standard actions bar, with
    its controls in the same spots as on Instances, Worlds, Resource packs and Shader packs.  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: title only. Actions are in the bar below, the count in the status bar. ── -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel>
                <TextBlock Style="{StaticResource H1}" Text="Mods"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Your default mods, and every mod installed across your instances."/>
            </StackPanel>
        </DockPanel>

        <!-- ── Row 1: Import on the left; search, open folder and refresh on the right, in the
        same spots as the other content pages. ── -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-3,0,-3">
                <!--  The only AccentButton, first and at default padding; its size against
                HeaderActionButton sets the hierarchy. Hosting a mod is a step inside Import.  -->
                <Button x:Name="ImportButton" Style="{StaticResource AccentButton}"
                        Margin="0,3,8,3" Click="OnImport"
                        ToolTip="Import a jar - into instances, into your defaults, and optionally published">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <!--  No Browse button: browsing is the "Mod browsing" tab.  -->
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <views:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0"
                                        Placeholder="Search mods"
                                        SearchToolTip="Search by name, file, version, category or note (Ctrl+F)"/>
                <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnOpenFolder"
                        Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Open the folder this list is showing"/>
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Read every instance's mods folder again (F5)"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!--  Sort, filters, instance scope, this page's toggles, then the folder chips (last, as on
        every foldered page; the trailing chip creates a folder). One strip above the tabs serves
        all four: the list and the Categories board filter through ModListPane.Filtered, the graph
        uses the same rows, and the browser uses the scope's Minecraft version and loader.
        Controls that don't apply to the current tab are disabled and faded rather than hidden, so
        nothing moves, and their tooltips say why (ApplyStripForTab, with ShowOnDisabled).  -->
        <Grid x:Name="FilterStrip" Grid.Row="3" Margin="28,0,28,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}"
                        Click="OnSortButtonClick"
                        Content="&#xE8CB;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Sort mods" ToolTipService.ShowOnDisabled="True">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSortMenuOpened">
                            <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="name"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortPriorityMenuItem" Header="Priority" Tag="priority"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortInstancesMenuItem" Header="Instances" Tag="instances"
                                      IsCheckable="True" Click="OnSortMenuItemClick"
                                      ToolTip="The mods you have in the most instances first"/>
                            <MenuItem x:Name="SortAddedMenuItem" Header="Add date" Tag="added"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortSizeMenuItem" Header="Content size" Tag="size"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <Separator/>
                            <MenuItem x:Name="SortReverseMenuItem" Header="Reverse"
                                      IsCheckable="True" Click="OnSortReverseClick"/>
                            <Separator/>
                            <!--  The hosted stores answer in their own relevance order, so these
                                 three only apply while browsing one of the CloudLauncher chips.  -->
                            <MenuItem x:Name="SortUpdatedMenuItem" Header="Recently updated (browse)"
                                      Tag="updated" IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortCreatedMenuItem" Header="Newest (browse)"
                                      Tag="created" IsCheckable="True" Click="OnSortMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!--  A ToggleButton so an active filter is visible without hovering.  -->
                <ToggleButton x:Name="FiltersButton" Style="{StaticResource ToolbarToggleButton}"
                              Click="OnFiltersClick" Content="&#xE71C;" ToolTip="Filters"
                              ToolTipService.ShowOnDisabled="True"/>

                <!--  The page's only scope control, for every tab: which instance the list, board and
                graph show, and which instance the store browser searches and installs for.  -->
                <ComboBox x:Name="PackScopeBox" Width="240" Margin="0,0,8,0"
                          SelectionChanged="OnPackScopeChanged"
                          ToolTip="Narrow the list to one instance"
                          ToolTipService.ShowOnDisabled="True"/>

                <ToggleButton x:Name="DefaultsOnlyButton" Style="{StaticResource ToolbarToggleButton}"
                              Click="OnDefaultsOnlyClick" Content="&#xE734;"
                              ToolTip="Show only your defaults"
                              ToolTipService.ShowOnDisabled="True"/>
                <ToggleButton x:Name="GroupByCategoryButton" Style="{StaticResource ToolbarToggleButton}"
                              Click="OnGroupByCategoryClick" Content="&#xE8EC;"
                              ToolTip="Group the list by category"
                              ToolTipService.ShowOnDisabled="True"/>

                <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="0" VerticalOffset="6"
                       Closed="OnFiltersPopupClosed">
                    <slate:SlateBorder Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" MinWidth="260">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                            <CheckBox x:Name="FilterHideDisabled" Content="Hide disabled"
                                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,0,6"/>
                            <CheckBox x:Name="FilterShadowedOnly" Content="Only where an instance has its own copy"
                                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,0,6"
                                      ToolTip="The instance's own jar wins at launch, so your default is present and unused"/>
                            <CheckBox x:Name="FilterNotesOnly" Content="Only mods with a note"
                                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Store" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FilterSourceBox" Margin="0,0,0,10"
                                      SelectionChanged="OnFilterSourceChanged">
                                <ComboBoxItem Content="All stores" IsSelected="True"/>
                                <ComboBoxItem Content="CurseForge"/>
                                <ComboBoxItem Content="Modrinth"/>
                                <ComboBoxItem Content="External"/>
                            </ComboBox>
                            <!--  Used by the store browser. Kept in this popup so Filters means one
                            thing on this page.  -->
                            <TextBlock Style="{StaticResource Caption}" Text="Minecraft version (browse)"/>
                            <TextBox x:Name="FilterMcBox" Margin="0,4,0,10"
                                     ToolTip="e.g. 1.20.1 - leave empty for any"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Loader (browse)"/>
                            <ComboBox x:Name="FilterLoaderBox" Margin="0,4,0,10">
                                <ComboBoxItem Content="(any)" IsSelected="True"/>
                                <ComboBoxItem Content="fabric"/>
                                <ComboBoxItem Content="forge"/>
                                <ComboBoxItem Content="neoforge"/>
                                <ComboBoxItem Content="quilt"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Clear" Click="OnClearFilters" Padding="14,5" Margin="0,0,8,0"/>
                                <Button Content="Apply" Style="{StaticResource AccentButton}"
                                        Click="OnApplyFilters" Padding="14,5"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>
                </Popup>

                <!--  The default rules for one mod: a short form, so a popup over the row rather
                than a window.  -->
                <Popup x:Name="RulesPopup" PlacementTarget="{Binding ElementName=PackScopeBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       VerticalOffset="6">
                    <slate:SlateBorder Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" MinWidth="380" MaxWidth="440">
                        <StackPanel>
                            <TextBlock x:Name="RulesTitle" Style="{StaticResource H3}" Margin="0,0,0,2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="A default is placed into every instance these rules admit, and taken back out of the ones they stop admitting. An instance can still turn it off for itself."/>
                            <CheckBox x:Name="RulesEnabled" Margin="0,0,0,10"
                                      Content="Put this in every compatible instance automatically"
                                      Checked="OnRulesFieldChanged" Unchecked="OnRulesFieldChanged"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Minecraft versions"/>
                            <TextBox x:Name="RulesMcBox" Margin="0,4,0,10"
                                     TextChanged="OnRulesTextChanged"
                                     ToolTip="1.21.1, or 1.21 for the whole family, or 1.21.* - empty means any"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Loaders"/>
                            <TextBox x:Name="RulesLoaderBox" Margin="0,4,0,10"
                                     TextChanged="OnRulesTextChanged"
                                     ToolTip="neoforge, fabric - empty means any"/>
                            <CheckBox x:Name="RulesKeepLocal" Margin="0,0,0,8"
                                      Content="Keep on this machine (never upload to collaborators)"
                                      Checked="OnRulesFieldChanged" Unchecked="OnRulesFieldChanged"
                                      ToolTip="A shared instance's mods folder is uploaded; this holds your own copy back"/>
                            <TextBlock x:Name="RulesReach" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Click="OnRulesCancel" Padding="14,5" Margin="0,0,8,0"/>
                                <Button Content="Save and apply" Style="{StaticResource AccentButton}"
                                        Click="OnRulesSave" Padding="14,5"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>
                </Popup>

                <!--  Which instances get a mod. It only adds: an instance that already has the mod
                is ticked and disabled, since removing it means "Stop being a default" (the
                library keeps the file) or Delete (the file goes).  -->
                <Popup x:Name="InstancesPopup" PlacementTarget="{Binding ElementName=PackScopeBox}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       VerticalOffset="6">
                    <slate:SlateBorder Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="16" MinWidth="420" MaxWidth="520">
                        <StackPanel>
                            <TextBlock x:Name="InstancesTitle" Style="{StaticResource H3}" Margin="0,0,0,2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Ticked instances get the shared copy - one copy of the bytes, however many instances hold it. An instance that already has its own copy keeps it."/>
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="InstancePickList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanChoose}"
                                                      Margin="0,0,0,8" Click="OnInstancePickToggled"
                                                      ToolTip="{Binding ToolTipText}"
                                                      ToolTipService.ShowOnDisabled="True">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="InstancesReach" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,10,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Click="OnInstancesCancel" Padding="14,5" Margin="0,0,8,0"/>
                                <Button x:Name="InstancesApplyButton" Content="Add to instances"
                                        Style="{StaticResource AccentButton}"
                                        Click="OnInstancesApply" Padding="14,5"/>
                            </StackPanel>
                        </StackPanel>
                    </slate:SlateBorder>
                </Popup>
            </StackPanel>

            <!--  The user's folders over the mods on this PC. On the browsing tab the store chips
            pick the set, so these are disabled and faded there rather than hidden. The whole
            ScrollViewer is disabled because the chips are Borders with click handlers and have no
            disabled state of their own.  -->
            <ScrollViewer x:Name="FolderScroller" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          ToolTipService.ShowOnDisabled="True">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Selected state is a trigger on IsActive rather than a brush baked
                            into the row, so an accent change in Settings repaints chips already
                            on screen.  -->
                            <slate:SlateBorder Style="{StaticResource FolderChipBorder}"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource FolderChipGlyph}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FolderChipLabel}"/>
                                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource FolderChipCount}"/>
                                </StackPanel>
                            </slate:SlateBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── Row 4: the per-pack hub's tabs over the launcher-wide mod set, with the same labels and
        order as Views/ModManagementView. The hub's other two tabs don't apply here (see the class
        remarks). The strip in row 3 applies to all four tabs (ApplyStripForTab). ── -->
        <TabControl x:Name="Tabs" Grid.Row="4" Margin="28,2,28,12" SelectionChanged="OnTabChanged">

            <!-- ─────────────────────── LIST VIEW ──────────────────────── -->
            <TabItem Header="List view">
                <DockPanel Margin="0,12,0,0">
                    <Grid x:Name="ManageHost">
                        <views:ModListPane x:Name="ListPane"/>
                        <!--  Last in the cell so it overlays the list.  -->
                        <views:PageStateView x:Name="PageStateHost"/>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ───────────────────── MOD BROWSING ───────────────────── -->
            <TabItem Header="Mod browsing">
                <DockPanel Margin="0,12,0,0">
                    <!--  The stores, where the folders sit on the List tab. This is the only part of
                    the page that needs an account, and its empty state says so
                    (EmptyCopyForActiveChip).  -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" Margin="0,0,10,0"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SourceStrip">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <slate:SlateBorder Padding="0" Margin="0,2,8,2"
                                                Cursor="{Binding CursorHint}"
                                                Background="{Binding Background}"
                                                BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                                CornerRadius="14"
                                                MouseLeftButtonUp="OnSourceChipClick"
                                                Visibility="{Binding ChipVisibility}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}"
                                                           FontSize="11" Margin="12,0,6,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground}"
                                                           Visibility="{Binding IconVisibility}"/>
                                                <TextBlock Text="{Binding Label}" Margin="0,0,12,0"
                                                           Padding="0,5,0,5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground}"
                                                           FontWeight="{Binding FontWeight}"/>
                                            </StackPanel>
                                        </slate:SlateBorder>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!--  Says how the scope affects this tab: with an instance selected, results are
                        narrowed to its Minecraft version and loader and Install goes into it,
                        neither of which shows in the results. Empty on "All instances".  -->
                        <TextBlock x:Name="BrowseScopeNote" Grid.Column="1" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" MaxWidth="440" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <Grid x:Name="BrowseHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="4*"/>
                        </Grid.ColumnDefinitions>

                        <slate:SlateBorder Grid.Column="0"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <ListBox x:Name="ResultsList"
                                         SelectionChanged="OnResultSelected"
                                         MouseDoubleClick="OnResultDoubleClick"
                                         Background="Transparent" BorderThickness="0"
                                         anim:Animate.EntranceStagger="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.ScrollChanged="OnResultsScroll">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!--  No inline ContextMenu: it would build every
                                            MenuItem for each realized row while scrolling.
                                            OnRowRightButtonUp builds the menu on demand
                                            instead.  -->
                                            <Border Padding="10" Background="Transparent"
                                                    anim:Animate.HoverLift="True"
                                                    MouseRightButtonUp="OnRowRightButtonUp"
                                                    ToolTip="{Binding RowToolTip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <slate:SlateBorder Grid.Column="0" Width="44" Height="44"
                                                            Background="{DynamicResource Surface3Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            ClipToBounds="True" VerticalAlignment="Top">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <!--  Never bind a URL straight to Image.Source: see IconLoader.  -->
                                                            <Image views:IconLoader.Url="{Binding IconUrl}"
                                                                   views:IconLoader.DecodeWidth="44" Stretch="Uniform"/>
                                                        </Grid>
                                                    </slate:SlateBorder>

                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <DockPanel>
                                                            <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                                    Background="{Binding SourceBadgeBackground}"
                                                                    Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding SourceBadge}"
                                                                           Style="{StaticResource PillText}"
                                                                           Foreground="{Binding SourceBadgeForeground}"/>
                                                            </slate:SlateBorder>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="13" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                                   Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Row action, right edge. Disabled with a reason when the
                                                         hosted mod has no uploaded version to install. -->
                                                    <Button Grid.Column="2" Content="Install"
                                                            Style="{StaticResource AccentButton}"
                                                            Click="OnQuickInstallMod" Tag="{Binding}"
                                                            Padding="12,5" MinHeight="30" MinWidth="0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding InstallVisibility}"
                                                            IsEnabled="{Binding IsInstallable}"
                                                            ToolTip="{Binding InstallToolTip}"
                                                            ToolTipService.ShowOnDisabled="True"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <views:PageStateView x:Name="BrowseStateHost"/>
                            </Grid>
                        </slate:SlateBorder>

                        <Border Grid.Column="1" Width="1"
                                Background="{DynamicResource BorderSubtleBrush}"
                                HorizontalAlignment="Center"/>

                        <slate:SlateBorder Grid.Column="2"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="18">
                            <Grid>
                                <TextBlock x:Name="DetailPlaceholder"
                                           Text="Select a mod to see overview, screenshots, links, versions, and profile-specific install options."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" MaxWidth="420"/>

                                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <slate:SlateBorder Grid.Column="0" Width="44" Height="44"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                                            </Grid>
                                        </slate:SlateBorder>
                                        <StackPanel Grid.Column="1">
                                            <!--  MaxHeight is two lines of H2; longer names are
                                            trimmed.  -->
                                            <TextBlock x:Name="ModNameLabel" Style="{StaticResource H2}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="54"/>
                                            <TextBlock x:Name="ModMetaLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!--  The actions get their own row: docked beside the name
                                        they would take most of a pane that is ~200 px wide at
                                        MinWidth and squeeze the name. WrapPanel so they wrap
                                        instead of spilling out of the card.  -->
                                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
                                                   HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button x:Name="OpenProjectButton" Content="Open page"
                                                    Click="OnOpenSelectedProject"
                                                    Padding="10,4" MinWidth="0" MinHeight="0"/>
                                            <Button x:Name="ManageHostedButton" Content="Manage"
                                                    Style="{StaticResource AccentButton}"
                                                    Click="OnManageHostedMod"
                                                    Padding="10,4" MinWidth="0" MinHeight="0"/>
                                            <Button x:Name="InstallSelectedButton" Content="Install"
                                                    Style="{StaticResource AccentButton}"
                                                    Click="OnInstallSelectedMod"
                                                    Padding="10,4" MinWidth="0" MinHeight="0"/>
                                        </WrapPanel>
                                    </Grid>

                                    <TabControl Grid.Row="1" x:Name="ModTabs" anim:Animate.TabTransition="True">
                                        <TabItem Header="Overview">
                                            <slate:SlateBorder CornerRadius="8" ClipToBounds="True" Margin="0,12,0,0"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Border x:Name="OverviewHost" ClipToBounds="True"
                                                        Background="{DynamicResource Surface0Brush}">
                                                    <views:RichDescriptionView x:Name="OverviewBrowser"/>
                                                </Border>
                                            </slate:SlateBorder>
                                        </TabItem>

                                        <TabItem x:Name="ScreenshotsTab" Header="Screenshots">
                                            <Grid Margin="0,12,0,0">
                                                <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                                           Text="No screenshots are available for this mod."
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl x:Name="ScreenshotList">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <slate:SlateBorder Width="210" Margin="0,0,10,10" Style="{StaticResource Card}" Padding="8"
                                                                        Cursor="Hand" ToolTip="Open screenshot"
                                                                        MouseLeftButtonUp="OnOpenScreenshot">
                                                                    <StackPanel>
                                                                        <slate:SlateBorder Height="112" Background="{DynamicResource Surface0Brush}"
                                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                                        </slate:SlateBorder>
                                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                                    </StackPanel>
                                                                </slate:SlateBorder>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                        <TabItem x:Name="LinksTab" Header="Links">
                                            <StackPanel Margin="0,14,0,0">
                                                <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                                                <WrapPanel Margin="0,2,0,0">
                                                    <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                                    <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                                    <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                                    <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                                    <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                                </WrapPanel>
                                                <TextBlock x:Name="LinksEmptyText" Style="{StaticResource Muted}"
                                                           Text="This project has not published extra links through the selected provider."
                                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="Versions">
                                            <Grid Margin="0,12,0,0">
                                                <!--  Versions on top, the selected one's changelog
                                                under them; the rule between them drags.  -->
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="3*" MinHeight="110"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="2*" MinHeight="120"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                                        <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                                                        <TextBlock x:Name="VersionFilterNote" Style="{StaticResource Caption}"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="ShowAllVersionsBox" Grid.Column="1" Content="Show all"
                                                              VerticalAlignment="Center"
                                                              Checked="OnShowAllVersionsChanged" Unchecked="OnShowAllVersionsChanged"/>
                                                </Grid>
                                                <slate:SlateBorder Grid.Row="1" Background="{DynamicResource Surface0Brush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="6">
                                                    <!--  Right-click selects the row, then offers its
                                                         changelog and an install of that version.  -->
                                                    <DataGrid x:Name="VersionsGrid"
                                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                                              HeadersVisibility="Column" RowHeaderWidth="0"
                                                              SelectionMode="Single" IsReadOnly="True"
                                                              Background="Transparent" BorderThickness="0"
                                                              PreviewMouseRightButtonDown="OnVersionsGridPreviewRightDown"
                                                              MouseRightButtonUp="OnVersionsGridRightClick"
                                                              SelectionChanged="OnVersionSelected">
                                                        <!--  BasedOn keeps the app's row hover and
                                                        selection, so a right-clicked row shows which one
                                                        the menu is for.  -->
                                                        <DataGrid.RowStyle>
                                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                                <Setter Property="ToolTip" Value="{Binding ChangelogToolTip}"/>
                                                            </Style>
                                                        </DataGrid.RowStyle>
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                                            <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="120"/>
                                                            <DataGridTextColumn Header="Loader" Binding="{Binding LoaderList}" Width="96"/>
                                                            <DataGridTextColumn Header="Channel" Binding="{Binding ReleaseChannel}" Width="74"/>
                                                            <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="96"/>
                                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
                                                            <!-- Row actions, right edge: the changelog (the one the
                                                                 server stores for a hosted mod, fetched from the
                                                                 store for the rest), then Install. -->
                                                            <DataGridTemplateColumn Width="34">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource IconButton}"
                                                                                Content="&#xE7C3;" FontFamily="{DynamicResource IconFont}"
                                                                                FontSize="12" Width="26" Height="24" Padding="0"
                                                                                Click="OnShowChangelog" Tag="{Binding}"
                                                                                Visibility="{Binding ChangelogButtonVisibility}"
                                                                                ToolTip="Show this version's changelog"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTemplateColumn Width="88">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="Install" Style="{StaticResource AccentButton}"
                                                                                Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                                                Click="OnDownloadVersion"/>
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </slate:SlateBorder>

                                                <Border Grid.Row="2" Height="1" Margin="2,6" VerticalAlignment="Center"
                                                        IsHitTestVisible="False" Background="{DynamicResource BorderBrush}"/>
                                                <GridSplitter Grid.Row="2" Height="13" Background="Transparent"
                                                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                                                              FocusVisualStyle="{x:Null}"
                                                              ToolTip="Drag to give the versions or the changelog more room"/>

                                                <views:VersionChangelogPane x:Name="VersionChangelog" Grid.Row="3"/>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>

                                    <DockPanel Grid.Row="2" Margin="0,14,0,0">
                                        <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Bottom" Height="3"
                                                     Margin="0,0,0,-8" VerticalAlignment="Bottom"
                                                     Visibility="Collapsed" IsIndeterminate="False"/>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </slate:SlateBorder>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ────────────────────── GRAPH VIEW ─────────────────────── -->
            <TabItem Header="Graph view">
                <DockPanel Margin="0,12,0,0">
                    <!--  Which mods are on the canvas (per the page scope) and what an edge means
                    across instances. Also says when the graph was capped (LoadGraph).  -->
                    <TextBlock x:Name="GraphNotice" DockPanel.Dock="Top" Style="{StaticResource Caption}"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid>
                        <Grid x:Name="GraphHost"/>
                        <!--  Shown instead of the graph while there is nothing to graph;
                        ShowGraphHint sets both visibilities. It has no background, so the
                        host must be hidden behind it.  -->
                        <StackPanel x:Name="GraphHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="460">
                            <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFont}" FontSize="44"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="GraphHintTitle" Style="{StaticResource H2}"
                                       Text="Nothing to graph" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock x:Name="GraphHintBody" Style="{StaticResource Muted}"
                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="No mod in any instance matches the filters above."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ────────────────────── CATEGORIES ─────────────────────── -->
            <TabItem Header="Categories">
                <!--  The hub's Categories workbench over ModMetadataService.GlobalScope. Its category
                APIs already take a scope id. It checks IsGlobalScope itself to drop the per-file
                Delete and Update-to-version items and its own search box (the page's search box
                applies here).  -->
                <Grid x:Name="CategoriesHost" Margin="0,12,0,0"/>
            </TabItem>
        </TabControl>

        <!-- ── Row 5: status left, count and progress right. One bar for all tabs, since only the
        visible tab loads. ── -->
        <Border Grid.Row="5" Style="{StaticResource PageStatusBar}">
            <DockPanel>
                <!--  No Foreground: PageState colours this line.  -->
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4"
                             IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
