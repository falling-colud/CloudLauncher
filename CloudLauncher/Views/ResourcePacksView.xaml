<Page x:Class="CloudLauncher.Views.ResourcePacksView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      Title="Resource packs"
      Background="{DynamicResource Surface0Brush}">

    <!--  The standard six-row page (header, actions, divider, strip, content, status), laid out
    like Worlds and Shaders so matching buttons sit in the same places. Lists every resource pack
    you have, in your own folders, with one "on by default" switch per row: on means every
    compatible instance gets it. A row opens the pack's page, where the instances can be narrowed.
    Folders are named lists in AppSettings.ResourcePackFolders, managed from the chip and row
    menus. Load order lives in each instance's options.txt, so it is on that instance's
    Resources tab (the row menu's "Load order for ...").  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: title and one line saying what the page is. No buttons, no count. ── -->
        <DockPanel Grid.Row="0" Style="{StaticResource PageHeaderPanel}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource H1}" Text="Resource packs"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Every pack on this PC, across all your instances. File them into folders, and click one to open its own page."/>
            </StackPanel>
        </DockPanel>

        <!-- ── Row 1: the canonical actions bar ────────────────────────────── -->
        <Grid Grid.Row="1" Style="{StaticResource PageFilterBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-3,0,-3">
                <!--  The page's one accent button. Import picks the file, optionally the
                instances, and can publish it in the same flow.  -->
                <Button x:Name="ImportButton" Style="{StaticResource AccentButton}"
                        Margin="0,3,8,3" Click="OnImport"
                        ToolTip="Bring a .zip (or an unpacked pack folder) in, and into any instances you choose. You can also drop one onto this page.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Import" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BrowseButton" Style="{StaticResource HeaderActionButton}"
                        Click="OnOpenDownloadBrowser"
                        ToolTip="Browse CurseForge, Modrinth and CloudLauncher for a resource pack" Margin="0,3,8,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <views:CompactSearchBox x:Name="SearchBox" Margin="0,0,8,0"
                                        Placeholder="Filter packs"
                                        SearchToolTip="Filter by name, file or instance (Ctrl+F)"/>
                <!--  Icon-only utilities, always in this order: open folder, then refresh.
                     "Open folder" has no global meaning here because resourcepacks/ is per instance,
                     so it resolves one first - see OnOpenFolder.  -->
                <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnOpenFolder"
                        Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Open an instance's resourcepacks folder"/>
                <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                        Click="OnRefresh"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Re-read every instance's resourcepacks folder and your own packs (F5)"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource PageDivider}"/>

        <!-- ── Row 3: sort, instance scope, folders ─────────────────────── -->
        <Grid Grid.Row="3" Margin="28,4,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}"
                        Click="OnSortButtonClick"
                        Content="&#xE8CB;" FontFamily="{DynamicResource IconFont}"
                        ToolTip="Sort resource packs">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnSortMenuOpened">
                            <MenuItem x:Name="SortModifiedMenuItem" Header="Last modified" Tag="Modified"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortNameMenuItem" Header="Name" Tag="Name"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortSizeMenuItem" Header="Size" Tag="Size"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                            <MenuItem x:Name="SortPackMenuItem" Header="Instances using it" Tag="Pack"
                                      IsCheckable="True" Click="OnSortMenuItemClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <ComboBox x:Name="PackScopeBox" Width="240" Margin="0,0,8,0"
                          SelectionChanged="OnPackScopeChanged"
                          ToolTip="Narrow the page to one instance - only that instance's packs are listed, and the status line reports which of them override each other"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="FolderStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Active state is an accent border and a bolder label, from
                            DataTriggers on DynamicResource brushes. ThemeService hands out
                            new brushes on every apply, so a brush stored on the row would
                            keep the old accent.  -->
                            <slate:SlateBorder Style="{StaticResource FolderChipBorder}"
                                    ToolTip="{Binding ToolTipText}"
                                    MouseLeftButtonUp="OnFolderChipClick"
                                    MouseRightButtonUp="OnFolderChipRightClick">
                                <slate:SlateBorder.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Rename folder..." Click="OnFolderRename"/>
                                        <MenuItem Header="Delete folder..." Click="OnFolderDelete"/>
                                    </ContextMenu>
                                </slate:SlateBorder.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource FolderChipGlyph}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FolderChipLabel}"/>
                                    <TextBlock Text="{Binding CountLabel}" Style="{StaticResource FolderChipCount}"/>
                                    <!--  Rename and delete are on the chip's right-click menu;
                                    adding a pack is on the pack's row menu.  -->
                                </StackPanel>
                            </slate:SlateBorder>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ── Row 4: the list ────────────────────────────────────────────── -->
        <!--  AllowDrop is on this Grid rather than the list because PageState collapses the list
        while the page is empty, and the empty panel invites dropping a zip.  -->
        <Grid Grid.Row="4" Margin="28,0,28,16"
              Background="Transparent"
              AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop">
            <views:ContentListView x:Name="PackList"/>

            <!--  Last child so it draws over the list. Loading, empty, filtered-empty, error and
            offline states all come from this control, driven by Views/PageState.cs.  -->
            <views:PageStateView x:Name="PageStateHost"/>
        </Grid>

        <!-- ── Row 5: status left, count and progress right ───────────────── -->
        <!--  The count lives here rather than in the header, where nobody would see it change.  -->
        <Border Grid.Row="5" Style="{StaticResource PageStatusBar}">
            <DockPanel>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
                <!--  No Click handler: PageState.Slots routes this button to its own
                     CancelRequested, and a handler here as well would cancel twice.  -->
                <Button x:Name="BusyCancelButton" DockPanel.Dock="Right" Content="Cancel"
                        Padding="10,2" MinHeight="0" MinWidth="0" Margin="12,0,0,0"
                        Visibility="Collapsed" VerticalAlignment="Center"
                        ToolTip="Stop the operation in progress"/>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4"
                             IsIndeterminate="True" Visibility="Collapsed"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
