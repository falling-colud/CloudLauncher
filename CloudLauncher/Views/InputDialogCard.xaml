<UserControl x:Class="CloudLauncher.Views.InputDialogCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="24" MinWidth="340" MaxWidth="440">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" TextWrapping="Wrap"/>
            <TextBlock x:Name="LabelText" Style="{StaticResource Caption}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="InputBox"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnCancel"/>
                <Button Content="OK" Style="{StaticResource AccentButton}" Click="OnOk"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
