<UserControl x:Class="CloudLauncher.Views.CompactSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             VerticalAlignment="Center">
    <!--  Host is what animates; the control sizes itself to it. Right-aligned so that in a
    stretched column the box grows leftwards, away from the page edge.  -->
    <slate:SlateBorder x:Name="Host"
            HorizontalAlignment="Right"
            Background="{DynamicResource Surface1Brush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            MinHeight="36" Width="36"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ToggleButton" Grid.Column="0"
                    Style="{StaticResource IconButton}"
                    Click="OnToggleClick"
                    Content="&#xE721;"
                    FontFamily="{DynamicResource IconFont}" FontSize="13"/>

            <Grid Grid.Column="1">
                <TextBlock x:Name="PlaceholderText"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>

                <!--  Bare template: the surrounding border draws the chrome.  -->
                <TextBox x:Name="Box"
                         Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Visibility="Collapsed"
                         TextChanged="OnBoxTextChanged"
                         PreviewKeyDown="OnBoxPreviewKeyDown"
                         LostKeyboardFocus="OnBoxLostKeyboardFocus">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>
        </Grid>
    </slate:SlateBorder>
</UserControl>
