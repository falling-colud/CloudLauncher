<Page x:Class="CloudLauncher.Views.ModManagementView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      Background="{DynamicResource Surface0Brush}">
    <Page.Resources>
        <!-- How wide a row's name/meta block may get before the row's buttons start. Replaced at load
             from Settings → Mods; DynamicResource is what lets a change reach the rows already built. -->
        <sys:Double x:Key="ModRowContentWidth">620</sys:Double>
        <!-- Which edge of the leftover space a row's buttons hug. Right by default so a wide window
             keeps a straight column of controls; Settings → Mods can pull them back beside the name. -->
        <HorizontalAlignment x:Key="ModRowActionsAlign">Right</HorizontalAlignment>
        <local:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <local:PriorityToVisibilityConverter x:Key="PriorityVis"/>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>
        <local:ModSideLabelConverter x:Key="SideLabel"/>
        <local:CategoryToBrushConverter x:Key="CategoryBrush"/>

        <!-- Note chip on a card: muted when empty, accent (with the note as its tooltip) when set -->
        <Style x:Key="NoteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="ToolTip" Value="Add a note"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNote}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="ToolTip" Value="{Binding Note}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Reusable enable/disable switch (matches the Mod view toggle) -->
        <Style x:Key="ModToggleSwitch" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <DockPanel Margin="20">
        <!-- Header.
             The right inset keeps every header control clear of the shell's floating panel buttons.
             MainWindow draws those (close, and back when it is showing) in a StackPanel pinned to the
             top-right of SidePanelHost at Margin="0,10,10,0" with 32-px buttons, so they cover the
             rightmost 42 px of this page whenever it is opened in the side panel. This DockPanel's own
             Margin="20" accounts for 20 of that; the 34 here clears the remaining 22 and leaves a
             12-px gap, so nothing in the header can end up underneath the overlay. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,34,12">
            <StackPanel>
                <TextBlock Text="Modpack Management" Style="{StaticResource H2}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PackNameLabel" Style="{StaticResource Muted}"/>
                    <TextBlock x:Name="ModCountLabel" Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Refresh deliberately is NOT here: it lives at the right end of the List view
                     toolbar, with the other controls that act on the list. -->
                <Button x:Name="LaunchButton" Content="Launch" Style="{StaticResource AccentButton}"
                        Margin="0,0,12,0" Click="OnLaunch" ToolTip="Launch this pack"/>
                <Button x:Name="ToolsButton" Content="Tools ▾" Style="{StaticResource SubtleButton}"
                        Margin="0,0,8,0" Click="OnSideTools"
                        ToolTip="Side routing, extras, and server/client export"/>
                <Button x:Name="RunTestButton" Content="Run as Test" Style="{StaticResource SubtleButton}"
                        Click="OnRunTest"
                        ToolTip="Launch with only test-marked mods and their dependencies"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
            <!-- ───────────────────────── LIST VIEW ───────────────────────── -->
            <TabItem Header="List view">
                <DockPanel Margin="0,12,0,0">
                    <!-- The controls wrap onto a second line when the window is narrow rather than clipping. -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="260" MinHeight="34" Margin="0,0,12,6"
                                Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="11,0,8,0"/>
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="SearchPlaceholder" Text="Search mods…"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                             VerticalAlignment="Center" Margin="0,0,10,0" TextChanged="OnSearchChanged"
                                             GotKeyboardFocus="OnSearchFocusChanged" LostKeyboardFocus="OnSearchFocusChanged"
                                             ToolTip="Filter by name, version or source">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </Border>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Sort" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SortBox" Width="150" SelectionChanged="OnSortChanged">
                                <ComboBoxItem Content="Priority" IsSelected="True"/>
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Add date"/>
                                <ComboBoxItem Content="Update date"/>
                                <ComboBoxItem Content="Status"/>
                                <ComboBoxItem Content="Content size"/>
                                <ComboBoxItem Content="Category" ToolTip="Group the list by category, with a heading for each"/>
                            </ComboBox>
                            <Button x:Name="SortDirButton" Style="{StaticResource IconButton}" Content="&#xE70D;"
                                    FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0"
                                    ToolTip="Reverse sort direction" Click="OnToggleSortDir"/>
                            </StackPanel>
                            <CheckBox x:Name="HideDisabled" Content="Hide disabled" Margin="14,0,0,6"
                                      VerticalAlignment="Center" Click="OnFilterToggle"/>
                            <CheckBox x:Name="OnlyUpdates" Content="Only updates" Margin="12,0,0,6"
                                      VerticalAlignment="Center" Click="OnFilterToggle"/>
                            <ComboBox x:Name="SourceFilterBox" Width="122" Margin="12,0,0,6" SelectionChanged="OnSortChanged"
                                      VerticalAlignment="Center" ToolTip="Show only mods from one store">
                                <ComboBoxItem Content="All sources" IsSelected="True"/>
                                <ComboBoxItem Content="CurseForge"/>
                                <ComboBoxItem Content="Modrinth"/>
                                <ComboBoxItem Content="External"/>
                            </ComboBox>
                            <!-- Narrow the list to one flag or one category. Deliberately not sticky
                                 across sessions, for the same reason "Only updates" is not: these are
                                 triage filters, and opening a pack that looks empty is alarming. -->
                            <ComboBox x:Name="FlagFilterBox" Width="132" Margin="8,0,0,6" SelectionChanged="OnSortChanged"
                                      VerticalAlignment="Center" ToolTip="Show only mods carrying one flag">
                                <ComboBoxItem Content="All mods" IsSelected="True"/>
                                <ComboBoxItem Content="Library"/>
                                <ComboBoxItem Content="Testing"/>
                                <ComboBoxItem Content="Extra"/>
                                <ComboBoxItem Content="Locked"/>
                                <ComboBoxItem Content="Has note"/>
                                <ComboBoxItem Content="Conflicts"/>
                                <ComboBoxItem Content="Client-only"/>
                                <ComboBoxItem Content="Server-only"/>
                            </ComboBox>
                            <ComboBox x:Name="CategoryFilterBox" Width="150" Margin="8,0,0,6" SelectionChanged="OnSortChanged"
                                      VerticalAlignment="Center" ToolTip="Show only mods in one category"/>
                            <Button x:Name="AddFileButton" Content="Add file" Style="{StaticResource SubtleButton}"
                                    Margin="12,0,0,6" Padding="12,5" Click="OnAddFile"
                                    ToolTip="Add mod jars from this PC — or just drop them onto the list"/>
                            <Button x:Name="UpdateAllButton" Content="Update all" Style="{StaticResource AccentButton}"
                                    Margin="12,0,0,6" Padding="12,5" Visibility="Collapsed" Click="OnUpdateAll"
                                    ToolTip="Review every available update, read the changelogs, and pick which ones to install"/>
                            <!-- The one refresh in this page. RenderTransformOrigin centres the spin
                                 the code-behind puts on it while a refresh is running. -->
                            <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                    FontFamily="{StaticResource IconFont}" FontSize="13" Margin="12,0,0,6"
                                    RenderTransformOrigin="0.5,0.5" Click="OnRefresh"
                                    ToolTip="Re-scan the mods folder and check every mod against its store again"/>
                        </WrapPanel>
                    </Grid>

                    <Border x:Name="SelectionBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,10"
                            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,7">
                        <DockPanel>
                            <!-- Bulk actions sit on the bar itself, right-aligned, so the thing the
                                 selection was made for is one click away instead of behind a
                                 right-click. They call the same methods the options menu does. -->
                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SubtleButton}"
                                    Padding="12,3" MinHeight="0" Click="OnClearSelection"/>
                            <Button DockPanel.Dock="Right" Content="Select all" Style="{StaticResource SubtleButton}"
                                    Padding="12,3" MinHeight="0" Margin="0,0,8,0" Click="OnSelectAll"/>
                            <Border DockPanel.Dock="Right" Width="1" Margin="10,2,10,2"
                                    Background="{DynamicResource BorderBrush}"/>
                            <Button DockPanel.Dock="Right" x:Name="BulkOptionsButton" Content="Options ▾"
                                    Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                                    Margin="0,0,8,0" Click="OnBulkOptions"
                                    ToolTip="Every mod option, applied to the whole selection"/>
                            <Button DockPanel.Dock="Right" x:Name="BulkDeleteButton" Content="Delete"
                                    Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                                    Margin="0,0,8,0" Click="OnBulkDelete"
                                    ToolTip="Delete the selected jars from the pack"/>
                            <Button DockPanel.Dock="Right" x:Name="BulkUpdateButton" Content="Update"
                                    Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                                    Margin="0,0,8,0" Click="OnBulkUpdate"
                                    ToolTip="Update the selected mods to their newest compatible version"/>
                            <Button DockPanel.Dock="Right" x:Name="BulkDisableButton" Content="Disable"
                                    Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                                    Margin="0,0,8,0" Click="OnBulkDisable"/>
                            <Button DockPanel.Dock="Right" x:Name="BulkEnableButton" Content="Enable"
                                    Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                                    Margin="0,0,8,0" Click="OnBulkEnable"/>
                            <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DockPanel>
                    </Border>

                    <!-- Fixed-height status / launch-log strip: shows at most 3 lines, so streaming game
                         output never grows this area or resizes the mod list above it. -->
                    <Border DockPanel.Dock="Bottom" Height="50" Margin="2,10,0,0" ClipToBounds="True">
                        <TextBlock x:Name="ListStatus" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Top"/>
                    </Border>

                    <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop"
                            MouseRightButtonUp="OnListBackgroundRightClick">
                        <Grid>
                        <ItemsControl x:Name="ModItems" Padding="8"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ScrollViewer CanContentScroll="True" Focusable="False"
                                                          VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,14,2,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Background="{Binding Name, Converter={StaticResource CategoryBrush}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Name, Converter={StaticResource CategoryBrush}}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ItemCount}"
                                                               Style="{StaticResource Caption}" Margin="8,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" Height="1" VerticalAlignment="Center"
                                                            Background="{DynamicResource BorderBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="2,2,2,8" CornerRadius="8"
                                                MouseRightButtonUp="OnCardRightClick"
                                                MouseLeftButtonUp="OnCardLeftClick"
                                                ToolTipService.InitialShowDelay="350">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="440">
                                                    <TextBlock Text="{Binding TooltipText}" TextWrapping="Wrap"/>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <!-- Name/meta block, capped so it does not stretch
                                                         across a wide monitor. Settings → Mods tunes
                                                         the cap. -->
                                                    <ColumnDefinition Width="*" MaxWidth="{DynamicResource ModRowContentWidth}"/>
                                                    <!-- Everything left over. The action cluster lives
                                                         in here and hugs whichever edge
                                                         Settings → Mods asks for (right by default). -->
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- priority strip -->
                                                <Border Grid.Column="0" CornerRadius="8,0,0,8"
                                                        Background="{Binding Priority, Converter={StaticResource PriorityBrush}}"
                                                        Visibility="{Binding Priority, Converter={StaticResource PriorityVis}}"/>

                                                <!-- selection checkbox -->
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="10,0,0,0"
                                                          Click="OnSelectToggle" ToolTip="Select for bulk right-click actions"/>

                                                <!-- icon -->
                                                <Border Grid.Column="2" Width="36" Height="36" Margin="12,10,12,10" CornerRadius="7"
                                                        Background="{DynamicResource Surface3Brush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                                    </Grid>
                                                </Border>

                                                <!-- info -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,8,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <local:ContentSizeMeter Size="{Binding ContentSize}" Margin="9,2,0,0"/>
                                                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                                Visibility="{Binding IsLibrary, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="LIB" Style="{StaticResource PillText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                Visibility="{Binding IsTesting, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="TEST" Style="{StaticResource PillText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                Visibility="{Binding IsSideRestricted, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="{Binding Side, Converter={StaticResource SideLabel}}"
                                                                       Style="{StaticResource PillText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                Visibility="{Binding IsExtra, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="EXTRA" Style="{StaticResource PillText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                ToolTip="Updates locked - Update all skips this mod"
                                                                Visibility="{Binding IsUpdateLocked, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="LOCKED" Style="{StaticResource PillText}"/>
                                                        </Border>
                                                        <!-- A recorded mod-to-mod incompatibility the user set from the
                                                             options menu. The tooltip names the other mod; the card's own
                                                             tooltip repeats it in the flag list. -->
                                                        <Border Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                                ToolTip="{Binding ConflictLabel}"
                                                                Visibility="{Binding HasConflict, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="CONFLICT" Style="{StaticResource PillText}"
                                                                       Foreground="{DynamicResource DangerBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Caption}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="8,0,8,0"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   Visibility="{Binding AddedLabel, Converter={StaticResource NotEmptyVis}}"/>
                                                        <TextBlock Text="{Binding AddedLabel}" Style="{StaticResource Caption}"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   ToolTip="When this mod was first added to the pack"
                                                                   Visibility="{Binding AddedLabel, Converter={StaticResource NotEmptyVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CategoriesLabel}" Style="{StaticResource Caption}"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"
                                                               Visibility="{Binding CategoriesLabel, Converter={StaticResource NotEmptyVis}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                                Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding NotePreview}" Style="{StaticResource Caption}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- actions -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            HorizontalAlignment="{DynamicResource ModRowActionsAlign}"
                                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <Button Content="Update" Click="OnUpdateClick" Padding="10,4" FontSize="11"
                                                            MinHeight="0" Margin="0,0,8,0"
                                                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}"/>
                                                    <Button Style="{StaticResource NoteButton}" Content="&#xE70B;"
                                                            FontSize="14" Margin="0,0,2,0" Click="OnNoteClick"/>
                                                    <ToggleButton IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggleEnabled"
                                                                  Style="{StaticResource ModToggleSwitch}"
                                                                  Width="36" Height="20" VerticalAlignment="Center"
                                                                  ToolTip="Enable or disable"/>
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE712;"
                                                            FontFamily="{StaticResource IconFont}" FontSize="14" Margin="8,0,0,0"
                                                            Click="OnOptions" ToolTip="Options"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state — a pack with no jars at all. Both buttons are the two
                                 ways a mod gets into a pack, so the state is a route rather than a
                                 statement. -->
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed" IsHitTestVisible="True">
                                <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Style="{StaticResource H2}" Text="No mods in this pack yet"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"
                                           Text="Browse CurseForge and Modrinth from the Mod browsing tab, or add jars you already have — you can also drop them straight onto this list."/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="Browse for mods" Style="{StaticResource AccentButton}"
                                            Click="OnEmptyBrowse"/>
                                    <Button Content="Add file…" Margin="8,0,0,0" Click="OnAddFile"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Empty state — the pack has mods but the search/filters hide all of them. -->
                            <StackPanel x:Name="EmptyFilterState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="48"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                <TextBlock Style="{StaticResource H2}" Text="Nothing matches your filters"
                                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock x:Name="EmptyFilterDetail" Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                                           TextAlignment="Center"/>
                                <Button Content="Clear filters" Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnClearFilters"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- ───────────────────────── MOD BROWSING ───────────────────────── -->
            <TabItem Header="Mod browsing">
                <Frame x:Name="BrowseFrame" NavigationUIVisibility="Hidden" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ───────────────────────── GRAPH VIEW ───────────────────────── -->
            <TabItem Header="Graph view">
                <Grid x:Name="GraphHost" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ───────────────────────── CATEGORIES ───────────────────────── -->
            <TabItem Header="Categories">
                <Grid x:Name="CategoriesHost" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ─────────────────────── MODPACK PLANNING ─────────────────────── -->
            <TabItem Header="Modpack planning">
                <Grid x:Name="PlanHost" Margin="0,12,0,0"/>
            </TabItem>

            <!-- ───────────────────────── ADVANCED ───────────────────────── -->
            <TabItem Header="Advanced">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left" Margin="2">
                        <TextBlock Text="Dependencies" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AdvAutoDeps" Margin="0,4" Click="OnAdvChanged"
                                  Content="Auto-download and enable required dependencies"
                                  ToolTip="Off: installing a mod fetches only that mod, and enabling one leaves its dependencies as they are."/>
                        <CheckBox x:Name="AdvCascadeDependents" Margin="0,4" Click="OnAdvChanged"
                                  Content="Disabling a mod also disables mods that depend on it"/>
                        <CheckBox x:Name="AdvCascadeLibraries" Margin="0,4" Click="OnAdvChanged"
                                  Content="Clean up orphaned library mods when disabling"/>

                        <TextBlock Text="Updates" Style="{StaticResource H3}" Margin="0,16,0,8"/>
                        <CheckBox x:Name="AdvWarnUpdate" Margin="0,4" Click="OnAdvChanged"
                                  Content="Warn before updating update-incompatible mods"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="Version channel" Width="150"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="AdvChannelBox" Width="200" HorizontalAlignment="Left"
                                      SelectionChanged="OnAdvChannelChanged">
                                <ComboBoxItem x:Name="AdvChannelDefaultItem" Content="Launcher default"
                                              ToolTip="Follow Settings → Mods"/>
                                <ComboBoxItem Content="Release" ToolTip="Stable releases only"/>
                                <ComboBoxItem Content="Beta" ToolTip="Releases and betas"/>
                                <ComboBoxItem Content="Alpha" ToolTip="Every published version, including alphas"/>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Which release channel this pack's downloads and updates come from. Launcher default follows Settings → Mods, so one switch changes every pack. Right-click a mod → Update channel to give one mod its own channel."/>

                        <TextBlock Text="Stores" Style="{StaticResource H3}" Margin="0,16,0,8"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Default store" Width="150"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="AdvStoreBox" Width="200" HorizontalAlignment="Left"
                                      SelectionChanged="OnAdvStoreChanged">
                                <ComboBoxItem x:Name="AdvStoreAutoItem" Content="Automatic"/>
                                <ComboBoxItem Content="CurseForge"/>
                                <ComboBoxItem Content="Modrinth"/>
                            </ComboBox>
                        </DockPanel>
                        <TextBlock x:Name="AdvStoreAutoNote" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="150,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="For mods published on both CurseForge and Modrinth: which listing to follow for the label, page link and updates. Automatic follows the store most of this pack's mods are exclusive to; a pack imported from CurseForge is set to CurseForge. Right-click a mod → Store to override it for one mod."/>

                        <TextBlock Text="Graph" Style="{StaticResource H3}" Margin="0,16,0,8"/>
                        <CheckBox x:Name="AdvShowLines" Margin="0,4" Click="OnAdvChanged"
                                  Content="Show dependency lines in the graph by default"/>

                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,16,0,0" TextWrapping="Wrap"
                                   Text="These settings are saved to the modpack and shared with collaborators."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Page>
