<UserControl x:Class="CloudLauncher.Views.ContentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             xmlns:anim="clr-namespace:CloudLauncher.Animations"
             Background="Transparent">
    <!--  Shared library list, one row per library item, laid out like the mods list.
    Resource packs, Worlds and Shader packs all host this control and pass everything
    kind-specific through ContentListHost, so keep pack formats, save folders and Iris out
    of this file.  -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>

        <!--  Same switch as the mods list and the packs tab. Bound OneWay: the state comes back from
        the write, so the list never shows "on" for something the disk says is off.  -->
        <Style x:Key="ContentToggleSwitch" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <slate:SlateBorder x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </slate:SlateBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  Transparent background makes the whole scroller a hit target, so drops on the gaps
    between rows and below the last row still reach the page's drop handler.  -->
    <ScrollViewer x:Name="RowScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  anim:Animate.SmoothScroll="True"
                  Background="Transparent">
        <!--  The stagger only plays once: the page diffs its rows, so filtering or a background
        refresh doesn't re-animate rows already on screen.  -->
        <ItemsControl x:Name="RowList" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      anim:Animate.EntranceStagger="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <slate:SlateBorder Margin="0,0,0,6" CornerRadius="8" Cursor="Hand"
                            Background="{DynamicResource Surface2Brush}"
                            BorderThickness="1"
                            MouseLeftButtonUp="OnRowLeftClick"
                            MouseRightButtonUp="OnRowRightClick">
                        <slate:SlateBorder.ToolTip>
                            <ToolTip MaxWidth="460">
                                <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap"/>
                            </ToolTip>
                        </slate:SlateBorder.ToolTip>
                        <slate:SlateBorder.Style>
                            <!--  Hover and default state are triggers: brushes stored on the row
                            would go stale when the accent changes in Settings.  -->
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    </DataTrigger>
                                    <!--  Hover is restated here: once the trigger above sets the
                                    background, the base style's hover no longer shows.  -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDefault}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </slate:SlateBorder.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 28px icon slot: the item's pack.png if it has one, over a letter tile. -->
                            <slate:SlateBorder Grid.Column="0" Width="28" Height="28" Margin="12,10,12,10"
                                    CornerRadius="6" ClipToBounds="True"
                                    Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </slate:SlateBorder>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <!--  The name opens the item, as in the mods list. A TextBlock
                                    so the row keeps its own click; colours live in the Style
                                    because a local Foreground would override the hover trigger.  -->
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MouseLeftButtonUp="OnNameClick">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanOpen}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Pills in a fixed order on all three pages: what it is to the
                                    launcher, then what is in the way, then the advisory. -->
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="8,0,0,0"
                                            Background="{DynamicResource AccentBrush}"
                                            ToolTip="One of your defaults - every compatible instance gets it"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="DEFAULT" Style="{StaticResource PillText}"
                                                   Foreground="{DynamicResource TextOnAccentBrush}"/>
                                    </slate:SlateBorder>
                                    <!--  No LIBRARY pill: whether the launcher keeps its own copy
                                    is an internal detail the user doesn't need to act on.  -->
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                            ToolTip="{Binding OwnCopyTip}"
                                            Visibility="{Binding HasOwnCopy, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="OWN COPY" Style="{StaticResource PillText}"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </slate:SlateBorder>
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                            ToolTip="{Binding FolderTip}"
                                            Visibility="{Binding FolderLabel, Converter={StaticResource NotEmptyVis}}">
                                        <TextBlock Text="{Binding FolderLabel}" Style="{StaticResource PillText}"/>
                                    </slate:SlateBorder>
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                            ToolTip="{Binding LocalTip}"
                                            Visibility="{Binding IsLocalOnly, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="LOCAL" Style="{StaticResource PillText}"/>
                                    </slate:SlateBorder>
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                            ToolTip="{Binding OffHereTip}"
                                            Visibility="{Binding OffHere, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="OFF HERE" Style="{StaticResource PillText}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </slate:SlateBorder>
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                            ToolTip="{Binding LoaderTip}"
                                            Visibility="{Binding NeedsLoader, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding LoaderLabel}" Style="{StaticResource PillText}"
                                                   Foreground="{DynamicResource WarningBrush}"/>
                                    </slate:SlateBorder>
                                    <!--  Advisory only: the pack_format table ships with the
                                    launcher and goes stale as Mojang adds formats.  -->
                                    <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                            ToolTip="{Binding FormatTip}"
                                            Visibility="{Binding FormatLabel, Converter={StaticResource NotEmptyVis}}">
                                        <TextBlock Text="{Binding FormatLabel}" Style="{StaticResource PillText}"/>
                                    </slate:SlateBorder>
                                </StackPanel>

                                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding MetaLine, Converter={StaticResource NotEmptyVis}}"/>
                                <!--  The item's rules as one line, visible without opening an editor.  -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                            Visibility="{Binding RulesLine, Converter={StaticResource NotEmptyVis}}">
                                    <TextBlock Text="&#xE71C;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding RulesLine}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!--  "in 4 of 7": how many instances have it. Plain text; the
                            per-instance list is on the item's own page.  -->
                            <TextBlock Grid.Column="2" Text="{Binding CoverageLine}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="{Binding CoverageTip}"
                                       Visibility="{Binding CoverageLine, Converter={StaticResource NotEmptyVis}}"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                <!--  The row's "on by default" control, on every row. The host's
                                ContentRowControl picks which one shows: a switch for resource
                                packs and worlds, a selection circle for shader packs, since an
                                instance loads only one shader.  -->
                                <ToggleButton IsChecked="{Binding ToggleOn, Mode=OneWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              Click="OnToggleClick"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding ToggleTip}"
                                              ToolTipService.ShowOnDisabled="True">
                                    <ToggleButton.Style>
                                        <!--  Collapsed by default, so a page that shows the circle
                                        needs no extra state to hide the switch.  -->
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ContentToggleSwitch}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsRowToggle, RelativeSource={RelativeSource AncestorType=local:ContentListView}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <!--  One-slot version of the switch, drawn by the shared RadioButton
                                style. Width trims the template's label space. A RadioButton
                                raises Click even when checked, so clicking the selected one
                                turns it off (no shader at all). The left margin matches the
                                switch's 36px slot so the "..." button lines up.  -->
                                <RadioButton Width="18" Height="18" Margin="18,0,0,0"
                                             IsChecked="{Binding ToggleOn, Mode=OneWay}"
                                             IsEnabled="{Binding CanToggle}"
                                             Click="OnToggleClick"
                                             VerticalAlignment="Center"
                                             ToolTip="{Binding ToggleTip}"
                                             ToolTipService.ShowOnDisabled="True">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsRowChoice, RelativeSource={RelativeSource AncestorType=local:ContentListView}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <!--  Left-click opens the short menu, right-click every option, as in
                                the mods list. Menus are built on demand rather than per row.
                                The right-click handler must mark itself handled or the row
                                opens a second menu.  -->
                                <Button Style="{StaticResource IconButton}" Content="&#xE712;"
                                        FontFamily="{DynamicResource IconFont}" FontSize="14"
                                        Margin="8,0,0,0"
                                        Click="OnOptionsClick" MouseRightButtonUp="OnOptionsRightClick"
                                        ToolTip="Quick actions - right-click for every option"/>
                            </StackPanel>
                        </Grid>
                    </slate:SlateBorder>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
