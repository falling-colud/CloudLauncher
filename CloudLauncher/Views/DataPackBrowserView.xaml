<Page x:Class="CloudLauncher.Views.DataPackBrowserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      xmlns:anim="clr-namespace:CloudLauncher.Animations"
      Title="Data pack browser"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  Header. Browser pages have no container supplying the left/top gutter, so it is set here;
        the 34 right inset clears MainWindow's floating panel buttons.  -->
        <DockPanel Grid.Row="0" Margin="22,18,34,12">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Download data packs"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="CurseForge and Modrinth, searched together. A data pack lives inside a world, so you pick the worlds after the download."/>
            </StackPanel>
        </DockPanel>

        <!--  Search, filters and refresh. The box is always open here: on a browser, search is the main
        action rather than a filter over what is already listed.  -->
        <Grid Grid.Row="1" Margin="22,0,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <slate:SlateBorder Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8,2" MinHeight="34">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBox x:Name="QueryBox" BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center"
                             KeyDown="OnQueryKeyDown"
                             ToolTip="Search CurseForge and Modrinth for data packs - Enter runs it"/>
                </DockPanel>
            </slate:SlateBorder>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="FiltersButton" Style="{StaticResource ToolbarIconButton}"
                        Margin="8,0,0,0"
                        Content="&#xE71C;" ToolTip="Filters" Click="OnFiltersClick"/>
                <Button x:Name="RefreshButton" Style="{StaticResource ToolbarIconButton}"
                        Margin="0,0,0,0"
                        Content="&#xE72C;" ToolTip="Search again (F5)" Click="OnRefresh"/>
            </StackPanel>
            <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=QueryBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="0" VerticalOffset="10">
                <slate:SlateBorder Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" MinWidth="280">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                        <CheckBox x:Name="AnyVersionBox" Content="Any Minecraft version"
                                  ToolTip="Off: only packs listed for the target instance's Minecraft version"/>
                        <TextBlock x:Name="VersionHintLabel" Style="{StaticResource Caption}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Apply" Style="{StaticResource AccentButton}"
                                    Click="OnApplyFilters"/>
                        </StackPanel>
                    </StackPanel>
                </slate:SlateBorder>
            </Popup>
        </Grid>

        <!--  Source chips. "Both stores" pages the two side by side, so a CurseForge error doesn't lose
        the Modrinth results. Single-store chips help when a pack is only listed on one store.  -->
        <ScrollViewer Grid.Row="2" Margin="22,0,22,12"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SourceStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <slate:SlateBorder Padding="0" Margin="0,2,8,2" Cursor="Hand"
                                Background="{DynamicResource Surface3Brush}"
                                BorderThickness="1" CornerRadius="14"
                                MouseLeftButtonUp="OnSourceChipClick"
                                ToolTip="{Binding ToolTipText}">
                            <slate:SlateBorder.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </slate:SlateBorder.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Margin="12,0,12,0" Padding="0,5,0,5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="{Binding LabelWeight}"/>
                            </StackPanel>
                        </slate:SlateBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Results on the left, project detail on the right.  -->
        <Grid Grid.Row="3" Margin="22,0,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="240"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <slate:SlateBorder Grid.Column="0"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnResultsScroll"
                             anim:Animate.EntranceStagger="True"
                             SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,8" Background="Transparent"
                                        ToolTip="{Binding RowToolTip}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Install latest" Click="OnCtxInstall">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Choose version..." Click="OnCtxChooseVersion"/>
                                            <Separator/>
                                            <MenuItem Header="Open project page" Click="OnCtxOpenPage">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE774;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy project URL" Click="OnCtxCopyUrl">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <slate:SlateBorder Grid.Column="0" Width="44" Height="44"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image views:IconLoader.Url="{Binding IconUrl}"
                                                       views:IconLoader.DecodeWidth="44"
                                                       Stretch="Uniform"/>
                                            </Grid>
                                        </slate:SlateBorder>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <DockPanel>
                                                <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                        Margin="6,0,0,0"
                                                        ToolTip="Which store this result came from">
                                                    <TextBlock Text="{Binding SourceBadge}"
                                                               Style="{StaticResource PillText}"/>
                                                </slate:SlateBorder>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Install" Click="OnInstallRow"
                                                Style="{StaticResource AccentButton}" Tag="{Binding}"
                                                Padding="12,5" MinHeight="30" MinWidth="0"
                                                VerticalAlignment="Center"
                                                ToolTip="Download the newest version, then pick the worlds that get it. Right-click for Choose version..."/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <views:PageStateView x:Name="PageStateHost"/>
                </Grid>
            </slate:SlateBorder>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center"
                    Background="{DynamicResource BorderSubtleBrush}"/>

            <Grid Grid.Column="2">
                <TextBlock x:Name="DetailPlaceholder" Style="{StaticResource Muted}"
                           Text="Pick a result to see its description, screenshots, links and versions."
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Grid x:Name="DetailPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <slate:SlateBorder Grid.Column="0" Width="44" Height="44"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                ClipToBounds="True" VerticalAlignment="Top">
                            <Grid>
                                <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="SelectedIconImage" views:IconLoader.DecodeWidth="44"
                                       Stretch="UniformToFill"/>
                            </Grid>
                        </slate:SlateBorder>
                        <StackPanel Grid.Column="1">
                            <!--  MaxHeight is two lines of H3; longer names get trimmed.  -->
                            <TextBlock x:Name="StoreNameLabel" Style="{StaticResource H3}"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="38"/>
                            <TextBlock x:Name="StoreMetaLabel" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!--  Actions get their own row, since beside the name they squeeze
                        it at the minimum window width. WrapPanel so they stack instead of
                        spilling out of the card.  -->
                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
                                   HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="OpenProjectButton" Content="Open page"
                                    Click="OnOpenSelectedProject"
                                    Padding="10,4" MinWidth="0" MinHeight="0"/>
                            <Button x:Name="InstallSelectedButton" Content="Install"
                                    Style="{StaticResource AccentButton}"
                                    Click="OnInstallSelected"
                                    Padding="10,4" MinWidth="0" MinHeight="0"/>
                        </WrapPanel>
                    </Grid>

                    <TabControl Grid.Row="1" x:Name="DetailTabs" anim:Animate.TabTransition="True">
                        <TabItem Header="Overview">
                            <slate:SlateBorder CornerRadius="8" ClipToBounds="True" Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Border x:Name="OverviewHost" ClipToBounds="True"
                                        Background="{DynamicResource Surface0Brush}">
                                    <views:RichDescriptionView x:Name="OverviewBrowser"/>
                                </Border>
                            </slate:SlateBorder>
                        </TabItem>

                        <TabItem Header="Screenshots">
                            <Grid Margin="0,10,0,0">
                                <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                           Text="This pack published no screenshots."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ScreenshotList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <slate:SlateBorder Width="190" Margin="0,0,10,10"
                                                        Style="{StaticResource Card}" Padding="8"
                                                        Cursor="Hand" ToolTip="Open screenshot"
                                                        MouseLeftButtonUp="OnOpenScreenshot">
                                                    <StackPanel>
                                                        <slate:SlateBorder Height="100"
                                                                Background="{DynamicResource Surface0Brush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="6"
                                                                ClipToBounds="True">
                                                            <Image views:IconLoader.Url="{Binding ImageUrl}"
                                                                   views:IconLoader.DecodeWidth="190"
                                                                   Stretch="Uniform"/>
                                                        </slate:SlateBorder>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </slate:SlateBorder>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>


                        <TabItem Header="Links">
                            <StackPanel Margin="0,12,0,0">
                                <WrapPanel>
                                    <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink"
                                            Margin="0,0,10,10" Padding="14,6"/>
                                    <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink"
                                            Margin="0,0,10,10" Padding="14,6"/>
                                    <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink"
                                            Margin="0,0,10,10" Padding="14,6"/>
                                    <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink"
                                            Margin="0,0,10,10" Padding="14,6"/>
                                    <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink"
                                            Margin="0,0,10,10" Padding="14,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="LinksEmptyText" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Text="This project exposes no extra links."/>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Versions">
                            <slate:SlateBorder Margin="0,10,0,0" CornerRadius="6"
                                    Background="{DynamicResource Surface0Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <DataGrid x:Name="VersionsGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" HeadersVisibility="Column"
                                          RowHeaderWidth="0" SelectionMode="Single" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                        <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="110"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="70"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="88"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="70"/>
                                        <DataGridTemplateColumn Width="82">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Install" Style="{StaticResource AccentButton}"
                                                            Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                            Click="OnInstallVersionClick"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </slate:SlateBorder>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <!--  Status bar. Shows the default install target so it is clear before clicking Install.  -->
        <Border Grid.Row="4" Style="{StaticResource PageStatusBar}">
            <DockPanel>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="InstallTargetLabel" DockPanel.Dock="Right" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="260"
                           ToolTip="Which instance and world a download from this page starts out pointed at - you can change it before anything is written"/>
                <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="Cancel"
                        Click="OnCancelDownload" Padding="10,3" Margin="12,0,0,0"
                        Visibility="Collapsed" VerticalAlignment="Center"/>
                <ProgressBar x:Name="DownloadProgress" DockPanel.Dock="Right" Width="160" Height="6"
                             Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="Collapsed" Minimum="0" Maximum="100"/>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="140" Height="4"
                             Margin="12,0,0,0" VerticalAlignment="Center"
                             IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
