<UserControl x:Class="CloudLauncher.Views.ModListPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--  The mod row, shared with the per-pack hub so both lists look and behave the same: priority
    strip, select box, icon, name linking to the store page, flag pills, meta line, note preview,
    then Update / note / enable / more on the right. The global list adds the library column:
    whether the mod is a default and what its rule narrows it to.  -->
    <UserControl.Resources>
        <sys:Double x:Key="ModRowContentWidth">620</sys:Double>
        <local:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <local:PriorityToVisibilityConverter x:Key="PriorityVis"/>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>
        <local:ModSideLabelConverter x:Key="SideLabel"/>
        <local:ModListCategoryBrushConverter x:Key="CategoryBrush"/>

        <!--  Note chip: muted when empty, accent (with the note as its tooltip) when set. A
        DataTrigger rather than a view-model brush, because the theme service creates new brushes
        on every apply and a cached one stops repainting.  -->
        <Style x:Key="PaneNoteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="ToolTip" Value="Add a note"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mod.HasNote}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                    <Setter Property="ToolTip" Value="{Binding Mod.Note}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaneToggleSwitch" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <slate:SlateBorder x:Name="Track" Width="36" Height="20" CornerRadius="10"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </slate:SlateBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!--  Bulk actions sit on the bar itself, one click away. They call the same methods as the
        options menu.  -->
        <slate:SlateBorder x:Name="SelectionBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,7">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource SubtleButton}"
                        Padding="12,3" MinHeight="0" Click="OnClearSelection"/>
                <Button DockPanel.Dock="Right" Content="Select all" Style="{StaticResource SubtleButton}"
                        Padding="12,3" MinHeight="0" Margin="0,0,8,0" Click="OnSelectAll"/>
                <Border DockPanel.Dock="Right" Width="1" Margin="10,2,10,2"
                        Background="{DynamicResource BorderBrush}"/>
                <Button DockPanel.Dock="Right" x:Name="BulkOptionsButton" Content="Options ▾"
                        Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                        Margin="0,0,8,0" Click="OnBulkOptions"
                        ToolTip="Every mod option, applied to the whole selection"/>
                <Button DockPanel.Dock="Right" x:Name="BulkDisableButton" Content="Disable"
                        Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                        Margin="0,0,8,0" Click="OnBulkDisable"/>
                <Button DockPanel.Dock="Right" x:Name="BulkEnableButton" Content="Enable"
                        Style="{StaticResource SubtleButton}" Padding="12,3" MinHeight="0"
                        Margin="0,0,8,0" Click="OnBulkEnable"/>
                <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </DockPanel>
        </slate:SlateBorder>

        <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8"
                AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop"
                MouseRightButtonUp="OnListBackgroundRightClick">
            <ItemsControl x:Name="ModItems" Padding="8"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True" Focusable="False"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Grid Margin="2,14,2,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <slate:SlateBorder Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            Background="{Binding Name, Converter={StaticResource CategoryBrush}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Name, Converter={StaticResource CategoryBrush}}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ItemCount}"
                                               Style="{StaticResource Caption}" Margin="8,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="3" Height="1" VerticalAlignment="Center"
                                            Background="{DynamicResource BorderBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <slate:SlateBorder Margin="2,2,2,8" CornerRadius="8" Cursor="Hand"
                                MouseRightButtonUp="OnCardRightClick"
                                MouseLeftButtonUp="OnCardLeftClick"
                                ToolTipService.InitialShowDelay="350">
                            <slate:SlateBorder.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <!--  Hover before selection: the last trigger to set a
                                        property wins, so a selected row keeps its look under the
                                        mouse. No Animate.HoverLift, whose 1.02 scale is too much
                                        for a full-width row.  -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </slate:SlateBorder.Style>
                            <slate:SlateBorder.ToolTip>
                                <ToolTip MaxWidth="440">
                                    <TextBlock Text="{Binding Mod.TooltipText}" TextWrapping="Wrap"/>
                                </ToolTip>
                            </slate:SlateBorder.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MaxWidth="{DynamicResource ModRowContentWidth}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- priority strip -->
                                <slate:SlateBorder Grid.Column="0" CornerRadius="8,0,0,8"
                                        Background="{Binding Mod.Priority, Converter={StaticResource PriorityBrush}}"
                                        Visibility="{Binding Mod.Priority, Converter={StaticResource PriorityVis}}"/>

                                <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="10,0,0,0"
                                          Click="OnSelectToggle" ToolTip="Select for bulk actions"/>

                                <slate:SlateBorder Grid.Column="2" Width="36" Height="36" Margin="12,10,12,10" CornerRadius="7"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="{Binding Mod.Initial}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!--  Never bind a URL straight to Image.Source: see IconLoader.  -->
                                        <Image local:IconLoader.Url="{Binding Mod.IconUrl}"
                                               local:IconLoader.DecodeWidth="36" Stretch="UniformToFill"/>
                                    </Grid>
                                </slate:SlateBorder>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,8,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  The name links to the store page. It is a TextBlock
                                        because a Button or Hyperlink would swallow the mouse and
                                        break the row's double-click. The colours live in the Style
                                        since a local Foreground would override the hover
                                        setter.  -->
                                        <TextBlock Text="{Binding Mod.DisplayName}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   MouseLeftButtonUp="OnModNameClick"
                                                   ToolTip="{Binding Mod.PageUrl}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Style.Triggers>
                                                        <!--  An external jar has no page, so its name
                                                             stays inert: no underline, no accent.  -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Mod.HasPage}" Value="True"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}"/>
                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <local:ContentSizeMeter Size="{Binding Mod.ContentSize}" Margin="9,2,0,0"/>

                                        <!--  DEFAULT pill (global page only): the mod is in the
                                        library with a rule, so every compatible instance gets
                                        it.  -->
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="8,0,0,0"
                                                ToolTip="{Binding LibraryLabel}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="DEFAULT" Style="{StaticResource PillText}"
                                                       Foreground="{DynamicResource AccentTextBrush}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                ToolTip="An instance has its own copy of this mod; the shared one is not in use there."
                                                Visibility="{Binding AnyShadowed, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="OWN COPY" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                ToolTip="These flags come from your defaults, not from this instance."
                                                Visibility="{Binding Mod.MetaInherited, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="INHERITED" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                ToolTip="On in some instances and off in others."
                                                Visibility="{Binding MixedEnabled, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="MIXED" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>

                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                Visibility="{Binding Mod.IsLibrary, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="LIB" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                Visibility="{Binding Mod.IsTesting, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="TEST" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                Visibility="{Binding Mod.IsSideRestricted, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Mod.Side, Converter={StaticResource SideLabel}}"
                                                       Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                Visibility="{Binding Mod.IsExtra, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="EXTRA" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                ToolTip="Updates locked - a bulk update skips this mod"
                                                Visibility="{Binding Mod.IsUpdateLocked, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="LOCKED" Style="{StaticResource PillText}"/>
                                        </slate:SlateBorder>
                                        <slate:SlateBorder Style="{StaticResource Pill}" Margin="6,0,0,0"
                                                ToolTip="{Binding Mod.ConflictLabel}"
                                                Visibility="{Binding Mod.HasConflict, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="CONFLICT" Style="{StaticResource PillText}"
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </slate:SlateBorder>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Mod.MetaLine}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="8,0,8,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Visibility="{Binding Mod.WhereLabel, Converter={StaticResource NotEmptyVis}}"/>
                                        <TextBlock Text="{Binding Mod.WhereLabel}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   ToolTip="{Binding WhereTooltip}"
                                                   Visibility="{Binding Mod.WhereLabel, Converter={StaticResource NotEmptyVis}}"/>
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="8,0,8,0"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Visibility="{Binding Mod.AddedLabel, Converter={StaticResource NotEmptyVis}}"/>
                                        <TextBlock Text="{Binding Mod.AddedLabel}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   ToolTip="When this mod was first seen"
                                                   Visibility="{Binding Mod.AddedLabel, Converter={StaticResource NotEmptyVis}}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LibraryLabel}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="What your rule for this mod narrows down to"
                                               Visibility="{Binding LibraryLabel, Converter={StaticResource NotEmptyVis}}"/>
                                    <TextBlock Text="{Binding Mod.CategoriesLabel}" Style="{StaticResource Caption}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"
                                               Visibility="{Binding Mod.CategoriesLabel, Converter={StaticResource NotEmptyVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                Visibility="{Binding Mod.HasNote, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="&#xE70B;" FontFamily="{DynamicResource IconFont}" FontSize="10"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Mod.NotePreview}" Style="{StaticResource Caption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Button Style="{StaticResource PaneNoteButton}" Content="&#xE70B;"
                                            FontSize="14" Margin="0,0,2,0" Click="OnNoteClick"/>
                                    <ToggleButton IsChecked="{Binding EnabledEverywhere, Mode=OneWay}"
                                                  Click="OnToggleEnabled"
                                                  Style="{StaticResource PaneToggleSwitch}"
                                                  Width="36" Height="20" VerticalAlignment="Center"
                                                  ToolTip="Enable or disable, in every instance that has it"/>
                                    <!--  Left-click opens the short list, right-click every option.
                                    MouseRightButtonUp must mark itself handled, or it bubbles to the row
                                    and a second menu opens on top.  -->
                                    <Button Style="{StaticResource IconButton}" Content="&#xE712;"
                                            FontFamily="{DynamicResource IconFont}" FontSize="14" Margin="8,0,0,0"
                                            Click="OnOptions" MouseRightButtonUp="OnOptionsRightClick"
                                            ToolTip="Quick actions - right-click for every option"/>
                                </StackPanel>
                            </Grid>
                        </slate:SlateBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </slate:SlateBorder>
    </DockPanel>
</UserControl>
