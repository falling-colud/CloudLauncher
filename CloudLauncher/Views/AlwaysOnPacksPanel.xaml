<UserControl x:Class="CloudLauncher.Views.AlwaysOnPacksPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <slate:SlateBorder Style="{StaticResource Card}" Padding="0">
        <DockPanel>
            <slate:SlateBorder DockPanel.Dock="Top"
                    Background="{DynamicResource Surface3Brush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Padding="14,10" CornerRadius="10,10,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="OnOpenFolder" VerticalAlignment="Center"
                            Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                            ToolTip="Open the always-on folder in Explorer"/>
                    <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add..."
                            Click="OnAdd" Margin="0,0,8,0" Padding="10,4" VerticalAlignment="Center"
                            ToolTip="Copy a pack (.zip) into the always-on folder. You can also drop a zip or a pack folder here."/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource H3}" Text="Always on"/>
                        <TextBlock x:Name="HintText" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </slate:SlateBorder>

            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                       Margin="14,6,14,8" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                       Margin="14" TextWrapping="Wrap" Visibility="Collapsed"/>

            <ItemsControl x:Name="EntryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                ToolTip="{Binding Tooltip}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Content="&#xE712;" FontFamily="{DynamicResource IconFont}" FontSize="14"
                                        Padding="6,3" MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                        Click="OnRowMenu" Tag="{Binding}" ToolTip="More"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding OrderVisibility}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding OrderLabel}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="18"
                                               TextAlignment="Right"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;"
                                            FontFamily="{DynamicResource IconFont}" FontSize="11"
                                            Padding="5,2" MinWidth="0" MinHeight="0"
                                            Click="OnMoveUp" Tag="{Binding}"
                                            ToolTip="Move up - win over the packs below it"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;"
                                            FontFamily="{DynamicResource IconFont}" FontSize="11"
                                            Padding="5,2" MinWidth="0" MinHeight="0"
                                            Click="OnMoveDown" Tag="{Binding}"
                                            ToolTip="Move down"/>
                                </StackPanel>
                                <slate:SlateBorder DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </slate:SlateBorder>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
