<Page x:Class="CloudLauncher.Views.ModExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      Title="Browse mods"
      Background="{StaticResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════ PACK HEADER — shows which instance mods land in ════════════ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="18,16,18,10" Padding="16,12">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="10"
                        Background="{StaticResource AccentSoftBrush}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="HeroBadge" Style="{StaticResource H2}"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource H2}" Text="Browse mods"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeroPackLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════ BODY — results on the left, detail on the right ════════════ -->
        <Grid Grid.Row="1" Margin="18,0,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="340"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="4*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: search + sources + result list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Surface1Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,2" MinHeight="34">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                       FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0"
                                       Foreground="{StaticResource TextTertiaryBrush}"/>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalAlignment="Center"
                                     KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged"
                                     ToolTip="Search mod name or description"/>
                        </DockPanel>
                    </Border>
                    <ComboBox Grid.Column="1" x:Name="SortBox" Width="124" Margin="6,0,0,0"
                              SelectionChanged="OnSortChanged" ToolTip="Sort results">
                        <ComboBoxItem Content="Relevance" IsSelected="True"/>
                        <ComboBoxItem Content="Latest"/>
                        <ComboBoxItem Content="Downloads"/>
                    </ComboBox>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Margin="6,0,0,0" Padding="8,5"
                            Content="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="13"
                            ToolTip="Filters" Click="OnFiltersClick"/>
                    <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="0" VerticalOffset="8">
                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" MinWidth="260">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Minecraft version"/>
                                <TextBox x:Name="FilterMcBox" Margin="0,4,0,10"
                                         ToolTip="Leave empty to inherit from pack"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Loader"/>
                                <ComboBox x:Name="FilterLoaderBox" Margin="0,4,0,10">
                                    <ComboBoxItem Content="(inherit)" IsSelected="True"/>
                                    <ComboBoxItem Content="fabric"/>
                                    <ComboBoxItem Content="forge"/>
                                    <ComboBoxItem Content="neoforge"/>
                                    <ComboBoxItem Content="quilt"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Apply" Style="{StaticResource AccentButton}"
                                            Click="OnApplyFilters" Padding="14,5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,0,8">
                    <ItemsControl x:Name="SourceStrip">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0" Margin="0,2,8,2"
                                        Cursor="{Binding CursorHint}"
                                        Background="{Binding Background}"
                                        BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                        CornerRadius="14"
                                        MouseLeftButtonUp="OnSourceChipClick"
                                        Visibility="{Binding ChipVisibility}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="11" Margin="12,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground}"
                                                   Visibility="{Binding IconVisibility}"/>
                                        <TextBlock Text="{Binding Label}" Margin="0,0,12,0"
                                                   Padding="0,5,0,5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground}"
                                                   FontWeight="{Binding FontWeight}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8">
                    <ListBox x:Name="ResultsList" SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnResultsScroll">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42"
                                                Background="{StaticResource Surface3Brush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,5,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Pill}"
                                                                Background="{StaticResource TagModrinthBgBrush}"
                                                                Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource PillText}"
                                                                       Foreground="{StaticResource TagModrinthFgBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#xE896;"
                                                    Width="34" Height="34" MinWidth="34" MinHeight="34"
                                                    Padding="0" FontSize="14"
                                                    IsEnabled="{Binding CanDownload}"
                                                    ToolTip="{Binding DownloadTooltip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Click="OnQuickDownloadMod">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="SearchStatus" Grid.Row="3" Style="{StaticResource Caption}" Margin="2,8,0,0"/>
            </Grid>

            <!-- ════════════ DETAIL ════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="DetailHeader" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52"
                            Background="{StaticResource Surface3Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ModNameLabel" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModMetaLabel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="DetailPlaceholder"
                           Text="Select or double-click a mod to see overview, screenshots, issues, and versions."
                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"/>

                <TabControl Grid.Row="1" x:Name="ModTabs" Visibility="Collapsed">
                    <TabItem Header="Overview">
                        <Border CornerRadius="8" ClipToBounds="True" Margin="0,12,0,0"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border x:Name="OverviewHost" ClipToBounds="True"
                                    Background="{StaticResource Surface0Brush}">
                                <views:RichDescriptionView x:Name="OverviewBrowser"/>
                            </Border>
                        </Border>
                    </TabItem>

                    <TabItem Header="Screenshots">
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                       Text="No screenshots are available for this mod."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ScreenshotList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="240" Margin="0,0,12,12" Style="{StaticResource Card}" Padding="8"
                                                    Cursor="Hand" ToolTip="Open screenshot"
                                                    MouseLeftButtonUp="OnOpenScreenshot">
                                                <StackPanel>
                                                    <Border Height="126" Background="{StaticResource Surface0Brush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Links">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            </WrapPanel>
                            <TextBlock x:Name="IssuesEmptyText" Style="{StaticResource Muted}"
                                       Text="This project has not published issue/source links through the selected provider."
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Versions">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                                    <TextBlock x:Name="VersionFilterNote" Style="{StaticResource Caption}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowAllVersionsBox" Grid.Column="1" Content="Show all"
                                          VerticalAlignment="Center"
                                          Checked="OnShowAllVersionsChanged" Unchecked="OnShowAllVersionsChanged"/>
                            </Grid>
                            <Border Grid.Row="1" Background="{StaticResource Surface1Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <DataGrid x:Name="VersionsGrid"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" RowHeaderWidth="0"
                                          SelectionMode="Single" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                        <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="150"/>
                                        <DataGridTextColumn Header="Loader" Binding="{Binding LoaderList}" Width="100"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding ReleaseChannel}" Width="74"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="96"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
                                        <DataGridTemplateColumn Width="104">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Download" Style="{StaticResource AccentButton}"
                                                            Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                            IsEnabled="{Binding CanDownload}"
                                                            ToolTip="{Binding DownloadTooltip}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Click="OnDownloadVersion"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <DockPanel Grid.Row="2" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Download to" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="DownloadTargetBox" Width="140">
                            <ComboBoxItem Content="game/mods/" IsSelected="True"/>
                            <ComboBoxItem Content="local/mods/"/>
                        </ComboBox>
                        <Button x:Name="TestDownloadButton" Content="Test" Click="OnTestDownload"
                                Style="{StaticResource SubtleButton}" Margin="10,0,0,0"
                                ToolTip="Download the best version and mark it as testing"/>
                        <Button x:Name="CustomDownloadButton" Content="Custom ▾" Click="OnCustomDownload"
                                Margin="8,0,0,0" ToolTip="Download with options (testing, library, side, priority)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="14,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Background" Value="#FFE87D3E"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF0904E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
                <ProgressBar Grid.Row="2" x:Name="DownloadProgress" Height="3"
                             Margin="0,0,0,-10" VerticalAlignment="Bottom"
                             Visibility="Collapsed" IsIndeterminate="False"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
