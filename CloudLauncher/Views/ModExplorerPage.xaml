<Page x:Class="CloudLauncher.Views.ModExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      Title="Browse mods"
      PreviewKeyDown="OnPageKeyDown"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════ PACK HEADER - shows which instance mods land in ════════════ -->
        <slate:SlateBorder Grid.Row="0" Style="{StaticResource Card}" Margin="18,16,18,10" Padding="16,12">
            <DockPanel>
                <slate:SlateBorder DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="HeroBadge" Style="{StaticResource H2}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </slate:SlateBorder>
                <!--  Icon-only utilities: open folder, then refresh. Both work with the store
                unreachable.  -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Button x:Name="OpenFolderButton" Style="{StaticResource HeaderIconButton}"
                            Content="&#xE8DA;" FontFamily="{DynamicResource IconFont}"
                            Click="OnOpenModsFolder"
                            ToolTip="Open this instance's mods folder"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource HeaderIconButton}"
                            Content="&#xE72C;" FontFamily="{DynamicResource IconFont}"
                            Click="OnRefresh"
                            ToolTip="Search the stores again (F5)"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource H2}" Text="Browse mods"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeroPackLabel" Style="{StaticResource PageSubtitle}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </slate:SlateBorder>

        <!-- ════════════ BODY - results on the left, detail on the right ════════════ -->
        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="18,0,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ResultsColumn" Width="5*" MinWidth="340"/>
                <ColumnDefinition x:Name="GapColumn" Width="16"/>
                <ColumnDefinition x:Name="DetailColumn" Width="4*" MinWidth="340"/>
            </Grid.ColumnDefinitions>
            <!-- The second row is only used below NarrowWidth, where the detail moves under the results. -->
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ResultsRow" Height="*"/>
                <RowDefinition x:Name="DetailRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- LEFT: search + sources + result list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--  Filter bar: the store chips (wrapping), with Sort, Filters and search on the
                row below.  -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ItemsControl x:Name="SourceStrip" Grid.Row="0" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <slate:SlateBorder Padding="0" Margin="0,2,8,2"
                                            Cursor="{Binding CursorHint}"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                            CornerRadius="14"
                                            MouseLeftButtonUp="OnSourceChipClick"
                                            Visibility="{Binding ChipVisibility}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontFamily="{DynamicResource IconFont}"
                                                       FontSize="11" Margin="12,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground}"
                                                       Visibility="{Binding IconVisibility}"/>
                                            <TextBlock Text="{Binding Label}" Margin="0,0,12,0"
                                                       Padding="0,5,0,5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground}"
                                                       FontWeight="{Binding FontWeight}"/>
                                        </StackPanel>
                                    </slate:SlateBorder>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <Button x:Name="SortButton" Style="{StaticResource ToolbarIconButton}"
                                Content="&#xE8CB;" FontFamily="{DynamicResource IconFont}"
                                Click="OnSortButtonClick" ToolTip="Sort results">
                            <Button.ContextMenu>
                                <ContextMenu Opened="OnSortMenuOpened">
                                    <MenuItem x:Name="SortRelevanceMenuItem" Header="Relevance" Tag="0"
                                              IsCheckable="True" Click="OnSortMenuItemClick"/>
                                    <MenuItem x:Name="SortLatestMenuItem" Header="Latest" Tag="1"
                                              IsCheckable="True" Click="OnSortMenuItemClick"/>
                                    <MenuItem x:Name="SortDownloadsMenuItem" Header="Downloads" Tag="2"
                                              IsCheckable="True" Click="OnSortMenuItemClick"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="FiltersButton" Style="{StaticResource ToolbarIconButton}"
                                Content="&#xE71C;" FontFamily="{DynamicResource IconFont}"
                                ToolTip="Filters" Click="OnFiltersClick"/>
                        <views:CompactSearchBox x:Name="SearchBox" Margin="0,0,0,0"
                                                Placeholder="Search mods"
                                                SearchToolTip="Search mod name or description"/>
                    </StackPanel>

                    <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           HorizontalOffset="0" VerticalOffset="8">
                        <slate:SlateBorder Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14" MinWidth="260">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                                <StackPanel x:Name="CategoryFilterPanel" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="Categories"/><Run x:Name="CategorySourceLabel" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </TextBlock>
                                        <Button x:Name="CategoryClearButton" Content="Clear" HorizontalAlignment="Right"
                                                Style="{StaticResource LinkButton}" FontSize="11" Click="OnClearCategories"/>
                                    </Grid>
                                    <slate:SlateBorder Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" MaxHeight="168" Margin="0,0,0,10">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,6">
                                            <ItemsControl x:Name="FilterCategoryList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}" Margin="0,3"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </slate:SlateBorder>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Minecraft version"/>
                                <TextBox x:Name="FilterMcBox" Margin="0,4,0,10"
                                         ToolTip="Leave empty to inherit from pack"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Loader"/>
                                <ComboBox x:Name="FilterLoaderBox" Margin="0,4,0,10">
                                    <ComboBoxItem Content="(inherit)" IsSelected="True"/>
                                    <ComboBoxItem Content="fabric"/>
                                    <ComboBoxItem Content="forge"/>
                                    <ComboBoxItem Content="neoforge"/>
                                    <ComboBoxItem Content="quilt"/>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Apply" Style="{StaticResource AccentButton}"
                                            Click="OnApplyFilters" Padding="14,5"/>
                                </StackPanel>
                            </StackPanel>
                        </slate:SlateBorder>
                    </Popup>
                </Grid>

                <slate:SlateBorder Grid.Row="1"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                    <ListBox x:Name="ResultsList" SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnResultsScroll">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="Transparent"
                                        MouseRightButtonUp="OnResultRightClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <slate:SlateBorder Grid.Column="0" Width="42" Height="42"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!--  Not bound straight to Image.Source, which
                                                downloads and decodes at full size on the UI thread
                                                for every row that gets realized.  -->
                                                <Image views:IconLoader.Url="{Binding IconUrl}"
                                                       views:IconLoader.DecodeWidth="42" Stretch="UniformToFill"/>
                                            </Grid>
                                        </slate:SlateBorder>

                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,5,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <slate:SlateBorder Style="{StaticResource Pill}"
                                                                Background="{DynamicResource TagModrinthBgBrush}"
                                                                Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding}" Style="{StaticResource PillText}"
                                                                       Foreground="{DynamicResource TagModrinthFgBrush}"/>
                                                        </slate:SlateBorder>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="&#xE896;"
                                                    Width="34" Height="34" MinWidth="34" MinHeight="34"
                                                    Padding="0" FontSize="14"
                                                    IsEnabled="{Binding CanDownload}"
                                                    ToolTip="{Binding DownloadTooltip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Click="OnQuickDownloadMod">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                                                <Setter Property="Opacity" Value="0.8"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--  Last in the cell so it overlays the list. Driven only by PageState.  -->
                    <views:PageStateView x:Name="PageStateHost"/>
                    </Grid>
                </slate:SlateBorder>

                <!--  Status left, count right, like the main status bar but without its background,
                which would only span one of the two columns.  -->
                <DockPanel Grid.Row="2" Margin="2,8,0,0">
                    <TextBlock x:Name="SearchStatus" DockPanel.Dock="Right"
                               Style="{StaticResource Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ListStatus" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>

            <!-- ════════════ DETAIL ════════════ -->
            <Grid x:Name="DetailPane" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="DetailHeader" Visibility="Collapsed" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <slate:SlateBorder Width="52" Height="52"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H2}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                        </Grid>
                    </slate:SlateBorder>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ModNameLabel" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ModMetaLabel" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        <!-- Shown only when the mod is on both stores, so the user can choose which one to
                        download from instead of getting the merged pick. -->
                        <StackPanel x:Name="SourceToggle" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Source" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <slate:SlateBorder x:Name="SourceModrinthChip" CornerRadius="13" BorderThickness="1"
                                    Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonUp="OnPickModrinthSource">
                                <TextBlock Text="Modrinth" Padding="12,4" VerticalAlignment="Center"/>
                            </slate:SlateBorder>
                            <slate:SlateBorder x:Name="SourceCurseForgeChip" CornerRadius="13" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="OnPickCurseForgeSource">
                                <TextBlock Text="CurseForge" Padding="12,4" VerticalAlignment="Center"/>
                            </slate:SlateBorder>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="DetailPlaceholder"
                           Text="Select or double-click a mod to see overview, screenshots, issues, and versions."
                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"/>

                <TabControl Grid.Row="1" x:Name="ModTabs" Visibility="Collapsed">
                    <TabItem Header="Overview">
                        <slate:SlateBorder CornerRadius="8" ClipToBounds="True" Margin="0,12,0,0"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Border x:Name="OverviewHost" ClipToBounds="True"
                                    Background="{DynamicResource Surface0Brush}">
                                <views:RichDescriptionView x:Name="OverviewBrowser"/>
                            </Border>
                        </slate:SlateBorder>
                    </TabItem>

                    <TabItem Header="Screenshots">
                        <Grid Margin="0,12,0,0">
                            <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                       Text="No screenshots are available for this mod."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ScreenshotList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <slate:SlateBorder Width="240" Margin="0,0,12,12" Style="{StaticResource Card}" Padding="8"
                                                    Cursor="Hand" ToolTip="Open screenshot"
                                                    MouseLeftButtonUp="OnOpenScreenshot">
                                                <StackPanel>
                                                    <slate:SlateBorder Height="126" Background="{DynamicResource Surface0Brush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                    </slate:SlateBorder>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </slate:SlateBorder>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Links">
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                <Button x:Name="DiscordButton" Content="Discord" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                            </WrapPanel>
                            <TextBlock x:Name="IssuesEmptyText" Style="{StaticResource Muted}"
                                       Text="This project has not published issue/source links through the selected provider."
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Versions">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                    <TextBlock Text="Versions" Style="{StaticResource H3}"/>
                                    <TextBlock x:Name="VersionFilterNote" Style="{StaticResource Caption}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowAllVersionsBox" Grid.Column="1" Content="Show all"
                                          VerticalAlignment="Center"
                                          Checked="OnShowAllVersionsChanged" Unchecked="OnShowAllVersionsChanged"/>
                            </Grid>
                            <slate:SlateBorder Grid.Row="1" Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6">
                                <!--  Right-click selects the row, then offers its changelog.  -->
                                <DataGrid x:Name="VersionsGrid"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" RowHeaderWidth="0"
                                          SelectionMode="Single" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0"
                                          PreviewMouseRightButtonDown="OnVersionsGridPreviewRightDown"
                                          MouseRightButtonUp="OnVersionsGridRightClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                        <DataGridTextColumn Header="MC" Binding="{Binding McVersions}" Width="150"/>
                                        <DataGridTextColumn Header="Loader" Binding="{Binding LoaderList}" Width="100"/>
                                        <DataGridTextColumn Header="Channel" Binding="{Binding ReleaseChannel}" Width="74"/>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="96"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
                                        <DataGridTemplateColumn Width="104">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Download" Style="{StaticResource AccentButton}"
                                                            Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                            IsEnabled="{Binding CanDownload}"
                                                            ToolTip="{Binding DownloadTooltip}"
                                                            ToolTipService.ShowOnDisabled="True"
                                                            Click="OnDownloadVersion"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </slate:SlateBorder>
                        </Grid>
                    </TabItem>
                </TabControl>

                <StackPanel Grid.Row="2" Margin="0,13,0,0">
                    <WrapPanel>
                        <TextBlock Text="Download to" VerticalAlignment="Center" Margin="0,3,8,3"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox x:Name="DownloadTargetBox" Width="140" Margin="0,3,10,3">
                            <ComboBoxItem Content="game/mods/" IsSelected="True"/>
                            <ComboBoxItem Content="local/mods/"/>
                        </ComboBox>
                        <Button x:Name="TestDownloadButton" Content="Test" Click="OnTestDownload"
                                Style="{StaticResource SubtleButton}" Margin="0,3,8,3"
                                ToolTip="Download the best version and mark it as testing"/>
                        <Button x:Name="CustomDownloadButton" Content="Custom ▾" Click="OnCustomDownload"
                                Margin="0,3,0,3" ToolTip="Download with options (testing, library, side, priority)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="14,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <slate:SlateBorder CornerRadius="6" Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </slate:SlateBorder>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ProgressBar Grid.Row="2" x:Name="DownloadProgress" Height="3"
                             Margin="0,0,0,-10" VerticalAlignment="Bottom"
                             Visibility="Collapsed" IsIndeterminate="False"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
