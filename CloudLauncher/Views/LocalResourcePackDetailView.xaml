<Page x:Class="CloudLauncher.Views.LocalResourcePackDetailView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      Title="Resource pack"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <slate:SlateBorder Grid.Row="0" Style="{StaticResource ElevatedCard}"
                Margin="24,18,24,16" Padding="20">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                            Background="{DynamicResource Surface4Brush}">
                        <TextBlock x:Name="SourcePackLabel" Style="{StaticResource PillText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </slate:SlateBorder>
                    <!-- Icon: the pack's own pack.png, falling back to its initial. -->
                    <slate:SlateBorder DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <TextBlock x:Name="PackInitialLabel" Style="{StaticResource H3}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PackIconImage" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </slate:SlateBorder>
                    <TextBlock x:Name="PackNameLabel" Style="{StaticResource H2}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="MetaLabel" Style="{StaticResource Muted}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <slate:SlateBorder x:Name="EnabledPill" Style="{StaticResource Pill}"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            ToolTip="Listed in this instance's options.txt - the game loads it">
                        <TextBlock x:Name="EnabledPillText" Style="{StaticResource PillText}"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </slate:SlateBorder>
                    <!-- Shown instead of the ON pill when the page is opened for the launcher's
                    own copy: with no instance there is no stack position, so it says how many
                    instances hold the file. -->
                    <slate:SlateBorder x:Name="PlacementPill" Style="{StaticResource Pill}"
                            Background="{DynamicResource Surface4Brush}" Margin="0,0,6,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="PlacementPillText" Style="{StaticResource PillText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </slate:SlateBorder>
                    <slate:SlateBorder x:Name="FormatPill" Style="{StaticResource Pill}"
                            Background="{DynamicResource Surface4Brush}" Margin="0,0,6,0"
                            Visibility="Collapsed"
                            ToolTip="The pack format the author declared in pack.mcmeta - Minecraft warns when it does not match the game version">
                        <TextBlock x:Name="FormatPillText" Style="{StaticResource PillText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </slate:SlateBorder>
                    <slate:SlateBorder x:Name="KindPill" Style="{StaticResource Pill}"
                            Background="{DynamicResource Surface4Brush}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="KindPillText" Style="{StaticResource PillText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </slate:SlateBorder>
                </StackPanel>

                <!-- LastChildFill off, or a lone docked button stretches across the card. -->
                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Open file location" Click="OnOpenFolder"/>
                </DockPanel>
            </StackPanel>
        </slate:SlateBorder>

        <TabControl Grid.Row="1" Margin="24,0,24,0" Padding="0,12,0,0"
                    Background="Transparent" BorderThickness="0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,18">
                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Display name" Margin="0,0,0,8"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Save" Click="OnSaveName"/>
                                    <TextBox x:Name="NameBox" Margin="0,0,8,0"/>
                                </DockPanel>
                            </StackPanel>
                        </slate:SlateBorder>

                        <slate:SlateBorder Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Publishing is recorded against one instance's copy of the
                                zip, so a pack no instance has yet can't be published; the card
                                then says which copy it is waiting for. -->
                                <!-- Heading only when the note replaces the checkbox, which is
                                otherwise the heading. -->
                                <TextBlock x:Name="SharingUnavailableHeading"
                                           Style="{StaticResource H3}" Text="Sharing"
                                           Margin="0,0,0,8" Visibility="Collapsed"/>
                                <TextBlock x:Name="SharingUnavailableNote"
                                           Style="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <CheckBox x:Name="SharePackBox"
                                          Content="Share this resource pack"
                                          Click="OnSharePackToggled"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,8"/>
                                <TextBlock x:Name="SharingDisabledHint"
                                           Style="{StaticResource Muted}"
                                           Text="Enable sharing to publish this zip, upload versions, and grant access."
                                           TextWrapping="Wrap"/>

                                <StackPanel x:Name="SharingSettingsPanel" Visibility="Collapsed">
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="UploadHostedButton" DockPanel.Dock="Right"
                                                Content="Upload version (.zip)"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnShareOrUploadZip" Padding="14,5"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        <Button x:Name="PackPermissionsButton" DockPanel.Dock="Right"
                                                Content="Manage collaborators..."
                                                Click="OnEditHostedPermissions"
                                                Margin="0,0,8,0" Padding="14,5"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        <!--  Only when this copy is linked to a pack somebody else owns and
                                             shared with this person directly.  -->
                                        <Button x:Name="LeaveHostedButton" DockPanel.Dock="Right"
                                                Content="Leave..." Click="OnLeaveHosted"
                                                Style="{StaticResource SubtleButton}"
                                                Margin="0,0,8,0" Padding="14,5" Visibility="Collapsed"/>
                                        <TextBlock Style="{StaticResource H3}" Text="Hosted resource pack"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock x:Name="HostedStatusLabel" Style="{StaticResource Muted}"
                                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <TextBlock Style="{StaticResource Caption}" Text="Summary"/>
                                    <TextBox x:Name="SummaryBox" Margin="0,4,0,12" MaxLength="512"
                                             TextChanged="OnOverviewEdited"/>

                                    <TextBlock Style="{StaticResource Caption}" Text="Description"/>
                                    <TextBox x:Name="DescriptionBox" Margin="0,4,0,12"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="90" MaxHeight="220" MaxLength="4096"
                                             TextChanged="OnOverviewEdited"/>

                                    <TextBlock Style="{StaticResource Caption}" Text="Visibility when shared"/>
                                    <ComboBox x:Name="VisibilityBox" Margin="0,4,0,12"
                                              SelectionChanged="OnOverviewSelectionEdited"
                                              ToolTipService.ShowOnDisabled="True">
                                        <ComboBoxItem Content="Private"/>
                                        <ComboBoxItem Content="Team"/>
                                        <ComboBoxItem Content="Public"/>
                                    </ComboBox>

                                    <DockPanel>
                                        <Button x:Name="SaveOverviewButton" DockPanel.Dock="Right" Content="Save overview"
                                                Click="OnSaveOverview" Padding="14,5"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        <TextBlock x:Name="OverviewSaveStatus" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </slate:SlateBorder>

                        <slate:SlateBorder Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="Local file" Margin="0,0,0,8"/>
                                <TextBlock x:Name="FilePathLabel" Style="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <!-- Which copy the path above is, when it is not an instance's.
                                The button below opens a real file either way. -->
                                <TextBlock x:Name="FileScopeNote" Style="{StaticResource Body}"
                                           TextWrapping="Wrap" Margin="0,0,0,10"
                                           Visibility="Collapsed"/>
                                <TextBlock Style="{StaticResource Caption}" Text="What the pack says about itself"
                                           x:Name="PackDescriptionCaption" Visibility="Collapsed"/>
                                <TextBlock x:Name="PackDescriptionLabel" Style="{StaticResource Body}"
                                           TextWrapping="Wrap" Margin="0,4,0,10"
                                           Visibility="Collapsed"/>
                                <Button Content="Reveal in Explorer" HorizontalAlignment="Left" Click="OnOpenFolder"/>
                            </StackPanel>
                        </slate:SlateBorder>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Versions">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,18,0,18">
                        <slate:SlateBorder x:Name="VersionsDisabledPanel" Style="{StaticResource Card}">
                            <!-- Named because the text varies: sharing is off, or no instance
                            has a copy of the pack yet. -->
                            <TextBlock x:Name="VersionsDisabledText" Style="{StaticResource Muted}"
                                       Text="Enable sharing on the Overview tab to upload and view hosted versions."
                                       TextWrapping="Wrap"/>
                        </slate:SlateBorder>

                        <slate:SlateBorder x:Name="VersionsPanel" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
                            <DockPanel>
                                <slate:SlateBorder DockPanel.Dock="Top"
                                        Background="{DynamicResource Surface3Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                        Padding="14,10" CornerRadius="10,10,0,0">
                                    <DockPanel>
                                        <Button x:Name="RefreshVersionsButton" DockPanel.Dock="Right"
                                                Content="Refresh" Click="OnRefreshHostedVersions"
                                                Padding="10,4"/>
                                        <Button x:Name="VersionsUploadButton" DockPanel.Dock="Right"
                                                Content="Upload version"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnShareOrUploadZip"
                                                Margin="0,0,8,0" Padding="10,4"
                                                ToolTipService.ShowOnDisabled="True"/>
                                        <TextBlock Text="Uploaded versions" Style="{StaticResource H3}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </slate:SlateBorder>
                                <ItemsControl x:Name="HostedVersionsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12" Margin="0,0,0,1"
                                                    Background="{DynamicResource Surface1Brush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    ToolTip="{Binding Tooltip}">
                                                <Border.ContextMenu>
                                                    <!--  Opened decides what this person may do with the
                                                         hosted pack: saving needs Download, deleting a
                                                         version is the owner's.  -->
                                                    <ContextMenu Opened="OnVersionMenuOpened">
                                                        <MenuItem x:Name="VersionCtxSave" Header="Save as..." Click="OnCtxSaveVersion">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xE74E;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Copy download link" Click="OnCtxCopyVersionLink"/>
                                                        <Separator x:Name="VersionCtxDeleteSeparator"/>
                                                        <MenuItem x:Name="VersionCtxDelete" Header="Delete version..." Click="OnCtxDeleteVersion"
                                                                  Foreground="{DynamicResource DangerBrush}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding VersionString}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <slate:SlateBorder Grid.Column="1" Style="{StaticResource Pill}"
                                                            Background="{DynamicResource Surface4Brush}"
                                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding McVersionLabel}" Style="{StaticResource PillText}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </slate:SlateBorder>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="VersionsEmptyLabel"
                                           Style="{StaticResource Muted}"
                                           Text="No hosted versions uploaded yet."
                                           Margin="14" Visibility="Collapsed"/>
                            </DockPanel>
                        </slate:SlateBorder>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Instances">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <slate:SlateBorder Style="{StaticResource Card}" Margin="0,18,0,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H3}" Text="Where this goes" Margin="0,0,0,4"/>
                            <TextBlock x:Name="InstanceStateNote" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <slate:SlateBorder x:Name="PackListWrap" Background="{DynamicResource Surface1Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="6">
                                <ItemsControl x:Name="PackCheckList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The caption is a sibling of the CheckBox rather than its
                                            content: the CheckBox template uses a horizontal StackPanel,
                                            which measures children with unbounded width, so text in it
                                            never wraps. 28px is the template's 20px box plus its 8px
                                            gap, so the caption lines up under the name. The version
                                            pill sits on the name's line so it doesn't narrow the
                                            caption. -->
                                            <StackPanel Margin="6,4">
                                                <DockPanel>
                                                    <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                            Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource PillText}"/>
                                                    </slate:SlateBorder>
                                                    <CheckBox IsChecked="{Binding IsCompatible, Mode=TwoWay}"
                                                              IsEnabled="{Binding IsEditable}"
                                                              Click="OnPackCompatibilityChanged"
                                                              Tag="{Binding PackId}"
                                                              Content="{Binding PackName}"
                                                              ToolTip="{Binding StateLine}"
                                                              VerticalContentAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding StateLine}" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" Margin="28,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </slate:SlateBorder>
                        </StackPanel>
                    </slate:SlateBorder>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusLabel" Grid.Row="2" Style="{StaticResource Caption}"
                   Margin="24,8,24,18"/>
    </Grid>
</Page>
