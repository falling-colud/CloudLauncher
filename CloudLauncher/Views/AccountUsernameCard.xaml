<UserControl x:Class="CloudLauncher.Views.AccountUsernameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls">
    <slate:SlateBorder Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="24" MinWidth="380" MaxWidth="440">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>
        <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="Change username" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="People find you by this name when they share with you. You sign in with the new name from now on."/>

            <TextBlock Style="{StaticResource Caption}" Text="New username"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,4"/>
            <TextBox x:Name="UsernameBox" TextChanged="OnTyping"/>

            <TextBlock x:Name="ErrorLabel" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SubtleButton}"
                        Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="SubmitButton" Content="Change username" Style="{StaticResource AccentButton}"
                        Click="OnSubmit"/>
            </StackPanel>
        </StackPanel>
    </slate:SlateBorder>
</UserControl>
