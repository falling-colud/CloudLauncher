<Window x:Class="CloudLauncher.Views.PackRulesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CloudLauncher.Views"
        Title="File rules" Height="580" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface1Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource H2}" Text="File rules"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0">
                The most specific rule wins — a deeper pattern like
                <Run FontFamily="{StaticResource MonoFont}">mods/1.12.2/</Run> overrides
                <Run FontFamily="{StaticResource MonoFont}">mods/</Run> whatever the order; ties are broken top-to-bottom.
                Patterns support exact paths
                (<Run FontFamily="{StaticResource MonoFont}">options.txt</Run>),
                folder prefixes (<Run FontFamily="{StaticResource MonoFont}">mods/</Run>),
                and globs (<Run FontFamily="{StaticResource MonoFont}">config/*.json</Run>,
                <Run FontFamily="{StaticResource MonoFont}">saves/**</Run>).
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="RulesGrid"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Pattern" Width="*"
                                        Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridComboBoxColumn Header="Action" Width="130"
                                            SelectedValueBinding="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{x:Static local:PackRulesDialog.ActionValues}"/>
                    <!-- Row action at the right edge, as on the instance list. -->
                    <DataGridTemplateColumn x:Name="DeleteColumn" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Style="{StaticResource DangerButton}"
                                        Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                        HorizontalAlignment="Right"
                                        ToolTip="Remove this rule"
                                        Click="OnDeleteRule"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,12,0,0"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="Add rule:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="NewActionBox" Width="140" DockPanel.Dock="Right" Margin="8,0,0,0"
                          ToolTip="Shared files are uploaded for everyone; Local stays on this PC; Ignored is never synced"/>
                <Button x:Name="AddRuleButton" Content="Add" Style="{StaticResource AccentButton}"
                        DockPanel.Dock="Right" Click="OnAddRule" Margin="8,0,0,0"/>
                <TextBox x:Name="NewPatternBox"
                         KeyDown="OnNewPatternKeyDown"
                         ToolTip="e.g. mods/ or options.txt or config/*.json — press Enter to add"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" IsCancel="True"/>
            <Button x:Name="ResetDefaultsButton" DockPanel.Dock="Right" Content="Reset to defaults"
                    ToolTip="Replace every rule with the built-in set"
                    Click="OnResetDefaults"/>
            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>

        <!-- Confirmations render inside this window: it is modal, so an overlay drawn on the main
             window would be visible but unclickable. -->
        <Grid x:Name="DialogLayer" Visibility="Collapsed"/>
    </Grid>
</Window>
