<UserControl x:Class="CloudLauncher.Views.ConfigCopyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:anim="clr-namespace:CloudLauncher.Animations">
    <!--  Fixed size and shadow are for the floating card. Embed() strips both when the control is
    used as the body of a page pane.  -->
    <slate:SlateBorder x:Name="CardRoot"
            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="22" Width="640" Height="580">
        <slate:SlateBorder.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="28" ShadowDepth="6"/>
        </slate:SlateBorder.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="TitleLabel" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid DockPanel.Dock="Top" Margin="0,14,0,8">
                <TextBlock x:Name="CountLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Select all" Style="{StaticResource LinkButton}" FontSize="11"
                            Click="OnSelectAll" Margin="0,0,10,0"/>
                    <Button Content="None" Style="{StaticResource LinkButton}" FontSize="11"
                            Click="OnSelectNone"/>
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <TextBlock x:Name="FooterNote" Style="{StaticResource Caption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                           Margin="0,0,250,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="OnCancel"
                            Margin="0,0,8,0" Padding="14,5"/>
                    <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource AccentButton}"
                            Click="OnCopy" Padding="16,5" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <slate:SlateBorder CornerRadius="8" Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="6">
                <Grid>
                    <ItemsControl x:Name="TargetList" anim:Animate.EntranceStagger="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              anim:Animate.SmoothScroll="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <slate:SlateBorder Padding="12,9" Margin="3,3" CornerRadius="8"
                                        Background="{DynamicResource Surface2Brush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                                                  Margin="10,0,2,0"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Checked="OnTargetToggled" Unchecked="OnTargetToggled"
                                                  ToolTip="Copy into this instance"/>
                                        <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Background="{DynamicResource WarningBrush}"
                                                Visibility="{Binding SharedVisibility}"
                                                ToolTip="{Binding SharedHint}">
                                            <TextBlock Text="SHARED" Style="{StaticResource PillText}"
                                                       Foreground="White"/>
                                        </slate:SlateBorder>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PackName}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </slate:SlateBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel x:Name="BusyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="160" Height="4" IsIndeterminate="True"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Text="Checking what each instance already has..."/>
                    </StackPanel>
                </Grid>
            </slate:SlateBorder>
        </DockPanel>
    </slate:SlateBorder>
</UserControl>
