<Page x:Class="CloudLauncher.Views.WorldBrowserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:slate="clr-namespace:CloudLauncher.Controls"
      xmlns:views="clr-namespace:CloudLauncher.Views"
      Title="World browser"
      Background="{DynamicResource Surface0Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,18,22,12">
            <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="Download a world"/>
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Browse CurseForge worlds and the CloudLauncher catalog. Single-click a result to read about it, double-click to download it."/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="22,0,22,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <slate:SlateBorder Grid.Column="0" Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8,2" MinHeight="34">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{DynamicResource IconFont}"
                               FontSize="13" VerticalAlignment="Center" Margin="2,0,8,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center"
                             KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged"
                             ToolTip="Search worlds"/>
                </DockPanel>
            </slate:SlateBorder>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox x:Name="SortBox" Width="150" Margin="6,0,0,0" MinHeight="34"
                          SelectedIndex="0" SelectionChanged="OnSortChanged"
                          ToolTip="Order the results">
                    <ComboBoxItem Content="Popularity"/>
                    <ComboBoxItem Content="Downloads"/>
                    <ComboBoxItem Content="Last updated"/>
                    <ComboBoxItem Content="Name"/>
                </ComboBox>
                <Button Style="{StaticResource IconButton}"
                        Margin="6,0,0,0" Padding="8,5"
                        Content="&#xE71C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                        ToolTip="Filters" Click="OnFiltersClick"/>
                <Button x:Name="RefreshButton" Style="{StaticResource IconButton}"
                        Margin="6,0,0,0" Padding="8,5"
                        Content="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="13"
                        ToolTip="Refresh (F5)" Click="OnRefresh"/>
            </StackPanel>
            <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=SearchBox}"
                   Placement="Top" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="0" VerticalOffset="-8">
                <slate:SlateBorder Background="{DynamicResource Surface2Brush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14" MinWidth="240">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H3}" Text="Filters" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource Caption}" Text="Minecraft version"/>
                        <TextBox x:Name="FilterMcBox" Margin="0,4,0,10"
                                 ToolTip="e.g. 1.20.1 - leave empty for any"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Apply" Style="{StaticResource AccentButton}"
                                    Click="OnApplyFilters" Padding="14,5"/>
                        </StackPanel>
                    </StackPanel>
                </slate:SlateBorder>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="22,0,22,12"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SourceStrip">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <slate:SlateBorder Padding="0" Margin="0,2,8,2" Cursor="{Binding CursorHint}"
                                Background="{Binding Background}"
                                BorderBrush="{Binding BorderColor}" BorderThickness="1"
                                CornerRadius="14"
                                MouseLeftButtonUp="OnSourceChipClick"
                                Visibility="{Binding ChipVisibility}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" Margin="12,0,12,0"
                                           Padding="0,5,0,5"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground}"
                                           FontWeight="{Binding FontWeight}"/>
                            </StackPanel>
                        </slate:SlateBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="22,0,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <slate:SlateBorder Grid.Column="0"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ListBox x:Name="ResultsList"
                             SelectionChanged="OnResultSelected"
                             MouseDoubleClick="OnResultDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="OnResultsScroll">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Background="Transparent"
                                        ToolTip="{Binding RowToolTip}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Download..." Click="OnCtxDownload">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Open project page" Click="OnCtxOpenPage">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE774;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Copy project link" Click="OnCtxCopyLink">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="&#xE71B;" FontFamily="{DynamicResource IconFont}" FontSize="12"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <slate:SlateBorder Grid.Column="0" Width="44" Height="44"
                                                Background="{DynamicResource Surface3Brush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initial}" Style="{StaticResource H3}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Don't bind a remote URL straight to Image.Source:
                                                WPF opens a connection per row and decodes at full
                                                size on the UI thread. IconLoader shares one decoded,
                                                frozen bitmap per URL. -->
                                                <Image views:IconLoader.Url="{Binding IconUrl}"
                                                       views:IconLoader.DecodeWidth="44"
                                                       Stretch="UniformToFill"/>
                                            </Grid>
                                        </slate:SlateBorder>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <DockPanel>
                                                <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                        Background="{Binding SourceBadgeBackground}"
                                                        Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding SourceBadge}"
                                                               Style="{StaticResource PillText}"
                                                               Foreground="{Binding SourceBadgeForeground}"/>
                                                </slate:SlateBorder>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource Caption}"
                                                       Margin="0,4,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding DownloadLabel}"
                                                Style="{StaticResource AccentButton}"
                                                Click="OnDownloadRow" Tag="{Binding}"
                                                IsEnabled="{Binding CanDownload}"
                                                ToolTip="{Binding DownloadToolTip}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Padding="12,5" MinHeight="30" MinWidth="0"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,80,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE909;" FontFamily="{DynamicResource IconFont}" FontSize="40"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"/>
                        <TextBlock x:Name="EmptyTitle" Style="{StaticResource H3}"
                                   Text="No worlds found"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock x:Name="EmptyDetail" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="320" TextAlignment="Center"
                                   Text="Try a different search or pick another source."/>
                    </StackPanel>
                </Grid>
            </slate:SlateBorder>

            <Border Grid.Column="1" Width="1"
                    Background="{DynamicResource BorderSubtleBrush}"
                    HorizontalAlignment="Center"/>

            <slate:SlateBorder Grid.Column="2"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <Grid>
                    <TextBlock x:Name="DetailPlaceholder"
                               Text="Select a world to see its description, screenshots, links, versions, and download options."
                               Style="{StaticResource Muted}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" MaxWidth="420"/>

                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <slate:SlateBorder Grid.Column="0" Width="44" Height="44"
                                    Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    ClipToBounds="True" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock x:Name="SelectedIconFallback" Style="{StaticResource H3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="SelectedIconImage" Stretch="UniformToFill"/>
                                </Grid>
                            </slate:SlateBorder>
                            <StackPanel Grid.Column="1">
                                <!-- MaxHeight is two lines of H2; past that the name is
                                trimmed with an ellipsis. -->
                                <TextBlock x:Name="WorldNameLabel" Style="{StaticResource H2}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           MaxHeight="54"/>
                                <TextBlock x:Name="WorldMetaLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Actions get their own row: beside the name they leave it only a
                            few characters per line at the minimum width. WrapPanel so they
                            stack rather than spill out of the card. -->
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2"
                                       HorizontalAlignment="Right" Margin="0,10,0,0">
                                <!-- Lets anyone who may manage a hosted world do so from here,
                                not only from the save it was published from. -->
                                <Button x:Name="ManageAccessButton" Content="Manage access..."
                                        Click="OnManageAccess" Visibility="Collapsed"
                                        Padding="10,4" MinWidth="0" MinHeight="0" Margin="0,0,6,0"
                                        ToolTip="Choose who can see, download, upload to or manage this world"/>
                                <Button x:Name="LeaveWorldButton" Content="Leave..."
                                        Click="OnLeaveWorld" Visibility="Collapsed"
                                        Style="{StaticResource SubtleButton}"
                                        Padding="10,4" MinWidth="0" MinHeight="0" Margin="0,0,6,0"/>
                                <Button x:Name="OpenProjectButton" Content="Open page"
                                        Click="OnOpenSelectedProject"
                                        Padding="10,4" MinWidth="0" MinHeight="0"/>
                                <Button x:Name="DownloadSelectedButton" Content="Download"
                                        Style="{StaticResource AccentButton}"
                                        Click="OnDownloadSelectedWorld"
                                        ToolTipService.ShowOnDisabled="True"
                                        Padding="10,4" MinWidth="0" MinHeight="0"/>
                            </WrapPanel>
                        </Grid>

                        <TabControl Grid.Row="1" x:Name="WorldTabs">
                            <TabItem Header="Overview">
                                <slate:SlateBorder CornerRadius="8" ClipToBounds="True" Margin="0,12,0,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Border x:Name="OverviewHost" ClipToBounds="True"
                                            Background="{DynamicResource Surface0Brush}">
                                        <views:RichDescriptionView x:Name="OverviewBrowser"/>
                                    </Border>
                                </slate:SlateBorder>
                            </TabItem>

                            <TabItem Header="Screenshots">
                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="ScreenshotsEmptyText" Style="{StaticResource Muted}"
                                               Text="No screenshots are available for this world."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="ScreenshotList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <slate:SlateBorder Width="210" Margin="0,0,10,10" Style="{StaticResource Card}" Padding="8"
                                                            Cursor="Hand" ToolTip="Open screenshot"
                                                            MouseLeftButtonUp="OnOpenScreenshot">
                                                        <StackPanel>
                                                            <slate:SlateBorder Height="112" Background="{DynamicResource Surface0Brush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                                                                <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                            </slate:SlateBorder>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"
                                                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </slate:SlateBorder>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Links">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="Project links" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,2,0,0">
                                        <Button x:Name="ProjectPageButton" Content="Project page" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="IssuesButton" Content="Issues" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="SourceButton" Content="Source" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                        <Button x:Name="WikiButton" Content="Wiki" Click="OnOpenLink" Margin="0,0,14,12" Padding="18,8"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="LinksEmptyText" Style="{StaticResource Muted}"
                                               Text="This world has not published extra links through the selected provider."
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="Versions">
                                <slate:SlateBorder Background="{DynamicResource Surface0Brush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,12,0,0">
                                    <DataGrid x:Name="VersionsGrid"
                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" RowHeaderWidth="0"
                                              SelectionMode="Single" IsReadOnly="True"
                                              Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Version" Binding="{Binding VersionNumber}" Width="*"/>
                                            <DataGridTextColumn Header="MC" Binding="{Binding McVersion}" Width="110"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="96"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding SizeLabel}" Width="74"/>
                                            <DataGridTemplateColumn Width="96">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Download" Style="{StaticResource AccentButton}"
                                                                Padding="6,2" MinWidth="0" MinHeight="0" FontSize="11"
                                                                IsEnabled="{Binding CanDownload}"
                                                                ToolTip="{Binding DownloadHint}"
                                                                ToolTipService.ShowOnDisabled="True"
                                                                Click="OnDownloadVersion"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </slate:SlateBorder>
                            </TabItem>
                        </TabControl>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <DockPanel x:Name="DownloadProgressRow" Visibility="Collapsed" Margin="0,0,0,6">
                                <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right"
                                        Content="Cancel" Click="OnCancelDownload"
                                        Padding="10,3" MinHeight="0" Margin="10,0,0,0"/>
                                <ProgressBar x:Name="DownloadProgress" Height="5"
                                             Minimum="0" Maximum="1" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="DownloadStatus" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </slate:SlateBorder>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource PageStatusBar}">
            <DockPanel>
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Right"
                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Page>
