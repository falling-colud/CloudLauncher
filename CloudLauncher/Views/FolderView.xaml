<UserControl x:Class="CloudLauncher.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             Background="Transparent">
    <DockPanel>
        <!-- Breadcrumb bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel>
                <Button x:Name="UpButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="&#xE74A;" FontFamily="{DynamicResource IconFont}" FontSize="11"
                        Click="OnUp" Padding="4" MinWidth="22" MinHeight="22"
                        ToolTip="Up one folder"
                        Visibility="Collapsed"/>
                <!-- Compact search box. Hosts with their own search field collapse it (the file management
                page filters both panes from one box). -->
                <slate:SlateBorder x:Name="SearchHost" DockPanel.Dock="Right" Width="168" Margin="8,0,4,0"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="5" Padding="6,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE721;"
                                   FontFamily="{DynamicResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Grid>
                            <TextBox x:Name="FilterBox"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MinHeight="20" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnFilterChanged"
                                     KeyDown="OnFilterKeyDown"
                                     ToolTip="Filter this folder. Two characters or more searches the whole instance instead. Esc clears.">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Text="Find a file..." FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </slate:SlateBorder>
                <ItemsControl x:Name="Breadcrumb">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Label}" Tag="{Binding Path}"
                                        Click="OnBreadcrumbClick"
                                        Style="{StaticResource LinkButton}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        FontSize="11" Cursor="Hand" Padding="4,1"/>
                                <TextBlock Text="/" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Sort header - click a column to sort by it; click again to flip direction -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Padding="8,3,6,3">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                        Click="OnSortByDate" Cursor="Hand" Width="118"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        HorizontalContentAlignment="Right"
                        ToolTip="Sort by date modified">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Modified" FontSize="11"/>
                        <TextBlock x:Name="DateSortArrow" Text="" FontSize="9"
                                   Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                        Click="OnSortBySize" Cursor="Hand" Width="72"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        HorizontalContentAlignment="Right"
                        ToolTip="Sort by size - the quickest way to find what is making this instance big">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Size" FontSize="11"/>
                        <TextBlock x:Name="SizeSortArrow" Text="" FontSize="9"
                                   Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LinkButton}"
                        Click="OnSortByName" Cursor="Hand"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        HorizontalContentAlignment="Left"
                        ToolTip="Sort by name">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Name" FontSize="11"/>
                        <TextBlock x:Name="NameSortArrow" Text="" FontSize="9"
                                   Margin="3,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Empty state, so an empty folder and a filter with no matches can be told apart -->
        <TextBlock x:Name="EmptyLabel" DockPanel.Dock="Bottom"
                   Style="{StaticResource Caption}"
                   Margin="10,10,10,12" TextWrapping="Wrap" TextAlignment="Center"
                   Visibility="Collapsed"/>

        <Grid>
            <!-- File / folder list - supports drag-and-drop between sibling FolderViews and from Explorer -->
            <ListBox x:Name="FileList" SelectionMode="Extended"
                     Background="Transparent" BorderThickness="0"
                     AllowDrop="True"
                     MouseDoubleClick="OnDoubleClick"
                     SelectionChanged="FileList_SelectionChanged"
                     PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
                     PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnPreviewMouseMove"
                     PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                     DragEnter="OnDragEnter"
                     DragOver="OnDragEnter"
                     DragLeave="OnDragLeave"
                     Drop="OnDrop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                        <Style.Triggers>
                            <!-- The folder a same-pane drag would move the files into. -->
                            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}"
                                       Width="118" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"
                                       Margin="8,0,2,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeLabel}"
                                       Width="72" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <!-- Private files are never uploaded, whatever the rules say, so the row
                            says so. -->
                            <slate:SlateBorder DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                    Background="{DynamicResource WarningBrush}"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding PrivateBadgeVisibility}"
                                    ToolTip="Held back from every upload, whatever the rules say.">
                                <TextBlock Text="private" Style="{StaticResource PillText}"
                                           Foreground="{DynamicResource TextOnAccentBrush}"/>
                            </slate:SlateBorder>
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji"
                                       Margin="0,0,6,0" VerticalAlignment="Center" FontSize="13"/>
                            <!-- Rule colour comes from triggers: a brush read from resources in code
                            is a snapshot and would keep the old palette after a theme change. -->
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="{Binding FontWeight}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoLocal}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAutoShared}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <!-- Last so it wins: ignored files are outside sync entirely. -->
                                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Shown while an acceptable drag is over the pane. An overlay so it can't shift the rows,
            and not hit-testable so the drop still reaches the list. -->
            <Border x:Name="DropHighlight" IsHitTestVisible="False" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                    Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"/>
        </Grid>
    </DockPanel>
</UserControl>
