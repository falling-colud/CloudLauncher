<UserControl x:Class="CloudLauncher.Views.ModPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:slate="clr-namespace:CloudLauncher.Controls"
             xmlns:local="clr-namespace:CloudLauncher.Views"
             Background="Transparent" Focusable="True">
    <DockPanel>
        <!-- ───────────────────────────── toolbar ───────────────────────────── -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <!-- The board's name. The rail on the left is the board switcher. -->
                <TextBlock x:Name="BoardTitle" Style="{StaticResource H3}" VerticalAlignment="Center"
                           MaxWidth="210" TextTrimming="CharacterEllipsis"
                           ToolTip="The board being edited - switch or rename it in the rail on the left"/>

                <Border Width="1" Margin="10,4" Background="{DynamicResource BorderBrush}"/>

                <Button Content="Mod" Style="{StaticResource SubtleButton}" Padding="11,5" MinHeight="0"
                        Click="OnAddModCard" ToolTip="Add a card for one specific mod"/>
                <Button Content="Placeholder" Style="{StaticResource SubtleButton}" Padding="11,5" MinHeight="0"
                        Margin="6,0,0,0" Click="OnAddPlaceholder"
                        ToolTip="Add a card for a mod the pack doesn't have yet: one you still need to find or port"/>
                <Button Content="Group ▾" Style="{StaticResource SubtleButton}" Padding="11,5" MinHeight="0"
                        Margin="6,0,0,0" Click="OnAddGroupCard"
                        ToolTip="Add a live card for every mod sharing a property (category, priority, side...)"/>
                <Button Content="Note" Style="{StaticResource SubtleButton}" Padding="11,5" MinHeight="0"
                        Margin="6,0,0,0" Click="OnAddNoteCard" ToolTip="Add a free-text planning card"/>
                <Button Content="Section" Style="{StaticResource SubtleButton}" Padding="11,5" MinHeight="0"
                        Margin="6,0,0,0" Click="OnAddSection"
                        ToolTip="Add a titled region - dragging it carries the cards inside"/>
                <Button x:Name="ArrowToolButton" Content="Arrow" Style="{StaticResource SubtleButton}" Padding="11,5"
                        MinHeight="0" Margin="6,0,0,0" Click="OnToggleArrowTool"
                        ToolTip="Draw arrows between cards: click a card, then the card it points to. Stays on until you click it again or press Esc."/>
                <Button Content="Tools ▾" Style="{StaticResource SubtleButton}" Padding="11,5" MinHeight="0"
                        Margin="10,0,0,0" Click="OnTools" ToolTip="Fill the board automatically, tidy it, snap it to the grid, or clear it"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Whether the boards are live on the server (ModPlanView.ShowSyncState). Hidden for an
                instance that is only on this PC. -->
                <StackPanel x:Name="SyncBadge" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,14,0" Visibility="Collapsed" Background="Transparent">
                    <Ellipse x:Name="SyncDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                             Fill="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="SyncText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="PlanStatus" Style="{StaticResource Caption}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="0,0,10,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                <!-- What is still to find: shown while the board has placeholders (ModPlanView.Placeholders.cs). -->
                <Button x:Name="PlaceholderSummary" Style="{StaticResource SubtleButton}" Padding="10,5" MinHeight="0"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="OnPlaceholderSummary"/>
                <Button x:Name="RailToggle" Style="{StaticResource IconButton}" Content="&#xE71C;"
                        FontFamily="{DynamicResource IconFont}" FontSize="13"
                        ToolTip="Show or hide the boards rail" Click="OnToggleRail"/>
                <!-- One setting for every board, saved in the launcher settings rather than on the
                board, since it is an editing preference. -->
                <CheckBox x:Name="GridToggle" Content="Grid" IsChecked="True" VerticalAlignment="Center"
                          Margin="10,0,8,0" Click="OnGridToggled"
                          ToolTip="Snap cards to the grid. Untick to place them freely."/>
                <Button Style="{StaticResource IconButton}" Content="&#xE71F;" FontFamily="{DynamicResource IconFont}"
                        FontSize="13" ToolTip="Zoom out" Click="OnZoomOut"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" FontFamily="{DynamicResource IconFont}"
                        FontSize="13" ToolTip="Zoom in" Click="OnZoomIn"/>
                <Button Style="{StaticResource SubtleButton}" Content="Fit" Padding="12,6" Margin="6,0,0,0"
                        ToolTip="Fit the whole board to the view" Click="OnFit"/>
            </StackPanel>
        </Grid>

        <!-- ───────────────────────── rail + canvas ───────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- The rail is the board switcher. Mods get onto a board with the Mod button above. -->
            <slate:SlateBorder x:Name="RailHost" Grid.Column="0" Margin="0,0,10,0"
                    Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <!-- ───────────── boards + their categories ───────────── -->
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="2,2,2,6">
                        <TextBlock Text="BOARDS" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RailSummary" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <!-- Docked under the list rather than as its last row, so it stays
                    reachable without scrolling. -->
                    <ContentControl x:Name="RailNewChips" DockPanel.Dock="Bottom" Margin="0,7,0,0"/>

                    <!-- Drop handling is on the ScrollViewer rather than the row host, so
                    dropping in the gap under the last row means "put it at the end" (as in
                    ContentListView). -->
                    <ScrollViewer x:Name="RailScroll" Background="Transparent" Padding="0,0,2,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AllowDrop="True" DragOver="OnRailDragOver" Drop="OnRailDrop"
                                  DragLeave="OnRailDragLeave">
                        <StackPanel x:Name="RailList" Background="Transparent"/>
                    </ScrollViewer>
                </DockPanel>
            </slate:SlateBorder>

            <slate:SlateBorder x:Name="Viewport" Grid.Column="1" ClipToBounds="True"
                    Focusable="True" FocusVisualStyle="{x:Null}"
                    Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8"
                    MouseWheel="OnViewportWheel"
                    PreviewMouseLeftButtonDown="OnViewportPreviewMouseDown"
                    PreviewMouseLeftButtonUp="OnViewportPreviewMouseUp"
                    MouseLeftButtonDown="OnViewportMouseDown"
                    MouseMove="OnViewportMouseMove"
                    MouseLeftButtonUp="OnViewportMouseUp"
                    MouseRightButtonUp="OnViewportRightClick">
                <Grid>
                    <!-- ruled grid (ModPlanView.GridLines, drawn in code), kept in sync with the canvas pan/zoom -->
                    <Decorator x:Name="GridBackdrop" IsHitTestVisible="False"/>

                    <Canvas x:Name="BoardCanvas" RenderTransformOrigin="0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomT" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PanT" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>

                    <!-- shown only while the board has nothing on it -->
                    <StackPanel x:Name="EmptyHint" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                        <TextBlock Text="Plan your modpack here" Style="{StaticResource H3}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Add mods with the Mod button above, add a live group card for a category or priority, and connect them with arrows: turn on Arrow above and click one card then another, or drag the dot on a card's edge. Double-click anywhere for a note, right-click for everything else. Drop cards onto a section and they move with it; shift-drag to select a group."/>
                    </StackPanel>
                </Grid>
            </slate:SlateBorder>
        </Grid>
    </DockPanel>
</UserControl>
