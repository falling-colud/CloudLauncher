<Page x:Class="CloudLauncher.Views.SettingsPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:CloudLauncher.Views"
      Title="Settings"
      Background="{DynamicResource Surface0Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="SettingsStack" Margin="22,18,22,28">

            <DockPanel>
                <TextBox x:Name="SettingsSearchBox" DockPanel.Dock="Right" Width="230"
                         VerticalAlignment="Center" TextChanged="OnSettingsSearchChanged"
                         PreviewKeyDown="OnSettingsSearchKeyDown"
                         ToolTip="Show only the sections mentioning what you type (Ctrl+F)"/>
                <TextBlock Style="{StaticResource H2}" Text="Settings" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="NoSettingsMatchLabel" Style="{StaticResource Muted}" Visibility="Collapsed"
                       Margin="0,24,0,0" HorizontalAlignment="Center"
                       Text="No settings matched that search."/>

            <!-- Default RAM -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Default memory" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Maximum RAM allocated to new instances. You can override this per-instance on the instance's Options tab."
                               TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <DockPanel>
                        <TextBlock x:Name="RamValueLabel" DockPanel.Dock="Right"
                                   Text="4096 MB" MinWidth="96" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="RamSlider" Minimum="1024" Maximum="32768"
                                TickFrequency="512" IsSnapToTickEnabled="True"
                                Value="4096" ValueChanged="OnRamChanged"
                                VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                    <TextBlock x:Name="RamHint" Style="{StaticResource Caption}"
                               Margin="0,16,0,0"
                               Text="Recommended: 4–8 GB for modded play. Changes save automatically."/>
                </StackPanel>
            </Border>

            <!-- Minecraft defaults link -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Right" Content="Edit defaults…"
                            Style="{StaticResource AccentButton}" Click="OnOpenMcDefaults"
                            VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource H3}" Text="Minecraft defaults"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="FOV, render distance, brightness, volumes, keybindings — applied to new instances."
                                   TextWrapping="Wrap" Margin="0,4,16,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Java -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Java" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="The Java runtime used for every instance that has no choice of its own (instance Options tab → Java). Automatic picks the version each Minecraft release needs and downloads it when it is missing."
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Default runtime" Width="120"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DefaultJavaBox" DisplayMemberPath="Label" SelectionChanged="OnDefaultJavaChanged"/>
                    </DockPanel>
                    <TextBlock x:Name="DefaultJavaHint" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Layout preferences -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Layout" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Choose how secondary pages (Settings, Worlds, instance details...) open."
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <CheckBox x:Name="UseSidePanelBox"
                              Content="Open pages on the right (next to the instance list)"
                              Click="OnUseSidePanelToggled"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,4,0,0"
                               Text="When off, pages cover the main content. Use the back arrow to return."/>
                </StackPanel>
            </Border>

            <!-- Display scale -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Display scale" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Zoom the whole launcher, and separately make mod entries in the list and browse views larger or smaller."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="Launcher" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LauncherScaleLabel" DockPanel.Dock="Right" MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="LauncherScaleSlider" Minimum="0.7" Maximum="1.6"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnLauncherScaleChanged" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Mods (list / browse)" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModScaleLabel" DockPanel.Dock="Right" MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="ModScaleSlider" Minimum="0.7" Maximum="1.6"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnModScaleChanged" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="100% is the default. Changes save and apply automatically; the mod size stacks on top of the launcher scale."/>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Colours" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Pick a preset, or set the two colours the rest of the launcher is built from. Changes apply immediately."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Preset" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ThemePresetBox" Width="260" HorizontalAlignment="Left"
                                  DisplayMemberPath="Name" SelectionChanged="OnThemePresetChanged"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Accent" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="AccentSwatch" Width="46" Height="26" Click="OnPickAccent"
                                HorizontalAlignment="Left" Padding="0"
                                ToolTip="Play, focus rings, links and the rail indicator"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Background" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="SurfaceSwatch" Width="46" Height="26" Click="OnPickSurface"
                                HorizontalAlignment="Left" Padding="0"
                                ToolTip="The deepest surface. Every other panel, border and text tier is derived from it — pick a light colour for a light launcher."/>
                    </DockPanel>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="State colours. Leave one unset to derive it from the two above."/>

                    <WrapPanel Margin="0,0,0,4">
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Danger" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="DangerSwatch" Width="46" Height="26" Click="OnPickDanger" Padding="0"
                                    ToolTip="Delete, Remove and every other destructive button"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Success" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="SuccessSwatch" Width="46" Height="26" Click="OnPickSuccess" Padding="0"
                                    ToolTip="Up-to-date badges, finished downloads, confirmations"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Warning" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="WarningSwatch" Width="46" Height="26" Click="OnPickWarning" Padding="0"
                                    ToolTip="Update-available badges and anything that needs attention but is not an error"/>
                        </StackPanel>
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,8,0,14"/>

                    <TextBlock Style="{StaticResource H3}" Text="Logs" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Colours for the log views (an instance&apos;s Logs tab and the launcher log). Leave a colour unset to derive it from the two above."
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <WrapPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Background" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="LogBgSwatch" Width="46" Height="26" Click="OnPickLogBackground" Padding="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Text" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="LogTextSwatch" Width="46" Height="26" Click="OnPickLogText" Padding="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Warnings" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="LogWarnSwatch" Width="46" Height="26" Click="OnPickLogWarning" Padding="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Errors" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="LogErrorSwatch" Width="46" Height="26" Click="OnPickLogError" Padding="0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Muted" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="LogMutedSwatch" Width="46" Height="26" Click="OnPickLogMuted" Padding="0"
                                    ToolTip="Timestamps and other low-priority log text"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,10">
                            <TextBlock Text="Highlights" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <Button x:Name="LogAccentSwatch" Width="46" Height="26" Click="OnPickLogAccent" Padding="0"
                                    ToolTip="Matches from the log search box and other highlighted lines"/>
                        </StackPanel>
                    </WrapPanel>

                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Reset to default" Click="OnResetTheme"
                                Style="{StaticResource SubtleButton}"/>
                        <TextBlock x:Name="ThemeHint" Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,12,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Downloads -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Downloads" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="How many mod files download at the same time — during Update all, when installing a mod with its dependencies, and while a modpack is being installed."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="At once" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConcurrencyLabel" DockPanel.Dock="Right" MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="9"
                                TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                ValueChanged="OnConcurrencyChanged" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="150,8,0,0" TextWrapping="Wrap"
                               Text="Three is a good default. Higher is faster on a quick connection, but the mod stores answer a burst of requests from one address with refusals — which everyone using this launcher shares."/>
                </StackPanel>
            </Border>

            <!-- Mod stores -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Mod stores" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="The launcher normally uses its own CurseForge key, shared by everyone. Put your own key here and your mod searches, update checks and downloads use your quota instead of the shared one."
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="CurseForge key" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Get a key" Style="{StaticResource LinkButton}"
                                Click="OnOpenCurseForgeConsole" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Opens console.curseforge.com, where a free API key can be created"/>
                        <PasswordBox x:Name="CurseForgeKeyBox" PasswordChanged="OnCurseForgeKeyChanged"
                                     ToolTip="Leave empty to use the launcher&apos;s shared key"/>
                    </DockPanel>
                    <TextBlock x:Name="CurseForgeKeyHint" Style="{StaticResource Caption}"
                               Margin="150,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Mods -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Mods" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="How mods are downloaded, updated and listed. An instance can override the channel on its Mods Management → Advanced tab."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Version channel" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ModChannelBox" Width="260" HorizontalAlignment="Left"
                                  SelectionChanged="OnModChannelChanged">
                            <ComboBoxItem Content="Latest version" ToolTip="Whatever was published last, including betas and alphas"/>
                            <ComboBoxItem Content="Latest beta or release" ToolTip="Skips alphas"/>
                            <ComboBoxItem Content="Latest release only" ToolTip="Stable releases only"/>
                        </ComboBox>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="150,8,0,0" TextWrapping="Wrap"
                               Text="Applies to downloading a mod, to Update all, and to required dependencies. A mod that only ever publishes betas still installs whatever this is set to."/>

                    <DockPanel Margin="0,16,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Row text width" Width="150"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModRowWidthLabel" DockPanel.Dock="Right" MinWidth="56" TextAlignment="Right"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Slider x:Name="ModRowWidthSlider" Minimum="360" Maximum="2000"
                                TickFrequency="20" IsSnapToTickEnabled="True"
                                ValueChanged="OnModRowWidthChanged" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="150,8,0,0" TextWrapping="Wrap"
                               Text="How far a mod's name and version may run in the List view before it is trimmed."/>

                    <CheckBox x:Name="ModRowActionsRightBox" Margin="150,14,0,0" Click="OnModRowActionsChanged"
                              Content="Keep row buttons at the right edge"/>
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="150,6,0,0" TextWrapping="Wrap"
                               Text="On gives every row one straight column of controls down the right of the list. Off tucks them in right after the mod's name, a shorter mouse hop away on a wide monitor."/>
                </StackPanel>
            </Border>

            <!-- Minecraft game window -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Minecraft game window" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Launcher-started Minecraft instances open in a custom window with a bottom play-time bar and a right instance panel."
                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <CheckBox x:Name="UseCustomGameWindowBox"
                              Content="Launch the game in CloudLauncher's custom window"
                              Click="OnUseCustomGameWindowToggled"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,4,0,14"
                               Text="When off, Minecraft opens in its own native window and the options below don't apply."/>
                    <StackPanel x:Name="CustomGameWindowOptions">
                        <local:KeybindRow x:Name="MinecraftWindowKey" Label="Collapse shortcut" Margin="0,0,0,8"
                                          BoundChanged="OnMinecraftWindowKeyChanged"/>
                        <local:KeybindRow x:Name="MinecraftWindowFullscreenKey" Label="Fullscreen shortcut" Margin="0,0,0,12"
                                          BoundChanged="OnMinecraftWindowFullscreenKeyChanged"/>
                        <CheckBox x:Name="MinecraftWindowPackPageCollapsedBox"
                                  Content="Start with launcher chrome hidden"
                                  Click="OnMinecraftWindowPackPageCollapsedToggled"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,4,0,10"
                                   Text="Opens with the title bar, instance page, and play-time bar collapsed — same result as pressing the collapse shortcut once. Press it again to bring chrome back."/>
                        <CheckBox x:Name="MinecraftWindowBorderlessFullscreenBox"
                                  Content="Open borderless fullscreen by default"
                                  Click="OnMinecraftWindowBorderlessFullscreenToggled"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="26,4,0,12"
                                   Text="Instances can override this default on their Options tab."/>
                        <TextBlock x:Name="MinecraftWindowKeyHint" Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Text="Keyboard shortcuts are saved when selected and registered while the game wrapper is open."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Storage paths -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Storage" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="Where instances and the Minecraft runtime are stored on this machine."
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="Instances folder" Width="120"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <!-- Row actions at the right edge -->
                        <Button DockPanel.Dock="Right" Content="Open" Click="OnOpenPacksFolder"
                                ToolTip="Open this folder in Explorer"/>
                        <Button DockPanel.Dock="Right" x:Name="ChangePacksFolderButton" Content="Change..."
                                Click="OnChangePacksFolder" Margin="0,0,8,0"
                                ToolTip="Put your instances on another drive. You choose whether the existing ones move with it."/>
                        <TextBlock x:Name="PacksFolderLabel" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,16,0"/>
                    </DockPanel>
                    <TextBlock x:Name="PacksFolderHint" Style="{StaticResource Caption}"
                               Margin="120,0,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Runtime" Width="120"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Open" Click="OnOpenRuntimeFolder"/>
                        <TextBlock x:Name="RuntimeFolderLabel" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,16,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Never-upload paths -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="Files that never leave this PC" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Anything matching one of these paths is left out when a shared instance is uploaded, and a sync from the server is never allowed to overwrite or delete it. Use it for large local-only assets that everyone else does not need."/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource TextTertiaryBrush}">
                        Paths are relative to an instance&apos;s <Run FontFamily="{StaticResource MonoFont}">game/</Run> folder.
                        A trailing <Run FontFamily="{StaticResource MonoFont}">/</Run> means the whole folder
                        (<Run FontFamily="{StaticResource MonoFont}">config/mymod/bundle/</Run>); otherwise it is an exact
                        path or a glob (<Run FontFamily="{StaticResource MonoFont}">saves/**</Run>).
                    </TextBlock>

                    <Border Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="6" MinHeight="60">
                        <ItemsControl x:Name="PrivatePathsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,3">
                                        <!-- Row actions at the right edge -->
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Content="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                Foreground="{DynamicResource DangerBrush}"
                                                Visibility="{Binding RemoveVisibility}"
                                                Click="OnRemovePrivatePath"
                                                ToolTip="Stop protecting this path"/>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                VerticalAlignment="Center" Margin="8,0,0,0"
                                                Visibility="{Binding BuiltInVisibility}"
                                                ToolTip="Shipped with the launcher and always applied">
                                            <TextBlock Text="built-in" Style="{StaticResource PillText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Pattern}" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Add pattern..." Click="OnAddPrivatePath"
                                Style="{StaticResource AccentButton}"/>
                        <TextBlock x:Name="PrivatePathsHint" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="22,18">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="CheckUpdateButton" Content="Check for updates"
                                Style="{StaticResource AccentButton}" Click="OnCheckForUpdates"
                                VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" x:Name="ChangelogButton" Content="What&apos;s new"
                                Click="OnOpenChangelog" VerticalAlignment="Center" Margin="0,0,8,0"
                                ToolTip="Read the release notes for this and every earlier version"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource H3}" Text="Launcher updates"/>
                            <TextBlock x:Name="VersionLabel" Style="{StaticResource Muted}"
                                       TextWrapping="Wrap" Margin="0,4,16,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="UpdateStatusLabel" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource H3}" Text="About" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="CloudLauncher - Minecraft launcher with shared instances, team sync, and built-in mod browsing."/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusLabel" Style="{StaticResource Caption}" Margin="0,16,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
