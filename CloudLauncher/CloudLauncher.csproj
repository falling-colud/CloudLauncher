<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\CloudLauncher.Shared\CloudLauncher.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- The Slate style's fonts: Pixelify Sans (OFL, static weights built by tools/fonts) and the
           Slate pixel icon set mapped onto Segoe MDL2 codepoints (tools/slate-icons). -->
      <Resource Include="Assets\Fonts\*.ttf" />
    </ItemGroup>

    <ItemGroup>
      <!-- Shipped next to the exe; Settings > About opens them. -->
      <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CmlLib.Core" Version="4.0.6" />
      <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
      <PackageReference Include="CmlLib.Core.Auth.Microsoft.UI.Wpf" Version="2.0.2" />
      <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
      <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
      <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.8" />
      <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
      <PackageReference Include="XboxAuthNet.Game" Version="1.4.1" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- Embedded as the exe's Win32 icon (taskbar / Explorer / Alt-Tab) and used by the
             installer for shortcuts. Because the self-updater rebuilds from this same project,
             every self-updated exe keeps the icon too. -->
        <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
        <!-- Shown in Explorer's file properties. Authors, company and copyright come from
             Directory.Build.props. -->
        <Description>CloudLauncher, a cloud-synced Minecraft launcher</Description>
        <!-- English-only app: skip the translated resource folders dependencies bring along. -->
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <!-- Launcher version. Bump this before publishing an update or building the installer;
             publish-release.ps1 and build-installer.ps1 read it and the in-app updater compares
             against it. -->
        <Version>0.9.2</Version>
    </PropertyGroup>

</Project>
