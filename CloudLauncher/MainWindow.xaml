<Window x:Class="CloudLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:anim="clr-namespace:CloudLauncher.Animations"
        xmlns:views="clr-namespace:CloudLauncher.Views"
        xmlns:svc="clr-namespace:CloudLauncher.Services"
        xmlns:slate="clr-namespace:CloudLauncher.Controls"
        Title="CloudLauncher" Height="720" Width="1180" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface0Brush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!--  Nav icons. In the Slate style the selected item's icon takes the accent. The size is
        a resource because the pixel icon set is crisp at 16 but soft at 15.  -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource NavIconSize}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"/>
                        <Condition Binding="{Binding IsSlate, Source={x:Static svc:LookState.Current}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Reusable label column for nav items so labels share the same Margin/style.  -->
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <!-- The Discord mark, for the sidebar link. -->
        <Geometry x:Key="DiscordGlyph">M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z</Geometry>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Surface0Brush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="RootScale"/>
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!--  Offline banner. Auto height, and the banner is collapsed while online, so the
                row takes no space then.  -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════════════ TITLE BAR ════════════════ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">

                    <!-- Window buttons (right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE922;" ToolTip="Maximize" Click="OnMaximize"/>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                                Content="&#xE8BB;" ToolTip="Close" Click="OnClose"/>
                    </StackPanel>

                    <!-- Brand (left edge of the title bar) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20,0,16,0">
                        <slate:SlateBorder Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="CloudLauncher"
                                   FontFamily="{DynamicResource BrandFont}"
                                   FontSize="{DynamicResource BrandFontSize}" FontWeight="{DynamicResource BrandFontWeight}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minecraft-account chip -->
                    <slate:SlateBorder DockPanel.Dock="Right" Margin="0,4,12,4"
                            Background="{DynamicResource Surface3Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="2"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="McAccountChip" Style="{StaticResource IconButton}"
                                Padding="6,2" MinHeight="0" MinWidth="0"
                                Click="OnMcAccountChip" Cursor="Hand"
                                ToolTip="Switch Minecraft account">
                            <StackPanel Orientation="Horizontal">
                                <slate:SlateBorder Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFont}"
                                               FontSize="11" Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </slate:SlateBorder>
                                <TextBlock x:Name="McAccountChipLabel"
                                           Text="No MC account"
                                           Margin="8,0,8,0" VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </slate:SlateBorder>

                    <Grid Background="Transparent"/>
                </DockPanel>
            </Border>

            <!-- ════════════════ OFFLINE BANNER ════════════════ -->
            <views:OfflineBanner x:Name="OfflineBar" Grid.Row="1" Grid.ColumnSpan="2"/>

            <!-- ════════════════ SIDEBAR ════════════════ -->
            <!-- Every row inside is a Grid with a fixed 60 px icon column and a flexible label
            column, so the icons stay put when the sidebar collapses (60 px) or expands (240 px). -->
            <Border Grid.Row="2" Grid.Column="0"
                    Background="{DynamicResource Surface1Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel x:Name="Sidebar">

                    <!-- ── TOP: hamburger + sidebar header (expands rightward) ────────── -->
                    <Button x:Name="SidebarToggle" DockPanel.Dock="Top"
                            Click="OnSidebarToggle" ToolTip="Toggle sidebar"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Padding="0" MinHeight="48" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE700;"
                                       FontFamily="{DynamicResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="SidebarHeaderLabel" Grid.Column="1"
                                       Style="{StaticResource SidebarHeader}" Text="YOUR MINECRAFT"/>
                        </Grid>
                    </Button>

                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{DynamicResource BorderSubtleBrush}" Margin="0,2,0,4"/>

                    <!-- ── BOTTOM GROUP: utility panels ──────────────────────────────── -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4,0,4"/>

                        <!--  Storage sits with the other launcher-wide screens, not in the
                        scrolled rail. Unlike Sharing and Account it needs no account, so it
                        is never gated.  -->
                        <ToggleButton x:Name="NavStorage" Style="{StaticResource NavButton}"
                                      Click="OnNavStorage" ToolTip="Storage">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xEDA2;"
                                           Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="NavStorageLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Storage"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSharing" Style="{StaticResource NavButton}"
                                      Click="OnNavSharing" ToolTip="Sharing">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE72D;"
                                           Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="NavSharingLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Sharing"/>
                            </Grid>
                        </ToggleButton>

                        <!-- A link, not a page: OnNavDiscord unchecks it again. -->
                        <ToggleButton x:Name="NavDiscord" Style="{StaticResource NavButton}"
                                      Click="OnNavDiscord" ToolTip="Join the CloudLauncher Discord">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource DiscordGlyph}" Stretch="Uniform"
                                      Width="{DynamicResource NavIconSize}" Height="{DynamicResource NavIconSize}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                <TextBlock x:Name="NavDiscordLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Discord"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavAccount" Style="{StaticResource NavButton}"
                                      Click="OnNavAccount" ToolTip="Account">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE77B;"
                                           Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="NavAccountLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Account"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                      Click="OnNavSettings" ToolTip="Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE713;"
                                           Style="{StaticResource NavIcon}"/>
                                <TextBlock x:Name="NavSettingsLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Settings"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavDev" Style="{StaticResource NavButton}"
                                      Click="OnNavDev" ToolTip="Dev tools" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BA;"
                                           Style="{StaticResource NavIcon}"
                                           Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock x:Name="NavDevLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Dev tools"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <!-- ── TOP GROUP: master + secondary library views ──
                    Scrolls instead of clipping: as the DockPanel's fill child it would
                    otherwise cut off the last rows at small window heights or with RootScale
                    above 100%. LastChildFill makes it fill, so no Dock attribute. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ToggleButton x:Name="NavPacks" Style="{StaticResource NavButton}"
                                          Click="OnNavPacks" IsChecked="True" ToolTip="Instances">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7C3;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavPacksLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Instances"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavMods" Style="{StaticResource NavButton}"
                                          Click="OnNavMods" ToolTip="Mods">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xEC4A;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavModsLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Mods"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavWorlds" Style="{StaticResource NavButton}"
                                          Click="OnNavWorlds" ToolTip="Worlds">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE909;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavWorldsLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Worlds"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavResourcePacks" Style="{StaticResource NavButton}"
                                          Click="OnNavResourcePacks" ToolTip="Resource packs">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7C9;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavResourcePacksLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Resource packs"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavShaders" Style="{StaticResource NavButton}"
                                          Click="OnNavShaders" ToolTip="Shader packs">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE706;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavShadersLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Shader packs"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavServers" Style="{StaticResource NavButton}"
                                          Click="OnNavServers" ToolTip="Servers">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE968;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavServersLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Servers"/>
                                </Grid>
                            </ToggleButton>

                            <ToggleButton x:Name="NavConfigs" Style="{StaticResource NavButton}"
                                          Click="OnNavConfigs" ToolTip="Config &amp; scripts">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE943;"
                                               Style="{StaticResource NavIcon}"/>
                                    <TextBlock x:Name="NavConfigsLabel" Grid.Column="1"
                                               Style="{StaticResource NavLabel}" Text="Config &amp; scripts"/>
                                </Grid>
                            </ToggleButton>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ════════════════ CONTENT REGION ════════════════ -->
            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <!--  Master list - always visible; minimum so it stays readable  -->
                    <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="360"/>
                    <!--  Drag handle - 5 px when side panel is open, 0 when closed  -->
                    <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                    <!--  Side panel - star-based so the ratio holds on resize. MinWidth is set in
                    code only while the panel is open, otherwise it leaves a 280 px gap.  -->
                    <ColumnDefinition x:Name="SidePanelColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Frame x:Name="MainFrame" Grid.Column="0"
                       NavigationUIVisibility="Hidden"
                       anim:Animate.PageTransition="True"
                       Background="{DynamicResource Surface0Brush}"/>

                <!--  Drag splitter between master and side panel  -->
                <GridSplitter x:Name="PanelSplitter"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeWE"
                              Visibility="Collapsed"
                              Background="Transparent"
                              Width="5">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border x:Name="track"
                                    Background="{DynamicResource BorderBrush}"
                                    Width="1"
                                    HorizontalAlignment="Center">
                                <!-- grip dots centred in the handle -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="3" Height="3" Margin="0,2"
                                             Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Ellipse Width="3" Height="3" Margin="0,2"
                                             Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Ellipse Width="3" Height="3" Margin="0,2"
                                             Fill="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="track" Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="track" Property="Width" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid x:Name="SidePanelHost" Grid.Column="2"
                      Visibility="Collapsed">
                    <Border Background="{DynamicResource Surface1Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,0">
                        <Frame x:Name="SideFrame" NavigationUIVisibility="Hidden"
                               anim:Animate.PageTransition="True"
                               Background="{DynamicResource Surface0Brush}"/>
                    </Border>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,10,0"
                                Panel.ZIndex="2">
                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="8"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Content="&#xE8BB;"
                                FontFamily="{DynamicResource IconFont}"
                                FontSize="10"
                                Click="OnFullCloseSidePanel"
                                ToolTip="Close panel"/>
                        <Button x:Name="SidePanelBackButton"
                                Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="8"
                                Margin="0,6,0,0"
                                Background="{DynamicResource Surface3Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Content="&#xE72B;"
                                FontFamily="{DynamicResource IconFont}"
                                FontSize="10"
                                Click="OnBackSidePanel"
                                ToolTip="Back"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- In-window modal dialog overlay (themed; replaces OS message boxes) -->
            <Grid x:Name="DialogLayer" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2"
                  Panel.ZIndex="100" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
