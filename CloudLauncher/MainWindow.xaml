<Window x:Class="CloudLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:anim="clr-namespace:CloudLauncher.Animations"
        Title="CloudLauncher" Height="720" Width="1180" MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface0Brush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SidebarHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Reusable label column for nav items so labels share the same Margin/style.  -->
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource Surface0Brush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="RootScale"/>
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════════════ TITLE BAR ════════════════ -->
            <Border Grid.Row="0" Grid.ColumnSpan="2"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">

                    <!-- Window buttons (right) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE922;" ToolTip="Maximize" Click="OnMaximize"/>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                                Content="&#xE8BB;" ToolTip="Close" Click="OnClose"/>
                    </StackPanel>

                    <!-- Brand (left edge of the title bar) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="20,0,16,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="CloudLauncher"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Minecraft-account chip -->
                    <Border DockPanel.Dock="Right" Margin="0,4,12,4"
                            Background="{StaticResource Surface3Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="2"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="McAccountChip" Style="{StaticResource IconButton}"
                                Padding="6,2" MinHeight="0" MinWidth="0"
                                Click="OnMcAccountChip" Cursor="Hand"
                                ToolTip="Switch Minecraft account">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                               FontSize="11" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="McAccountChipLabel"
                                           Text="No MC account"
                                           Margin="8,0,8,0" VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <Grid Background="Transparent"/>
                </DockPanel>
            </Border>

            <!-- ════════════════ SIDEBAR ════════════════ -->
            <!-- Layout key: every row inside is a Grid with a fixed 60-px icon column and a
                 flexible label column. Icons stay anchored at the same X when the sidebar
                 collapses (60 px) or expands (240 px) — only the label column shrinks. -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel x:Name="Sidebar">

                    <!-- ── TOP: hamburger + LIBRARY label (expands rightward) ────────── -->
                    <Button x:Name="SidebarToggle" DockPanel.Dock="Top"
                            Click="OnSidebarToggle" ToolTip="Toggle sidebar"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                            Padding="0" MinHeight="48" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{StaticResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE700;"
                                       FontFamily="{StaticResource IconFont}" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="SidebarHeaderLabel" Grid.Column="1"
                                       Style="{StaticResource SidebarHeader}" Text="LIBRARY"/>
                        </Grid>
                    </Button>

                    <Border DockPanel.Dock="Top" Height="1"
                            Background="{StaticResource BorderSubtleBrush}" Margin="0,2,0,4"/>

                    <!-- ── BOTTOM GROUP: utility panels ──────────────────────────────── -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,4,0,4"/>

                        <ToggleButton x:Name="NavTeams" Style="{StaticResource NavButton}"
                                      Click="OnNavTeams" ToolTip="Teams">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE716;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavTeamsLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Teams"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavAccount" Style="{StaticResource NavButton}"
                                      Click="OnNavAccount" ToolTip="Account">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE77B;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavAccountLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Account"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                      Click="OnNavSettings" ToolTip="Settings">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE713;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSettingsLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Settings"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavDev" Style="{StaticResource NavButton}"
                                      Click="OnNavDev" ToolTip="Dev tools" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7BA;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock x:Name="NavDevLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Dev tools"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <!-- ── TOP GROUP: master + secondary library views ───────────────── -->
                    <StackPanel DockPanel.Dock="Top">
                        <ToggleButton x:Name="NavPacks" Style="{StaticResource NavButton}"
                                      Click="OnNavPacks" IsChecked="True" ToolTip="Instances">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7C3;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavPacksLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Instances"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavWorlds" Style="{StaticResource NavButton}"
                                      Click="OnNavWorlds" ToolTip="Worlds">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE909;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavWorldsLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Worlds"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavMods" Style="{StaticResource NavButton}"
                                      Click="OnNavMods" ToolTip="Mods">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xEC4A;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavModsLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Mods"/>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="NavResourcePacks" Style="{StaticResource NavButton}"
                                      Click="OnNavResourcePacks" ToolTip="Resource packs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE7C9;"
                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavResourcePacksLabel" Grid.Column="1"
                                           Style="{StaticResource NavLabel}" Text="Resource packs"/>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ════════════════ CONTENT REGION ════════════════ -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <!--  Master list — always visible; minimum so it stays readable  -->
                    <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="360"/>
                    <!--  Drag handle — 5 px when side panel is open, 0 when closed  -->
                    <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                    <!--  Side panel — star-based so ratio is maintained on resize.
                         MinWidth is set in code only when the panel is actually open
                         (otherwise it leaves a 280-px gap when closed).  -->
                    <ColumnDefinition x:Name="SidePanelColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <Frame x:Name="MainFrame" Grid.Column="0"
                       NavigationUIVisibility="Hidden"
                       anim:Animate.PageTransition="True"
                       Background="{StaticResource Surface0Brush}"/>

                <!--  Drag splitter between master and side panel  -->
                <GridSplitter x:Name="PanelSplitter"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeWE"
                              Visibility="Collapsed"
                              Background="Transparent"
                              Width="5">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Border x:Name="track"
                                    Background="{StaticResource BorderBrush}"
                                    Width="1"
                                    HorizontalAlignment="Center">
                                <!-- grip dots centred in the handle -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Ellipse Width="3" Height="3" Margin="0,2"
                                             Fill="{StaticResource TextTertiaryBrush}"/>
                                    <Ellipse Width="3" Height="3" Margin="0,2"
                                             Fill="{StaticResource TextTertiaryBrush}"/>
                                    <Ellipse Width="3" Height="3" Margin="0,2"
                                             Fill="{StaticResource TextTertiaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="track" Property="Background"
                                            Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="track" Property="Width" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Grid x:Name="SidePanelHost" Grid.Column="2"
                      Visibility="Collapsed">
                    <Border Background="{StaticResource Surface1Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,0">
                        <Frame x:Name="SideFrame" NavigationUIVisibility="Hidden"
                               anim:Animate.PageTransition="True"
                               Background="{StaticResource Surface0Brush}"/>
                    </Border>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,10,0"
                                Panel.ZIndex="2">
                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="8"
                                Background="{StaticResource Surface3Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Content="&#xE8BB;"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="10"
                                Click="OnFullCloseSidePanel"
                                ToolTip="Close panel"/>
                        <Button x:Name="SidePanelBackButton"
                                Style="{StaticResource IconButton}"
                                Width="32"
                                Height="32"
                                MinWidth="32"
                                MinHeight="32"
                                Padding="8"
                                Margin="0,6,0,0"
                                Background="{StaticResource Surface3Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Content="&#xE72B;"
                                FontFamily="{StaticResource IconFont}"
                                FontSize="10"
                                Click="OnBackSidePanel"
                                ToolTip="Back"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- In-window modal dialog overlay (themed; replaces OS message boxes) -->
            <Grid x:Name="DialogLayer" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Panel.ZIndex="100" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
