<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Surfaces (deepest → most elevated)  -->
    <Color x:Key="Surface0Color">#FF0B0D11</Color>
    <Color x:Key="Surface1Color">#FF11141B</Color>
    <Color x:Key="Surface2Color">#FF181C25</Color>
    <Color x:Key="Surface3Color">#FF1F2430</Color>
    <Color x:Key="Surface4Color">#FF272D3B</Color>
    <Color x:Key="SurfaceHoverColor">#FF2D3445</Color>
    <Color x:Key="SurfaceActiveColor">#FF353C50</Color>

    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource Surface0Color}"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="Surface4Brush" Color="{StaticResource Surface4Color}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}"/>

    <!--  Borders  -->
    <Color x:Key="BorderSubtleColor">#FF242938</Color>
    <Color x:Key="BorderColor">#FF2E3445</Color>
    <Color x:Key="BorderStrongColor">#FF3A4254</Color>
    <Color x:Key="BorderFocusColor">#FF6B1212</Color>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!--  Text  -->
    <Color x:Key="TextPrimaryColor">#FFEEF1F7</Color>
    <Color x:Key="TextSecondaryColor">#FFA8B0BF</Color>
    <Color x:Key="TextTertiaryColor">#FF7C8597</Color>
    <Color x:Key="TextDisabledColor">#FF555C6C</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <!--  Accent + Play: dark crimson red — used for all primary actions, focus, rail indicator  -->
    <Color x:Key="AccentColor">#FF6B1212</Color>
    <Color x:Key="AccentHoverColor">#FF871A1A</Color>
    <Color x:Key="AccentPressedColor">#FF4F0C0C</Color>
    <Color x:Key="AccentSoftColor">#336B1212</Color>
    <Color x:Key="AccentGlowColor">#1A6B1212</Color>

    <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentGlowBrush"    Color="{StaticResource AccentGlowColor}"/>

    <!--  Play reuses the accent red — unified "action" colour  -->
    <SolidColorBrush x:Key="PlayBrush"        Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="PlayHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="PlayPressedBrush" Color="{StaticResource AccentPressedColor}"/>

    <!--  Informational blue — Modrinth tags, local-file rule hints  -->
    <Color x:Key="InfoBlueColor">#FF5B9DF9</Color>
    <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}"/>

    <!--  Status colours  -->
    <Color x:Key="SuccessColor">#FF3FB950</Color>
    <Color x:Key="WarningColor">#FFE3B341</Color>
    <Color x:Key="DangerColor">#FF8A1C1C</Color>
    <Color x:Key="DangerHoverColor">#FFA32828</Color>
    <Color x:Key="InfoColor">#FF5B9DF9</Color>

    <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"     Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="InfoBrush"        Color="{StaticResource InfoColor}"/>

    <!--  Tag pill colours  -->
    <SolidColorBrush x:Key="TagSharedBgBrush"   Color="#336B1212"/>
    <SolidColorBrush x:Key="TagSharedFgBrush"   Color="#FFD36A6A"/>
    <SolidColorBrush x:Key="TagTeamBgBrush"     Color="#33A855F7"/>
    <SolidColorBrush x:Key="TagTeamFgBrush"     Color="#FFCFAEFF"/>
    <SolidColorBrush x:Key="TagPublicBgBrush"   Color="#3310B981"/>
    <SolidColorBrush x:Key="TagPublicFgBrush"   Color="#FF7EE2B5"/>
    <SolidColorBrush x:Key="TagEmptyBgBrush"    Color="#33808896"/>
    <SolidColorBrush x:Key="TagEmptyFgBrush"    Color="#FFB4BCC9"/>
    <SolidColorBrush x:Key="TagModrinthBgBrush" Color="#3318A0FF"/>
    <SolidColorBrush x:Key="TagModrinthFgBrush" Color="#FF7FC7FF"/>

    <!--  Title-bar gradient: very subtle red warmth on deepest surface  -->
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF12151D" Offset="0"/>
        <GradientStop Color="#FF161014" Offset="1"/>
    </LinearGradientBrush>

    <!--  Scrollbar  -->
    <SolidColorBrush x:Key="ScrollThumbBrush"      Color="#FF3A4254"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FF505A70"/>
    <SolidColorBrush x:Key="ScrollTrackBrush"      Color="#FF14171F"/>

    <!--  Typography
         IconFont: MDL2 Assets first so it works on Windows 10 + 11.
         All icon codepoints in the app (E700–E8BB range) live in MDL2 Assets.  -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Lucida Console</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
