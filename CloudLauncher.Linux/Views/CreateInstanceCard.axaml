<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CloudLauncher.Views.CreateInstanceCard">
    <UserControl.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="dialog" Width="520">
        <StackPanel>
            <TextBlock Classes="h2" Text="Create Instance"/>

            <TextBlock Classes="field" Text="Name" Margin="0,18,0,6"/>
            <TextBox x:Name="NameBox" MaxLength="128" Watermark="My Instance"/>

            <DockPanel>
                <TextBlock x:Name="SummaryCounter" DockPanel.Dock="Right" Classes="caption" VerticalAlignment="Bottom"
                           Margin="0,0,0,6"/>
                <TextBlock Classes="field" Text="Summary"/>
            </DockPanel>
            <TextBox x:Name="SummaryBox" Watermark="Optional" TextWrapping="Wrap" MaxHeight="72"/>

            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Minecraft Version"/>
                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="McVersionBox" PlaceholderText="Loading..."
                          MaxDropDownHeight="320"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Classes="field" Text="Loader"/>
                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LoaderBox" SelectedIndex="0">
                    <ComboBoxItem Content="Vanilla" Tag="None"/>
                    <ComboBoxItem Content="Fabric" Tag="Fabric"/>
                    <ComboBoxItem Content="Forge" Tag="Forge"/>
                    <ComboBoxItem Content="NeoForge" Tag="NeoForge"/>
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LoaderVersionLabel" Classes="field" Text="Loader Version"/>
                <ComboBox Grid.Row="3" Grid.Column="0" x:Name="LoaderVersionBox" PlaceholderText="Not needed"
                          IsEnabled="False" MaxDropDownHeight="320"/>

                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="VisibilityLabel" Classes="field" Text="Visibility"/>
                <ComboBox Grid.Row="3" Grid.Column="2" x:Name="VisibilityBox" SelectedIndex="0">
                    <ComboBoxItem Content="Private" Tag="Private"/>
                    <ComboBoxItem Content="Team" Tag="Team"/>
                    <ComboBoxItem Content="Public" Tag="Public"/>
                </ComboBox>
            </Grid>

            <CheckBox x:Name="EmptyBox" Content="Empty Instance" Margin="0,14,0,0"
                      ToolTip.Tip="A folder to share files with, without Minecraft: it can't be played"/>
            <TextBlock x:Name="NoteText" Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,10,0,0" IsVisible="False"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" HorizontalContentAlignment="Center"
                        Click="OnCancel"/>
                <Button x:Name="CreateButton" Classes="primary" Content="Create" MinWidth="90"
                        HorizontalContentAlignment="Center" Click="OnCreate"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
