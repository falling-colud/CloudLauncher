<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CloudLauncher.Views"
             x:Class="CloudLauncher.Views.InstancePage">
    <UserControl.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <!-- Play and Stop: the page's big button. -->
        <Style Selector="Button.big">
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.action">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.option">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="20,16"/>
        </Style>
        <Style Selector="ListBox.logs ListBoxItem">
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style Selector="TabControl#Tabs">
            <Setter Property="Padding" Value="0,12,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- ── back to the list ── -->
        <Button Grid.Row="0" x:Name="BackButton" Classes="ghost" Margin="20,14,0,0" Padding="8,5"
                HorizontalAlignment="Left" Click="OnBack" ToolTip.Tip="Back (Alt+Left)">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="icon" Text="&#xE72B;" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="Instances" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Button>

        <!-- ── the instance: cover, name, version, owner, Play and the sync actions ── -->
        <Border Grid.Row="1" Classes="card" Margin="28,6,28,0" Padding="22,20" BoxShadow="3 3 0 0 #4D000000">
            <Grid ColumnDefinitions="Auto,*">
                <Border x:Name="IconBox" Width="92" Height="92" CornerRadius="4" ClipToBounds="True"
                        VerticalAlignment="Top" Margin="0,2,22,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                <StackPanel Grid.Column="1">
                    <DockPanel>
                        <StackPanel x:Name="TagRow" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock x:Name="NameText" Classes="h1" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,6,0,0"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                    <TextBlock x:Name="MetaText" Classes="muted" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatsText" Classes="caption" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SummaryText" Classes="muted" Margin="0,10,0,0" TextWrapping="Wrap" MaxLines="2"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- a launch, import or sync in progress -->
                    <StackPanel x:Name="ProgressArea" Margin="0,14,0,0" Spacing="6" MaxWidth="560"
                                HorizontalAlignment="Left" Width="560" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ProgressLabel" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="ProgressPercent" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                       Margin="12,0,0,0" Foreground="{DynamicResource AccentTextBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="MainProgress" Minimum="0" Maximum="100"/>
                        <Grid x:Name="CurrentHeader" ColumnDefinitions="*,Auto" Margin="0,2,0,0" IsVisible="False">
                            <TextBlock x:Name="CurrentLabel" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="CurrentPercent" Grid.Column="1" FontSize="11" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="CurrentProgress" Minimum="0" Maximum="100" Height="2" MinHeight="2"
                                     IsVisible="False"/>
                    </StackPanel>

                    <!-- Play first (the page's accent), then what moves files, then the folder on the right. -->
                    <DockPanel Margin="0,16,0,0">
                        <Button x:Name="FolderButton" DockPanel.Dock="Right" Classes="action" VerticalAlignment="Top"
                                Margin="10,0,0,0" Click="OnOpenFolder" ToolTip.Tip="Open this instance's game folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="&#xE838;" FontSize="13"/>
                                <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <WrapPanel x:Name="ActionRow" Orientation="Horizontal" ItemSpacing="10" LineSpacing="10">
                            <Button x:Name="PlayButton" Classes="primary big" Click="OnPlay">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="icon" Text="&#xE768;" FontSize="13"/>
                                    <TextBlock Text="Play" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Classes="destructive big" Click="OnStop" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="icon" Text="&#xE711;" FontSize="13" Foreground="White"/>
                                    <TextBlock x:Name="StopText" Text="Stop" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="White"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PauseJobButton" Classes="big" Click="OnPauseJob" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="PauseJobIcon" Classes="icon" Text="&#xE769;" FontSize="13"/>
                                    <TextBlock x:Name="PauseJobText" Text="Pause" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopJobButton" Classes="action danger" Click="OnStopJob" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="&#xE711;" FontSize="12"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                    <TextBlock x:Name="StopJobText" Text="Stop" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpdateButton" Classes="action" Click="OnDownload" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="&#xE896;" FontSize="13"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                    <TextBlock x:Name="UpdateText" Text="Update" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="UploadButton" Classes="action" Click="OnUpload" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="UploadIcon" Classes="icon" Text="&#xE898;" FontSize="13"/>
                                    <TextBlock x:Name="UploadText" Text="Upload Changes" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ManualButton" Classes="action" Click="OnManualDownloads" IsVisible="False"
                                    ToolTip.Tip="Files this instance needs that only CurseForge's website hands out">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="icon" Text="&#xE7BA;" FontSize="13"
                                               Foreground="{DynamicResource WarningBrush}"/>
                                    <TextBlock x:Name="ManualText" Text="Manual Downloads" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock x:Name="StatusText" Classes="caption" TextWrapping="Wrap" Margin="0,12,0,0" IsVisible="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── tabs ── -->
        <TabControl Grid.Row="2" x:Name="Tabs" Margin="22,10,22,0">
            <TabItem Header="Mods">
                <ContentControl x:Name="ModsHost" Margin="6,0,6,16"/>
            </TabItem>

            <TabItem Header="Options">
                <ScrollViewer x:Name="OptionsScroll" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,0,6,20" Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
                        <Border Classes="option">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h3" Text="Memory"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Slider x:Name="RamSlider" Minimum="1024" Maximum="32768" TickFrequency="512"
                                            IsSnapToTickEnabled="True" SmallChange="512" LargeChange="1024"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RamText" Grid.Column="1" MinWidth="92" TextAlignment="Right"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextBrush}"/>
                                </Grid>
                                <DockPanel>
                                    <Button x:Name="RamDefaultButton" DockPanel.Dock="Right" Classes="link"
                                            Content="Use Default" Click="OnRamDefault"/>
                                    <TextBlock x:Name="RamHint" Classes="caption" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Classes="field" Text="JVM Arguments" Margin="0,10,0,0"/>
                                <TextBox x:Name="JvmArgsBox" FontFamily="{x:Static views:InstancePage.MonoFont}"
                                         FontSize="12" Watermark="-XX:+UseZGC"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Added after the standard flags, from the next launch."/>
                            </StackPanel>
                        </Border>

                        <Border Classes="option">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h3" Text="Java"/>
                                <ComboBox x:Name="JavaBox" HorizontalAlignment="Stretch" PlaceholderText="Looking for Java..."/>
                                <TextBlock x:Name="JavaHint" Classes="caption" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- An instance made without an account: why it can't be shared, and the step that
                             brings that (the Windows LocalInstanceNote). -->
                        <Border x:Name="LocalCard" Classes="option" IsVisible="False">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h3" Text="On This Computer Only"/>
                                <TextBlock x:Name="LocalText" Classes="muted" TextWrapping="Wrap"/>
                                <Button x:Name="LocalButton" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Click="OnLocalAction"/>
                                <TextBlock x:Name="LocalStatus" Classes="caption" TextWrapping="Wrap" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AutoUpdateCard" Classes="option" IsVisible="False">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="h3" Text="Updates"/>
                                <CheckBox x:Name="AutoUpdateBox" Content="Update Before Play"/>
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Gets the latest shared files from the server before each launch."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Log">
                <Grid ColumnDefinitions="250,14,*" Margin="6,0,6,16">
                    <Border Classes="well" Padding="4">
                        <ListBox x:Name="LogList" Classes="logs">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="views:InstanceLogSource">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Classes="icon" Text="{Binding Glyph}"
                                                   FontSize="12" Margin="0,1,10,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Meta}" Classes="caption" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Column="2" RowDefinitions="Auto,*">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Click="OnCopyLog" ToolTip.Tip="Copy what is shown">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="icon" Text="&#xE8C8;" FontSize="12"/>
                                        <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="OnOpenLogsFolder" ToolTip.Tip="Open the folder the game writes its logs to">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="icon" Text="&#xE838;" FontSize="12"/>
                                        <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="icon" Content="&#xE72C;" Click="OnRefreshLogs" ToolTip.Tip="Refresh"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LogTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="LogMeta" Classes="caption" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Row="1" Background="{DynamicResource Surface0Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <Panel>
                                <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock x:Name="LogText" Margin="12,10" FontSize="12"
                                                         FontFamily="{x:Static views:InstancePage.MonoFont}"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         TextWrapping="NoWrap"/>
                                </ScrollViewer>
                                <TextBlock x:Name="LogEmpty" Classes="caption" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="320" IsVisible="False"/>
                            </Panel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
